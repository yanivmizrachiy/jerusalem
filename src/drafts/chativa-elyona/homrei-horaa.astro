---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import UnitPlaylist from '../../components/UnitPlaylist.astro';
import { hsUnit } from '../../data/units';
---

<Base
  title="חומרי הוראה ומאגרים — חטיבה עליונה — מחוז ירושלים"
  description="מאגרי החטיבה העליונה לתוכנית החדשה: מסמכי התוכנית, קמפוס IL, חומרי מרכז המורים, תכנון שנתי, מאגרי אייל שלמה, רשת ביטחון ומבוא לאנליזה — כל קישור בדוק."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבה עליונה', href: '/chativa-elyona/' },
        { label: 'חומרי הוראה ומאגרים' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">חטיבה עליונה · {hsUnit.grade}</p>
      <h1>{hsUnit.title}</h1>
      <p class="lede">{hsUnit.intro}</p>
    </header>

    <div data-reveal>
      <UnitPlaylist unit={hsUnit} />
    </div>

    <section class="section-block" data-reveal>
      <h2>ההקשר הרשמי בחוזר מפמ״ר</h2>
      <div class="chip-links">
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-17">ספרי לימוד מאושרים</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-18">קמפוס IL בחוזר</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-19">רשת ביטחון בחוזר</a>
      </div>
    </section>

    <nav class="pager-nav" aria-label="ניווט חזרה">
      <a class="btn btn-ghost" href="/chativa-elyona/">חזרה לחטיבה העליונה</a>
      <a class="btn btn-ghost" href="/">לעמוד הראשי</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 680px; margin-block: 1.6rem 2rem; }
  .section-block { margin-block-start: clamp(2.4rem, 5vw, 3.4rem); }
  .section-block h2 { margin-block-end: 1.2rem; }
  .chip-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pager-nav { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-block-start: clamp(2.2rem, 5vw, 3rem); }
</style>
