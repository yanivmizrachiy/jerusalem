---
import Breadcrumbs from './Breadcrumbs.astro';
import AuthorAttribution from './AuthorAttribution.astro';
import { publishableItems } from '../data/publishing';
import { primaryResourceId } from '../data/primary-resources';
import { resourceCountLabel, resourceDisplayLabel } from '../data/resource-labels';
import { visibleResourceNote, visibleResourceTitle } from '../data/resource-copy';
import {
  chapterHref,
  chapterNeighbours,
  gradeHref,
  gradeLabel,
  gradeMaterialsHref,
  itemHref,
  type ChoveretChapter,
  type ChoveretGrade,
  type ChoveretItem,
} from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
  chapter: ChoveretChapter;
}

const { grade, chapter } = Astro.props;
const { prev, next } = chapterNeighbours(grade, chapter.id);
const items = publishableItems(chapter.items);
const primaryId = primaryResourceId(chapter.id);
const primary = primaryId ? items.find((item) => item.id === primaryId) : undefined;
const secondaryItems = primary ? items.filter((item) => item.id !== primary.id) : items;
const isLinearBooklet = chapter.id === 'h-linear-function' && primary?.id === 'kavit-flip';

/**
 * צבע השורה בטבלת המשימות — לפי הסיווג הפדגוגי, עם נפילה לסוג הטכני.
 * כל הצבעים מסדרת 5.19; פריט כללי יורש את צבע הנושא, כך שהטבלה צבעונית
 * אך לעולם לא חורגת מהפלטה.
 */
const resourceRowColor = (item: ChoveretItem): string => {
  const byType: Partial<Record<string, string>> = {
    game: 'var(--terracotta)',
    worksheet: 'var(--olive)',
    test: 'var(--rose)',
    'assessment-guide': 'var(--rose)',
    presentation: 'var(--lilac)',
    'summary-task': 'var(--amber)',
    'formula-sheet': 'var(--gold)',
    'interactive-activity': 'var(--sky)',
    'teaching-unit': 'var(--navy)',
    'teacher-guide': 'var(--navy)',
    'resource-repository': 'var(--gold)',
    'multi-activity-collection': 'var(--gold)',
  };
  const byKind: Partial<Record<string, string>> = {
    site: 'var(--sky)',
    canva: 'var(--lilac)',
    flip: 'var(--amber)',
    maf: 'var(--gold)',
  };
  return (
    (item.resourceType && byType[item.resourceType]) ??
    byKind[item.kind] ??
    'var(--ch)'
  );
};
---

<div
  class="container chapter-page"
  style={`--grade:${grade.color}; --grade-dark:${grade.dark}; --ch:${chapter.color}; --ch-dark:${chapter.dark}`}
>
  <Breadcrumbs
    items={[
      { label: 'ראשי', href: '/' },
      { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
      { label: gradeLabel(grade), href: gradeHref(grade.slug) },
      { label: 'חומרים להוראה', href: gradeMaterialsHref(grade.slug) },
      { label: chapter.title },
    ]}
  />

  <header class="chapter-head" data-reveal>
    <p class="chapter-eyebrow">{grade.title}</p>
    <h1 class="chapter-title">{chapter.title}</h1>
    <p class="chapter-n">{resourceCountLabel(items)}</p>
    <span class="chapter-rule" aria-hidden="true"></span>
  </header>

  {primary && (
    <section
      class:list={['primary-resource', { 'is-linear-booklet': isLinearBooklet }]}
      data-reveal
      aria-labelledby="primary-resource-title"
    >
      <div class="primary-copy">
        <p class="primary-kicker">המשאב המרכזי בנושא</p>
        <h2 id="primary-resource-title">{visibleResourceTitle(primary)}</h2>
        <span class="primary-kind">{resourceDisplayLabel(primary)}</span>
        <AuthorAttribution resourceId={primary.id} />
        {visibleResourceNote(primary) && <p>{visibleResourceNote(primary)}</p>}
        <a class="btn btn-primary" href={itemHref(grade.slug, primary)} data-resource-context={chapter.id}>
          לדף המשאב והפעולות
        </a>
      </div>

      <div class="primary-view embed-frame">
        {primary.embed ? (
          <iframe
            src={primary.embed}
            title={`${visibleResourceTitle(primary)} — תצוגה מרכזית`}
            loading="lazy"
            allow="fullscreen; clipboard-write"
          />
        ) : (
          <a class="primary-open" href={itemHref(grade.slug, primary)} data-resource-context={chapter.id}>
            <strong>{visibleResourceTitle(primary)}</strong>
            <span>פתיחת המשאב המרכזי</span>
          </a>
        )}
      </div>
    </section>
  )}

  {secondaryItems.length > 0 && (
    <section class="secondary-resources" aria-labelledby={primary ? 'secondary-title' : undefined}>
      {primary && <h2 id="secondary-title">חומרים נוספים בנושא</h2>}
      <div class="luxt tasks-table">
        <div class="luxt-head" aria-hidden="true">
          <span>מס׳</span>
          <span>החומר</span>
          <span>סוג</span>
          <span></span>
        </div>
        <ul class="cards">
          {secondaryItems.map((item, i) => {
            const title = visibleResourceTitle(item);
            const note = visibleResourceNote(item);
            return (
              <li data-reveal style={`--rowc:${resourceRowColor(item)}; --reveal-delay:${Math.min(i * 40, 320)}ms`}>
                <a class="rcard" href={itemHref(grade.slug, item)} data-resource-context={chapter.id}>
                  <span class="luxt-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="rcard-main">
                    <span class="rcard-title">{title}</span>
                    {note && <span class="rcard-note">{note}</span>}
                  </span>
                  <span class="rcard-kind luxt-pill">{resourceDisplayLabel(item)}</span>
                  <span class="rcard-go luxt-go" aria-hidden="true">
                    <svg viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M33 6H2M8 1 2 6l6 5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <nav class="chapter-nav" aria-label="ניווט בין הנושאים">
    <a class="btn btn-ghost" href={gradeMaterialsHref(grade.slug)} data-to-topics>
      כל הנושאים של {grade.title}
    </a>

    <div class="chapter-sides">
      {prev ? (
        <a class="pager-link" href={chapterHref(grade.slug, prev.id)} style={`--p:${prev.color}`}>
          <span class="pager-tag">→ הנושא הקודם</span>
          <span class="pager-title">{prev.title}</span>
        </a>
      ) : <span class="pager-spacer" />}
      {next ? (
        <a class="pager-link" href={chapterHref(grade.slug, next.id)} style={`--p:${next.color}`}>
          <span class="pager-tag">הנושא הבא ←</span>
          <span class="pager-title">{next.title}</span>
        </a>
      ) : <span class="pager-spacer" />}
    </div>
  </nav>
</div>

<style>
  .chapter-page { padding-block: 1.2rem 2.6rem; --ch-ink: color-mix(in srgb, var(--ch-dark) 76%, #10141c); }
  .chapter-head { max-width: 820px; margin-block: 0.8rem 1.6rem; }
  .chapter-eyebrow { margin: 0 0 0.3rem; color: var(--ink-faint); font-size: 0.95rem; font-weight: 600; }
  .chapter-title { margin: 0; font-family: var(--font-display); font-size: clamp(1.9rem, 4.6vw, 3rem); line-height: 1.1; color: var(--ch-dark); }
  .chapter-n { margin: 0.45rem 0 0; color: var(--ink-faint); font-size: 0.95rem; }
  .chapter-rule { display: block; margin-block-start: 1rem; block-size: 3px; inline-size: 128px; border-radius: 3px; background: linear-gradient(90deg, var(--ch), color-mix(in srgb, var(--gold) 70%, transparent)); }

  .primary-resource {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.6fr);
    gap: clamp(1rem, 2.5vw, 1.6rem);
    align-items: stretch;
    margin-block: 0 2rem;
    padding: clamp(1rem, 2.2vw, 1.35rem);
    border: 1px solid color-mix(in srgb, var(--ch) 42%, var(--line));
    border-radius: calc(var(--radius-lg) + 4px);
    background: linear-gradient(145deg, color-mix(in srgb, var(--ch) 5%, #fff), var(--paper));
    box-shadow: var(--shadow-soft);
  }
  .primary-resource.is-linear-booklet { grid-template-columns: minmax(220px, 0.52fr) minmax(0, 1.8fr); }
  .primary-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 0.65rem; padding: clamp(0.3rem, 1vw, 0.8rem); }
  .primary-kicker { margin: 0; color: var(--gold-deep); font-size: 0.8rem; font-weight: 850; }
  .primary-copy h2 { margin: 0; color: var(--navy); font-family: var(--font-display); font-size: clamp(1.55rem, 3.5vw, 2.45rem); line-height: 1.12; }
  .primary-copy > p:not(.primary-kicker) { margin: 0; color: var(--ink-soft); line-height: 1.7; }
  .primary-kind { padding: 0.2rem 0.65rem; border-radius: 999px; background: color-mix(in srgb, var(--ch) 10%, #fff); color: var(--ch-ink); font-size: 0.76rem; font-weight: 800; }
  .primary-view { min-block-size: clamp(430px, 55vw, 680px); overflow: hidden; }
  .is-linear-booklet .primary-view { min-block-size: clamp(620px, 72vw, 960px); }
  .primary-view iframe { inline-size: 100%; block-size: 100%; min-block-size: inherit; border: 0; background: #fff; }
  .primary-open { min-block-size: inherit; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.45rem; padding: 2rem; background: var(--navy); color: var(--paper); text-align: center; text-decoration: none; border-radius: var(--embed-inner-radius); }
  .primary-open strong { font-family: var(--font-display); font-size: clamp(1.35rem, 3vw, 2rem); }
  .primary-open span { color: #e8c877; font-weight: 800; }

  /* ===== טבלת המשימות — עמודות: מס׳ | החומר | סוג | חץ ===== */
  .secondary-resources > h2 { margin: 0 0 0.9rem; color: var(--navy); font-family: var(--font-display); font-size: clamp(1.35rem, 3vw, 1.9rem); }

  /* עמודת הסוג ברוחב קבוע — כדי שהגלולות יתיישרו כעמודה אמיתית */
  .tasks-table { --luxt-cols: 3.3rem minmax(0, 1fr) clamp(9.5rem, 13vw, 11.5rem) 3.2rem; }

  .rcard { grid-template-areas: 'idx main kind go'; }
  .rcard .luxt-idx { grid-area: idx; }
  .rcard-main { grid-area: main; display: flex; flex-direction: column; gap: 0.3rem; min-inline-size: 0; }
  .rcard-kind { grid-area: kind; }
  .rcard-go { grid-area: go; }

  .rcard-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.3;
    color: var(--navy);
    transition: color 280ms var(--ease);
  }
  .rcard:hover .rcard-title { color: var(--rowc-ink); }

  .rcard-note {
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .chapter-nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-block-start: clamp(2.4rem, 6vw, 3.6rem); padding-block-start: 1.6rem; border-block-start: 1px solid var(--line); }
  .chapter-sides { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; }
  .pager-link { display: flex; flex-direction: column; gap: 0.15rem; min-inline-size: 200px; min-block-size: 44px; justify-content: center; padding: 0.75rem 1.05rem; border-radius: var(--radius); border: 1px solid var(--line); background: #fff; color: var(--ink); text-decoration: none; }
  .pager-link:hover { border-color: color-mix(in srgb, var(--p) 45%, var(--line)); }
  .pager-link:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .pager-tag { font-size: 0.78rem; font-weight: 700; color: var(--gold-deep); }
  .pager-title { font-weight: 600; }
  .pager-spacer { display: none; }

  @media (max-width: 900px) {
    .primary-resource, .primary-resource.is-linear-booklet { grid-template-columns: 1fr; }
    .primary-view, .is-linear-booklet .primary-view { min-block-size: clamp(420px, 72svh, 640px); order: -1; }
  }
  @media (max-width: 720px) {
    .chapter-nav, .chapter-sides { flex-direction: column; align-items: stretch; }
    .pager-link { min-inline-size: 0; }
  }
  @media (max-width: 700px) {
    .tasks-table { --luxt-cols: 2.6rem minmax(0, 1fr) 2.1rem; }
    .rcard { grid-template-areas: 'idx main go' '. kind go'; row-gap: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rcard-title { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-resource-context]').forEach((link) => {
    link.addEventListener('click', () => {
      const contextId = link.dataset.resourceContext;
      if (!contextId) return;
      try {
        const target = new URL(link.href, location.href);
        sessionStorage.setItem(`resource-context:${target.pathname}`, contextId);
      } catch {
        // sessionStorage חסום/לא זמין — ה-referrer בעמוד היעד עדיין משמש fallback.
      }
    });
  });
</script>
