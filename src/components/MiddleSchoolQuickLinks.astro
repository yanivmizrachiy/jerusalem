---
import { MONTHLY_DOC_LABEL, choveret, gradeMainDocs, itemHref, type ChoveretGrade } from '../data/choveret';

const requireGrade = (slug: string): ChoveretGrade => {
  const grade = choveret.find((entry) => entry.slug === slug);
  if (!grade) throw new Error(`MiddleSchoolQuickLinks: missing grade ${slug}`);
  return grade;
};

const requireItemHref = (grade: ChoveretGrade, id: string): string => {
  const item = grade.chapters.flatMap((chapter) => chapter.items).find((entry) => entry.id === id);
  if (!item) throw new Error(`MiddleSchoolQuickLinks: missing ${grade.slug}/${id}`);
  return itemHref(grade.slug, item);
};

const requireMainHref = (grade: ChoveretGrade, kind: 'plan' | 'prisa'): string => {
  const docs = gradeMainDocs(grade);
  const entry = docs[kind];
  if (!entry) throw new Error(`MiddleSchoolQuickLinks: missing ${kind} for grade ${grade.slug}`);
  return itemHref(grade.slug, entry.item);
};

const z = requireGrade('z');
const h = requireGrade('h');
const t = requireGrade('t');

const rows = [
  {
    general: { label: 'תוכנית הלימודים', href: requireItemHref(z, 'tochnit-limudim-z') },
    plan: { label: 'תוכנית הוראה ז׳', href: requireMainHref(z, 'plan') },
    prisa: { label: 'פריסת הוראה ז׳', href: requireMainHref(z, 'prisa') },
    amat: { label: 'פריסת הוראה ז׳ עמ״ט', href: requireItemHref(z, 'amat-tashpaz') },
  },
  {
    // פריסות ספטמבר של עידן אחוון — פריט קנוני לכל שכבה (rega-lifney)
    general: {
      label: MONTHLY_DOC_LABEL,
      gradeLinks: [
        { short: 'לכיתה ז׳', title: 'פריסת ספטמבר לכיתה ז׳', href: requireItemHref(z, 'prisa-september-z') },
        { short: 'לכיתה ח׳', title: 'פריסת ספטמבר לכיתה ח׳', href: requireItemHref(h, 'prisa-september-h') },
        { short: 'לכיתה ט׳', title: 'פריסת ספטמבר לכיתה ט׳', href: requireItemHref(t, 'prisa-september-t') },
      ],
    },
    plan: { label: 'תוכנית הוראה ח׳', href: requireMainHref(h, 'plan') },
    prisa: { label: 'פריסת הוראה ח׳', href: requireMainHref(h, 'prisa') },
    amat: { label: 'פריסת הוראה ח׳ עמ״ט', href: requireItemHref(h, 'amat-tashpaz') },
  },
  {
    general: { label: 'חומרים לחט״ב ברוח התוכנית החדשה בחט״ע', href: '/chativat-beynayim/kita-z/chomarim/' },
    plan: { label: 'תוכנית הוראה ט׳', href: requireMainHref(t, 'plan') },
    prisa: { label: 'פריסת הוראה ט׳', href: requireMainHref(t, 'prisa') },
    amat: null,
  },
  {
    general: { label: 'חומרי הוראה — המרחב הפדגוגי', href: requireItemHref(z, 'merchav-chatb') },
    plan: { label: 'תוכנית הוראה ט׳ מצומצמת', href: requireItemHref(t, 'tochnit-t-b') },
    prisa: { label: 'פריסת הוראה ט׳ מצומצמת', href: requireItemHref(t, 'prisa-t-b') },
    amat: null,
  },
] as const;
---

<section class="quick-links" aria-labelledby="middle-school-quick-links-title" data-reveal>
  <div class="quick-head">

    <h2 id="middle-school-quick-links-title">תוכניות, פריסות וחומרי הוראה</h2>

  </div>

  <div class="table-shell">
    <table>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">קישורים כלליים</span></th>
          <th scope="col">תוכניות הוראה</th>
          <th scope="col">פריסות</th>
          <th scope="col">
            <span>פריסות עמ״ט</span>
            <small>התוכנית הייעודית לתלמידי העתודה המדעית־טכנולוגית</small>
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td data-label="קישורים כלליים">
              {'gradeLinks' in row.general ? (
                <div class="multi" data-monthly-cell>
                  <span class="multi-label">{row.general.label}</span>
                  <span class="multi-links">
                    {row.general.gradeLinks.map((link) => (
                      <a href={link.href} aria-label={link.title}>{link.short}</a>
                    ))}
                  </span>
                </div>
              ) : (
                <a href={row.general.href}>{row.general.label}</a>
              )}
            </td>
            <td data-label="תוכניות הוראה"><a href={row.plan.href}>{row.plan.label}</a></td>
            <td data-label="פריסות"><a href={row.prisa.href}>{row.prisa.label}</a></td>
            <td data-label="פריסות עמ״ט">
              {row.amat ? <a href={row.amat.href}>{row.amat.label}</a> : <span class="empty" aria-hidden="true">—</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .quick-links { margin-block: clamp(1.25rem, 3vw, 2.25rem) clamp(1.4rem, 3vw, 2.5rem); }
  .quick-head { margin-block-end: 1.15rem; max-inline-size: 820px; }
  .quick-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    color: var(--gold-deep);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.025em;
  }
  .quick-kicker::before {
    content: '';
    inline-size: 1.8rem;
    block-size: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--gold), var(--rose), var(--sky));
  }
  .quick-head h2 { margin: 0; color: var(--navy); font-family: var(--font-display); font-size: clamp(1.65rem, 3.2vw, 2.45rem); line-height: 1.12; }
  .quick-head > p:last-child { margin: 0.55rem 0 0; color: var(--ink-soft); line-height: 1.65; }

  .table-shell {
    position: relative;
    overflow: hidden;
    padding: 6px;
    border: 1px solid color-mix(in srgb, var(--gold) 42%, var(--line));
    border-radius: calc(var(--radius-lg) + 6px);
    background: linear-gradient(155deg, #2a3852 0%, var(--navy) 56%, #172235 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 -2px 0 rgb(212 175 92 / 0.32),
      0 30px 60px -38px rgb(31 41 61 / 0.62);
  }
  .table-shell::after {
    content: '';
    position: absolute;
    inset-inline: 12%;
    inset-block-start: 0;
    block-size: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(232 200 119 / 0.8), transparent);
  }

  table {
    inline-size: 100%;
    overflow: hidden;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    direction: rtl;
    border-radius: calc(var(--radius-lg) - 1px);
    background: #fff;
  }
  th, td {
    border-inline-start: 1px solid color-mix(in srgb, var(--sky) 22%, var(--line));
    border-block-end: 1px solid color-mix(in srgb, var(--sky) 22%, var(--line));
    text-align: center;
    vertical-align: middle;
  }
  th:last-child, td:last-child { border-inline-start: 0; }
  tbody tr:last-child td { border-block-end: 0; }

  th {
    min-block-size: 96px;
    padding: 1rem 0.8rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.02rem, 1.8vw, 1.3rem);
    font-weight: 800;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.16);
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.13);
  }
  th:nth-child(1) {
    background:
      radial-gradient(120% 180% at 100% 120%, rgb(232 200 119 / 0.2), transparent 58%),
      linear-gradient(145deg, #34445f, var(--navy));
  }
  th:nth-child(2) { background: linear-gradient(145deg, color-mix(in srgb, var(--sky) 60%, var(--navy)), #315f82); }
  th:nth-child(3) { background: linear-gradient(145deg, color-mix(in srgb, var(--lilac) 72%, var(--navy)), #58446e); }
  th:nth-child(4) { background: linear-gradient(145deg, color-mix(in srgb, var(--olive) 72%, var(--navy)), #4c5a37); }
  th small { display: block; margin-block-start: 0.35rem; font-family: var(--font-body); font-size: 0.68rem; line-height: 1.4; font-weight: 600; color: rgb(255 255 255 / 0.87); }

  td {
    --cell-accent: var(--gold);
    min-block-size: 74px;
    padding: 0;
    background: #fff;
  }
  td:nth-child(1) { --cell-accent: var(--gold); }
  td:nth-child(2) { --cell-accent: var(--sky); }
  td:nth-child(3) { --cell-accent: var(--lilac); }
  td:nth-child(4) { --cell-accent: var(--olive); }
  tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--cell-accent) 3.5%, #fff); }

  td > a {
    position: relative;
    min-block-size: 74px;
    inline-size: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.05rem;
    color: var(--navy);
    font-weight: 750;
    line-height: 1.45;
    text-decoration-line: underline;
    text-decoration-thickness: 1.35px;
    text-decoration-color: color-mix(in srgb, var(--cell-accent) 52%, transparent);
    text-underline-offset: 0.2em;
    transition: background 240ms var(--ease), color 240ms var(--ease), box-shadow 260ms var(--ease);
  }
  td > a::after {
    content: none;
    flex: none;
    color: color-mix(in srgb, var(--cell-accent) 72%, var(--ink));
    opacity: 0.66;
    transition: transform 380ms var(--ease-lift), opacity 240ms var(--ease);
  }
  td > a:hover {
    background: color-mix(in srgb, var(--cell-accent) 9%, #fff);
    color: var(--ink);
    box-shadow: inset 4px 0 0 color-mix(in srgb, var(--cell-accent) 72%, transparent);
  }
  td > a:hover::after { transform: translateX(-3px); opacity: 1; }
  td > a:focus-visible { position: relative; z-index: 1; outline: 3px solid var(--gold); outline-offset: -4px; text-decoration-thickness: 2px; }

  .empty { min-block-size: 74px; display: grid; place-items: center; color: var(--ink-faint); }
  .multi { min-block-size: 74px; display: grid; align-content: center; justify-items: center; gap: 0.38rem; padding: 0.65rem; }
  .multi-label { color: var(--navy); font-weight: 800; line-height: 1.35; }
  .multi-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.36rem; }
  .multi-links a {
    --multi-accent: var(--sky);
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.34rem 0.72rem;
    border: 1px solid color-mix(in srgb, var(--multi-accent) 42%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--multi-accent) 7%, #fff);
    color: var(--navy);
    font-weight: 750;
    text-decoration: none;
    box-shadow: inset 0 1px 0 #fff;
    transition: background 220ms var(--ease), border-color 220ms var(--ease), transform 360ms var(--ease-lift);
  }
  .multi-links a:nth-child(2) { --multi-accent: var(--olive); }
  .multi-links a:nth-child(3) { --multi-accent: var(--rose); }
  .multi-links a:hover { transform: translateY(-1px); background: color-mix(in srgb, var(--multi-accent) 13%, #fff); border-color: color-mix(in srgb, var(--multi-accent) 62%, var(--line)); }
  .multi-links a:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 820px) {
    .table-shell { overflow: visible; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
    .table-shell::after { display: none; }
    table, tbody, tr, td { display: block; }
    thead { display: none; }
    tbody { display: grid; gap: 0.9rem; }
    tr {
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--gold) 22%, var(--line));
      border-radius: var(--radius-lg);
      background: #fff;
      box-shadow: 0 18px 38px -30px rgb(31 41 61 / 0.45);
    }
    td,
    tbody tr:nth-child(even) td {
      min-block-size: 0;
      display: grid;
      grid-template-columns: minmax(7.6rem, 38%) 1fr;
      align-items: stretch;
      padding: 0;
      border-inline-start: 0;
      border-block-end: 1px solid var(--line);
      background: #fff;
      text-align: start;
    }
    td:last-child { border-block-end: 0; }
    td::before {
      content: attr(data-label);
      display: flex;
      align-items: center;
      padding: 0.85rem 0.8rem;
      color: #fff;
      font-weight: 800;
      font-size: 0.78rem;
      line-height: 1.35;
      background: linear-gradient(145deg, color-mix(in srgb, var(--cell-accent) 66%, var(--navy)), var(--navy));
    }
    td > a,
    .empty { min-block-size: 58px; justify-content: flex-start; padding: 0.85rem 0.95rem; text-align: start; }
    td > a:hover { box-shadow: inset -4px 0 0 color-mix(in srgb, var(--cell-accent) 72%, transparent); }
    .multi { justify-items: start; padding: 0.65rem 0.95rem; }
    .multi-links { justify-content: flex-start; }
    .multi-links a { min-block-size: 44px; }
  }

  @media (max-width: 420px) {
    td { grid-template-columns: minmax(6.7rem, 36%) 1fr; }
    td::before { padding-inline: 0.65rem; font-size: 0.73rem; }
    td > a { padding-inline: 0.75rem; font-size: 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    td > a,
    td > a::after,
    .multi-links a { transition-duration: 1ms; }
    td > a:hover::after,
    .multi-links a:hover { transform: none; }
  }
</style>
