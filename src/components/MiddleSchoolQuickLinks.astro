---
import { choveret, gradeMainDocs, itemHref, type ChoveretGrade } from '../data/choveret';

const requireGrade = (slug: string): ChoveretGrade => {
  const grade = choveret.find((entry) => entry.slug === slug);
  if (!grade) throw new Error(`MiddleSchoolQuickLinks: missing grade ${slug}`);
  return grade;
};

const requireItemHref = (grade: ChoveretGrade, id: string): string => {
  const item = grade.chapters.flatMap((chapter) => chapter.items).find((entry) => entry.id === id);
  if (!item) throw new Error(`MiddleSchoolQuickLinks: missing ${grade.slug}/${id}`);
  return itemHref(grade.slug, item);
};

const requireMainHref = (grade: ChoveretGrade, kind: 'plan' | 'prisa'): string => {
  const docs = gradeMainDocs(grade);
  const entry = docs[kind];
  if (!entry) throw new Error(`MiddleSchoolQuickLinks: missing ${kind} for grade ${grade.slug}`);
  return itemHref(grade.slug, entry.item);
};

const z = requireGrade('z');
const h = requireGrade('h');
const t = requireGrade('t');

const rows = [
  {
    general: { label: 'תוכנית הלימודים', href: requireItemHref(z, 'tochnit-limudim-z') },
    plan: { label: 'תוכנית הוראה ז׳', href: requireMainHref(z, 'plan') },
    prisa: { label: 'פריסת הוראה ז׳', href: requireMainHref(z, 'prisa') },
    amat: { label: 'פריסת הוראה ז׳ עמ״ט', href: requireItemHref(z, 'amat-tashpaz') },
  },
  {
    general: { label: 'רגע לפני — ספטמבר', href: '/luach/' },
    plan: { label: 'תוכנית הוראה ח׳', href: requireMainHref(h, 'plan') },
    prisa: { label: 'פריסת הוראה ח׳', href: requireMainHref(h, 'prisa') },
    amat: { label: 'פריסת הוראה ח׳ עמ״ט', href: requireItemHref(h, 'amat-tashpaz') },
  },
  {
    general: { label: 'חומרים לחט״ב ברוח התוכנית החדשה בחט״ע', href: '/chativat-beynayim/kita-z/chomarim/' },
    plan: { label: 'תוכנית הוראה ט׳', href: requireMainHref(t, 'plan') },
    prisa: { label: 'פריסת הוראה ט׳', href: requireMainHref(t, 'prisa') },
    amat: null,
  },
  {
    general: { label: 'חומרי הוראה — המרחב הפדגוגי', href: requireItemHref(z, 'merchav-chatb') },
    plan: { label: 'תוכנית הוראה ט׳ מצומצמת', href: requireItemHref(t, 'tochnit-t-b') },
    prisa: { label: 'פריסת הוראה ט׳ מצומצמת', href: requireItemHref(t, 'prisa-t-b') },
    amat: null,
  },
] as const;
---

<section class="quick-links" aria-labelledby="middle-school-quick-links-title" data-reveal>
  <div class="quick-head">
    <p class="quick-kicker">קישורים מרכזיים · תשפ״ז</p>
    <h2 id="middle-school-quick-links-title">תוכניות, פריסות וחומרי הוראה</h2>
    <p>הטבלה המעודכנת של חטיבת הביניים — כל קישור מוביל למשאב החדש והקנוני שכבר נמצא בפרויקט.</p>
  </div>

  <div class="table-shell">
    <table>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">קישורים כלליים</span></th>
          <th scope="col">תוכניות הוראה</th>
          <th scope="col">פריסות</th>
          <th scope="col">
            <span>פריסות עמ״ט</span>
            <small>התוכנית הייעודית לתלמידי העתודה המדעית־טכנולוגית</small>
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td data-label="קישורים כלליים"><a href={row.general.href}>{row.general.label}</a></td>
            <td data-label="תוכניות הוראה"><a href={row.plan.href}>{row.plan.label}</a></td>
            <td data-label="פריסות"><a href={row.prisa.href}>{row.prisa.label}</a></td>
            <td data-label="פריסות עמ״ט">
              {row.amat ? <a href={row.amat.href}>{row.amat.label}</a> : <span class="empty" aria-hidden="true">—</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .quick-links { margin-block: clamp(1.25rem, 3vw, 2.25rem) clamp(1.4rem, 3vw, 2.5rem); }
  .quick-head { margin-block-end: 1rem; max-inline-size: 820px; }
  .quick-kicker { margin: 0 0 0.35rem; color: var(--gold-deep); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.025em; }
  .quick-head h2 { margin: 0; color: var(--navy); font-family: var(--font-display); font-size: clamp(1.65rem, 3.2vw, 2.45rem); line-height: 1.12; }
  .quick-head > p:last-child { margin: 0.55rem 0 0; color: var(--ink-soft); line-height: 1.65; }
  .table-shell { overflow: hidden; border: 1px solid color-mix(in srgb, var(--sky) 30%, var(--line)); border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-soft); }
  table { inline-size: 100%; border-collapse: collapse; table-layout: fixed; direction: rtl; }
  th, td { border-inline-start: 1px solid color-mix(in srgb, var(--sky) 34%, var(--line)); border-block-end: 1px solid color-mix(in srgb, var(--sky) 34%, var(--line)); text-align: center; vertical-align: middle; }
  th:last-child, td:last-child { border-inline-start: 0; }
  tbody tr:last-child td { border-block-end: 0; }
  th { min-block-size: 96px; padding: 1rem 0.8rem; background: linear-gradient(180deg, rgb(255 255 255 / 0.08), transparent), linear-gradient(135deg, #2f8edc, #4d9ee7); color: #fff; font-family: var(--font-display); font-size: clamp(1.02rem, 1.8vw, 1.35rem); font-weight: 800; }
  th:first-child { background: radial-gradient(110% 160% at 90% 120%, rgb(232 200 119 / 0.18), transparent 60%), linear-gradient(135deg, #26324a, var(--navy)); }
  th small { display: block; margin-block-start: 0.35rem; font-family: var(--font-body); font-size: 0.68rem; line-height: 1.4; font-weight: 600; color: rgb(255 255 255 / 0.84); }
  td { min-block-size: 74px; padding: 0; background: #fff; }
  tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--sky) 3.5%, #fff); }
  td a { min-block-size: 74px; inline-size: 100%; display: flex; align-items: center; justify-content: center; padding: 0.85rem 0.8rem; color: #1235a7; font-weight: 700; line-height: 1.45; text-decoration-line: underline; text-decoration-thickness: 1.5px; text-underline-offset: 0.18em; transition: background 220ms var(--ease), color 220ms var(--ease); }
  td a:hover { background: color-mix(in srgb, var(--sky) 10%, #fff); color: #071f78; }
  td a:focus-visible { position: relative; z-index: 1; outline: 3px solid var(--gold); outline-offset: -4px; text-decoration-thickness: 2px; }
  .empty { min-block-size: 74px; display: grid; place-items: center; color: var(--ink-faint); }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 820px) {
    .table-shell { overflow: visible; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
    table, tbody, tr, td { display: block; }
    thead { display: none; }
    tbody { display: grid; gap: 0.9rem; }
    tr { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-soft); }
    td, tbody tr:nth-child(even) td { min-block-size: 0; display: grid; grid-template-columns: minmax(7.6rem, 38%) 1fr; align-items: stretch; padding: 0; border-inline-start: 0; border-block-end: 1px solid var(--line); background: #fff; text-align: start; }
    td:last-child { border-block-end: 0; }
    td::before { content: attr(data-label); display: flex; align-items: center; padding: 0.85rem 0.8rem; background: linear-gradient(135deg, #26324a, var(--navy)); color: #fff; font-weight: 800; font-size: 0.78rem; line-height: 1.35; }
    td a, .empty { min-block-size: 58px; justify-content: flex-start; padding: 0.85rem 0.95rem; text-align: start; }
  }

  @media (max-width: 420px) {
    td { grid-template-columns: minmax(6.7rem, 36%) 1fr; }
    td::before { padding-inline: 0.65rem; font-size: 0.73rem; }
    td a { padding-inline: 0.75rem; font-size: 0.9rem; }
  }
</style>
