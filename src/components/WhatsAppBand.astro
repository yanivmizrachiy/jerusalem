---
/**
 * רצועת ההצטרפות לקבוצת המורים — תחתית העמוד הראשי (7.27, 9.2).
 * הרצועה כולה קישור אחד: לחיצה בכל נקודה מובילה מייד לקבוצה.
 */
import { whatsappCommunity } from '../data/resources';

const waPath =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
---

<section class="wa-band-wrap" data-reveal>
  <a
    class="wa-band"
    href={whatsappCommunity.url}
    target="_blank"
    rel="noopener"
    aria-label="הצטרפות מהירה לקבוצת ה־WhatsApp — קבוצה של מורים למתמטיקה בחטיבת הביניים"
  >
    <span class="wa-band-watermark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d={waPath}></path></svg>
    </span>
    <span class="wa-band-inner">
      <span class="wa-band-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d={waPath}></path></svg>
      </span>
      <span class="wa-band-texts">
        <strong class="wa-band-title">הצטרפו לקבוצת המורים בווטסאפ</strong>
        <span class="wa-band-sub">קבוצה של מורים למתמטיקה בחטיבת הביניים — לחיצה בכל נקודה ברצועה מצרפת אתכם מייד</span>
      </span>
      <span class="wa-band-cta">
        הצטרפות מהירה לקבוצה
        <span class="wa-band-arrow" aria-hidden="true">←</span>
      </span>
    </span>
  </a>
</section>

<style>
  .wa-band-wrap { margin-block-start: clamp(3rem, 7vw, 5rem); }

  /* הרצועה כולה קישור אחד — ירוק WhatsApp עמוק עם זוהר וזיגוג עדין */
  .wa-band {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    background:
      radial-gradient(120% 170% at 85% -20%, rgb(37 211 102 / 0.5) 0%, transparent 55%),
      radial-gradient(90% 150% at 10% 125%, rgb(37 211 102 / 0.32) 0%, transparent 60%),
      linear-gradient(130deg, #0a5137 0%, #0f7a4e 48%, #12915c 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 -1px 0 rgb(0 0 0 / 0.25),
      0 18px 50px -22px rgb(15 122 78 / 0.55);
    transition: filter 300ms var(--ease);
  }

  .wa-band:hover { filter: brightness(1.07) saturate(1.05); }

  .wa-band:focus-visible { outline: 3px solid #fff; outline-offset: -6px; }

  /* קו-אור אלכסוני על הזכוכית — באותה שפה של מסגרות האתר (8.26) */
  .wa-band::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / 0.13) 47%, transparent 56%);
  }

  /* חותם רקע ענק ושקוף של האייקון — עומק בלי רעש */
  .wa-band-watermark {
    position: absolute;
    inset-inline-end: -3%;
    inset-block-end: -42%;
    color: #fff;
    opacity: 0.09;
    rotate: -12deg;
    pointer-events: none;
  }

  .wa-band-watermark svg { inline-size: clamp(190px, 26vw, 330px); block-size: auto; display: block; }

  .wa-band-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.6vw, 1.7rem);
    width: min(1520px, 100% - 2 * clamp(1rem, 3vw, 2rem));
    margin-inline: auto;
    padding-block: clamp(1.5rem, 3.6vw, 2.3rem);
  }

  /* התג הלבן הפועם עם האייקון */
  .wa-band-badge {
    flex: none;
    inline-size: clamp(64px, 8vw, 82px);
    block-size: clamp(64px, 8vw, 82px);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #0f7a4e;
    background: #fff;
    box-shadow: 0 10px 26px -12px rgb(0 0 0 / 0.45);
  }

  .wa-band-badge svg { inline-size: 52%; block-size: 52%; }

  @media (prefers-reduced-motion: no-preference) {
    .wa-band-badge { animation: wa-band-pulse 2.6s var(--ease) infinite; }

    @keyframes wa-band-pulse {
      0% { box-shadow: 0 10px 26px -12px rgb(0 0 0 / 0.45), 0 0 0 0 rgb(255 255 255 / 0.5); }
      70% { box-shadow: 0 10px 26px -12px rgb(0 0 0 / 0.45), 0 0 0 18px rgb(255 255 255 / 0); }
      100% { box-shadow: 0 10px 26px -12px rgb(0 0 0 / 0.45), 0 0 0 0 rgb(255 255 255 / 0); }
    }
  }

  .wa-band-texts { display: flex; flex-direction: column; gap: 0.35rem; min-inline-size: 0; }

  .wa-band-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2.05rem);
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
    text-wrap: balance;
  }

  .wa-band-sub {
    color: rgb(255 255 255 / 0.88);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.6vw, 1.08rem);
    text-wrap: pretty;
  }

  /* גלולת הפעולה — לבן על ירוק, נדחפת לקצה הרצועה */
  .wa-band-cta {
    flex: none;
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    background: #fff;
    color: #0a5137;
    font-weight: 800;
    font-size: 1rem;
    box-shadow: 0 12px 30px -14px rgb(0 0 0 / 0.5);
    transition: transform 350ms var(--ease-lift), box-shadow 300ms var(--ease);
  }

  .wa-band:hover .wa-band-cta { transform: translateY(-3px); box-shadow: 0 16px 34px -14px rgb(0 0 0 / 0.55); }

  .wa-band-arrow { transition: translate 300ms var(--ease); }

  .wa-band:hover .wa-band-arrow { translate: -6px 0; }

  @media (max-width: 760px) {
    .wa-band-inner { flex-direction: column; text-align: center; }
    .wa-band-texts { align-items: center; }
    .wa-band-cta { margin-inline-start: 0; }
    .wa-band-watermark { inset-inline-end: -18%; inset-block-end: -16%; }
  }
</style>
