---
/**
 * תצוגת החומרים של שכבה (הוראת יניב, 06/08/2026):
 * **רשימת נושאים בלבד** — ברורה, גדולה ונוחה. כל נושא הוא שורה לחיצה
 * אחת שמובילה לעמוד הנושא, ובו רשימת המשימות שלו. כל השאר (הניווט בין
 * השכבות וחזרה לשער) יורד ממש לתחתית העמוד, כדי שהמסך הראשון יהיה
 * רשימת הנושאים ותו לא.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import GradeNav from './GradeNav.astro';
import { chapterHref, gradeCounts, gradeHref, gradeLabel, type ChoveretGrade } from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
}

const { grade } = Astro.props;
---

<div class="container grade-page" style={`--grade:${grade.color}; --grade-dark:${grade.dark}`}>
  <Breadcrumbs
    items={[
      { label: 'ראשי', href: '/' },
      { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
      { label: gradeLabel(grade), href: gradeHref(grade.slug) },
      { label: 'חומרים להוראה' },
    ]}
  />

  <header class="grade-head" data-reveal>
    <h1 class="grade-title">{grade.title}</h1>
    <p class="grade-count">{grade.chapters.length} נושאים · {gradeCounts[grade.slug]} קבצים, קישורים ופעילויות</p>
    <span class="grade-rule" aria-hidden="true"></span>
  </header>

  <ul class="topics" aria-label="נושאי הלימוד">
    {
      grade.chapters.map((ch) => (
        <li id={ch.id} style={`--ch:${ch.color}; --ch-dark:${ch.dark}`}>
          <a class="topic" href={chapterHref(grade.slug, ch.id)}>
            <span class="topic-dot" aria-hidden="true" />
            <span class="topic-text">
              <span class="topic-title">{ch.title}</span>
              <span class="topic-n">{ch.items.length} משימות</span>
            </span>
            <span class="topic-go" aria-hidden="true">
              <svg viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M33 6H2M8 1 2 6l6 5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="grade-tail">
    <GradeNav grade={grade} here="materials" />
  </div>
</div>

<style>
  .grade-page { padding-block: 1.2rem 2.6rem; }

  .grade-head { max-width: 820px; margin-block: 0.8rem 1.6rem; }

  .grade-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.08;
    color: var(--navy);
  }

  .grade-count { margin: 0.5rem 0 0; color: var(--ink-faint); font-size: 0.95rem; }

  .grade-rule {
    display: block;
    margin-block-start: 1rem;
    block-size: 3px;
    inline-size: 128px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--grade), color-mix(in srgb, var(--gold) 70%, transparent));
  }

  /* ===== רשימת הנושאים — המסך הראשון, ורק היא ===== */
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.7rem, 1.4vw, 1rem);
  }

  .topics li { --ch-ink: color-mix(in srgb, var(--ch-dark) 76%, #10141c); }

  .topic {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.3rem);
    min-block-size: 88px;
    padding: clamp(1rem, 2.2vw, 1.5rem) clamp(1.1rem, 2.4vw, 1.8rem);
    border-radius: var(--radius-lg, 18px);
    border: 1px solid var(--line);
    border-inline-start: 6px solid var(--ch);
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--line) 60%, transparent);
    transition: transform 320ms var(--ease-lift), box-shadow 320ms var(--ease), border-color 320ms var(--ease),
      background-color 320ms var(--ease);
  }

  .topic:hover {
    transform: translateY(-3px);
    background: color-mix(in srgb, var(--ch) 4%, #fff);
    border-color: color-mix(in srgb, var(--ch) 42%, var(--line));
    box-shadow: 0 22px 46px -28px color-mix(in srgb, var(--ch) 80%, transparent);
  }

  .topic:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .topic-dot {
    flex: none;
    inline-size: 14px;
    block-size: 14px;
    border-radius: 50%;
    background: var(--ch);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--ch) 12%, transparent);
  }

  .topic-text { display: flex; flex-direction: column; gap: 0.25rem; min-inline-size: 0; }

  .topic-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.8vw, 1.85rem);
    line-height: 1.25;
    color: var(--navy);
  }

  .topic-n { color: var(--ch-ink); font-size: 0.92rem; font-weight: 600; }

  .topic-go {
    margin-inline-start: auto;
    flex: none;
    color: var(--ch-dark);
    opacity: 0.6;
    transition: translate 320ms var(--ease), opacity 320ms var(--ease);
  }

  .topic-go svg { inline-size: 34px; block-size: auto; display: block; }
  .topic:hover .topic-go { translate: -8px 0; opacity: 1; }

  /* ===== כל השאר — ממש למטה ===== */
  .grade-tail { margin-block-start: clamp(5rem, 18vh, 11rem); }

  @media (prefers-reduced-motion: reduce) {
    .topic, .topic-go { transition: none; }
    .topic:hover { transform: none; }
    .topic:hover .topic-go { translate: 0; }
  }
</style>
