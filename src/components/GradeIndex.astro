---
/**
 * עמוד שכבה אחיד (הוראת יניב, 05/08/2026 — מחליף את תוכן העניינים של
 * החוברת): כל פרק הוא מקטע צבעוני, כל קובץ הוא כרטיס לחיץ שמוביל לעמוד
 * המשאב, ובראש העמוד סרגל קפיצה דביק לפרקים. בתחתית — מעבר לשכבה
 * הקודמת/הבאה וחזרה לשער (5.3–5.4, 5.11).
 */
import Breadcrumbs from './Breadcrumbs.astro';
import {
  choveret,
  gradeCounts,
  gradeHref,
  gradeLabel,
  itemHref,
  kindLabel,
  type ChoveretGrade,
} from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
}

const { grade } = Astro.props;

const order = choveret.findIndex((g) => g.slug === grade.slug);
const prev = order > 0 ? choveret[order - 1] : undefined;
const next = order < choveret.length - 1 ? choveret[order + 1] : undefined;
---

<div class="container grade-page" style={`--grade:${grade.color}; --grade-dark:${grade.dark}`}>
  <Breadcrumbs
    items={[
      { label: 'ראשי', href: '/' },
      { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
      { label: gradeLabel(grade) },
    ]}
  />

  <header class="grade-head" data-reveal>
    <h1 class="grade-title">{grade.title}</h1>
    <p class="grade-count">{gradeCounts[grade.slug]} קבצים, קישורים ופעילויות · {grade.chapters.length} פרקים</p>
    <span class="grade-rule" aria-hidden="true"></span>
  </header>

  <nav class="chapter-bar" aria-label="קפיצה לפרק">
    {
      grade.chapters.map((ch) => (
        <a class="chip" href={`#${ch.id}`} style={`--ch:${ch.color}; --ch-dark:${ch.dark}`}>
          <span class="chip-dot" aria-hidden="true"></span>
          {ch.title}
          <span class="chip-n">{ch.items.length}</span>
        </a>
      ))
    }
  </nav>

  {
    grade.chapters.map((ch) => (
      <section class="chapter" id={ch.id} style={`--ch:${ch.color}; --ch-dark:${ch.dark}`} data-reveal>
        <header class="chapter-head">
          <h2 class="chapter-title">{ch.title}</h2>
          <span class="chapter-n">{ch.items.length} קבצים</span>
        </header>

        <ul class="cards">
          {ch.items.map((item) => (
            <li>
              <a class="rcard" href={itemHref(grade.slug, item)}>
                <span class="rcard-top">
                  <span class="rcard-kind">{kindLabel[item.kind]}</span>
                  <span class="rcard-go" aria-hidden="true">
                    <svg viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M27 6H2M8 1 2 6l6 5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </span>
                <span class="rcard-title">{item.title}</span>
                {item.note && <span class="rcard-note">{item.note}</span>}
                {item.source && <span class="rcard-source">{item.source}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <nav class="grade-pager" aria-label="מעבר בין שכבות">
    {
      prev ? (
        <a class="pager-link" href={gradeHref(prev.slug)} style={`--p:${prev.color}`}>
          <span class="pager-tag">השכבה הקודמת</span>
          <span class="pager-title">{prev.title}</span>
        </a>
      ) : (
        <span class="pager-spacer" />
      )
    }
    <a class="btn btn-ghost" href="/chativat-beynayim/">חזרה לחטיבת ביניים</a>
    {
      next ? (
        <a class="pager-link pager-next" href={gradeHref(next.slug)} style={`--p:${next.color}`}>
          <span class="pager-tag">השכבה הבאה</span>
          <span class="pager-title">{next.title}</span>
        </a>
      ) : (
        <span class="pager-spacer" />
      )
    }
  </nav>
</div>

<style>
  .grade-page { padding-block: 1.2rem 2.6rem; }

  .grade-head { max-width: 820px; margin-block: 0.8rem 1.4rem; }

  .grade-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.08;
    color: var(--navy);
  }

  .grade-count { margin: 0.5rem 0 0; color: var(--ink-faint); font-size: 0.95rem; }

  .grade-rule {
    display: block;
    margin-block-start: 1rem;
    block-size: 3px;
    inline-size: 128px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--grade), color-mix(in srgb, var(--gold) 70%, transparent));
  }

  /* ===== סרגל קפיצה דביק — הניווט הנוח בתוך השכבה ===== */
  .chapter-bar {
    position: sticky;
    inset-block-start: calc(var(--header-h) + 6px);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.6rem;
    margin-block-end: clamp(1.6rem, 3vw, 2.4rem);
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    box-shadow: var(--shadow-soft);
  }

  /* גוון קריא של צבע הפרק — עומד ב-AA גם בטקסט קטן על הגוון הרך שלו */
  .chip,
  .chapter { --ch-ink: color-mix(in srgb, var(--ch-dark) 76%, #10141c); }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-block-size: 44px;
    padding-inline: 0.95rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ch) 32%, transparent);
    background: #fff;
    color: var(--ch-ink);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 260ms var(--ease), box-shadow 260ms var(--ease), background-color 260ms var(--ease);
  }

  .chip:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--ch) 6%, #fff);
    box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--ch) 70%, transparent);
  }

  .chip:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .chip-dot { inline-size: 9px; block-size: 9px; border-radius: 50%; background: var(--ch); }

  .chip-n {
    min-inline-size: 22px;
    padding-inline: 0.35rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ch) 9%, #fff);
    font-size: 0.8rem;
    text-align: center;
  }

  /* ===== פרק ===== */
  .chapter { scroll-margin-block-start: calc(var(--header-h) + 74px); margin-block-end: clamp(2.2rem, 4.5vw, 3.4rem); }

  .chapter-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 5px solid var(--ch);
    margin-block-end: 1.1rem;
  }

  .chapter-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    color: var(--ch-dark);
  }

  .chapter-n { color: var(--ink-faint); font-size: 0.86rem; white-space: nowrap; }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 285px), 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.1rem);
  }

  .rcard {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    block-size: 100%;
    padding: 1rem 1.1rem 1.15rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
    text-decoration: none;
    color: var(--ink);
    position: relative;
    overflow: hidden;
    transition: transform 320ms var(--ease-lift), box-shadow 320ms var(--ease), border-color 320ms var(--ease);
  }

  /* חוט הצבע של הפרק על קצה הכרטיס */
  .rcard::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 3px;
    background: var(--ch);
    opacity: 0.85;
  }

  .rcard:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--ch) 42%, var(--line));
    box-shadow: 0 20px 44px -26px color-mix(in srgb, var(--ch) 80%, transparent);
  }

  .rcard:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .rcard-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }

  .rcard-kind {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ch) 9%, #fff);
    color: var(--ch-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .rcard-go { color: var(--ch-dark); opacity: 0.65; transition: translate 320ms var(--ease), opacity 320ms var(--ease); }
  .rcard-go svg { inline-size: 28px; block-size: auto; display: block; }
  .rcard:hover .rcard-go { translate: -6px 0; opacity: 1; }

  .rcard-title { font-family: var(--font-display); font-size: 1.08rem; line-height: 1.35; color: var(--navy); }

  .rcard-note {
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rcard-source { color: var(--ink-faint); font-size: 0.78rem; margin-block-start: auto; padding-block-start: 0.3rem; }

  /* ===== מעבר בין שכבות ===== */
  .grade-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(2rem, 5vw, 3rem);
    padding-block-start: 1.6rem;
    border-block-start: 1px solid var(--line);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-inline-size: 210px;
    padding: 0.75rem 1.05rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease), border-color 300ms var(--ease);
  }

  .pager-link:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--p) 45%, var(--line));
    box-shadow: var(--shadow-soft);
  }

  .pager-link:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .pager-tag { font-size: 0.78rem; font-weight: 700; color: var(--gold-deep); }
  .pager-title { font-weight: 600; }
  .pager-spacer { min-inline-size: 210px; }

  @media (max-width: 720px) {
    .chapter-bar { border-radius: var(--radius-lg); }
    .grade-pager { flex-direction: column; align-items: stretch; }
    .pager-spacer { display: none; }
    .pager-link { min-inline-size: 0; }
  }
</style>
