---
/**
 * תצוגת החומרים של שכבה (הוראת יניב, 06/08/2026; עיצוב טבלה 10/08/2026):
 * **טבלת נושאים בלבד** — טבלת יוקרה צבעונית אחת (מחלקות `.luxt` מ-global.css,
 * אותה שפה בדיוק כמו טבלת המשימות בעמוד הנושא): מספור שורות, פס צבע לכל
 * נושא, גלולת מניין אמיתי וחץ מעבר. כל נושא הוא שורה לחיצה אחת שמובילה
 * לעמוד הנושא, ובו רשימת המשימות שלו. כל השאר (הניווט בין השכבות וחזרה
 * לשער) יורד ממש לתחתית העמוד, כדי שהמסך הראשון יהיה טבלת הנושאים ותו לא.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import GradeNav from './GradeNav.astro';
import { canonicalChapterItems, canonicalPublishedGradeCount } from '../data/canonical-content';
import { publishableItems } from '../data/publishing';
import { resourceCountLabel } from '../data/resource-labels';
import { chapterHref, gradeHref, gradeLabel, materialChapters, type ChoveretGrade } from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
}

const { grade } = Astro.props;
const chapters = materialChapters(grade)
  .map((chapter) => {
    const items = publishableItems(canonicalChapterItems(chapter));
    return { chapter, items, count: items.length, countLabel: resourceCountLabel(items) };
  })
  .filter(({ count }) => count > 0);
const publishedCount = canonicalPublishedGradeCount(grade);
---

<div class="container grade-page" style={`--grade:${grade.color}; --grade-dark:${grade.dark}`}>
  <Breadcrumbs
    items={[
      { label: 'ראשי', href: '/' },
      { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
      { label: gradeLabel(grade), href: gradeHref(grade.slug) },
      { label: 'חומרים להוראה' },
    ]}
  />

  <header class="grade-head" data-reveal>
    <h1 class="grade-title">{grade.title}</h1>
    <p class="grade-count">{chapters.length} נושאים ואוספים · {publishedCount} קבצים וקישורים</p>
    <span class="grade-rule" aria-hidden="true"></span>
  </header>

  <section class="luxt topics-table">
    <div class="luxt-head" aria-hidden="true">
      <span>מס׳</span>
      <span>נושא</span>
      <span>מניין</span>
      <span></span>
    </div>
    <ul class="topics" aria-label="נושאי הלימוד">
      {
        chapters.map(({ chapter: ch, countLabel }, i) => (
          <li
            id={ch.id}
            data-kind={ch.kind ?? 'topic'}
            data-reveal
            style={`--ch:${ch.color}; --ch-dark:${ch.dark}; --rowc:${ch.color}; --reveal-delay:${Math.min(i * 40, 320)}ms`}
          >
            <a class="topic" href={chapterHref(grade.slug, ch.id)}>
              <span class="luxt-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="topic-text">
                <span class="topic-title">{ch.title}</span>
              </span>
              <span class="topic-n luxt-pill">{countLabel}</span>
              <span class="topic-go luxt-go" aria-hidden="true">
                <svg viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M33 6H2M8 1 2 6l6 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="grade-tail">
    <GradeNav grade={grade} here="materials" />
  </div>
</div>

<style>
  .grade-page { padding-block: 1.2rem 2.6rem; }

  .grade-head { max-width: 820px; margin-block: 0.8rem 1.6rem; }

  .grade-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.08;
    color: var(--navy);
  }

  .grade-count { margin: 0.5rem 0 0; color: var(--ink-faint); font-size: 0.95rem; }

  .grade-rule {
    display: block;
    margin-block-start: 1rem;
    block-size: 3px;
    inline-size: 128px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--grade), color-mix(in srgb, var(--gold) 70%, transparent));
  }

  /* ===== טבלת הנושאים — עמודות: מס׳ | נושא | מניין | חץ ===== */
  /* עמודת המניין ברוחב קבוע — כדי שהגלולות יתיישרו כעמודה אמיתית */
  .topics-table { --luxt-cols: 3.3rem minmax(0, 1fr) clamp(10rem, 15vw, 12.5rem) 3.2rem; }

  .topics li { --ch-ink: color-mix(in srgb, var(--ch-dark) 76%, #10141c); }

  .topic { grid-template-areas: 'idx text n go'; }
  .topic .luxt-idx { grid-area: idx; }
  .topic-text { grid-area: text; display: flex; flex-direction: column; gap: 0.2rem; min-inline-size: 0; }
  .topic-n { grid-area: n; }
  .topic-go { grid-area: go; }

  .topic-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.25;
    color: var(--navy);
    transition: color 280ms var(--ease);
  }

  .topic:hover .topic-title { color: var(--ch-dark); }

  /* אוסף — שורה מודגשת: מדליון מלא בצבע הכהה וכותרת גדולה יותר */
  .topics li[data-kind='collection'] .luxt-idx {
    background: var(--ch-dark);
    box-shadow: none;
    color: #fff;
  }

  .topics li[data-kind='collection'] .topic-title {
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
  }

  /* ===== כל השאר — ממש למטה ===== */
  .grade-tail { margin-block-start: clamp(5rem, 18vh, 11rem); }

  @media (max-width: 700px) {
    .topics-table { --luxt-cols: 2.6rem minmax(0, 1fr) 2.1rem; }
    .topic { grid-template-areas: 'idx text go' '. n go'; row-gap: 0.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-title { transition: none; }
  }
</style>
