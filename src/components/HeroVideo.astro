---
/**
 * סרטון הפתיחה (RULES §6): נפתח אוטומטית עם קול, ריצה אחת, ללא loop,
 * ובסיום נעצר ומושתק אוטומטית ומתחלף ברקע בהיר שעליו צוות ההדרכה (6.5).
 * אם הדפדפן חוסם שמע — ניגון אוטומטי מושתק, בלי שום כפתור (6.7, הוראת
 * יניב 03/08/2026); רגישי תנועה מקבלים את מצב הצוות מיד.
 */
import { team } from '../data/team';
---

<section class="hero" aria-label="פתיחת האתר">
  <div class="hero-media" id="hero-media">
    <div class="hero-bg" aria-hidden="true"></div>
    <video
      id="hero-video"
      poster="/media/hero-poster-880.avif"
      width="1080"
      height="1080"
      preload="metadata"
      playsinline
      aria-label="סרטון הפתיחה של מחוז ירושלים"
    ></video>

    <div class="hero-after" id="hero-after">
      <div class="hero-after-inner">
        <h1>צוות הדרכה</h1>
        <p class="hero-under">במחוז ירושלים והעיר ירושלים — מנח״י</p>
        <ul class="hero-team hero-team-lead">
          {
            team.filter((m) => m.featured).map((m) => (
              <li class:list={['hero-member', 'is-featured']}>
                <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                  {m.photo ? (
                    <img
                      class="hero-avatar"
                      style={`--accent:${m.accent}`}
                      src={m.photo}
                      alt={`תמונתה של ${m.name}`}
                      width="140"
                      height="140"
                      loading="lazy"
                    />
                  ) : (
                    <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                      {m.initial}
                    </span>
                  )}
                  <strong class="hero-name">{m.name}</strong>
                  <span class="hero-role">{m.role}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="hero-team">
          {
            team.filter((m) => !m.featured).map((m) => (
              <li class="hero-member">
                <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                  {m.photo ? (
                    <img
                      class="hero-avatar"
                      style={`--accent:${m.accent}`}
                      src={m.photo}
                      alt={`תמונתה של ${m.name}`}
                      width="104"
                      height="104"
                      loading="lazy"
                    />
                  ) : (
                    <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                      {m.initial}
                    </span>
                  )}
                  <strong class="hero-name">{m.name}</strong>
                  <span class="hero-role">{m.role}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-block-start: calc(-1 * var(--header-h));
  }

  /* הסרטון המקורי ריבועי (1440×1440) — מוצג בשלמותו, ללא חיתוך פוגעני (6.8).
     כל אזור ה-hero מתמלא (הוראת יניב, 04/08/2026): שכבת רקע מלאה מאותו
     poster — cover עם טשטוש ועומק עדינים — ומעליה הסרטון החד במרכז; אין
     רצועות שחורות בצדדים ואין video כפול. */
  .hero-media {
    position: relative;
    inline-size: 100%;
    block-size: min(70vh, 100vw);
    overflow: hidden;
    display: grid;
    /* שורה מפורשת בגובה המיכל — כך block-size:100% של הווידאו נפתר באמת
       והריבוע ממלא את הגובה בדיוק, בלי חיתוך ובלי גלישה */
    grid-template-rows: 100%;
    place-items: center;
    background: #10141d;
  }

  .hero-bg {
    position: absolute;
    /* חורג מעט מהמסגרת כדי שהטשטוש לא יחשוף קצוות שקופים */
    inset: -4%;
    background: url('/media/hero-poster-880.avif') center 32% / cover no-repeat;
    filter: blur(26px) saturate(1.15) brightness(0.62);
    transform: scale(1.06);
    transition: opacity 1400ms var(--ease);
  }

  /* עומק עדין מעל הרקע — הסרטון החד נשאר המוקד */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(85% 100% at 50% 45%, transparent 40%, rgb(9 10 15 / 0.5) 100%);
  }

  video {
    /* גובה נעול לגובה המיכל — אפס קפיצת layout בטעינה (CLS) */
    position: relative;
    block-size: 100%;
    inline-size: auto;
    max-inline-size: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    filter: drop-shadow(0 30px 80px rgb(0 0 0 / 0.55));
    transition: opacity 1400ms var(--ease), filter 1400ms var(--ease);
  }

  /* ההיעלמות מתחילה מוקדם ונמשכת לאט: עמעום הדרגתי עד איפוס מלא
     (6.9, הוראת יניב 03/08/2026) */
  .hero-media.is-ending video {
    opacity: 0;
    filter: brightness(0.35) drop-shadow(0 30px 80px rgb(0 0 0 / 0.55));
    transition: opacity 3400ms cubic-bezier(0.3, 0, 0.6, 1), filter 3400ms cubic-bezier(0.3, 0, 0.6, 1);
  }


  /* המצב הבהיר שאחרי הסרטון (6.5) */
  .hero-after {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: clamp(1.5rem, 5vw, 3rem);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(201 155 63 / 0.14), transparent 60%),
      linear-gradient(180deg, #fdfcf9 0%, var(--paper) 100%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 1400ms var(--ease), visibility 0s linear 1400ms;
  }

  .hero-media.is-ended video { opacity: 0; }
  .hero-media.is-ended .hero-after {
    opacity: 1;
    visibility: visible;
    transition-delay: 200ms, 0s;
  }

  .hero-after-inner { max-width: 860px; }

  /* צוות ההדרכה על המסך הבהיר (6.5) */
  .hero-team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(0.9rem, 3vw, 2.2rem);
    list-style: none;
    margin: clamp(1rem, 3vh, 1.8rem) 0;
    padding: 0;
  }

  .hero-member a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    max-inline-size: 150px;
    text-align: center;
  }

  .hero-avatar {
    inline-size: clamp(68px, 9vw, 96px);
    block-size: clamp(68px, 9vw, 96px);
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 3px solid transparent;
    background:
      linear-gradient(var(--paper), var(--paper)) padding-box,
      conic-gradient(from 200deg, var(--accent), color-mix(in srgb, var(--accent) 30%, #fff), var(--accent)) border-box;
    box-shadow: var(--shadow-soft);
    transition: transform 400ms var(--ease-lift);
  }

  .hero-member a:hover .hero-avatar { transform: translateY(-4px) scale(1.04); }

  /* איילת מעל כולם, גדולה יותר (7.1, הוראת יניב 03/08/2026) */
  .hero-team-lead { margin-block-end: 0.2rem; }

  .hero-member.is-featured a { max-inline-size: 300px; }

  .hero-member.is-featured .hero-avatar {
    inline-size: clamp(104px, 15vw, 148px);
    block-size: clamp(104px, 15vw, 148px);
  }

  .hero-member.is-featured .hero-name { font-size: clamp(1.05rem, 2vw, 1.25rem); }

  .hero-mono {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-name { font-size: clamp(0.92rem, 1.6vw, 1.05rem); font-weight: 700; }

  .hero-role {
    font-size: clamp(0.72rem, 1.3vw, 0.8rem);
    color: var(--ink-soft);
    line-height: 1.35;
  }

  /* השורה הקטנה שמתחת לכותרת (6.5, הוראת יניב 03/08/2026) */
  .hero-under {
    color: var(--gold-deep);
    font-weight: 600;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    letter-spacing: 0.06em;
    margin: -0.2rem 0 0.4rem;
  }

  .hero-after h1 {
    margin-block-end: 0.4em;
    background: linear-gradient(175deg, var(--gold-deep) 20%, var(--amber) 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (max-width: 700px) {
    .hero-media {
      block-size: auto;
      min-block-size: 54vh;
      grid-template-rows: none;
      padding-block: calc(var(--header-h) + 0.5rem) 1rem;
    }
    video { inline-size: 100%; block-size: auto; }
  }
</style>

<script>
  const media = document.getElementById('hero-media')!;
  const video = document.getElementById('hero-video') as HTMLVideoElement;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // בחירת גרסה לפי רוחב המסך — שתי הגרסאות קודדו מהמקור ללא שינוי תוכן (6.10)
  video.src = innerWidth < 760 ? '/media/hero-720.mp4' : '/media/hero-1080.mp4';

  const finish = () => media.classList.add('is-ended');

  video.addEventListener('ended', finish, { once: true });

  // הדעיכה מתחילה ~1.8 שניות לפני הסוף ונמשכת לאט (6.9)
  video.addEventListener('timeupdate', () => {
    if (video.duration && video.duration - video.currentTime <= 1.8) {
      media.classList.add('is-ending');
    }
  });

  if (reduced) {
    // רגישי תנועה: מצב הצוות מיד, בלי ניגון אוטומטי
    finish();
  } else {
    // פתיחה אוטומטית עם קול (6.3, הוראת יניב); אם הדפדפן חוסם שמע —
    // ניגון אוטומטי מושתק, בלי שום כפתור (6.7). בסיום — עצירה אוטומטית.
    video.play().catch(() => {
      video.muted = true;
      video.play().catch(finish);
    });
  }
</script>
