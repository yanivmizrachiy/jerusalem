---
/**
 * סרטון הפתיחה (RULES §6): נפתח אוטומטית עם קול, ריצה אחת, ללא loop,
 * ובסיום נעצר ומושתק אוטומטית ומתחלף ברקע בהיר שעליו צוות ההדרכה (6.5).
 * אם הדפדפן חוסם שמע — ניגון אוטומטי מושתק, בלי שום כפתור (6.7, הוראת
 * יניב 03/08/2026); רגישי תנועה מקבלים את מצב הצוות מיד.
 */
import { team } from '../data/team';
---

<section class="hero" aria-label="פתיחת האתר">
  <div class="hero-media" id="hero-media">
    <div class="hero-bg" aria-hidden="true"></div>
    <video
      id="hero-video"
      poster="/media/hero-poster-880.avif"
      width="1080"
      height="1080"
      preload="metadata"
      playsinline
      aria-label="סרטון הפתיחה של מחוז ירושלים"
    ></video>

    <div class="hero-after" id="hero-after">
      <div class="hero-after-inner">
        <h1>צוות הדרכה</h1>
        <p class="hero-under">במחוז ירושלים והעיר ירושלים — מנח״י</p>
        <ul class="hero-team hero-team-lead">
          {
            team.filter((m) => m.featured).map((m) => (
              <li class:list={['hero-member', 'is-featured']}>
                <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                  {m.photo ? (
                    <img
                      class="hero-avatar"
                      style={`--accent:${m.accent}`}
                      src={m.photo}
                      alt={`תמונתה של ${m.name}`}
                      width="140"
                      height="140"
                      loading="lazy"
                    />
                  ) : (
                    <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                      {m.initial}
                    </span>
                  )}
                  <strong class="hero-name">{m.name}</strong>
                  <span class="hero-role">{m.role}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="hero-team">
          {
            team.filter((m) => !m.featured).map((m) => (
              <li class="hero-member">
                <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                  {m.photo ? (
                    <img
                      class="hero-avatar"
                      style={`--accent:${m.accent}`}
                      src={m.photo}
                      alt={`תמונתה של ${m.name}`}
                      width="104"
                      height="104"
                      loading="lazy"
                    />
                  ) : (
                    <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                      {m.initial}
                    </span>
                  )}
                  <strong class="hero-name">{m.name}</strong>
                  <span class="hero-role">{m.role}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* מדליון "התחל" — מעוגן בתחתית מסך הפתיחה עצמו, נראה בלי גלילה (7.28) */}
      <a
        class="start-btn"
        href="/shearim/"
        aria-label="התחל — מעבר לבחירת החטיבה: חטיבת ביניים או חטיבה עליונה"
      >
        <span class="start-face">
          <span class="start-label">התחל</span>
          <svg class="start-arrow" viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <path d="M33 6H2M8 1 2 6l6 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>

      {/* הודעות שוטפות — נגיש כבר ממסך הפתיחה, בלי להסתמך על גלילה (הוראת יניב, 10/08/2026) */}
      <a class="hodaot-pill" href="/hodaot/" aria-label="הודעות שוטפות — כל העדכונים וההודעות">
        <span class="pill-dot" aria-hidden="true"></span>
        <span class="pill-label">הודעות שוטפות</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-block-start: calc(-1 * var(--header-h));
  }

  /* הסרטון המקורי ריבועי (1440×1440) — מוצג בשלמותו, ללא חיתוך פוגעני (6.8).
     כל אזור ה-hero מתמלא (הוראת יניב, 04/08/2026): שכבת רקע מלאה מאותו
     poster — cover עם טשטוש ועומק עדינים — ומעליה הסרטון החד במרכז; אין
     רצועות שחורות בצדדים ואין video כפול. */
  .hero-media {
    position: relative;
    inline-size: 100%;
    /* פרוס עד תחתית המסך — בלי שטח ריק מתחתיו (הוראת יניב, 05/08/2026).
       הערך המדויק נקבע ב-JS לפי המרחק מראש החלון; זהו נפילת-חסד. */
    block-size: var(--hero-h, calc(100svh - 68px));
    overflow: hidden;
    display: grid;
    /* שורה מפורשת בגובה המיכל — כך block-size:100% של הווידאו נפתר באמת
       והריבוע ממלא את הגובה בדיוק, בלי חיתוך ובלי גלישה */
    grid-template-rows: 100%;
    place-items: center;
    background: #10141d;
  }

  .hero-bg {
    position: absolute;
    /* חורג מעט מהמסגרת כדי שהטשטוש לא יחשוף קצוות שקופים */
    inset: -4%;
    background: url('/media/hero-poster-880.avif') center 32% / cover no-repeat;
    filter: blur(26px) saturate(1.15) brightness(0.62);
    transform: scale(1.06);
    transition: opacity 1400ms var(--ease);
  }

  /* עומק עדין מעל הרקע — הסרטון החד נשאר המוקד */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(85% 100% at 50% 45%, transparent 40%, rgb(9 10 15 / 0.5) 100%);
  }

  video {
    /* גובה נעול לגובה המיכל — אפס קפיצת layout בטעינה (CLS) */
    position: relative;
    block-size: 100%;
    inline-size: auto;
    max-inline-size: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    filter: drop-shadow(0 30px 80px rgb(0 0 0 / 0.55));
    transition: opacity 1400ms var(--ease), filter 1400ms var(--ease);
  }

  /* ההיעלמות מתחילה מוקדם ונמשכת לאט: עמעום הדרגתי עד איפוס מלא
     (6.9, הוראת יניב 03/08/2026) */
  .hero-media.is-ending video {
    opacity: 0;
    filter: brightness(0.35) drop-shadow(0 30px 80px rgb(0 0 0 / 0.55));
    transition: opacity 3400ms cubic-bezier(0.3, 0, 0.6, 1), filter 3400ms cubic-bezier(0.3, 0, 0.6, 1);
  }


  /* המצב הבהיר שאחרי הסרטון (6.5) */
  .hero-after {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: clamp(1.5rem, 5vw, 3rem);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(201 155 63 / 0.14), transparent 60%),
      linear-gradient(180deg, #fdfcf9 0%, var(--paper) 100%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 1400ms var(--ease), visibility 0s linear 1400ms;
  }

  .hero-media.is-ended video { opacity: 0; }
  .hero-media.is-ended .hero-after {
    opacity: 1;
    visibility: visible;
    transition-delay: 200ms, 0s;
  }

  /* ===== כבר נצפה באותו session (RULES 6.2.1) =====
     ‏`hero-seen` נקבע ב-bootstrap שב-<head> (Base.astro) לפני ה-paint הראשון,
     ולכן החוזר ל"ראשי" נוחת ישר על מצב הצוות — בלי הבזק. `display: none` על
     הווידאו מבטל גם את ה-poster (שהוא תכונה על האלמנט), ו-`transition: none`
     מונע דהייה של 1400ms שהייתה נראית כמו "משהו נטען". */
  :global(html.hero-seen) .hero-media video { display: none; }
  :global(html.hero-seen) .hero-media .hero-after {
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  /* ריווח יוקרתי — יש מקום בעמוד, והכותרות נושמות (הוראת יניב, 05/08/2026).
     בתחתית שמור מקום למדליון "התחל" כדי שלא ייווצר חפיפה איתו (7.28) */
  .hero-after-inner {
    max-width: 980px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.1rem, 3.2vh, 2.6rem);
    padding-block: clamp(1rem, 4vh, 3rem);
    padding-block-end: calc(var(--start-d) + clamp(1.6rem, 4vh, 3rem));
  }

  /* ---------- מדליון "התחל" (7.28, הוראת יניב 05/08/2026) ----------
     עגול, בהיקף זהב, בתוך מסך הפתיחה — נראה תמיד בלי גלילה. */
  .hero-after { --start-d: clamp(96px, 13vh, 132px); }

  .start-btn {
    position: absolute;
    inset-block-end: clamp(1.2rem, 3.5vh, 2.6rem);
    /* ממורכז מול תמונות הצוות — אותו מרכז בדיוק, בלי היסט פס "מה צפוי?" */
    inset-inline: 0;
    margin-inline: auto;
    translate: 0 10px;
    inline-size: var(--start-d);
    block-size: var(--start-d);
    display: grid;
    place-items: center;
    border-radius: 50%;
    text-decoration: none;
    /* טבעת הזהב: חוט דק כפול על נייר — שפת המדליונים של אתרי יוקרה */
    background:
      radial-gradient(circle at 50% 32%, #fffefb 0%, var(--paper) 62%, var(--paper-soft) 100%);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--gold) 62%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      inset 0 0 0 6px color-mix(in srgb, var(--gold) 26%, transparent),
      0 22px 50px -26px rgb(42 37 32 / 0.5);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 900ms var(--ease),
      translate 900ms var(--ease),
      visibility 0s linear 900ms,
      box-shadow 420ms var(--ease);
  }

  /* נחשף רק אחרי שתמונת הפתיחה נעלמה כליל (7.28) */
  :global(html.hero-done) .start-btn {
    opacity: 1;
    visibility: visible;
    translate: none;
    transition-delay: 260ms, 260ms, 0s, 0s;
  }

  /* בתצוגת מורה יחיד "התחל" נעלם — נשאר רק חץ החזרה (הוראת יניב, 05/08/2026) */
  :global(html.team-solo) .start-btn {
    display: none;
  }

  .start-face {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.32rem;
    color: var(--gold-deep);
  }

  .start-label {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.1vh, 1.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
  }

  .start-arrow {
    inline-size: clamp(30px, 3.6vh, 40px);
    block-size: auto;
    transition: translate 420ms var(--ease);
  }

  .start-btn:hover {
    box-shadow:
      0 0 0 1px var(--gold),
      inset 0 0 0 1px rgb(255 255 255 / 0.95),
      inset 0 0 0 6px color-mix(in srgb, var(--gold) 40%, transparent),
      0 26px 56px -24px rgb(42 37 32 / 0.55);
  }

  .start-btn:hover .start-arrow { translate: -5px 0; }

  .start-btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 6px; }

  @media (prefers-reduced-motion: reduce) {
    .start-btn, .start-arrow { transition-duration: 1ms; }
  }

  /* גלולת "הודעות שוטפות" — קטנה, עדינה וצבעונית; חשופה עם המדליון (10/08/2026) */
  .hodaot-pill {
    position: absolute;
    inset-block-end: clamp(1.4rem, 3.8vh, 2.8rem);
    inset-inline-start: clamp(0.9rem, 4vw, 3rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--navy);
    font-weight: 800;
    font-size: 0.92rem;
    background: linear-gradient(135deg, #fffdf8, color-mix(in srgb, var(--sky) 14%, #fff));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--sky) 45%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      0 14px 34px -20px rgb(42 37 32 / 0.45);
    opacity: 0;
    visibility: hidden;
    translate: 0 10px;
    transition:
      opacity 900ms var(--ease),
      translate 900ms var(--ease),
      visibility 0s linear 900ms,
      box-shadow 420ms var(--ease);
  }
  :global(html.hero-done) .hodaot-pill {
    opacity: 1;
    visibility: visible;
    translate: none;
    transition-delay: 380ms, 380ms, 0s, 0s;
  }
  :global(html.team-solo) .hodaot-pill { display: none; }
  .pill-dot {
    inline-size: 9px;
    block-size: 9px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--terracotta), var(--gold), var(--sky), var(--terracotta));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 22%, transparent);
  }
  .hodaot-pill:hover {
    box-shadow:
      0 0 0 1px var(--sky),
      inset 0 0 0 1px rgb(255 255 255 / 0.95),
      0 18px 38px -18px rgb(42 37 32 / 0.5);
  }
  .hodaot-pill:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .hodaot-pill { transition-duration: 1ms; }
  }

  /* צוות ההדרכה על המסך הבהיר (6.5) */
  .hero-team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(1.1rem, 3.4vw, 2.8rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-member a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    max-inline-size: 150px;
    text-align: center;
  }

  .hero-avatar {
    inline-size: clamp(68px, 9vw, 96px);
    block-size: clamp(68px, 9vw, 96px);
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 3px solid transparent;
    background:
      linear-gradient(var(--paper), var(--paper)) padding-box,
      conic-gradient(from 200deg, var(--accent), color-mix(in srgb, var(--accent) 30%, #fff), var(--accent)) border-box;
    box-shadow: var(--shadow-soft);
    transition: transform 400ms var(--ease-lift);
  }

  .hero-member a:hover .hero-avatar { transform: translateY(-4px) scale(1.04); }

  /* איילת מעל כולם, גדולה יותר (7.1, הוראת יניב 03/08/2026) */
  .hero-team-lead { margin-block-end: 0; }

  .hero-member.is-featured a { max-inline-size: 300px; }

  .hero-member.is-featured .hero-avatar {
    inline-size: clamp(104px, 15vw, 148px);
    block-size: clamp(104px, 15vw, 148px);
  }

  .hero-member.is-featured .hero-name { font-size: clamp(1.05rem, 2vw, 1.25rem); }

  .hero-mono {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-name { font-size: clamp(0.92rem, 1.6vw, 1.05rem); font-weight: 700; }

  .hero-role {
    font-size: clamp(0.72rem, 1.3vw, 0.8rem);
    color: var(--ink-soft);
    line-height: 1.35;
  }

  /* השורה הקטנה שמתחת לכותרת (6.5, הוראת יניב 03/08/2026) */
  .hero-under {
    color: var(--gold-deep);
    font-weight: 600;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    letter-spacing: 0.06em;
    margin: 0;
  }

  .hero-after h1 {
    margin: 0;
    line-height: 1.1;
    background: linear-gradient(175deg, var(--gold-deep) 20%, var(--amber) 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* מסך נמוך: מהדקים את הריווח והדיוקנאות כדי שהצוות והמדליון ייכנסו
     יחד בלי גלילה ובלי חפיפה (7.28) */
  @media (max-height: 820px) {
    .hero-after-inner { gap: clamp(0.6rem, 2vh, 1.4rem); padding-block-start: 0.5rem; }
    .hero-member.is-featured .hero-avatar { inline-size: clamp(92px, 12vh, 120px); block-size: clamp(92px, 12vh, 120px); }
    .hero-avatar { inline-size: clamp(60px, 8vh, 84px); block-size: clamp(60px, 8vh, 84px); }
  }

  @media (max-width: 700px) {
    .hero-media {
      block-size: var(--hero-h, calc(100svh - 192px));
      grid-template-rows: 100%;
      padding-block: 0;
    }
    video { inline-size: 100%; block-size: auto; max-block-size: 100%; }
  }
</style>

<script>
  const media = document.getElementById('hero-media')!;
  const video = document.getElementById('hero-video') as HTMLVideoElement;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ===== "נצפה" — פעם אחת בכל session של הטאב (RULES 6.2.1, 6.6) ===== */
  const SEEN_KEY = 'jerusalem.heroSeen.v1';
  const wasSeen = () => {
    try {
      return sessionStorage.getItem(SEEN_KEY) === '1';
    } catch {
      return false; // מצב פרטי/חסום — מתנהגים כמו כניסה ראשונה
    }
  };
  const markSeen = () => {
    try {
      sessionStorage.setItem(SEEN_KEY, '1');
    } catch {
      /* אין אחסון — אין מה לשמור; ההתנהגות נשארת תקינה */
    }
  };

  // בחירת גרסה לפי רוחב המסך — שתי הגרסאות קודדו מהמקור ללא שינוי תוכן (6.10).
  // מי שכבר צפה אינו מקבל src כלל: בלי בקשת רשת, בלי פריים ובלי poster.
  if (!wasSeen()) {
    video.src = innerWidth < 760 ? '/media/hero-720.mp4' : '/media/hero-1080.mp4';
  }

  // גובה ה-hero עד תחתית החלון בדיוק — בלי שטח ריק מתחת לתמונה
  const fit = () => {
    const top = media.getBoundingClientRect().top + window.scrollY;
    media.style.setProperty('--hero-h', `${Math.max(380, Math.round(innerHeight - top))}px`);
  };
  fit();
  addEventListener('resize', fit, { passive: true });
  addEventListener('load', fit, { once: true });
  document.fonts?.ready.then(fit);

  // כפתור "התחל" נחשף רק אחרי שתמונת הפתיחה נעלמה כליל (7.28)
  const finish = () => {
    media.classList.add('is-ended');
    document.documentElement.classList.add('hero-done');
    markSeen();
  };

  /* מצב הצוות המיידי למי שכבר צפה: בלי play(), בלי איפוס currentTime,
     בלי poster ובלי אנימציה (6.2.1). `hero-seen` כבר הוסף ב-<head> ברוב
     המקרים; מוסיפים אותו גם כאן כרשת ביטחון ל-bfcache ולסדר טעינה חריג. */
  const settleSeen = () => {
    document.documentElement.classList.add('hero-seen', 'hero-done');
    media.classList.add('is-ending', 'is-ended');
  };

  video.addEventListener('ended', finish);

  // הדעיכה מתחילה ~1.8 שניות לפני הסוף ונמשכת לאט (6.9)
  video.addEventListener('timeupdate', () => {
    if (video.duration && video.duration - video.currentTime <= 1.8) {
      media.classList.add('is-ending');
    }
  });

  /* פתיחה אוטומטית עם קול (6.3, הוראת יניב); אם הדפדפן חוסם שמע —
     ניגון אוטומטי מושתק, בלי שום כפתור (6.7). בסיום — עצירה אוטומטית. */
  const play = () => {
    video.play().catch(() => {
      video.muted = true;
      video.play().catch(finish);
    });
  };

  /* ===== פעם אחת בכל session של הטאב (6.2.1, הוראת יניב 06/08/2026) =====
     מבטל את "הסרטון רץ בכל כניסה" ומחזיר את 6.6 לתוקף: לאחר שנצפה, כל חזרה
     ל"ראשי" באותו session מציגה מיד את מצב הצוות. הניסוח הקודם כאן איפס את
     המחלקות ואת `currentTime` בכל `pageshow` מ-bfcache, ולכן הסרטון חזר שוב
     ושוב — זו בדיוק התלונה. טאב חדש (session חדש) רשאי להציג אותו מחדש. */
  const start = () => {
    if (wasSeen()) {
      settleSeen();
      return;
    }
    if (reduced) {
      // רגישי תנועה: מצב הצוות מיד, בלי ניגון אוטומטי — ונחשב "נצפה"
      finish();
      return;
    }
    media.classList.remove('is-ending', 'is-ended');
    document.documentElement.classList.remove('hero-done');
    try {
      video.currentTime = 0;
    } catch {
      /* המדיה עדיין לא ניתנת לחיפוש — הניגון יתחיל מההתחלה ממילא */
    }
    play();
  };

  start();

  /* bfcache/‏history back: אם כבר נצפה — מצב צוות מיד ובלי ניגון; אם טרם נצפה
     (למשל חזרה אחורה באמצע הצפייה הראשונה) — מותר להתחיל. */
  addEventListener('pageshow', (e) => {
    if (!(e as PageTransitionEvent).persisted) return;
    if (wasSeen()) {
      settleSeen();
      return;
    }
    start();
  });
</script>
