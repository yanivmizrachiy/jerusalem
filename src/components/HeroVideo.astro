---
/**
 * המסך הראשוני (RULES §6, §7.28 — הוראת יניב 10/08/2026): העמוד עולה מיד,
 * בלי סרטון-שער ובלי הסתרת כפתורים. צוות ההדרכה, כפתורי הפעולה המובילים
 * והניווט גלויים מהרגע הראשון; הסרטון קבוע כלוח קולנועי ממוסגר בתוך המסך,
 * במקום שאינו מפריע לשום כפתור ואין עליו שכבות: מושתק, פעם אחת, בלי loop.
 * רגישי תנועה מקבלים poster נייח בלבד.
 */
import { team } from '../data/team';

const leads = [
  {
    href: '/chativat-beynayim/',
    label: 'חטיבת ביניים',
    sub: 'מתמטיקה לכיתות ז׳–ט׳',
    tone: 'lead--mid',
    icon: 'book',
  },
  {
    href: '/chativa-elyona/',
    label: 'חטיבה עליונה',
    sub: 'מתמטיקה לכיתות י׳–י״ב',
    tone: 'lead--high',
    icon: 'cap',
  },
  {
    href: '/hodaot/',
    label: 'הודעות שוטפות',
    sub: 'עדכוני המחוז וההדרכה',
    tone: 'lead--news',
    icon: 'bell',
  },
] as const;
---

<section class="hero" aria-label="פתיחת האתר">
  <div class="hero-after" id="hero-after">
    <div class="hero-after-inner">
      <h1>צוות הדרכה</h1>
      <p class="hero-under">במחוז ירושלים והעיר ירושלים — מנח״י</p>
      <ul class="hero-team hero-team-lead">
        {
          team.filter((m) => m.featured).map((m) => (
            <li class:list={['hero-member', 'is-featured']}>
              <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                {m.photo ? (
                  <img
                    class="hero-avatar"
                    style={`--accent:${m.accent}`}
                    src={m.photo}
                    alt={`תמונתה של ${m.name}`}
                    width="140"
                    height="140"
                    loading="lazy"
                  />
                ) : (
                  <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                    {m.initial}
                  </span>
                )}
                <strong class="hero-name">{m.name}</strong>
                <span class="hero-role">{m.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="hero-team">
        {
          team.filter((m) => !m.featured).map((m) => (
            <li class="hero-member">
              <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                {m.photo ? (
                  <img
                    class="hero-avatar"
                    style={`--accent:${m.accent}`}
                    src={m.photo}
                    alt={`תמונתה של ${m.name}`}
                    width="104"
                    height="104"
                    loading="lazy"
                  />
                ) : (
                  <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                    {m.initial}
                  </span>
                )}
                <strong class="hero-name">{m.name}</strong>
                <span class="hero-role">{m.role}</span>
              </a>
            </li>
          ))
        }
      </ul>

      {/* כפתורי הפעולה המובילים (7.28, הוראת יניב 10/08/2026) — במקום "התחל":
          צבעוניים מהפלטה (5.19), גלויים מיד, כל כפתור בגוון משלו וחוט זהב מאחד */}
      <nav class="hero-actions" aria-label="כניסות מרכזיות">
        {
          leads.map((l) => (
            <a class:list={['lead-btn', l.tone]} href={l.href}>
              <span class="lead-icon" aria-hidden="true">
                {l.icon === 'book' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5.5C10 4 7.5 3.5 5 3.5v13c2.5 0 5 .5 7 2 2-1.5 4.5-2 7-2v-13c-2.5 0-5 .5-7 2Z" />
                    <path d="M12 5.5v13" />
                  </svg>
                )}
                {l.icon === 'cap' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 4 10 4.5L12 13 2 8.5 12 4Z" />
                    <path d="M6.5 10.7V15c0 1.6 2.5 3 5.5 3s5.5-1.4 5.5-3v-4.3" />
                  </svg>
                )}
                {l.icon === 'bell' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 15.5H6c1.2-1.2 1.8-2.3 1.8-4.8 0-3 1.6-5.2 4.2-5.2s4.2 2.2 4.2 5.2c0 2.5.6 3.6 1.8 4.8Z" />
                    <path d="M10.3 18.4a1.8 1.8 0 0 0 3.4 0" />
                  </svg>
                )}
              </span>
              <span class="lead-copy">
                <strong>{l.label}</strong>
                <small>{l.sub}</small>
              </span>
              <svg class="lead-arrow" viewBox="0 0 26 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <path d="M25 6H2M7.5 1.5 2 6l5.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          ))
        }
      </nav>
    </div>

    {/* הסרטון — לוח קולנועי קבוע וממוסגר (6.3): אין עליו שום כפתור או שכבה,
        ובמסך רחב הוא מעוגן בצד בלי לחפוף לצוות או לכפתורים */}
    <figure class="hero-clip">
      <video
        id="hero-video"
        poster="/media/hero-poster-880.avif"
        width="1080"
        height="1080"
        preload="metadata"
        muted
        playsinline
        aria-label="סרטון מחוז ירושלים"
      ></video>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-block-start: calc(-1 * var(--header-h));
  }

  /* המסך הראשוני — רקע בהיר, מוצג מיד (6.2). הגובה נמדד ב-JS עד תחתית
     החלון; min ולא גובה קשיח, כדי שתוכן ארוך לעולם לא ייחתך. */
  .hero-after {
    position: relative;
    min-block-size: var(--hero-h, calc(100svh - 68px));
    display: grid;
    place-items: center;
    align-content: center;
    gap: clamp(1rem, 2.6vh, 1.8rem);
    text-align: center;
    padding: clamp(1.2rem, 4vw, 2.6rem);
    padding-block-start: calc(var(--header-h) + clamp(0.7rem, 2vh, 1.5rem));
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(201 155 63 / 0.14), transparent 60%),
      linear-gradient(180deg, #fdfcf9 0%, var(--paper) 100%);
  }

  .hero-after-inner {
    max-width: 980px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 2.8vh, 2.2rem);
    padding-block: clamp(0.5rem, 2.5vh, 2rem);
  }

  @keyframes hero-rise {
    from { opacity: 0; translate: 0 14px; }
    to { opacity: 1; translate: 0 0; }
  }

  .hero-after h1 { animation: hero-rise 700ms var(--ease) both; }
  .hero-under { animation: hero-rise 700ms var(--ease) 90ms both; }
  .hero-team-lead { animation: hero-rise 750ms var(--ease) 170ms both; }
  .hero-team:not(.hero-team-lead) { animation: hero-rise 750ms var(--ease) 250ms both; }
  .hero-actions { animation: hero-rise 750ms var(--ease) 330ms both; }
  .hero-clip { animation: hero-rise 900ms var(--ease) 430ms both; }

  @media (prefers-reduced-motion: reduce) {
    .hero-after h1,
    .hero-under,
    .hero-team,
    .hero-actions,
    .hero-clip { animation: none; }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.7rem, 1.6vw, 1.1rem);
    margin-block-start: clamp(0.2rem, 1.4vh, 0.9rem);
  }

  .lead-btn {
    --tone: var(--gold);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.6rem, 1.2vw, 0.85rem);
    min-block-size: 64px;
    min-inline-size: min(248px, 84vw);
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--navy);
    text-align: start;
    background: linear-gradient(135deg, #fffefb, color-mix(in srgb, var(--tone) 17%, #fff));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--tone) 58%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      inset 0 -1px 0 0 color-mix(in srgb, var(--gold) 38%, transparent),
      0 18px 40px -22px rgb(42 37 32 / 0.5);
    transition: translate 320ms var(--ease), box-shadow 320ms var(--ease);
  }

  .lead--mid { --tone: var(--terracotta); }
  .lead--high { --tone: var(--sky); }
  .lead--news { --tone: var(--amber); }

  .lead-btn:hover,
  .lead-btn:focus-visible {
    translate: 0 -3px;
    box-shadow:
      0 0 0 1.5px color-mix(in srgb, var(--tone) 85%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.95),
      inset 0 -1px 0 0 color-mix(in srgb, var(--gold) 55%, transparent),
      0 24px 48px -22px rgb(42 37 32 / 0.55);
  }

  .lead-btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }

  .lead-icon {
    display: grid;
    place-items: center;
    inline-size: clamp(42px, 5vh, 48px);
    block-size: clamp(42px, 5vh, 48px);
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(160deg, var(--tone), color-mix(in srgb, var(--tone) 55%, var(--navy)));
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.32);
  }

  .lead-icon svg { inline-size: 58%; block-size: 58%; }
  .lead-copy { display: flex; min-inline-size: 0; flex-direction: column; gap: 0.1rem; }
  .lead-copy strong { font-size: clamp(1.02rem, 1.8vw, 1.2rem); font-weight: 800; line-height: 1.15; }
  .lead-copy small { color: var(--ink-soft); font-size: clamp(0.74rem, 1.3vw, 0.84rem); }

  .lead-arrow {
    inline-size: 24px;
    block-size: auto;
    color: var(--gold-deep);
    transition: translate 320ms var(--ease);
  }

  .lead-btn:hover .lead-arrow { translate: -5px 0; }

  @media (prefers-reduced-motion: reduce) {
    .lead-btn,
    .lead-arrow { transition-duration: 1ms; }
  }

  .hero-clip {
    margin: 0;
    inline-size: min(66vw, 300px);
    aspect-ratio: 1 / 1;
    padding: 9px;
    border-radius: var(--radius-lg);
    background: linear-gradient(165deg, #1b2434, var(--navy) 55%, #101725);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--gold) 55%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 26px 60px -30px rgb(9 10 15 / 0.7);
  }

  .hero-clip video {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 6px);
    background: #10141d url('/media/hero-poster-880.avif') center / cover no-repeat;
  }

  @media (min-width: 1440px) {
    .hero-clip {
      position: absolute;
      inset-block-end: clamp(1.2rem, 3vh, 2.4rem);
      inset-inline-start: clamp(1.2rem, 2.2vw, 2.6rem);
      inline-size: clamp(150px, 13vw, 205px);
    }
  }

  .hero-team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(1.1rem, 3.4vw, 2.8rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-member a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    max-inline-size: 150px;
    text-align: center;
  }

  .hero-avatar {
    inline-size: clamp(68px, 9vw, 96px);
    block-size: clamp(68px, 9vw, 96px);
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 3px solid transparent;
    background:
      linear-gradient(var(--paper), var(--paper)) padding-box,
      conic-gradient(from 200deg, var(--accent), color-mix(in srgb, var(--accent) 30%, #fff), var(--accent)) border-box;
    box-shadow: var(--shadow-soft);
    transition: transform 400ms var(--ease-lift);
  }

  .hero-member a:hover .hero-avatar { transform: translateY(-4px) scale(1.04); }
  .hero-team-lead { margin-block-end: 0; }
  .hero-member.is-featured a { max-inline-size: 300px; }

  .hero-member.is-featured .hero-avatar {
    inline-size: clamp(104px, 15vw, 148px);
    block-size: clamp(104px, 15vw, 148px);
  }

  .hero-member.is-featured .hero-name { font-size: clamp(1.05rem, 2vw, 1.25rem); }

  .hero-mono {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-name { font-size: clamp(0.92rem, 1.6vw, 1.05rem); font-weight: 700; }

  .hero-role {
    font-size: clamp(0.72rem, 1.3vw, 0.8rem);
    color: var(--ink-soft);
    line-height: 1.35;
  }

  .hero-under {
    color: var(--gold-deep);
    font-weight: 600;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    letter-spacing: 0.06em;
    margin: 0;
  }

  .hero-after h1 {
    margin: 0;
    line-height: 1.1;
    background: linear-gradient(175deg, var(--gold-deep) 20%, var(--amber) 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (max-height: 820px) {
    .hero-after-inner { gap: clamp(0.6rem, 2vh, 1.3rem); padding-block-start: 0.4rem; }
    .hero-member.is-featured .hero-avatar { inline-size: clamp(92px, 12vh, 120px); block-size: clamp(92px, 12vh, 120px); }
    .hero-avatar { inline-size: clamp(60px, 8vh, 84px); block-size: clamp(60px, 8vh, 84px); }
    .hero-clip { inline-size: min(52vw, 230px); }
  }

  @media (max-width: 700px) {
    .hero-actions {
      order: 2;
      inline-size: min(100%, 350px);
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.4rem;
      margin-block-start: 0.1rem;
    }
    .hero-team-lead { order: 3; }
    .hero-team:not(.hero-team-lead) { order: 4; }
    .hero-clip { inline-size: min(70vw, 280px); }
    .lead-btn {
      min-inline-size: 0;
      inline-size: 100%;
      min-block-size: 52px;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.18rem;
      padding: 0.35rem 0.2rem;
      border-radius: 18px;
      text-align: center;
    }
    .lead-icon { inline-size: 30px; block-size: 30px; }
    .lead-copy strong { font-size: clamp(0.72rem, 3vw, 0.86rem); line-height: 1.1; }
    .lead-copy small,
    .lead-arrow { display: none; }
  }
</style>

<script>
  const media = document.getElementById('hero-after')!;
  const video = document.getElementById('hero-video') as HTMLVideoElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const fit = () => {
    const top = media.getBoundingClientRect().top + window.scrollY;
    media.style.setProperty('--hero-h', `${Math.max(380, Math.round(innerHeight - top))}px`);
  };
  fit();
  addEventListener('resize', fit, { passive: true });
  addEventListener('load', fit, { once: true });
  document.fonts?.ready.then(fit);

  if (!reduced) {
    video.muted = true;
    video.src = '/media/hero-720.mp4';
    const tryPlay = () => {
      video.play().catch(() => {
        /* אם הדפדפן מסרב גם לניגון מושתק — נשאר ה-poster; אין כפתור (6.4) */
      });
    };
    if (video.readyState >= 2) tryPlay();
    else video.addEventListener('canplay', tryPlay, { once: true });
  }
</script>