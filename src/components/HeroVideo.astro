---
/**
 * סרטון הפתיחה (RULES §6): נפתח אוטומטית עם קול, ריצה אחת, ללא loop,
 * ובסיום נעצר ומושתק אוטומטית ומתחלף ברקע בהיר שעליו צוות ההדרכה (6.5).
 * אם הדפדפן חוסם שמע — ניגון אוטומטי מושתק, בלי שום כפתור (6.7, הוראת
 * יניב 03/08/2026); רגישי תנועה מקבלים את מצב הצוות מיד.
 * כרטיס-היחיד (6.5, הוראת יניב 03/08/2026) נחשף כאן, בתוך מסך הפתיחה —
 * אין שום מקטע צוות אחר בעמוד.
 */
import { team } from '../data/team';

const waPath =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
---

<section class="hero" id="tzevet" aria-label="פתיחת האתר">
  <div class="hero-media" id="hero-media">
    <video
      id="hero-video"
      poster="/media/hero-poster-880.avif"
      width="1080"
      height="1080"
      preload="metadata"
      playsinline
      aria-label="סרטון הפתיחה של מחוז ירושלים"
    ></video>

    <div class="hero-after" id="hero-after">
      <div class="hero-after-inner">
        <h1>צוות הדרכה</h1>
        <p class="hero-under">במחוז ירושלים והעיר ירושלים — מנח״י</p>
        <ul class="hero-team hero-team-lead">
          {
            team.filter((m) => m.featured).map((m) => (
              <li class:list={['hero-member', 'is-featured']}>
                <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                  {m.photo ? (
                    <img
                      class="hero-avatar"
                      style={`--accent:${m.accent}`}
                      src={m.photo}
                      alt={`תמונתה של ${m.name}`}
                      width="140"
                      height="140"
                      loading="lazy"
                    />
                  ) : (
                    <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                      {m.initial}
                    </span>
                  )}
                  <strong class="hero-name">{m.name}</strong>
                  <span class="hero-role">{m.role}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="hero-team">
          {
            team.filter((m) => !m.featured).map((m) => (
              <li class="hero-member">
                <a href={`#tzevet-${m.slug}`} aria-label={`${m.name} — לפרטי הקשר`}>
                  {m.photo ? (
                    <img
                      class="hero-avatar"
                      style={`--accent:${m.accent}`}
                      src={m.photo}
                      alt={`תמונתה של ${m.name}`}
                      width="104"
                      height="104"
                      loading="lazy"
                    />
                  ) : (
                    <span class="hero-avatar hero-mono" style={`--accent:${m.accent}`} aria-hidden="true">
                      {m.initial}
                    </span>
                  )}
                  <strong class="hero-name">{m.name}</strong>
                  <span class="hero-role">{m.role}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- כרטיס-יחיד בתוך מסך הפתיחה (6.5): נחשף רק בלחיצה על חבר צוות -->
        <div class="hero-cards" data-team-details hidden>
          {
            team.map((m) => (
              <article id={`tzevet-${m.slug}`} class="hero-card" style={`--accent:${m.accent}`} hidden>
                {m.photo ? (
                  <img
                    class="hero-avatar hero-card-avatar"
                    style={`--accent:${m.accent}`}
                    src={m.photo}
                    alt={`תמונתה של ${m.name}`}
                    width="118"
                    height="118"
                    loading="lazy"
                  />
                ) : (
                  <span class="hero-avatar hero-mono hero-card-avatar" style={`--accent:${m.accent}`} aria-hidden="true">
                    {m.initial}
                  </span>
                )}
                <h2 class="hero-card-name">{m.name}</h2>
                <p class="hero-card-role">{m.role}</p>
                <a class="hero-card-phone" href={`tel:+${m.phoneIntl}`} aria-label={`חיוג אל ${m.name}`}>
                  {m.phoneDisplay}
                </a>
                <div class="hero-card-actions">
                  <a
                    class="btn btn-whatsapp"
                    href={`https://wa.me/${m.phoneIntl}`}
                    target="_blank"
                    rel="noopener"
                    aria-label={`שליחת WhatsApp אל ${m.name}`}
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={waPath} />
                    </svg>
                  </a>
                  {m.facebook && (
                    <a class="btn btn-facebook" href={m.facebook} target="_blank" rel="noopener" aria-label="הדפים של יניב — פייסבוק">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
                      </svg>
                    </a>
                  )}
                  {m.website && (
                    <a class="btn btn-site" href={m.website} target="_blank" rel="noopener" aria-label={`האתר של ${m.name}`}>
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3a13.4 13.4 0 0 1 0 18M12 3a13.4 13.4 0 0 0 0 18" />
                      </svg>
                    </a>
                  )}
                  {m.email && (
                    <a class="btn btn-gmail" href={`mailto:${m.email}`} aria-label={`שליחת דוא״ל אל ${m.name}`}>
                      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M1.636 20.5h3.819V11.73L0 7.64v11.223c0 .904.732 1.636 1.636 1.636Z" />
                        <path fill="#34A853" d="M18.545 20.5h3.819c.904 0 1.636-.732 1.636-1.636V7.64l-5.455 4.09Z" />
                        <path fill="#FBBC04" d="M18.545 5.457v6.273L24 7.64V6.275c0-2.023-2.309-3.178-3.927-1.964Z" />
                        <path fill="#EA4335" d="M5.455 11.73V5.457L12 10.366l6.545-4.909v6.273L12 16.639Z" />
                        <path fill="#C5221F" d="M0 6.275v1.365l5.455 4.09V5.457L4.073 4.42C2.309 3.098 0 4.252 0 6.275Z" />
                      </svg>
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-block-start: calc(-1 * var(--header-h));
  }

  /* הסרטון המקורי ריבועי (1440×1440) — מוצג בשלמותו, ללא חיתוך פוגעני (6.8) */
  .hero-media {
    position: relative;
    inline-size: 100%;
    block-size: min(70vh, 100vw);
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(90% 120% at 50% 10%, #1a2030 0%, #0d0f16 55%, #090a0f 100%);
  }

  video {
    /* גובה נעול לגובה המיכל — אפס קפיצת layout בטעינה (CLS) */
    block-size: 100%;
    inline-size: auto;
    max-inline-size: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    filter: drop-shadow(0 30px 80px rgb(0 0 0 / 0.55));
    transition: opacity 1400ms var(--ease), filter 1400ms var(--ease);
  }

  /* ההיעלמות מתחילה מוקדם ונמשכת לאט: עמעום הדרגתי עד איפוס מלא
     (6.9, הוראת יניב 03/08/2026) */
  .hero-media.is-ending video {
    opacity: 0;
    filter: brightness(0.35) drop-shadow(0 30px 80px rgb(0 0 0 / 0.55));
    transition: opacity 3400ms cubic-bezier(0.3, 0, 0.6, 1), filter 3400ms cubic-bezier(0.3, 0, 0.6, 1);
  }


  /* המצב הבהיר שאחרי הסרטון (6.5) */
  .hero-after {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: clamp(1.5rem, 5vw, 3rem);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(201 155 63 / 0.14), transparent 60%),
      linear-gradient(180deg, #fdfcf9 0%, var(--paper) 100%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 1400ms var(--ease), visibility 0s linear 1400ms;
  }

  .hero-media.is-ended video { opacity: 0; }
  .hero-media.is-ended .hero-after {
    opacity: 1;
    visibility: visible;
    transition-delay: 200ms, 0s;
  }

  .hero-after-inner { max-width: 860px; }

  /* צוות ההדרכה על המסך הבהיר (6.5) */
  .hero-team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(0.9rem, 3vw, 2.2rem);
    list-style: none;
    margin: clamp(1rem, 3vh, 1.8rem) 0;
    padding: 0;
  }

  .hero-member a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    max-inline-size: 150px;
    text-align: center;
  }

  .hero-avatar {
    inline-size: clamp(68px, 9vw, 96px);
    block-size: clamp(68px, 9vw, 96px);
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 3px solid transparent;
    background:
      linear-gradient(var(--paper), var(--paper)) padding-box,
      conic-gradient(from 200deg, var(--accent), color-mix(in srgb, var(--accent) 30%, #fff), var(--accent)) border-box;
    box-shadow: var(--shadow-soft);
    transition: transform 400ms var(--ease-lift);
  }

  .hero-member a:hover .hero-avatar { transform: translateY(-4px) scale(1.04); }

  /* איילת מעל כולם, גדולה יותר (7.1, הוראת יניב 03/08/2026) */
  .hero-team-lead { margin-block-end: 0.2rem; }

  .hero-member.is-featured a { max-inline-size: 300px; }

  .hero-member.is-featured .hero-avatar {
    inline-size: clamp(104px, 15vw, 148px);
    block-size: clamp(104px, 15vw, 148px);
  }

  .hero-member.is-featured .hero-name { font-size: clamp(1.05rem, 2vw, 1.25rem); }

  .hero-mono {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-name { font-size: clamp(0.92rem, 1.6vw, 1.05rem); font-weight: 700; }

  .hero-role {
    font-size: clamp(0.72rem, 1.3vw, 0.8rem);
    color: var(--ink-soft);
    line-height: 1.35;
  }

  /* השורה הקטנה שמתחת לכותרת (6.5, הוראת יניב 03/08/2026) */
  .hero-under {
    color: var(--gold-deep);
    font-weight: 600;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    letter-spacing: 0.06em;
    margin: -0.2rem 0 0.4rem;
  }

  .hero-after h1 {
    margin-block-end: 0.4em;
    background: linear-gradient(175deg, var(--gold-deep) 20%, var(--amber) 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* כרטיס-יחיד בתוך מסך הפתיחה (6.5): מודגש בזהב, במקום רשימת הצוות */
  .hero-cards { display: grid; justify-content: center; }

  .hero-cards[hidden],
  .hero-card[hidden] { display: none; }

  .hero-card {
    inline-size: min(440px, 92vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.4rem 1.6rem;
    background: linear-gradient(180deg, #fff 0%, #fdf7ea 100%);
    border-radius: var(--radius-lg);
    outline: 3px solid var(--gold);
    outline-offset: 3px;
    box-shadow: var(--shadow-soft);
  }

  .hero-card-avatar {
    inline-size: 118px;
    block-size: 118px;
    margin-block-end: 1rem;
  }

  .hero-card-name { margin: 0 0 0.2rem; font-size: 1.45rem; }

  .hero-card-role { margin: 0 0 0.5rem; color: var(--ink-soft); font-size: 0.95rem; }

  .hero-card-phone {
    color: var(--ink);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    margin-block-end: 1rem;
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
  }

  .hero-card-phone:hover { color: var(--gold-deep); }

  .hero-card-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  @media (max-width: 700px) {
    .hero-media { block-size: auto; min-block-size: 54vh; padding-block: calc(var(--header-h) + 0.5rem) 1rem; }
    video { inline-size: 100%; }
  }
</style>

<script>
  const media = document.getElementById('hero-media')!;
  const video = document.getElementById('hero-video') as HTMLVideoElement;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // בחירת גרסה לפי רוחב המסך — שתי הגרסאות קודדו מהמקור ללא שינוי תוכן (6.10)
  video.src = innerWidth < 760 ? '/media/hero-720.mp4' : '/media/hero-1080.mp4';

  const finish = () => media.classList.add('is-ended');

  video.addEventListener('ended', finish, { once: true });

  // הדעיכה מתחילה ~1.8 שניות לפני הסוף ונמשכת לאט (6.9)
  video.addEventListener('timeupdate', () => {
    if (video.duration && video.duration - video.currentTime <= 1.8) {
      media.classList.add('is-ending');
    }
  });

  if (reduced) {
    // רגישי תנועה: מצב הצוות מיד, בלי ניגון אוטומטי
    finish();
  } else {
    // פתיחה אוטומטית עם קול (6.3, הוראת יניב); אם הדפדפן חוסם שמע —
    // ניגון אוטומטי מושתק, בלי שום כפתור (6.7). בסיום — עצירה אוטומטית.
    video.play().catch(() => {
      video.muted = true;
      video.play().catch(finish);
    });
  }

  // כרטיס-יחיד בתוך מסך הפתיחה (6.5, הוראת יניב 03/08/2026): עוגן אישי
  // מציג אך ורק את הכרטיס של אותו חבר צוות במקום רשימת הצוות; הגעה עם
  // עוגן צוות מדלגת ישר למצב הצוות. אין שום מקטע צוות אחר בעמוד.
  const cardsWrap = document.querySelector<HTMLElement>('[data-team-details]');
  if (cardsWrap) {
    const lists = [...document.querySelectorAll<HTMLElement>('.hero-team')];
    const cards = [...cardsWrap.querySelectorAll<HTMLElement>('.hero-card')];
    const applySolo = () => {
      const m = location.hash.match(/^#tzevet-([a-z]+)$/);
      const solo = m ? document.getElementById(`tzevet-${m[1]}`) : null;
      if (location.hash.startsWith('#tzevet')) finish();
      cardsWrap.hidden = !solo;
      cards.forEach((c) => (c.hidden = c !== solo));
      lists.forEach((l) => (l.hidden = !!solo));
    };
    addEventListener('hashchange', applySolo);
    applySolo();
  }
</script>
