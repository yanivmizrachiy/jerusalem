---
/**
 * עמוד משאב קנוני: פירורי לחם, סביבת המשאב האחידה וניווט פדגוגי
 * קודם/הבא + חזרה לקטגוריה ולעמוד הראשי (5.3–5.4, 5.12).
 */
import Breadcrumbs from './Breadcrumbs.astro';
import ResourceFrame from './ResourceFrame.astro';
import type { CanonicalResource } from '../data/resources';

interface NavTarget {
  label: string;
  href: string;
}

interface Props {
  resource: CanonicalResource;
  prev?: NavTarget;
  next?: NavTarget;
}

const { resource, prev, next } = Astro.props;
---

<div class="container resource-page">
  <div class="page-top">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: resource.grade },
        { label: resource.domain },
        { label: resource.topic },
      ]}
    />
  </div>

  <header class="page-head" data-reveal>
    <p class="eyebrow">{resource.grade} · {resource.domain}</p>
    <h1>{resource.title}</h1>
    <p class="lede">{resource.short}</p>
  </header>

  <div data-reveal>
    <ResourceFrame
      id={resource.id}
      title={resource.title}
      sourceUrl={resource.url}
      audience="מורות ומורים"
      grade={resource.grade}
      domain={resource.domain}
      topic={resource.topic}
      purpose={resource.purpose}
      usage={resource.usage}
      accent={resource.accent}
    />
  </div>

  <nav class="pager" aria-label="ניווט בין נושאים">
    {
      prev ? (
        <a class="pager-link" href={prev.href}>
          <span class="pager-tag">הנושא הקודם</span>
          <span class="pager-title">{prev.label}</span>
        </a>
      ) : (
        <span class="pager-spacer" />
      )
    }
    <a class="btn btn-ghost" href="/chativat-beynayim/">חזרה לחטיבת ביניים</a>
    {
      next ? (
        <a class="pager-link pager-next" href={next.href}>
          <span class="pager-tag">הנושא הבא</span>
          <span class="pager-title">{next.label}</span>
        </a>
      ) : (
        <span class="pager-spacer" />
      )
    }
  </nav>
</div>

<style>
  .resource-page { padding-block: 1.6rem 0; }

  .page-top { margin-block-end: 1.6rem; }

  .page-head { max-width: 640px; margin-block-end: 2rem; }

  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(2rem, 5vw, 3rem);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--ink);
    padding: 0.7rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
    min-inline-size: 200px;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
  }

  .pager-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }

  .pager-next { text-align: start; }

  .pager-tag { font-size: 0.78rem; font-weight: 700; color: var(--gold-deep); }

  .pager-title { font-weight: 600; }

  .pager-spacer { min-inline-size: 200px; }

  @media (max-width: 720px) {
    .pager { flex-direction: column; align-items: stretch; }
    .pager-spacer { display: none; }
    .pager-link { min-inline-size: 0; }
  }
</style>
