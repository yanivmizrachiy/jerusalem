---
/**
 * הספר המדפדף של חטיבת הביניים (RULES 3.26, 3.29 — הוראות יניב 03/08/2026):
 * העמוד הראשי נקי עם שורות הכיתות בלבד; ברגע שמתחילים לעבוד על הספר הוא
 * משתלט על כל שטח המסך, עם כפתור זהב קבוע לחזרה לאתר; במסך רחב פריסה
 * כפולה תמיד. הדפדוף — עלה אחד רציף מעל השדרה בכיוון ספר עברי, מונע
 * פריים-אחר-פריים בלי תפר בין ההרמה לנחיתה, עם הצללת נייר על העלה וצל
 * מוטל נודד על העמודים הנייחים; גרירת דף אמיתית מאזורי השוליים משלימה או
 * מחזירה לפי מרחק ותנופה, ולחיצות מהירות מדפדפות ברצף. הדפים תופסים את
 * מרב שטח המסך — יחס עמוד גמיש בין A4 לאורך (210/297) ל־210/260 וסרגלים
 * מצומצמים בהשתלטות. מספור מודפס, לשוניות, מקלדת, מגע וקישור עומק.
 * חלוקה חכמה לעמודים (הוראת יניב 03/08/2026): כל שכבה נפתחת בשער-שכבה
 * אוורירי — תוכן עניינים של הפרקים — ואחריו עמודי פרקים בתקציב שורות;
 * אף עמוד אינו עמוס, והשערים והפרקים מזדווגים לכפולות בפריסה הרחבה.
 * הטמעה חכמה (3.29): preconnect למקורות, העמוד הפתוח נטען מיד, שכנים
 * מתחממים ברגעי סרק ועמוד שנטען נשאר חם; כל מה שלחיץ במקור לחיץ גם
 * בפנים — בלי שכבות מעל ההטמעה ובלי sandbox; רגישי תנועה — החלפה מיידית.
 */
import MafmarRange from './MafmarRange.astro';
import { choveret, type ChoveretChapter, type ChoveretGrade, type ChoveretItem } from '../data/choveret';

interface Props {
  /** מזהה העמוד הפותח: rashi / toc-z / it-z-maf-02 ... */
  initial?: string;
}

const { initial = 'rashi' } = Astro.props;

const kindLabel: Record<string, string> = {
  site: 'אתר חי',
  doc: 'מסמך',
  drive: 'קובץ',
  pdf: 'PDF',
  canva: 'מצגת',
  flip: 'חוברת דפדוף',
  maf: 'מתוך החוזר',
  link: 'קישור',
};

/**
 * חלוקה חכמה לעמודים (3.29, הוראת יניב 03/08/2026): שום שכבה אינה נדחסת
 * לעמוד אחד. כל שכבה נפתחת בשער-שכבה אווירירי (תוכן עניינים של הפרקים),
 * ואחריו עמודי פרקים בתקציב שורות — כותרת פרק = שורה, פריט = שורה, עד
 * CAP שורות לעמוד, כך שהעמוד לעולם אינו עמוס ואינו נגלל. פרקים נשארים
 * שלמים; פרק גדול מעמוד נפרס על כמה עמודים עם כותרת "המשך". החלוקה
 * נגזרת מהתוכן בכל build — אסורה חלוקה ידנית.
 */
interface ChapterSlice {
  chapter: ChoveretChapter;
  items: ChoveretItem[];
  cont: boolean;
}
const CAP = 10;
const paginateGrade = (g: ChoveretGrade): ChapterSlice[][] => {
  const out: ChapterSlice[][] = [];
  let page: ChapterSlice[] = [];
  let used = 0;
  const close = () => {
    if (page.length) out.push(page);
    page = [];
    used = 0;
  };
  for (const ch of g.chapters) {
    const w = 1 + ch.items.length;
    if (w <= CAP) {
      if (used + w > CAP) close();
      page.push({ chapter: ch, items: ch.items, cont: false });
      used += w;
    } else {
      let rest = ch.items;
      let first = true;
      while (rest.length) {
        if (used >= CAP - 2) close();
        const take = Math.min(rest.length, CAP - used - 1);
        page.push({ chapter: ch, items: rest.slice(0, take), cont: !first });
        used += 1 + take;
        rest = rest.slice(take);
        first = false;
      }
    }
  }
  close();
  return out;
};

interface PageDef {
  id: string;
  label: string;
}
const pages: PageDef[] = [{ id: 'rashi', label: 'ראשי' }];
const gradeToc = new Map(choveret.map((g): [string, ChapterSlice[][]] => [g.slug, paginateGrade(g)]));
for (const g of choveret) {
  pages.push({ id: `toc-${g.slug}`, label: `שער — ${g.letter}` });
  gradeToc.get(g.slug)!.forEach((_, i) => pages.push({ id: `toc-${g.slug}-${i + 2}`, label: `תוכן — ${g.letter}` }));
  for (const ch of g.chapters)
    for (const it of ch.items)
      if (!it.pageHref) pages.push({ id: `it-${g.slug}-${it.id}`, label: it.title });
}
const total = pages.length;
const pageNum = (id: string) => pages.findIndex((p) => p.id === id) + 1;
/** העמוד שבו נפתח כל פרק — יעד הקפיצה מתוכן העניינים שבשער השכבה */
const chapterPage = (slug: string, chId: string) =>
  `toc-${slug}-${gradeToc.get(slug)!.findIndex((pg) => pg.some((s) => s.chapter.id === chId)) + 2}`;
/** טווח העמודים המלא של השכבה — לשורת הסיכום שבשער השכבה */
const gradeSpan = (slug: string) => {
  const mine = pages.flatMap((p, i) =>
    p.id === `toc-${slug}` || p.id.startsWith(`toc-${slug}-`) || p.id.startsWith(`it-${slug}-`) ? [i + 1] : []
  );
  return { from: mine[0], to: mine[mine.length - 1] };
};

const site = 'https://jerusalem-virid.vercel.app';

// חיבור-מראש לכל מקורות ההטמעה החיצוניים — העמוד הראשון של כל משאב נפתח מהר (3.29)
const embedOrigins = [
  ...new Set(
    choveret
      .flatMap((g) => g.chapters.flatMap((ch) => ch.items))
      .map((it) => it.embed ?? '')
      .filter((u) => u.startsWith('https://'))
      .map((u) => new URL(u).origin)
  ),
];
---

<div class="book-shell" data-book data-initial={initial} data-total={total}>
  {embedOrigins.map((o) => <link rel="preconnect" href={o} />)}
  <!-- פס עליון קבוע: חזרה לאתר, לשוניות קפיצה, מתג תצוגה ומסך מלא -->
  <div class="book-bar">
    <a class="book-exit" href="/" data-exit>
      <span class="book-exit-ico" aria-hidden="true">→</span>
      חזרה לאתר
    </a>
    <div class="book-tabs" role="group" aria-label="קפיצה מהירה">
      <button class="btab" type="button" data-jump="rashi">ראשי</button>
      {
        choveret.map((g) => (
          <button class="btab" type="button" data-jump={`toc-${g.slug}`}>
            {g.letter}
          </button>
        ))
      }
    </div>
    <div class="book-tools">
      <button class="bfs" type="button" data-fullscreen aria-label="מסך מלא">⛶</button>
    </div>
  </div>

  <div class="book-stage">
    <div class="book" role="region" aria-roledescription="חוברת" aria-label="מתמטיקה לחטיבת הביניים — ספר מדפדף">
      <button class="book-edge book-edge-next" type="button" data-dir="next" tabindex="-1" aria-hidden="true"><span>‹</span></button>
      <button class="book-edge book-edge-prev" type="button" data-dir="prev" tabindex="-1" aria-hidden="true"><span>›</span></button>
      <div class="book-spine" aria-hidden="true"></div>

      <!-- העמוד הראשי — נקי, עם קווים דקים ושורות הכיתות בלבד (3.29) -->
      <section class="bpage bp-rashi" data-page="rashi" data-n="1" hidden>
        <div class="rashi-inner">
          <h2 class="rashi-title">מתמטיקה לחטיבת הביניים</h2>
          <div class="rashi-rows">
            {
              choveret.map((g) => (
                <button
                  class="rashi-row"
                  type="button"
                  data-jump={`toc-${g.slug}`}
                  style={`--g-color:${g.color}; --g-dark:${g.dark}`}
                >
                  <span class:list={['rashi-letter', { 'is-wide': g.slug === 'klali' }]}>{g.letter}</span>
                  <span class="rashi-text">
                    <span class="rashi-name">{g.slug === 'klali' ? 'משותף לכל השכבות' : `כיתה ${g.letter}`}</span>
                    <span class="rashi-count">
                      <b class="rashi-count-num">{g.chapters.reduce((n, c) => n + c.items.length, 0)}</b>
                      קבצים, קישורים ופעילויות
                    </span>
                  </span>
                  <span class="rashi-dots" aria-hidden="true"></span>
                  <span class="rashi-pnum">עמוד {pageNum(`toc-${g.slug}`)}</span>
                </button>
              ))
            }
          </div>
        </div>
      </section>

      {
        choveret.map((g) => (
          <>
            <!-- שער השכבה — עמוד פתיחה אוורירי: תוכן עניינים של הפרקים בלבד (3.29) -->
            <section
              class="bpage bp-shaar"
              data-page={`toc-${g.slug}`}
              data-n={pageNum(`toc-${g.slug}`)}
              style={`--g-color:${g.color}; --g-dark:${g.dark}`}
              hidden
            >
              <div class="shaar-inner">
                <span class:list={['shaar-letter', { 'is-wide': g.slug === 'klali' }]}>{g.letter}</span>
                <h2 class="shaar-title">{g.title}</h2>
                <p class="shaar-intro">{g.intro}</p>
                <p class="shaar-label">תוכן העניינים</p>
                <div class="shaar-rows">
                  {g.chapters.map((ch) => (
                    <button
                      class="shaar-row"
                      type="button"
                      data-jump={chapterPage(g.slug, ch.id)}
                      style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}
                    >
                      <span class="shaar-chip" aria-hidden="true"></span>
                      <span class="shaar-name">{ch.title}</span>
                      <span class="shaar-dots" aria-hidden="true"></span>
                      <span class="shaar-pnum">עמוד {pageNum(chapterPage(g.slug, ch.id))}</span>
                    </button>
                  ))}
                </div>
                <p class="shaar-meta">
                  <b>{g.chapters.reduce((n, c) => n + c.items.length, 0)}</b> קבצים, קישורים ופעילויות ·
                  עמודים {gradeSpan(g.slug).from}–{gradeSpan(g.slug).to}
                </p>
              </div>
            </section>

            <!-- עמודי הפרקים — מנה נוחה לעמוד, כמו בחוברת מודפסת (3.29) -->
            {gradeToc.get(g.slug)!.map((slices, pi) => (
              <section
                class="bpage bp-toc"
                data-page={`toc-${g.slug}-${pi + 2}`}
                data-n={pageNum(`toc-${g.slug}-${pi + 2}`)}
                style={`--g-color:${g.color}; --g-dark:${g.dark}`}
                hidden
              >
                <p class="toc-running">{g.title}</p>
                {slices.map((s) => (
                  <div class="toc-chapter" style={`--ch-color:${s.chapter.color}; --ch-dark:${s.chapter.dark}`}>
                    <h3 class="toc-chapter-title">
                      {s.chapter.title}
                      {s.cont && <span class="toc-cont"> · המשך</span>}
                    </h3>
                    <ol class="toc-list">
                      {s.items.map((item) => (
                        <li>
                          {item.pageHref ? (
                            <a class="toc-item" href={item.pageHref}>
                              <span class="toc-text">
                                <span class="toc-item-title">{item.title}</span>
                                {item.note && <span class="toc-item-note">{item.note}</span>}
                              </span>
                              <span class="toc-dots" aria-hidden="true"></span>
                              <span class="toc-pnum toc-ext" aria-label="נפתח בעמוד משלו">↗</span>
                            </a>
                          ) : (
                            <button class="toc-item" type="button" data-jump={`it-${g.slug}-${item.id}`}>
                              <span class="toc-text">
                                <span class="toc-item-title">{item.title}</span>
                                {item.note && <span class="toc-item-note">{item.note}</span>}
                              </span>
                              <span class="toc-dots" aria-hidden="true"></span>
                              <span class="toc-pnum">עמ׳ {pageNum(`it-${g.slug}-${item.id}`)}</span>
                            </button>
                          )}
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}
              </section>
            ))}

            {g.chapters.map((ch) =>
              ch.items
                .filter((it) => !it.pageHref)
                .map((item) => (
                  <section
                    class="bpage bp-item"
                    data-page={`it-${g.slug}-${item.id}`}
                    data-n={pageNum(`it-${g.slug}-${item.id}`)}
                    data-kind={item.kind}
                    style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}
                    hidden
                  >
                    <div class="item-grid">
                      <div class="item-embed">
                        {item.kind === 'maf' && item.maf ? (
                          <MafmarRange sectionId={item.maf} accent={ch.color} />
                        ) : item.embed ? (
                          <>
                            <div class="item-frame">
                              <iframe
                                data-esrc={item.embed}
                                data-eurl={item.url}
                                data-etitle={item.title}
                                title={`${item.title} — תצוגה חיה`}
                                allow="fullscreen; clipboard-write"
                              />
                            </div>
                            {item.kind === 'pdf' && (
                              <div class="item-frame item-open-card" data-pdf-fb hidden>
                                <p>בדפדפן הזה קובצי PDF נפתחים לצפייה מלאה במסך נפרד:</p>
                                <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                                  פתיחת {item.title} ↗
                                </a>
                              </div>
                            )}
                          </>
                        ) : (
                          <div class="item-frame item-open-card">
                            <p>המשאב הזה נפתח באתר המקור:</p>
                            <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                              פתיחת {item.title} ↗
                            </a>
                          </div>
                        )}
                      </div>
                      <aside class="item-info">
                        <p class="item-chapter">{ch.title} · {g.slug === 'klali' ? 'כללי' : `כיתה ${g.letter}`}</p>
                        <h2 class="item-title">{item.title}</h2>
                        {item.note && <p class="item-note">{item.note}</p>}
                        <p class="item-kind">{kindLabel[item.kind]}</p>
                        <div class="item-actions" role="group" aria-label="פעולות">
                          {item.download && (
                            <a class="btn btn-primary" href={item.download} target="_blank" rel="noopener" download>
                              הורדה ⬇
                            </a>
                          )}
                          <a
                            class="btn btn-whatsapp"
                            href={`https://wa.me/?text=${encodeURIComponent(`${item.title} — ${g.title} — ${site}/chativat-beynayim/reader/${g.slug}/${item.id}/`)}`}
                            target="_blank"
                            rel="noopener"
                            aria-label={`שיתוף ${item.title} ב־WhatsApp`}
                          >
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                          </a>
                          <a
                            class="btn btn-gmail"
                            href={`mailto:?subject=${encodeURIComponent(item.title)}&body=${encodeURIComponent(`${item.title} — ${site}/chativat-beynayim/reader/${g.slug}/${item.id}/`)}`}
                            aria-label={`שליחת ${item.title} בדוא״ל`}
                          >
                            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                              <path fill="#4285F4" d="M1.636 20.5h3.819V11.73L0 7.64v11.223c0 .904.732 1.636 1.636 1.636Z" />
                              <path fill="#34A853" d="M18.545 20.5h3.819c.904 0 1.636-.732 1.636-1.636V7.64l-5.455 4.09Z" />
                              <path fill="#FBBC04" d="M18.545 5.457v6.273L24 7.64V6.275c0-2.023-2.309-3.178-3.927-1.964Z" />
                              <path fill="#EA4335" d="M5.455 11.73V5.457L12 10.366l6.545-4.909v6.273L12 16.639Z" />
                              <path fill="#C5221F" d="M0 6.275v1.365l5.455 4.09V5.457L4.073 4.42C2.309 3.098 0 4.252 0 6.275Z" />
                            </svg>
                          </a>
                          <button class="btn btn-ghost" type="button" data-copy={item.url.startsWith('/') ? `${site}${item.url}` : item.url}>
                            העתקת קישור
                          </button>
                          <a
                            class="btn btn-ghost"
                            href={item.url}
                            target={item.url.startsWith('/') ? undefined : '_blank'}
                            rel="noopener"
                          >
                            פתיחה במקור ↗
                          </a>
                        </div>
                        <p class="item-status" data-status role="status" aria-live="polite"></p>
                      </aside>
                    </div>
                  </section>
                ))
            )}
          </>
        ))
      }
    </div>
  </div>

  <!-- סרגל הדפדוף -->
  <div class="book-nav" role="group" aria-label="דפדוף בספר">
    <button class="bnav bnav-prev" type="button">
      <span class="bnav-arrow" aria-hidden="true">→</span> דף קודם
    </button>
    <div class="book-meter">
      <span class="book-counter" data-counter aria-live="polite">עמוד 1 מתוך {total}</span>
      <span class="book-progress"><span class="book-progress-fill" data-progress></span></span>
    </div>
    <button class="bnav bnav-next" type="button">
      דף הבא <span class="bnav-arrow" aria-hidden="true">←</span>
    </button>
  </div>
</div>

<style is:global>
  /* בזמן ההשתלטות על המסך — האתר שמאחור לא נגלל ואין מסילת גלילה */
  html.book-lock,
  html.book-lock body {
    overflow: hidden;
    scrollbar-gutter: auto;
  }
</style>

<style>
  /* הספר פרוס לרוחב מלא מתוך המיכל (3.29) */
  .book-shell {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-block: 1.2rem 2rem;
    inline-size: min(100vw - clamp(0.8rem, 3vw, 3rem) * 2, 1680px);
    margin-inline: calc((100% - min(100vw - clamp(0.8rem, 3vw, 3rem) * 2, 1680px)) / 2);
  }

  /* השתלטות על כל שטח המסך (3.29): שכבה קבועה מעל כל האתר */
  .book-shell.is-full {
    position: fixed;
    inset: 0;
    z-index: 90;
    margin: 0;
    inline-size: auto;
    padding: clamp(0.35rem, 1.2vh, 0.7rem) clamp(0.5rem, 1.4vw, 1.1rem);
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-soft) 100%);
    gap: 0.55rem;
    overflow: hidden;
    overscroll-behavior: contain;
  }

  /* ===== הפס העליון ===== */
  .book-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* כפתור הזהב לחזרה לאתר — כפתור אחד קבוע, גלוי תמיד */
  .book-exit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 50px;
    padding: 0.55rem 1.35rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #f3d68b 0%, #d4af5c 100%);
    color: #3c2f12;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    box-shadow: 0 12px 26px -12px rgb(176 141 62 / 0.85);
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease);
  }

  .book-exit:hover { transform: translateY(-3px); color: #241b08; box-shadow: 0 16px 32px -12px rgb(176 141 62 / 0.95); }

  .book-exit-ico { font-size: 1.25em; line-height: 1; }

  .book-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-inline: auto;
  }

  .btab {
    min-block-size: 40px;
    min-inline-size: 46px;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
    font-weight: 800;
    cursor: pointer;
    transition: background-color 250ms var(--ease), color 250ms var(--ease);
  }

  .btab.is-current {
    background: linear-gradient(180deg, #16273f 0%, #0e1c31 100%);
    border-color: var(--gold);
    color: #f3d68b;
  }

  .book-tools { display: flex; align-items: center; gap: 0.6rem; }

  .bfs {
    flex: none;
    inline-size: 50px;
    block-size: 50px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--gold-deep);
    font-size: 1.3rem;
    cursor: pointer;
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease);
  }

  .bfs:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }

  /* בהשתלטות הסרגלים מצטמצמים — הדפים מקבלים את מרב הגובה (3.29) */
  .is-full .book-bar { gap: 0.55rem; }
  .is-full .book-exit { min-block-size: 44px; padding: 0.4rem 1.1rem; font-size: 0.95rem; }
  .is-full .btab { min-block-size: 34px; min-inline-size: 40px; padding: 0.15rem 0.7rem; font-size: 0.92rem; }
  .is-full .bfs { inline-size: 44px; block-size: 44px; font-size: 1.15rem; }
  .is-full .book-nav { gap: 0.7rem; }
  .is-full .bnav { min-block-size: 44px; padding: 0.45rem 1.15rem; font-size: 0.95rem; }
  .is-full .book-meter { gap: 0.2rem; }
  .is-full .book-counter { font-size: 0.8rem; }
  .is-full .book-progress { block-size: 5px; }

  /* ===== במת הספר — הדפים ממלאים את הגובה הפנוי ===== */
  .book-stage {
    position: relative;
    container-type: size;
    block-size: max(560px, calc(100dvh - var(--header-h) - 176px));
    display: grid;
    place-items: center;
  }

  .is-full .book-stage { flex: 1; min-block-size: 0; block-size: auto; }

  /* הדפים תופסים את מרב שטח המסך (3.29, הוראת יניב 03/08/2026): יחס
     העמוד גמיש בין A4 לאורך (210/297) לגבול מעט רחב יותר (210/260) —
     כשהבמה בתוך הטווח הספר ממלא אותה במלואה, ומעבר לו נצמד לגבול הקרוב.
     touch-action: גלילה אנכית חופשית — החלקה אופקית שמורה לדפדוף */
  .book { position: relative; perspective: 2200px; touch-action: pan-y pinch-zoom; }

  .mode-1 .book {
    block-size: min(100cqb, calc(100cqi * 297 / 210));
    inline-size: min(100cqi, calc(100cqb * 210 / 260));
  }

  /* פריסה כפולה ועמוד משאב רחב — אותן מידות ספר-פתוח, בלי קפיצות בדפדוף */
  .mode-2 .book,
  .book-shell.has-wide .book {
    block-size: min(100cqb, calc(100cqi * 297 / 420));
    inline-size: min(100cqi, calc(100cqb * 420 / 260));
  }

  /* אזורי דפדוף שקטים בשולי הדף — הקשה מדפדפת, גרירה אוחזת את העלה */
  .book-edge {
    position: absolute;
    inset-block: 0;
    inline-size: 34px;
    z-index: 4;
    border: 0;
    background: none;
    cursor: grab;
    touch-action: none;
    display: grid;
    place-items: center;
    color: transparent;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .book-edge:active { cursor: grabbing; }

  .book-edge-next { left: 0; border-radius: 18px 0 0 18px; }
  .book-edge-prev { right: 0; border-radius: 0 18px 18px 0; }

  /* בעמוד משאב שום שכבה של החוברת לא יושבת מעל ההטמעה — הקישורים
     שבפנים לחיצים תמיד, עד הפיקסל האחרון (3.29). ההטמעה היא החצי הימני,
     ולכן רק אזור הקצה הימני כבוי; הקצה השמאלי (מעל חצי המידע) ממשיך
     לדפדף ולגרור */
  .book-shell.on-embed .book-edge-prev { display: none; }

  .book-edge:hover {
    color: var(--gold-deep);
    background: linear-gradient(90deg, rgb(212 175 92 / 0.18), transparent);
  }

  .book-edge-prev:hover { background: linear-gradient(270deg, rgb(212 175 92 / 0.18), transparent); }

  /* השדרה באמצע הספר הפתוח */
  .book-spine { display: none; }

  /* השער: דף יחיד ענק לאורך — בלי שדרה, בלי ערימת דפים, בלי מראה של ספר פתוח
     (3.29, הוראת יניב 03/08/2026) */
  .book-shell.on-rashi .book-spine,
  .book-shell.on-rashi .book::before,
  .book-shell.on-rashi .book::after {
    display: none !important;
  }

  .book-shell.on-rashi .book {
    aspect-ratio: 210 / 280;
    inline-size: auto;
    max-inline-size: min(96vw, 100%);
    margin-inline: auto;
  }

  .book-shell.on-rashi .bpage {
    border-radius: 18px;
    box-shadow: 0 26px 60px -28px rgb(31 41 61 / 0.45);
  }

  .mode-2 .book-spine,
  .book-shell.has-wide .book-spine {
    display: block;
    position: absolute;
    inset-block: 0;
    left: calc(50% - 28px);
    inline-size: 56px;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(31 25 12 / 0.1) 38%,
      rgb(31 25 12 / 0.2) 50%,
      rgb(31 25 12 / 0.1) 62%,
      transparent
    );
  }

  /* מספור מודפס בצד הימני ובצד השמאלי (3.29) — נגזר אוטומטית מתוכן הספר */
  .book :global(.bp-num) {
    position: absolute;
    inset-block-end: 10px;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-faint);
    pointer-events: none;
  }

  .book :global(.bp-num-l) { left: 18px; }
  .book :global(.bp-num-r) { right: 18px; }
  .bpage :global(.bp-num-r) { display: none; }
  .mode-2 .bpage.pg-right :global(.bp-num-r) { display: block; }
  .mode-2 .bpage.pg-right :global(.bp-num-l) { display: none; }
  .bpage.pg-wide :global(.bp-num-r) { display: block; }

  .bpage {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: linear-gradient(180deg, #fffdf9 0%, #fbf7ee 100%);
    border: 1px solid var(--line);
    border-radius: 18px 6px 6px 18px;
    box-shadow:
      -1px 0 0 #e7ddc8,
      -3px 0 0 #f2ead8,
      -5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    padding: clamp(1rem, 2.2vw, 1.7rem);
    transform-origin: 100% 50%; /* השדרה מימין — ספר עברי */
    backface-visibility: hidden;
  }

  .bpage[hidden] { display: none; }

  /* פריסה כפולה: העמוד הימני והשמאלי משני צידי השדרה */
  .mode-2 .bpage.pg-right {
    inset: 0 0 0 50%;
    border-radius: 4px 18px 18px 4px;
    box-shadow:
      1px 0 0 #e7ddc8,
      3px 0 0 #f2ead8,
      5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    transform-origin: 0% 50%; /* השדרה בקצה השמאלי של העמוד הימני */
  }

  .mode-2 .bpage.pg-left {
    inset: 0 50% 0 0;
    border-radius: 18px 4px 4px 18px;
    box-shadow:
      -1px 0 0 #e7ddc8,
      -3px 0 0 #f2ead8,
      -5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    transform-origin: 100% 50%; /* השדרה בקצה הימני של העמוד השמאלי */
  }

  /* עמוד משאב: נפרס על כל רוחב הספר — המסך נחלק ימין/שמאל (3.29) */
  .bpage.pg-wide {
    inset: 0;
    border-radius: 18px;
    box-shadow:
      -1px 0 0 #e7ddc8,
      -3px 0 0 #f2ead8,
      -5px 0 0 #e7ddc8,
      1px 0 0 #e7ddc8,
      3px 0 0 #f2ead8,
      5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    transform-origin: 100% 50%;
  }

  .bpage.pg-wide .item-grid { column-gap: 56px; }

  /* עמוד חלק מול עמוד בודד — כמו בספר אמיתי */
  .mode-2 .book::before,
  .mode-2 .book::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inline-size: 50%;
    z-index: 0;
    background: linear-gradient(180deg, #fdfaf3 0%, #f7f1e3 100%);
    border: 1px solid var(--line);
  }

  .mode-2 .book::before { left: 0; border-radius: 18px 4px 4px 18px; }
  .mode-2 .book::after { right: 0; border-radius: 4px 18px 18px 4px; }

  /* הצללת הנייר על העלה המתהפך — המנוע קובע עומק (--shade) וכיוון
     (--shade-dir: הצד הכהה פונה לשדרה) פריים-אחר-פריים */
  .bpage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--shade, 0);
    background: linear-gradient(
      var(--shade-dir, 270deg),
      rgb(31 25 12 / 0.5),
      rgb(31 25 12 / 0.12) 55%,
      transparent 85%
    );
  }

  /* הצל שהעלה מטיל על העמודים הנייחים — מתעבה לקראת האנך ונמוג בנחיתה */
  .book :global(.book-cast) {
    position: absolute;
    inset-block: 0;
    inline-size: 50%;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
  }

  .book :global(.book-cast-l) {
    left: 0;
    background: linear-gradient(270deg, rgb(28 22 10 / 0.5), rgb(28 22 10 / 0.1) 60%, transparent 88%);
  }

  .book :global(.book-cast-r) {
    right: 0;
    background: linear-gradient(90deg, rgb(28 22 10 / 0.5), rgb(28 22 10 / 0.1) 60%, transparent 88%);
  }

  /* עלה חלק — כשמול דף בודד אין בן-זוג, מתהפך עמוד ריק כמו בספר אמיתי */
  .book :global(.bleaf) {
    position: absolute;
    inset: 0 50% 0 0;
    z-index: 1;
    background: linear-gradient(180deg, #fdfaf3 0%, #f7f1e3 100%);
    border: 1px solid var(--line);
    border-radius: 18px 4px 4px 18px;
    transform-origin: 100% 50%;
    backface-visibility: hidden;
  }

  .book :global(.bleaf[hidden]) { display: none; }

  .book :global(.bleaf)::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--shade, 0);
    background: linear-gradient(
      var(--shade-dir, 270deg),
      rgb(31 25 12 / 0.5),
      rgb(31 25 12 / 0.12) 55%,
      transparent 85%
    );
  }

  /* מסך צר: מעבר עמעום עדין בין עמודים — בלי ערימת דפים בזרימה */
  .bpage.fade-out { animation: bk-fade-out 150ms var(--ease) forwards; }
  .bpage.fade-in { animation: bk-fade-in 300ms var(--ease) backwards; }

  @keyframes bk-fade-out { to { opacity: 0; } }
  @keyframes bk-fade-in { from { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .bpage.fade-out,
    .bpage.fade-in {
      animation: none;
    }
  }

  /* ===== העמוד הראשי — מודרני, נקי, קווים דקים לכל האורך (3.29) ===== */
  .bp-rashi { display: grid; place-items: center; }

  .bp-rashi::before {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid rgb(176 141 62 / 0.38);
    border-radius: 12px;
    pointer-events: none;
  }

  .rashi-inner {
    inline-size: 100%;
    max-inline-size: 520px;
    padding-inline: clamp(0.4rem, 2cqi, 1.4rem);
  }

  .rashi-title {
    margin: 0 0 1.6rem;
    text-align: center;
    font-size: clamp(1.5rem, 6.5cqi, 2.5rem);
    color: var(--ink);
  }

  .rashi-title::after {
    content: '';
    display: block;
    inline-size: 100%;
    block-size: 2px;
    margin-block-start: 1rem;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .rashi-rows { border-block-end: 1px solid var(--line); }

  .rashi-row {
    inline-size: 100%;
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2.4cqi, 1.1rem);
    padding: clamp(0.7rem, 2.2cqb, 1.1rem) 0.4rem;
    border: 0;
    border-block-start: 1px solid var(--line);
    background: none;
    color: var(--ink);
    text-align: start;
    font: inherit;
    cursor: pointer;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .rashi-row:hover {
    background: color-mix(in srgb, var(--g-color, var(--gold)) 9%, #fff);
    transform: translateX(-4px);
  }

  .rashi-letter {
    flex: none;
    min-inline-size: 3.1em;
    block-size: 3.1em;
    display: grid;
    place-items: center;
    padding-inline: 0.45em;
    border: 2px solid var(--g-color, var(--gold));
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 3.4cqi, 1.45rem);
    font-weight: 700;
    color: var(--g-dark, var(--gold-deep));
    line-height: 1;
    background: color-mix(in srgb, var(--g-color, var(--gold)) 8%, #fff);
  }

  .rashi-letter.is-wide { font-size: clamp(0.85rem, 2.6cqi, 1.05rem); }

  .rashi-text { display: flex; flex-direction: column; gap: 0.15rem; min-inline-size: 0; }

  .rashi-name { font-weight: 800; font-size: clamp(1.02rem, 3cqi, 1.25rem); }

  .rashi-count {
    font-size: clamp(0.78rem, 2.2cqi, 0.9rem);
    color: var(--ink-soft);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }

  /* מספר הקבצים — גופן תלת-ממד ברור ובולט (3.29, הוראת יניב 03/08/2026) */
  .rashi-count-num {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4cqi, 1.8rem);
    font-weight: 800;
    line-height: 1;
    color: var(--g-color, var(--gold));
    text-shadow:
      1px 1px 0 var(--g-dark, var(--gold-deep)),
      2px 2px 0 var(--g-dark, var(--gold-deep)),
      3px 3px 0 color-mix(in srgb, var(--g-dark, var(--gold-deep)) 55%, transparent),
      4px 5px 8px rgb(31 25 12 / 0.35);
  }

  /* מוביל נקודות עד מספר העמוד — כמו בתוכן עניינים של חוברת אמיתית */
  .rashi-dots {
    flex: 1;
    min-inline-size: 24px;
    border-block-end: 2px dotted color-mix(in srgb, var(--g-color, var(--gold)) 55%, transparent);
    margin-inline: 0.5rem;
    transform: translateY(-0.35em);
  }

  .rashi-pnum {
    flex: none;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 2.4cqi, 1rem);
    font-weight: 700;
    color: var(--g-dark, var(--gold-deep));
    font-variant-numeric: tabular-nums;
  }


  /* ===== שער השכבה — עמוד פתיחה אוורירי עם תוכן עניינים של הפרקים (3.29) ===== */
  .bp-shaar { display: grid; }

  .bp-shaar::before {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px solid color-mix(in srgb, var(--g-color) 45%, transparent);
    border-radius: 12px;
    pointer-events: none;
  }

  .shaar-inner {
    margin: auto;
    inline-size: 100%;
    max-inline-size: 480px;
    padding-inline: clamp(0.5rem, 2cqi, 1.3rem);
    text-align: center;
  }

  .shaar-letter {
    display: inline-grid;
    place-items: center;
    min-inline-size: 2.3em;
    block-size: 2.3em;
    padding-inline: 0.4em;
    margin-block-end: 0.85rem;
    border: 2.5px solid var(--g-color);
    border-radius: 16px;
    background: color-mix(in srgb, var(--g-color) 9%, #fff);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.6cqi, 2.1rem);
    font-weight: 800;
    line-height: 1;
    color: var(--g-dark);
  }

  .shaar-letter.is-wide { font-size: clamp(1rem, 3cqi, 1.35rem); }

  .shaar-title { margin: 0 0 0.5rem; font-size: clamp(1.4rem, 5cqi, 2rem); }

  .shaar-intro {
    margin: 0 auto 1.4rem;
    max-inline-size: 42ch;
    color: var(--ink-soft);
    font-size: clamp(0.86rem, 2.3cqi, 0.98rem);
    line-height: 1.6;
  }

  .shaar-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.15rem;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 2.6cqi, 1.1rem);
    font-weight: 700;
    color: var(--g-dark);
  }

  .shaar-label::before,
  .shaar-label::after {
    content: '';
    flex: 1;
    block-size: 2px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--g-color) 55%, transparent), transparent);
  }

  .shaar-rows { text-align: start; }

  .shaar-row {
    inline-size: 100%;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-block-size: 52px;
    padding: 0.55rem 0.4rem;
    border: 0;
    border-block-end: 1px solid var(--line);
    background: none;
    color: var(--ink);
    text-align: start;
    font: inherit;
    cursor: pointer;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .shaar-row:hover {
    background: color-mix(in srgb, var(--ch-color) 8%, #fff);
    transform: translateX(-4px);
  }

  .shaar-chip {
    flex: none;
    inline-size: 15px;
    block-size: 15px;
    border-radius: 5px;
    background: var(--ch-color);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
  }

  .shaar-name { font-weight: 700; font-size: clamp(0.95rem, 2.6cqi, 1.08rem); }

  .shaar-dots {
    flex: 1;
    min-inline-size: 24px;
    border-block-end: 2px dotted color-mix(in srgb, var(--ch-color) 55%, transparent);
    margin-inline: 0.45rem;
    transform: translateY(-0.3em);
  }

  .shaar-pnum {
    flex: none;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 2.3cqi, 0.98rem);
    font-weight: 700;
    color: var(--ch-dark);
    font-variant-numeric: tabular-nums;
  }

  .shaar-meta {
    margin: 1.1rem 0 0;
    font-size: clamp(0.78rem, 2.1cqi, 0.88rem);
    color: var(--ink-soft);
  }

  .shaar-meta b {
    font-family: var(--font-display);
    font-size: 1.3em;
    color: var(--g-dark);
  }

  /* ===== עמודי הפרקים — תוכן עניינים במנות נוחות (3.29) ===== */

  /* כותרת רצה בראש העמוד, כמו בספר מודפס */
  .toc-running {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--g-dark);
  }

  .toc-running::after {
    content: '';
    flex: 1;
    block-size: 1.5px;
    background: linear-gradient(to left, color-mix(in srgb, var(--g-color) 50%, transparent), transparent);
  }

  .toc-chapter {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1.5px solid color-mix(in srgb, var(--ch-color) 45%, #fff);
    box-shadow: 0 14px 34px -22px color-mix(in srgb, var(--ch-color) 55%, transparent);
    background: #fff;
    margin-block-end: 0.85rem;
  }

  .toc-chapter:last-child { margin-block-end: 0; }

  .toc-chapter-title {
    margin: 0;
    padding: 0.5rem 1rem;
    background: linear-gradient(120deg, var(--ch-color), color-mix(in srgb, var(--ch-color) 72%, #000));
    color: #fff;
    font-size: clamp(1.05rem, 2.1vw, 1.25rem);
  }

  .toc-cont { font-weight: 400; font-size: 0.78em; opacity: 0.9; }

  .toc-list { list-style: none; margin: 0; padding: 0.3rem 0.4rem 0.35rem; }

  .toc-item {
    inline-size: 100%;
    text-align: start;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.55rem;
    border: 0;
    background: none;
    border-radius: calc(var(--radius) - 4px);
    color: var(--ink);
    min-block-size: 46px;
    cursor: pointer;
    font: inherit;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .toc-item:hover {
    background: color-mix(in srgb, var(--ch-color) 8%, #fff);
    transform: translateX(-4px);
  }

  .toc-text { display: flex; flex-direction: column; gap: 0.1rem; min-inline-size: 0; }
  .toc-item-title { font-weight: 700; font-size: clamp(0.9rem, 2.3cqi, 1rem); line-height: 1.3; }
  .toc-item-note { font-size: clamp(0.74rem, 2cqi, 0.82rem); color: var(--ink-soft); line-height: 1.35; }

  /* מוביל נקודות עד מספר העמוד — שורת תוכן-עניינים אמיתית */
  .toc-dots {
    flex: 1;
    min-inline-size: 20px;
    border-block-end: 2px dotted color-mix(in srgb, var(--ch-color) 50%, transparent);
    margin-inline: 0.35rem;
    transform: translateY(-0.3em);
  }

  .toc-pnum {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ch-dark);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* פריט שנפתח מחוץ לחוברת — ↗ במקום מספר עמוד */
  .toc-ext { font-size: 1.05rem; }

  /* ===== עמוד משאב ===== */
  .bp-item {
    border-block-start: 6px solid var(--ch-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .bp-item .item-grid { flex: 1; }

  /* חצייה מדויקת חצי-חצי: חצי ימין — הטמעה, חצי שמאל — מידע (3.29, 8.2) */
  .item-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(0.8rem, 2vw, 1.4rem);
    block-size: 100%;
  }

  .item-embed { min-block-size: 0; display: flex; flex-direction: column; }

  .item-info { min-block-size: 0; overflow-y: auto; }

  .item-frame {
    position: relative;
    padding: 10px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgb(250 246 236 / 0.95) 0%, rgb(240 233 216 / 0.78) 45%, rgb(252 249 242 / 0.92) 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      inset 0 0 0 2px rgb(176 141 62 / 0.4),
      0 18px 44px -22px rgb(31 41 61 / 0.4);
    flex: 1;
    min-block-size: 0;
  }

  .item-frame iframe {
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    display: block;
    border-radius: 14px;
    background: #fff;
  }

  .item-open-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    block-size: auto;
    min-block-size: 240px;
  }

  .item-open-card p { margin: 0; font-weight: 600; color: var(--ink-soft); }

  .item-chapter { margin: 0 0 0.3rem; font-size: 0.8rem; font-weight: 800; color: var(--ch-dark); }
  .item-title { margin: 0 0 0.4rem; font-size: clamp(1.2rem, 2.4vw, 1.5rem); }
  .item-note { margin: 0 0 0.6rem; color: var(--ink-soft); line-height: 1.55; }

  .item-kind {
    display: inline-block;
    margin: 0 0 0.9rem;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    border: 1.5px solid var(--ch-dark);
    color: var(--ch-dark);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .item-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

  .item-status { min-block-size: 1.2em; margin: 0.45rem 0 0; font-size: 0.86rem; font-weight: 600; color: var(--olive); }

  /* ===== סרגל הדפדוף ===== */
  .book-nav {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .bnav {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 54px;
    padding: 0.7rem 1.4rem;
    border: 0;
    border-radius: 999px;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease), opacity 200ms var(--ease);
  }

  .bnav[disabled] { opacity: 0.4; cursor: not-allowed; }

  .bnav-prev {
    background: linear-gradient(180deg, #8e2740 0%, #7a1f33 100%);
    box-shadow: 0 8px 20px -10px rgb(122 31 51 / 0.7);
  }

  .bnav-next {
    background: linear-gradient(180deg, #0f6b3a 0%, #0b5d31 100%);
    box-shadow: 0 8px 20px -10px rgb(11 93 49 / 0.7);
  }

  .bnav:not([disabled]):hover { transform: translateY(-3px); }

  .bnav-arrow { font-size: 1.2em; }

  .book-meter {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    min-inline-size: 0;
  }

  .book-counter { font-weight: 800; font-size: 0.92rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }

  .book-progress {
    inline-size: min(100%, 340px);
    block-size: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--gold) 22%, #fff);
    overflow: hidden;
  }

  .book-progress-fill {
    display: block;
    block-size: 100%;
    inline-size: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--gold-deep), var(--gold));
    transition: inline-size 400ms var(--ease);
  }

  /* נייד: עמוד אחד, זרימה טבעית, סרגלים נגישים לאגודל */
  @media (max-width: 880px) {
    .book-stage { container-type: normal; block-size: auto; display: block; }
    .mode-1 .book,
    .mode-2 .book,
    .book-shell.has-wide .book { block-size: auto; aspect-ratio: auto; min-block-size: 62vh; }
    .bpage { position: relative; inset: auto; }
    .bp-rashi { min-block-size: 62vh; }
    .book-edge { display: none; }
    .bp-item { display: block; overflow-y: auto; }
    /* בנייד הדף זורם טבעי — ההטמעה תחילה (8.6) ומקבלת את מרב השטח:
       שוליים מצומצמים וגובה יציב (svh — לא קופץ עם סרגל הדפדפן) */
    .bpage { padding: 0.9rem 0.7rem; }
    .item-grid { grid-template-columns: 1fr; block-size: auto; }
    .item-frame { flex: none; padding: 6px; border-radius: 16px; block-size: clamp(480px, 68svh, 820px); }
    .item-frame iframe { border-radius: 11px; }
    .book-nav { flex-wrap: wrap; justify-content: center; }
    .bnav { flex: 1; justify-content: center; min-inline-size: 140px; }
    .book-meter { order: 3; inline-size: 100%; }
    .book-shell.is-full { overflow: auto; }
    .is-full .book-stage { flex: none; }
    .is-full .book-bar {
      position: sticky;
      inset-block-start: 0;
      z-index: 7;
      background: var(--paper);
      padding-block: 0.4rem;
    }
    .is-full .book-nav {
      position: sticky;
      inset-block-end: 0;
      z-index: 7;
      background: var(--paper);
      padding-block: 0.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-book]').forEach((shell) => {
    const pages = [...shell.querySelectorAll<HTMLElement>('.bpage')];
    const ids = pages.map((p) => p.dataset.page!);
    const total = pages.length;
    const navPrev = shell.querySelector<HTMLButtonElement>('.bnav-prev')!;
    const navNext = shell.querySelector<HTMLButtonElement>('.bnav-next')!;
    const counter = shell.querySelector<HTMLElement>('[data-counter]')!;
    const progress = shell.querySelector<HTMLElement>('[data-progress]')!;
    const tabs = [...shell.querySelectorAll<HTMLButtonElement>('.btab')];
    const exitBtn = shell.querySelector<HTMLAnchorElement>('[data-exit]')!;
    const fsBtn = shell.querySelector<HTMLButtonElement>('[data-fullscreen]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = matchMedia('(max-width: 880px)');

    let cur = -1;
    let busy = false;
    let engaged = false;
    let savedY = 0;
    let mode: 1 | 2 = 2;

    // תמיד תצוגה מקסימלית: שני עמודים במסך רחב, עמוד אחד במסך צר (3.29)
    const prefMode = (): 1 | 2 => (narrow.matches ? 1 : 2);

    // מספור מודפס בצד הימני ובצד השמאלי — נגזר מהתוכן; העמוד הראשי בלי מספר
    pages.forEach((p) => {
      if (p.dataset.page === 'rashi') return;
      for (const side of ['bp-num-l', 'bp-num-r']) {
        const n = document.createElement('span');
        n.className = `bp-num ${side}`;
        n.textContent = `עמוד ${p.dataset.n}`;
        p.appendChild(n);
      }
    });

    // ההטמעה נטענת רק כשהעמוד נפתח, ועמוד שנטען נשאר חם (3.29).
    // דפדפן בלי מציג PDF מובנה (בעיקר אנדרואיד) — כרטיס פתיחה אמיתי
    // במקום מסגרת ריקה (8.8)
    const noPdfViewer = 'pdfViewerEnabled' in navigator && !navigator.pdfViewerEnabled;
    const mount = (p: HTMLElement) => {
      if (noPdfViewer && p.dataset.kind === 'pdf') {
        const fb = p.querySelector<HTMLElement>('[data-pdf-fb]');
        const frame = p.querySelector<HTMLElement>('iframe[data-esrc]')?.closest<HTMLElement>('.item-frame');
        if (fb && frame) {
          frame.hidden = true;
          fb.hidden = false;
        }
        return;
      }
      p.querySelectorAll<HTMLIFrameElement>('iframe[data-esrc]').forEach((f) => {
        const esrc = f.dataset.esrc!;
        // הטמעות הפרוקסי המחוזי הן same-origin: דף אמיתי נושא את חותם המשמר
        // (window.__EM_PROXY__ מ-proxyGuard.ts). דף בלי חותם הוא דף שגיאה —
        // סביבה סטטית בלי פונקציות (שרת הבדיקות בפורט 4321) או כשל במקור —
        // ובמקומו מוצג כרטיס פתיחה אמיתי, לא 404 חשוף בתוך מסגרת (8.8).
        if (esrc.startsWith('/api/')) {
          f.addEventListener('load', () => {
            let dead = false;
            try {
              const w = f.contentWindow as (Window & { __EM_PROXY__?: 1 }) | null;
              dead =
                !!w &&
                w.location.href !== 'about:blank' &&
                w.location.origin === location.origin &&
                !w.__EM_PROXY__;
            } catch {
              /* חוצה-מקור — האפליקציה ניווטה למקור אחר; אין שיפוט */
            }
            if (!dead) return;
            const frame = f.closest<HTMLElement>('.item-frame');
            if (!frame || frame.dataset.fb) return;
            frame.dataset.fb = '1';
            frame.classList.add('item-open-card');
            const msg = document.createElement('p');
            msg.textContent = 'התצוגה החיה אינה זמינה כאן כרגע — האתר נפתח בחלון חדש:';
            const open = document.createElement('a');
            open.className = 'btn btn-primary';
            open.href = f.dataset.eurl ?? '#';
            open.target = '_blank';
            open.rel = 'noopener';
            open.textContent = `פתיחת ${f.dataset.etitle ?? 'האתר'} ↗`;
            frame.replaceChildren(msg, open);
          });
        }
        f.src = esrc;
        f.removeAttribute('data-esrc');
      });
    };

    // הטמעה חכמה: אחרי שהעמוד הפתוח נטען, העמודים השכנים מתחממים בשקט
    // ברגעי סרק — הדפדוף הבא מציג הטמעה שכבר חיה. רשת חסכונית לא מחוממת.
    const conn = (navigator as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const idle: (cb: () => void) => void =
      'requestIdleCallback' in window ? (cb) => requestIdleCallback(cb, { timeout: 2500 }) : (cb) => setTimeout(cb, 600);
    let warmTimer = 0;
    const warmNeighbors = () => {
      clearTimeout(warmTimer);
      if (conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
      warmTimer = window.setTimeout(
        () =>
          idle(() => {
            const around =
              mode === 1
                ? [cur + 1, cur - 1]
                : [...(views2[view2Of[cur] + 1] ?? []), ...(views2[view2Of[cur] - 1] ?? [])];
            for (const k of around) if (k >= 0 && k < total) mount(pages[k]);
          }),
        900
      );
    };

    const ANIM = ['pg-left', 'pg-right', 'pg-wide', 'fade-out', 'fade-in'];

    // תצוגת שני עמודים (3.29): עמוד משאב נפרס על שני חצאי המסך — ההטמעה
    // מימין והמידע משמאל; עמודי שער ותוכן סמוכים מזדווגים, ועמוד בודד
    // נפתח מימין מול עמוד חלק
    const isItem = (k: number) => ids[k].startsWith('it-');
    const views2: number[][] = [];
    {
      let k = 0;
      while (k < total) {
        // עמוד השער תמיד לבדו — נפתח כעמוד יחיד רחב (הוראת יניב, 03/08/2026)
        if (k !== 0 && !isItem(k) && k + 1 < total && !isItem(k + 1)) {
          views2.push([k, k + 1]);
          k += 2;
        } else {
          views2.push([k]);
          k += 1;
        }
      }
    }
    const view2Of: number[] = [];
    views2.forEach((v, vi) => v.forEach((k) => (view2Of[k] = vi)));

    const visOf = (i: number): number[] => (mode === 1 ? [i] : views2[view2Of[i]]);

    const paint = () => {
      const vis = visOf(cur);
      const lo = vis[0] + 1;
      const hi = vis[vis.length - 1] + 1;
      counter.textContent = vis.length > 1 ? `עמודים ${lo}–${hi} מתוך ${total}` : `עמוד ${lo} מתוך ${total}`;
      progress.style.inlineSize = `${(hi / total) * 100}%`;
      navPrev.disabled = lo <= 1;
      navNext.disabled = hi >= total;
      const visIds = vis.map((k) => ids[k]);
      tabs.forEach((t) => {
        const j = t.dataset.jump!;
        // הלשונית דולקת על שער השכבה, על עמודי הפרקים שלה ועל עמודי המשאבים שלה
        t.classList.toggle(
          'is-current',
          visIds.some(
            (id) => id === j || id.startsWith(`${j}-`) || (id.startsWith('it-') && j === `toc-${id.split('-')[1]}`)
          )
        );
      });
      history.replaceState(null, '', `#${ids[cur]}`);
      // בשער — האתר חוזר: עמוד יחיד רחב בלי השתלטות, בכל מסלול הגעה (3.29)
      if (ids[cur] === 'rashi') disengage();
      // הדף יושב מדויק: בכל מעבר, ההשתלטות חוזרת לראש (בנייד השכבה נגללת)
      if (engaged) shell.scrollTop = 0;
      // עמוד משאב פתוח לרוחב — אזורי הקצה כבויים, ההטמעה לחיצה עד הקצה
      shell.classList.toggle('on-embed', !narrow.matches && vis.length === 1 && isItem(vis[0]));
      warmNeighbors();
    };

    const applySides = (v: number[]) => {
      if (mode === 1) {
        // עמוד משאב נפרס על כל המסך גם בתצוגת עמוד אחד — במסך רחב בלבד;
        // בנייד הדף זורם טבעי (3.29)
        if (isItem(v[0]) && !narrow.matches) pages[v[0]].classList.add('pg-wide');
        return;
      }
      if (v.length === 2) {
        pages[v[0]].classList.add('pg-right');
        pages[v[1]].classList.add('pg-left');
      } else pages[v[0]].classList.add(isItem(v[0]) || ids[v[0]] === 'rashi' ? 'pg-wide' : 'pg-right');
    };

    const layout = () => {
      const view = visOf(cur);
      shell.classList.toggle(
        'has-wide',
        !narrow.matches && view.length === 1 && (isItem(view[0]) || ids[view[0]] === 'rashi')
      );
      const vis = new Set(view);
      pages.forEach((p, k) => {
        p.classList.remove(...ANIM);
        p.style.zIndex = '';
        if (vis.has(k)) {
          if (p.hidden) {
            p.hidden = false;
            p.scrollTop = 0;
          }
          mount(p);
        } else p.hidden = true;
      });
      applySides(view);
      shell.classList.toggle('mode-2', mode === 2);
      shell.classList.toggle('mode-1', mode === 1);
      shell.classList.toggle('on-rashi', ids[cur] === 'rashi');
      paint();
    };

    // ===== מנוע ההיפוך (3.29, הוראת יניב 03/08/2026): עלה אחד רציף מעל
    // השדרה, מונע פריים-אחר-פריים — בלי תפר בין ההרמה לנחיתה. עד 90°
    // מתרומם הדף הישן (פני העלה), ומ-90° נוחת הדף החדש (גב העלה) באותה
    // תנועה עצמה; עמוד רחב מסתובב סביב השדרה כגיליון שלם. הצללת נייר על
    // העלה (--shade) וצל מוטל נודד על העמודים הנייחים (.book-cast). אותו
    // מנוע משרת גם דפדוף מתוזמן וגם אחיזת דף בגרירה מהשוליים.
    const bookEl = shell.querySelector<HTMLElement>('.book')!;
    const castL = document.createElement('div');
    castL.className = 'book-cast book-cast-l';
    const castR = document.createElement('div');
    castR.className = 'book-cast book-cast-r';
    const bleaf = document.createElement('div');
    bleaf.className = 'bleaf';
    bleaf.hidden = true;
    bookEl.append(castL, castR, bleaf);

    interface FlipCtl {
      seek: (deg: number) => void;
      settle: (target: 0 | 180, fullMs?: number) => void;
      finish: () => void;
      deg: () => number;
    }
    let anim: FlipCtl | null = null;
    let fadeCtl: { finish: () => void } | null = null;
    let dragging = false;
    let lastFlipEnd = 0;

    // הרמה מאיצה, שיא מהירות באנך, נחיתה מתרככת — כמו דף נייר אמיתי
    const easeFlip = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const easeLand = (t: number) => 1 - Math.pow(1 - t, 3);

    const flipStart = (
      ov: number[],
      nv: number[],
      dir: 1 | -1,
      onDone: (committed: boolean) => void
    ): FlipCtl => {
      const wideOf = (v: number[]) =>
        v.length === 1 && (isItem(v[0]) || ids[v[0]] === 'rashi') ? pages[v[0]] : null;
      const oldWide = wideOf(ov);
      const newWide = wideOf(nv);
      const oldR = oldWide ? null : pages[ov[0]];
      const oldL = oldWide ? null : ov.length === 2 ? pages[ov[1]] : null;
      const newR = newWide ? null : pages[nv[0]];
      const newL = newWide ? null : nv.length === 2 ? pages[nv[1]] : null;

      // פני העלה = הדף הישן שמתרומם; גב העלה = הדף החדש שנוחת.
      // קדימה בספר עברי העלה עובר משמאל לימין; אחורה — להפך
      const front = dir === 1 ? oldL ?? oldWide ?? bleaf : (oldR ?? oldWide)!;
      const back = dir === 1 ? (newWide ?? newR)! : newL ?? newWide ?? bleaf;

      applySides(nv);
      nv.forEach((k) => {
        mount(pages[k]);
        pages[k].scrollTop = 0;
      });

      const touched = new Set<HTMLElement>([front, back, bleaf]);
      ov.forEach((k) => touched.add(pages[k]));
      nv.forEach((k) => touched.add(pages[k]));

      // מתחת לעלה המתרומם נחשף הדף החדש; הדף הנייח של הצד השני נשאר
      // גלוי עד שגב העלה מכסה אותו — בדיוק כמו בספר אמיתי
      const under = dir === 1 ? newL : newR;
      const stay = dir === 1 ? oldR : oldL;
      if (under && under !== back) {
        under.hidden = false;
        under.style.zIndex = '1';
      }
      if (stay && stay !== front) stay.style.zIndex = '2';
      if (back !== front) back.hidden = true;
      if (front === bleaf) bleaf.hidden = false;
      front.style.zIndex = '6';
      front.style.willChange = 'transform';
      back.style.willChange = 'transform';
      if (front === oldWide) front.style.transformOrigin = '50% 50%';
      if (back === newWide) back.style.transformOrigin = '50% 50%';
      // הצד הכהה של ההצללה פונה תמיד לשדרה
      front.style.setProperty('--shade-dir', dir === 1 ? '270deg' : '90deg');
      back.style.setProperty('--shade-dir', dir === 1 ? '90deg' : '270deg');

      const setShade = (el: HTMLElement, v: string) => {
        if (v) el.style.setProperty('--shade', v);
        else el.style.removeProperty('--shade');
      };

      let crossed = false;
      const cross = () => {
        crossed = true;
        front.style.transform = '';
        setShade(front, '');
        front.hidden = true;
        back.hidden = false;
        back.style.zIndex = '6';
      };
      const uncross = () => {
        crossed = false;
        back.style.transform = '';
        setShade(back, '');
        back.hidden = true;
        front.hidden = false;
      };

      let curDeg = 0;
      const seek = (degRaw: number) => {
        const deg = Math.max(0, Math.min(180, degRaw));
        curDeg = deg;
        const lift = Math.min(deg, 90) / 90;
        const land = Math.max(deg - 90, 0) / 90;
        const dest = dir === 1 ? castR : castL;
        const src = dir === 1 ? castL : castR;
        dest.style.opacity = String(deg <= 90 ? 0.36 * Math.sin((lift * Math.PI) / 2) : 0.36 * (1 - land));
        src.style.opacity = String(deg <= 90 ? 0.2 * (1 - lift) : 0);
        if (deg < 90) {
          if (crossed) uncross();
          front.style.transform = `rotateY(${dir * deg}deg)`;
          setShade(front, (0.5 * Math.sin((lift * Math.PI) / 2)).toFixed(3));
        } else {
          if (!crossed) cross();
          back.style.transform = `rotateY(${dir === 1 ? deg - 180 : 180 - deg}deg)`;
          setShade(back, (0.55 * (1 - land)).toFixed(3));
        }
      };

      let raf = 0;
      let guard = 0;
      let ended = false;
      const cleanup = (committed: boolean) => {
        if (ended) return;
        ended = true;
        cancelAnimationFrame(raf);
        clearTimeout(guard);
        anim = null;
        touched.forEach((el) => {
          el.style.transform = '';
          el.style.transformOrigin = '';
          el.style.willChange = '';
          el.style.removeProperty('--shade');
          el.style.removeProperty('--shade-dir');
        });
        bleaf.hidden = true;
        castL.style.opacity = '0';
        castR.style.opacity = '0';
        busy = false;
        lastFlipEnd = performance.now();
        onDone(committed);
      };

      let lastTarget: 0 | 180 = 180;
      const settle = (target: 0 | 180, fullMs = 640) => {
        lastTarget = target;
        const from = curDeg;
        if (Math.abs(target - from) < 0.5) {
          seek(target);
          cleanup(target === 180);
          return;
        }
        // היפוך מלא — קצב דף שלם; השלמה מגרירה — נחיתה לפי הדרך שנותרה
        const fullRun = from <= 1 && target === 180;
        const ease = fullRun ? easeFlip : easeLand;
        const dur = fullRun ? fullMs : Math.max(160, Math.min(460, (Math.abs(target - from) / 180) * 540));
        const t0 = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - t0) / dur);
          seek(from + (target - from) * ease(t));
          if (t < 1) raf = requestAnimationFrame(tick);
          else cleanup(target === 180);
        };
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(tick);
        // שעון-שמירה: אם הדפדפן מקפיא פריימים (כרטיסייה ברקע) —
        // ההיפוך מושלם בכל זאת והספר לעולם לא נתקע באמצע תנועה
        clearTimeout(guard);
        guard = window.setTimeout(finish, dur + 450);
      };

      const finish = () => {
        if (ended) return;
        seek(lastTarget);
        cleanup(lastTarget === 180);
      };

      seek(0);
      return { seek, settle, finish, deg: () => curDeg };
    };

    const show = (i: number, dir: 1 | -1 | 0) => {
      if (i < 0 || i >= total || dragging) return;
      // לחיצות מהירות מדפדפות ברצף: היפוך פעיל מושלם מיידית והבא נכנס אחריו
      if (anim) anim.finish();
      if (fadeCtl) fadeCtl.finish();
      if (busy) return;
      if (cur >= 0 && (i === cur || (mode === 2 && view2Of[i] === view2Of[cur]))) {
        if (i !== cur) {
          cur = i;
          paint();
        }
        return;
      }
      const prev = cur;
      cur = i;
      if (prev < 0 || dir === 0 || reduced.matches) {
        layout();
        return;
      }
      busy = true;
      if (mode === 1) {
        // מסך צר: מעבר עמעום עדין — הדפים זורמים בגובה טבעי, בלי ערימה
        const from = pages[prev];
        const to = pages[cur];
        const swap = () => {
          from.hidden = true;
          from.classList.remove('fade-out');
          to.classList.remove(...ANIM);
          applySides([cur]);
          to.hidden = false;
          mount(to);
          to.scrollTop = 0;
          to.classList.add('fade-in');
        };
        from.classList.add('fade-out');
        const t1 = setTimeout(() => {
          swap();
          const t2 = setTimeout(() => {
            fadeCtl = null;
            busy = false;
            layout();
          }, 300);
          fadeCtl = {
            finish: () => {
              clearTimeout(t2);
              fadeCtl = null;
              busy = false;
              layout();
            },
          };
        }, 150);
        fadeCtl = {
          finish: () => {
            clearTimeout(t1);
            swap();
            fadeCtl = null;
            busy = false;
            layout();
          },
        };
        paint();
        return;
      }
      // פריסה כפולה: היפוך העלה הרציף של המנוע
      anim = flipStart(views2[view2Of[prev]], views2[view2Of[cur]], dir, () => layout());
      paint();
      anim.settle(180);
    };

    const step = (d: 1 | -1) => {
      if (mode === 1) {
        show(cur + d, d);
        return;
      }
      const nv = view2Of[cur] + d;
      if (nv < 0 || nv >= views2.length) return;
      show(views2[nv][0], d);
    };

    const norm = (h: string) => (h === 'cover' ? 'rashi' : h);
    const goto = (id: string) => {
      const i = ids.indexOf(id);
      if (i >= 0) show(i, i >= cur ? 1 : -1);
    };

    // ההשתלטות על כל שטח המסך (3.29): מתחילים לעבוד — הספר הופך למסך כולו
    const engage = () => {
      if (engaged) return;
      engaged = true;
      savedY = scrollY;
      shell.classList.add('is-full');
      document.documentElement.classList.add('book-lock');
    };

    const disengage = () => {
      if (!engaged) return;
      engaged = false;
      shell.classList.remove('is-full');
      document.documentElement.classList.remove('book-lock');
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      scrollTo(0, savedY);
    };

    // לפני ההשתלטות — קישור רגיל לעמוד הראשי של האתר; בתוכה — יציאה נקייה
    exitBtn.addEventListener('click', (e) => {
      if (!engaged) return;
      e.preventDefault();
      disengage();
    });

    navPrev.addEventListener('click', () => {
      engage();
      step(-1);
    });
    navNext.addEventListener('click', () => {
      engage();
      step(1);
    });
    // אזורי הקצה (3.29): הקשה הופכת דף שלם; גרירה אוחזת את העלה ומדפדפת
    // עם היד — שחרור משלים או מחזיר את הדף לפי המרחק והתנופה
    shell.querySelectorAll<HTMLButtonElement>('.book-edge').forEach((b) => {
      const dir: 1 | -1 = b.dataset.dir === 'next' ? 1 : -1;
      let pid = -1;
      let sx = 0;
      let lastX = 0;
      let lastT = 0;
      let vx = 0;
      let moved = false;
      let ctl: FlipCtl | null = null;
      b.addEventListener('pointerdown', (e) => {
        if (busy || dragging || anim || mode !== 2 || reduced.matches) return;
        const ni = view2Of[cur] + dir;
        if (ni < 0 || ni >= views2.length) return;
        engage();
        pid = e.pointerId;
        sx = lastX = e.clientX;
        lastT = performance.now();
        vx = 0;
        moved = false;
        dragging = true;
        busy = true;
        try {
          b.setPointerCapture(pid);
        } catch {
          /* מצביע שכבר שוחרר — הגרירה תלווה באירועי החלון */
        }
        const target = views2[ni];
        ctl = anim = flipStart(views2[view2Of[cur]], target, dir, (committed) => {
          dragging = false;
          if (committed) cur = target[0];
          layout();
        });
      });
      b.addEventListener('pointermove', (e) => {
        if (e.pointerId !== pid || !ctl) return;
        const now = performance.now();
        vx = 0.7 * vx + (0.3 * (e.clientX - lastX)) / Math.max(1, now - lastT);
        lastX = e.clientX;
        lastT = now;
        const dx = e.clientX - sx;
        if (Math.abs(dx) > 6) moved = true;
        const w = bookEl.getBoundingClientRect().width || 1;
        // קדימה בספר עברי: העלה נגרר מהשמאל ימינה מעל השדרה
        ctl.seek(Math.max(0, ((dir === 1 ? dx : -dx) / w) * 205));
      });
      b.addEventListener('pointerup', (e) => {
        if (e.pointerId !== pid || !ctl) return;
        pid = -1;
        const c = ctl;
        ctl = null;
        if (!moved) {
          c.settle(180);
          return;
        }
        const deg = c.deg();
        const toward = dir === 1 ? vx : -vx;
        const commit = deg > 160 || (toward > -0.35 && (deg > 68 || (deg > 10 && toward > 0.45)));
        c.settle(commit ? 180 : 0);
      });
      b.addEventListener('pointercancel', (e) => {
        if (e.pointerId !== pid || !ctl) return;
        pid = -1;
        const c = ctl;
        ctl = null;
        c.settle(0);
      });
      // רגישי תנועה: הקשה פשוטה מחליפה עמוד מיידית
      b.addEventListener('click', () => {
        if (!reduced.matches || mode !== 2) return;
        engage();
        step(dir);
      });
    });
    shell.querySelectorAll<HTMLButtonElement>('button[data-jump]').forEach((b) =>
      b.addEventListener('click', () => {
        // ההשתלטות מתחילה רק בבחירת שכבה/תוכן — לא בחזרה לשער
        if (b.dataset.jump !== 'rashi') engage();
        goto(b.dataset.jump!);
      })
    );

    narrow.addEventListener('change', () => {
      const m = prefMode();
      if (m !== mode) {
        mode = m;
        layout();
      }
    });

    // מקלדת: בעברית "קדימה" הוא שמאלה; Home לעמוד הראשי, End לסוף; Escape יוצא
    addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 'Escape') {
        disengage();
        return;
      }
      if (e.key === 'ArrowLeft' || e.key === 'PageDown') {
        e.preventDefault();
        engage();
        step(1);
      } else if (e.key === 'ArrowRight' || e.key === 'PageUp') {
        e.preventDefault();
        engage();
        step(-1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        engage();
        show(0, -1);
      } else if (e.key === 'End') {
        e.preventDefault();
        engage();
        show(total - 1, 1);
      }
    });

    // מסך מלא אמיתי — בנוסף להשתלטות על החלון
    fsBtn?.addEventListener('click', () => {
      engage();
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      else shell.requestFullscreen?.().catch(() => {});
    });
    document.addEventListener('fullscreenchange', () => {
      if (fsBtn) fsBtn.textContent = document.fullscreenElement ? '✕' : '⛶';
    });

    // החלקת מגע: דפדוף רק בתנועה אופקית מובהקת — גלילה אנכית לא מזיזה דף;
    // גרירת עלה מהשוליים לא מפעילה גם החלקה
    let x0 = 0;
    let y0 = 0;
    bookEl.addEventListener('touchstart', (e) => {
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
    }, { passive: true });
    bookEl.addEventListener('touchend', (e) => {
      if (busy || dragging || performance.now() - lastFlipEnd < 350) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.8) return;
      engage();
      step(dx < 0 ? 1 : -1);
    }, { passive: true });

    // העתקת קישור בעמודי המשאבים
    shell.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const status = btn.closest('.item-info')?.querySelector<HTMLElement>('[data-status]');
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          if (status) status.textContent = 'הקישור הועתק';
        } catch {
          if (status) status.textContent = 'ההעתקה נכשלה';
        }
      });
    });

    // עמוד פתיחה: hash עמוק גובר על ברירת המחדל של העמוד
    mode = prefMode();
    const fromHash = norm(location.hash.slice(1));
    const start = ids.includes(fromHash) ? fromHash : norm(shell.dataset.initial ?? 'rashi');
    show(Math.max(0, ids.indexOf(start)), 0);
    addEventListener('hashchange', () => {
      const h = norm(location.hash.slice(1));
      if (ids.includes(h) && h !== ids[cur]) goto(h);
    });
  });
</script>
