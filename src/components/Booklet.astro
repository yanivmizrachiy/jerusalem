---
/**
 * החוברת הדיגיטלית של חטיבת הביניים (RULES 3.26, 3.29 — הוראות יניב 04/08/2026):
 * שכבת התצוגה מונעת על ידי מנוע page-flip ייעודי (StPageFlip, MIT) —
 * גרירת פינה אמיתית בעכבר ובמגע, קיפול נראה לעין, חזית וגב דף, צל דינמי
 * לפי זווית — לא rotateY של מלבן. ספר עברי אמיתי: העמודים ניזונים למנוע
 * בסדר הפוך, כך שהדפדוף קדימה מתהפך מעל השדרה ימינה כמו בספר עברי, בלי
 * שיקוף CSS ובלי לגעת בתוכן.
 *
 * מבנה העמודים נגזר כולו מ-src/data/choveret.ts (מקור יחיד):
 * שער (דף קשיח בודד) ← עמודי תוכן-עניינים (עמוד לפרק, עם דף ריק ליישור
 * זוגות כשמספר הפרקים אי-זוגי) ← עמודי משאב (זוג אמיתי: דף הטמעה מימין,
 * דף מידע משמאל) ← כריכה אחורית (דף קשיח). סה"כ זוגי — כל spread מיושר.
 *
 * מכונת המצבים (הוראת יניב 05/08/2026): רק שער החוברת נשאר בזרימת האתר.
 * ברגע שנפתחת שכבה — תוכן העניינים והמשאבים כאחד משתלטים על מלוא המסך
 * (is-full): הניווט העליון של האתר מכוסה, החוברת עולה למקסימום הגובה,
 * ולשוניות השכבות עוברות לסרגל צד שמאלי יוקרתי. כפתור הזהב "חזרה לאתר"
 * ו-Escape יוצאים מההשתלטות אל השער שבזרימת האתר.
 * הטמעות נטענות רק כשהעמוד נפתח, שכנים מתחממים ברגעי סרק, ודפדפן בלי
 * מציג PDF מקבל כרטיס פתיחה (8.8).
 */
import MafmarRange from './MafmarRange.astro';
import { choveret } from '../data/choveret';

interface Props {
  /** מזהה העמוד הפותח: rashi / toc-z / toc-z-2 / it-z-maf-02 ... */
  initial?: string;
}

const { initial = 'rashi' } = Astro.props;

const kindLabel: Record<string, string> = {
  site: 'אתר חי',
  doc: 'מסמך',
  drive: 'קובץ',
  pdf: 'PDF',
  canva: 'מצגת',
  flip: 'חוברת דפדוף',
  maf: 'מתוך החוזר',
  link: 'קישור',
};

interface PageDef {
  id: string;
  label: string;
}

/**
 * סדר העמודים הלוגי (מספור רציף אוטומטי — אסור ידני):
 * לכל שכבה: עמודי הפרקים, דף ריק אם מספרם אי-זוגי, ואז זוגות המשאבים.
 * דף אחרון: כריכה אחורית — הסך הכולל זוגי וכל spread מיושר.
 */
/**
 * מפתח השכבה — כפולה אחת בלבד (הוראת יניב, 05/08/2026):
 * כל הפרקים וכל הקבצים של השכבה מרוכזים בשני עמודים נגדיים, כמו מפתח
 * בספר אמיתי. הפרקים נשמרים שלמים ומחולקים בין שני העמודים לפי מניין
 * השורות (כותרת פרק + קבציו), כך ששני העמודים מאוזנים ואין גלילה.
 */
const tocSplit = (g: (typeof choveret)[number]) => {
  const chs = g.chapters;
  const rows = (ch: (typeof chs)[number]) => 1 + ch.items.length;
  const total = chs.reduce((n, ch) => n + rows(ch), 0);

  // שכבה בעלת פרק יחיד: מפצלים את קבציו בין שני העמודים, והכותרת חוזרת כ"המשך"
  if (chs.length < 2) {
    const ch = chs[0];
    if (!ch) return [[], []] as const;
    const mid = Math.ceil(ch.items.length / 2);
    return [
      [{ ...ch, items: ch.items.slice(0, mid) }],
      [{ ...ch, title: `${ch.title} (המשך)`, items: ch.items.slice(mid) }],
    ] as const;
  }

  // גבול הפרקים שממזער את הפער בין שני העמודים — כמו מפתח בספר מודפס
  let best = 1;
  let bestGap = Infinity;
  let acc = 0;
  for (let k = 0; k < chs.length - 1; k++) {
    acc += rows(chs[k]);
    const gap = Math.abs(acc - (total - acc));
    if (gap < bestGap) {
      bestGap = gap;
      best = k + 1;
    }
  }
  return [chs.slice(0, best), chs.slice(best)] as const;
};

const pages: PageDef[] = [{ id: 'rashi', label: 'ראשי' }];
for (const g of choveret) {
  // מפתח השכבה — שני עמודים בדיוק, כפולה אחת (הוראת יניב, 05/08/2026)
  pages.push({ id: `toc-${g.slug}`, label: g.title });
  pages.push({ id: `toc-${g.slug}-2`, label: `${g.title} — המשך` });
  for (const ch of g.chapters)
    for (const it of ch.items)
      if (!it.pageHref) {
        pages.push({ id: `it-${g.slug}-${it.id}`, label: it.title });
        pages.push({ id: `it-${g.slug}-${it.id}-info`, label: it.title });
      }
}
pages.push({ id: 'back', label: '' });

const total = pages.length;
const pageNum = (id: string) => pages.findIndex((p) => p.id === id) + 1;
/** תוכן העניינים של השכבה — היעד של שורות השער ולשוניות הקפיצה */
const firstToc = (slug: string) => `toc-${slug}`;
/** עמוד המפתח שבו יושב הפרק — יעד החזרה ממשאב (data-toc) */
const tocPageOf = (g: (typeof choveret)[number], chId: string) =>
  tocSplit(g)[1].some((c) => c.id === chId) ? `toc-${g.slug}-2` : `toc-${g.slug}`;
/** צד הדף בפריסה: אינדקס אי-זוגי = דף ימין, זוגי = דף שמאל (השער והכריכה בודדים) */
const folioSide = (id: string) => (pageNum(id) % 2 === 0 ? 'folio-r' : 'folio-l');

const site = 'https://jerusalem-virid.vercel.app';

/**
 * ניווט למקומות אחרים באתר — מחוץ לחוברת (הוראת יניב, 05/08/2026):
 * מתחת לסרגל הדפדוף (שנשאר צמוד לספר) מוצגת שורת מעבר מהירה לשערים
 * ולאזורים אחרים בפרויקט. מוסתרת במצב העבודה המלא (is-full) כדי לא
 * להעמיס על קריאת המשאב. כל כפתור הוא קישור פנימי אמיתי בפלטת האתר.
 */
const siteLinks: { href: string; label: string; accent: string; icon: string }[] = [
  {
    href: '/chativa-elyona/',
    label: 'חטיבה עליונה',
    accent: 'var(--terracotta)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 2 9l10 5 10-5-10-5Z"/><path d="M6 11.4V16c0 1.3 2.7 2.4 6 2.4s6-1.1 6-2.4v-4.6"/><path d="M22 9v5"/></svg>',
  },
  {
    href: '/hozer-mafmar/',
    label: 'חוזר מפמ״ר',
    accent: 'var(--sky)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/></svg>',
  },
  {
    href: '/luach/',
    label: 'לוח שנה',
    accent: 'var(--olive)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>',
  },
  {
    href: '/hodaot/',
    label: 'הודעות',
    accent: 'var(--rose)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8.5a6 6 0 1 0-12 0c0 6-3 7.5-3 7.5h18s-3-1.5-3-7.5"/><path d="M13.7 20.5a2 2 0 0 1-3.4 0"/></svg>',
  },
  {
    href: '/pituach-miktzoi/',
    label: 'פיתוח מקצועי',
    accent: 'var(--lilac)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 18h5M10.5 21.5h3"/><path d="M12 2.5a6.5 6.5 0 0 0-4 11.6c.7.6 1 1.4 1 2.2V17h6v-.7c0-.8.4-1.6 1-2.2A6.5 6.5 0 0 0 12 2.5Z"/></svg>',
  },
  {
    href: '/',
    label: 'לעמוד הראשי',
    accent: 'var(--gold)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10.5V20h13v-9.5"/></svg>',
  },
];

// חיבור-מראש לכל מקורות ההטמעה החיצוניים — העמוד הפתוח נטען מהר (3.29)
const embedOrigins = [
  ...new Set(
    choveret
      .flatMap((g) => g.chapters.flatMap((ch) => ch.items))
      .map((it) => it.embed ?? '')
      .filter((u) => u.startsWith('https://'))
      .map((u) => new URL(u).origin)
  ),
];
---

<div class="book-shell" data-book data-initial={initial} data-total={total}>
  {embedOrigins.map((o) => <link rel="preconnect" href={o} />)}

  <!-- פס לשוניות: בשער — פס עליון קומפקטי; במצב פתוח (is-full) הופך לסרגל
       צד שמאלי יוקרתי עם "חזרה לאתר" ולשוניות השכבות (הוראת יניב 05/08/2026) -->
  <div class="book-bar">
    <button class="book-exit" type="button" data-exit hidden>
      <span class="book-exit-ico" aria-hidden="true">→</span>
      חזרה לאתר
    </button>
    <div class="book-tabs" role="group" aria-label="קפיצה מהירה">
      <button class="btab" type="button" data-jump="rashi">ראשי</button>
      {
        choveret.map((g) => (
          <button class="btab" type="button" data-jump={firstToc(g.slug)} data-grade={g.slug}>
            {g.letter}
          </button>
        ))
      }
    </div>
    <div class="book-tools">
      <button class="bfs" type="button" data-fullscreen aria-label="מסך מלא">⛶</button>
    </div>
  </div>

  <div class="book-stage" data-stage>
    <button class="book-edge book-edge-next" type="button" data-dir="next" aria-label="הדף הבא"><span aria-hidden="true">‹</span></button>
    <button class="book-edge book-edge-prev" type="button" data-dir="prev" aria-label="הדף הקודם"><span aria-hidden="true">›</span></button>

    <div class="flip-host" data-host aria-roledescription="חוברת" aria-label="מתמטיקה לחטיבת הביניים — ספר מדפדף">
      <!-- העמוד הראשי — שער החוברת: דף קשיח בודד, גדול וקריא (3.29) -->
      <section class="bpage bp-rashi" data-page="rashi" data-n="1" data-density="hard">
        <div class="page-face">
          <div class="rashi-inner">
            <h2 class="rashi-title">מתמטיקה לחטיבת הביניים</h2>
            <div class="rashi-rows">
              {
                choveret.map((g) => (
                  <button
                    class="rashi-row"
                    type="button"
                    data-jump={firstToc(g.slug)}
                    style={`--g-color:${g.color}; --g-dark:${g.dark}`}
                  >
                    <span class:list={['rashi-letter', { 'is-wide': g.slug === 'klali' }]}>{g.letter}</span>
                    <span class="rashi-text">
                      <span class="rashi-name">{g.slug === 'klali' ? 'משותף לכל השכבות' : `כיתה ${g.letter}`}</span>
                      <span class="rashi-count">
                        <b class="rashi-count-num">{g.chapters.reduce((n, c) => n + c.items.length, 0)}</b>
                        קבצים, קישורים ופעילויות
                      </span>
                    </span>
                    <span class="rashi-dots" aria-hidden="true"></span>
                    <span class="rashi-pnum">עמוד {pageNum(firstToc(g.slug))}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      {
        choveret.map((g) => (
          <>
            <!-- מפתח השכבה — כפולה אחת: כל הפרקים וכל הקבצים (הוראת יניב, 05/08/2026) -->
            {tocSplit(g).map((part, side) => {
              const pid = side === 0 ? `toc-${g.slug}` : `toc-${g.slug}-2`;
              /* צפיפות המפתח נגזרת ממספר השורות בעמוד: שכבה עשירה בקבצים
                 מתהדקת כדי שהמפתח יישאר כפולה אחת בדיוק (RULES 3.29) */
              const rows = part.reduce((n, ch) => n + ch.items.length + 1, 0);
              return (
                <section
                  class:list={[
                    'bpage',
                    'bp-gtoc',
                    folioSide(pid),
                    { 'is-dense': rows > 15, 'is-xdense': rows > 19 },
                  ]}
                  data-page={pid}
                  data-n={pageNum(pid)}
                >
                  <div class="page-face" style={`--g-color:${g.color}; --g-dark:${g.dark}`}>
                    <header class="gtoc-head">
                      <h2 class:list={['gtoc-title', { 'toc-title': side === 1 }]}>
                        {side === 0 ? g.title : `${g.title} — המשך`}
                      </h2>
                      <p class="gtoc-sub">תוכן העניינים</p>
                    </header>
                    <div class="idx">
                      {part.map((ch) => (
                        <section class="idx-ch" style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}>
                          <h3 class="idx-ch-head">
                            <span class="idx-ch-name">{ch.title}</span>
                            <span class="idx-ch-count">{ch.items.length} קבצים</span>
                          </h3>
                          <ol class="idx-rows">
                            {ch.items.map((item) => (
                              <li>
                                {item.pageHref ? (
                                  <a class="idx-row" href={item.pageHref}>
                                    <span class="idx-name">{item.title}</span>
                                    <span class="idx-dots" aria-hidden="true" />
                                    <span class="idx-pnum idx-pnum-ext" aria-hidden="true">
                                      ↗
                                    </span>
                                  </a>
                                ) : (
                                  <button class="idx-row" type="button" data-jump={`it-${g.slug}-${item.id}`}>
                                    <span class="idx-name">{item.title}</span>
                                    <span class="idx-dots" aria-hidden="true" />
                                    <span class="idx-pnum">{pageNum(`it-${g.slug}-${item.id}`)}</span>
                                  </button>
                                )}
                              </li>
                            ))}
                          </ol>
                        </section>
                      ))}
                    </div>
                    <span class="folio" aria-hidden="true">{pageNum(pid)}</span>
                  </div>
                </section>
              );
            })}


            {g.chapters.map((ch) =>
              ch.items
                .filter((it) => !it.pageHref)
                .map((item) => (
                  <>
                    <section
                      class:list={['bpage', 'bp-item', 'bp-item-embed', folioSide(`it-${g.slug}-${item.id}`)]}
                      data-page={`it-${g.slug}-${item.id}`}
                      data-n={pageNum(`it-${g.slug}-${item.id}`)}
                      data-kind={item.kind}
                      data-toc={tocPageOf(g, ch.id)}
                    >
                      <div class="page-face" style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}>
                        <div class="item-embed">
                          {item.kind === 'maf' && item.maf ? (
                            <MafmarRange sectionId={item.maf} accent={ch.color} fill />
                          ) : item.embed ? (
                            <>
                              <div class="item-frame">
                                <iframe
                                  data-esrc={item.embed}
                                  data-eurl={item.url}
                                  data-etitle={item.title}
                                  title={`${item.title} — תצוגה חיה`}
                                  allow="fullscreen; clipboard-write"
                                />
                              </div>
                              {item.kind === 'pdf' && (
                                <div class="item-frame item-open-card" data-pdf-fb hidden>
                                  <p>בדפדפן הזה קובצי PDF נפתחים לצפייה מלאה במסך נפרד:</p>
                                  <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                                    פתיחת {item.title} ↗
                                  </a>
                                </div>
                              )}
                            </>
                          ) : (
                            <div class="item-frame item-open-card">
                              <p>המשאב הזה נפתח באתר המקור:</p>
                              <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                                פתיחת {item.title} ↗
                              </a>
                            </div>
                          )}
                        </div>
                        <span class="folio" aria-hidden="true">{pageNum(`it-${g.slug}-${item.id}`)}</span>
                      </div>
                    </section>

                    <section
                      class:list={['bpage', 'bp-item', 'bp-item-info', folioSide(`it-${g.slug}-${item.id}-info`)]}
                      data-page={`it-${g.slug}-${item.id}-info`}
                      data-n={pageNum(`it-${g.slug}-${item.id}-info`)}
                      data-toc={tocPageOf(g, ch.id)}
                    >
                      <div class="page-face" style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}>
                        <aside class="item-info">
                          <p class="item-chapter">{ch.title} · {g.slug === 'klali' ? 'כללי' : `כיתה ${g.letter}`}</p>
                          <h2 class="item-title">{item.title}</h2>
                          {item.note && <p class="item-note">{item.note}</p>}
                          {/* ייחוס מקור אחיד לכל חומר שנשאב מחוזר המפמ״ר (RULES 9.3.21) */}
                          {item.source && <p class="item-source">{item.source}</p>}
                          <p class="item-kind">{kindLabel[item.kind]}</p>
                          <div class="item-actions" role="group" aria-label="פעולות">
                            {item.download && (
                              <a class="btn btn-primary" href={item.download} target="_blank" rel="noopener" download>
                                הורדה ⬇
                              </a>
                            )}
                            <a
                              class="btn btn-whatsapp"
                              href={`https://wa.me/?text=${encodeURIComponent(`${item.title} — ${g.title} — ${site}/chativat-beynayim/reader/${g.slug}/${item.id}/`)}`}
                              target="_blank"
                              rel="noopener"
                              aria-label={`שיתוף ${item.title} ב־WhatsApp`}
                            >
