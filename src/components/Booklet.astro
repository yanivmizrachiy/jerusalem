<script>
  import { PageFlip } from 'page-flip';

  document.querySelectorAll<HTMLElement>('[data-book]').forEach((shell) => {
    const stage = shell.querySelector<HTMLElement>('[data-stage]')!;
    const host = shell.querySelector<HTMLElement>('[data-host]')!;
    const secs = [...shell.querySelectorAll<HTMLElement>('.bpage')];
    const ids = secs.map((s) => s.dataset.page!);
    const total = secs.length;
    const navPrev = shell.querySelector<HTMLButtonElement>('.bnav-prev')!;
    const navNext = shell.querySelector<HTMLButtonElement>('.bnav-next')!;
    const counter = shell.querySelector<HTMLElement>('[data-counter]')!;
    const progress = shell.querySelector<HTMLElement>('[data-progress]')!;
    const tabs = [...shell.querySelectorAll<HTMLButtonElement>('.btab')];
    const exitBtn = shell.querySelector<HTMLButtonElement>('[data-exit]')!;
    const fsBtn = shell.querySelector<HTMLButtonElement>('[data-fullscreen]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    /* ספר עברי על מנוע LTR: העמודים ניזונים בסדר הפוך — "קדימה" שלנו הוא
       flipPrev של המנוע, והעלה עובר מעל השדרה ימינה כמו בספר עברי אמיתי */
    const k2e = (k: number) => total - 1 - k;
    const e2k = (e: number) => total - 1 - e;
    const reversed = [...secs].reverse();

    let pf: PageFlip | null = null;
    let cur = 0;
    let engaged = false;
    let savedY = 0;
    let pendingExit = false;

    const isLone = (k: number) => k === 0 || k === total - 1;
    /* הפריסה שלנו: השער והכריכה בודדים; השאר זוגות (אי-זוגי, זוגי) */
    const spreadOf = (k: number): number[] => (isLone(k) ? [k] : k % 2 === 1 ? [k, k + 1] : [k - 1, k]);

    /* ===== הטמעות: טעינה עצלה, חימום שכנים, כרטיס PDF ופרוקסי (8.8) ===== */
    const noPdfViewer = 'pdfViewerEnabled' in navigator && !navigator.pdfViewerEnabled;
    const mount = (p: HTMLElement) => {
      if (noPdfViewer && p.dataset.kind === 'pdf') {
        const fb = p.querySelector<HTMLElement>('[data-pdf-fb]');
        const frame = p.querySelector<HTMLElement>('iframe[data-esrc]')?.closest<HTMLElement>('.item-frame');
        if (fb && frame) {
          frame.hidden = true;
          fb.hidden = false;
        }
        return;
      }
      p.querySelectorAll<HTMLIFrameElement>('iframe[data-esrc]').forEach((f) => {
        const esrc = f.dataset.esrc!;
        // שלד טעינה יוקרתי + חשיפה בעדינות (8.9) — במקום הבזק לבן
        const skelFrame = f.closest<HTMLElement>('.item-frame');
        if (skelFrame && !skelFrame.querySelector('.frame-skel')) {
          const skel = document.createElement('div');
          skel.className = 'frame-skel';
          skel.setAttribute('aria-hidden', 'true');
          const spin = document.createElement('span');
          spin.className = 'frame-skel-spin';
          const txt = document.createElement('span');
          txt.className = 'frame-skel-txt';
          txt.textContent = 'טוען תצוגה חיה…';
          skel.append(spin, txt);
          skelFrame.appendChild(skel);
          skelFrame.setAttribute('aria-busy', 'true');
        }
        let revealed = false;
        const reveal = () => {
          if (revealed || !skelFrame) return;
          revealed = true;
          skelFrame.classList.add('is-loaded');
          skelFrame.setAttribute('aria-busy', 'false');
          const s = skelFrame.querySelector('.frame-skel');
          if (s) window.setTimeout(() => s.remove(), 520);
        };
        f.addEventListener('load', reveal, { once: true });
        // רשת אמת: חושפים גם אם load מתעכב — לעולם לא נשארים על השלד
        window.setTimeout(reveal, 8000);
        if (esrc.startsWith('/api/')) {
          f.addEventListener('load', () => {
            let dead = false;
            try {
              const w = f.contentWindow as (Window & { __EM_PROXY__?: 1 }) | null;
              dead =
                !!w &&
                w.location.href !== 'about:blank' &&
                w.location.origin === location.origin &&
                !w.__EM_PROXY__;
            } catch {
              /* חוצה-מקור — האפליקציה ניווטה למקור אחר; אין שיפוט */
            }
            if (!dead) return;
            const frame = f.closest<HTMLElement>('.item-frame');
            if (!frame || frame.dataset.fb) return;
            frame.dataset.fb = '1';
            frame.classList.add('item-open-card');
            const msg = document.createElement('p');
            msg.textContent = 'התצוגה החיה אינה זמינה כאן כרגע — האתר נפתח בחלון חדש:';
            const open = document.createElement('a');
            open.className = 'btn btn-primary';
            open.href = f.dataset.eurl ?? '#';
            open.target = '_blank';
            open.rel = 'noopener';
            open.textContent = `פתיחת ${f.dataset.etitle ?? 'האתר'} ↗`;
            frame.replaceChildren(msg, open);
          });
        }
        f.src = esrc;
        f.removeAttribute('data-esrc');
      });
    };

    const conn = (navigator as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const idle: (cb: () => void) => void =
      'requestIdleCallback' in window ? (cb) => requestIdleCallback(cb, { timeout: 2500 }) : (cb) => setTimeout(cb, 600);
    let warmTimer = 0;
    const warmNeighbors = () => {
      clearTimeout(warmTimer);
      if (conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
      warmTimer = window.setTimeout(
        () =>
          idle(() => {
            const s = spreadOf(cur);
            for (const k of [s[0] - 1, s[s.length - 1] + 1]) if (k >= 0 && k < total) mount(secs[k]);
          }),
        900
      );
    };

    /* גלילה פנימית רק כשבאמת צריך: המנוע מסמן עמודי מפתח שגולשים */
    const markScrollable = () => {
      shell.querySelectorAll<HTMLElement>('.bp-gtoc').forEach((p) => {
        const list = p.querySelector<HTMLElement>('.idx');
        if (list) p.classList.toggle('can-scroll', list.scrollHeight > list.clientHeight + 4);
      });
    };

    /* ===== מכונת המצבים: רק שער החוברת נשאר בזרימת האתר (3.29) ===== */

    /* בזמן ההשתלטות האתר שמאחור מכוסה גם למקלדת ולקורא מסך: כל מה שאינו
       החוברת מסומן inert (ומתועד ל-AT), אחרת Tab היה נודד לניווט הנסתר.
       זו אינה מלכודת focus (5.15) — Escape וכפתור "חזרה לאתר" תמיד משחררים. */
    let inerted: HTMLElement[] = [];

    const coverSite = () => {
      if (inerted.length) return;
      for (let node: HTMLElement | null = shell; node && node !== document.body; node = node.parentElement) {
        for (const sib of Array.from(node.parentElement?.children ?? [])) {
          if (sib === node || !(sib instanceof HTMLElement)) continue;
          if (sib.hasAttribute('inert')) continue;
          sib.setAttribute('inert', '');
          sib.setAttribute('aria-hidden', 'true');
          inerted.push(sib);
        }
      }
    };

    const uncoverSite = () => {
      for (const el of inerted) {
        el.removeAttribute('inert');
        el.removeAttribute('aria-hidden');
      }
      inerted = [];
    };

    /** לאן להחזיר את המיקוד ביציאה מההשתלטות, ודגל השלמה אחרי בניית המנוע */
    let focusReturn: HTMLElement | null = null;

    /** מיקוד חזרה למקום שממנו נכנסו, ואחרת לשורת השכבה הראשונה בשער */
    const focusHome = () => {
      const back = focusReturn?.isConnected ? focusReturn : shell.querySelector<HTMLElement>('.rashi-row');
      back?.focus({ preventScroll: true });
    };

    /* המנוע בונה את עצמו מחדש אחרי היציאה (לעיתים יותר מפעם אחת) ומאמץ את
       הדפים, וכל בנייה מאפסת מיקוד ל-body. לכן מחזירים את המיקוד שוב לזמן קצר,
       אך אך ורק כשהוא באמת אבד — כדי לא לחטוף מיקוד שהמשתמש העביר לאתר. */
    const focusHomeSoon = () => {
      let tries = 0;
      const tick = () => {
        if (engaged) return; // המשתמש נכנס שוב — אין מה לשחזר
        if (document.activeElement === document.body || !document.activeElement) focusHome();
        if (++tries < 5) setTimeout(tick, 200);
        else focusReturn = null;
      };
      tick();
    };

    const engage = () => {
      if (engaged) return;
      engaged = true;
      savedY = scrollY;
      const active = document.activeElement;
      focusReturn = active instanceof HTMLElement && !shell.contains(active) ? active : null;
      shell.classList.add('is-full');
      document.documentElement.classList.add('book-lock');
      exitBtn.hidden = false;
      coverSite();
      // כניסה דרך קישור עומק: המיקוד עדיין מחוץ לחוברת — מכניסים אותו פנימה
      if (!shell.contains(document.activeElement)) exitBtn.focus({ preventScroll: true });
      queueRebuild();
    };

    const disengage = () => {
      // נמדד לפני הסתרת כפתור היציאה — הסתרתו לבדה מפילה את המיקוד ל-body
      const hadFocusInside = shell.contains(document.activeElement);
      exitBtn.hidden = true;
      if (!engaged) return;
      engaged = false;
      shell.classList.remove('is-full');
      document.documentElement.classList.remove('book-lock');
      uncoverSite();
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      scrollTo(0, savedY);
      // המיקוד לא נשאר על כפתור שנעלם: חזרה למקורי, ואחרת לשער עצמו —
      // ומוחזק גם אחרי הבנייה מחדש שמאפסת מיקוד
      if (hadFocusInside) focusHomeSoon();
      queueRebuild();
    };

    const exitFull = () => {
      if (!engaged) return;
      if (turning) {
        pendingExit = true;
        return;
      }
      goto('rashi'); // "חזרה לאתר" — יציאה מלאה מההשתלטות אל שער החוברת בזרימת האתר
    };

    /* ===== ציור המצב: מונה, התקדמות, לשוניות, hash, השתלטות ===== */
    const paint = () => {
      const s = spreadOf(cur);
      const lo = s[0] + 1;
      const hi = s[s.length - 1] + 1;
      counter.textContent = s.length > 1 ? `עמודים ${lo}–${hi} מתוך ${total}` : `עמוד ${lo} מתוך ${total}`;
      progress.style.inlineSize = `${(hi / total) * 100}%`;
      navPrev.disabled = lo <= 1;
      navNext.disabled = hi >= total;
      const visIds = s.map((k) => ids[k]);
      tabs.forEach((t) => {
        const g = t.dataset.grade;
        t.classList.toggle(
          'is-current',
          visIds.some((id) => (g ? id.startsWith(`toc-${g}-`) || id.startsWith(`it-${g}-`) : id === t.dataset.jump))
        );
      });
      shell.classList.toggle('on-rashi', ids[cur] === 'rashi');
      shell.classList.toggle('on-back', ids[cur] === 'back');
      const hid = wantId && s.some((k) => ids[k] === wantId) ? wantId : ids[cur];
      history.replaceState(null, '', `#${hid}`);
      // רק שער החוברת נשאר בזרימת האתר; כל עמוד פתוח (תוכן עניינים או משאב)
      // משתלט על מלוא המסך — הניווט העליון מכוסה והחוברת שולטת בגובה (הוראת יניב 05/08/2026)
      if (ids[cur] === 'rashi') disengage();
      else engage();
      s.forEach((k) => mount(secs[k]));
      if (engaged) shell.scrollTop = 0;
      warmNeighbors();
    };

    /* ===== המנוע: בנייה לפי מידות הבמה, ובנייה מחדש בשינוי מידות ===== */
    let turning = false;
    let lastW = 0;
    let lastH = 0;

    const headerH = () =>
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 64;

    const pageSize = () => {
      // הגובה נקבע מהחלון עצמו: כל מה שנשאר אחרי הניווט והסרגלים הקומפקטיים
      if (!engaged) {
        const barH = shell.querySelector<HTMLElement>('.book-bar')!.offsetHeight;
        const navH = shell.querySelector<HTMLElement>('.book-nav')!.offsetHeight;
        const avail = Math.max(500, innerHeight - headerH() - barH - navH - 34);
        stage.style.blockSize = `${avail}px`;
      } else {
        stage.style.blockSize = '';
      }
      const r = stage.getBoundingClientRect();
      const cs = getComputedStyle(stage);
      const availW = r.width - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const availH = r.height;
      if (availW < 700) {
        // דף אחד במסך צר — כמעט כל הרוחב; במצב מלא ההטמעה מנצלת את כל הגובה
        const W = Math.max(280, Math.floor(availW - 4));
        const cap = engaged ? availH : Math.floor(W * 1.42);
        const H = Math.max(380, Math.min(availH, cap));
        return { W, H, portrait: true };
      }
      // שני דפים: כמעט כל הגובה; הרוחב נגזר עד תקרת יחס דף סבירה
      const H = Math.max(420, Math.floor(availH));
      const W = Math.max(320, Math.min(Math.floor(availW / 2) - 4, Math.floor(H * 0.96)));
      return { W, H, portrait: false };
    };

    const build = (startOur: number) => {
      const { W, H, portrait } = pageSize();
      lastW = W;
      lastH = H;
      // ה-host צמוד בדיוק למידות הספר — גאומטריית המנוע קנונית בכל מסך
      host.style.inlineSize = `${portrait ? W : W * 2}px`;
      host.style.blockSize = `${H}px`;
      shell.classList.toggle('is-portrait', portrait);
      pf?.destroy();
      // destroy() של המנוע מסיר גם את ה-host מה-DOM — מחזירים אותו לבמה
      if (!host.isConnected) stage.appendChild(host);
      host.replaceChildren(...secs); // המנוע מאמץ את הדפים מחדש בכל בנייה
      // דגל ההיפוך של המנוע הישן לא נודד לבנייה החדשה
      turning = false;
      shell.removeAttribute('data-turning');
      pf = new PageFlip(host, {
        width: W,
        height: H,
        size: 'fixed',
        startPage: k2e(startOur),
        showCover: true,
        usePortrait: true,
        autoSize: false,
        flippingTime: reduced.matches ? 1 : 680,
        maxShadowOpacity: 0.5,
        drawShadow: !reduced.matches,
        showPageCorners: !reduced.matches,
        mobileScrollSupport: true,
        clickEventForward: true,
        useMouseEvents: true,
        disableFlipByClick: true,
        swipeDistance: 24,
        startZIndex: 3,
      });
      pf.loadFromHTML(reversed);
      pf.on('flip', (e) => {
        cur = Math.min(...spreadOf(e2k(e.data as number)));
        paint();
      });
      pf.on('changeState', (e) => {
        turning = e.data !== 'read';
        shell.toggleAttribute('data-turning', turning);
        if (!turning && pendingExit) {
          pendingExit = false;
          exitFull();
        }
      });
      cur = Math.min(...spreadOf(startOur));
      shell.classList.add('is-ready');
      (shell as HTMLElement & { __pf?: unknown }).__pf = pf; // ידית לבדיקות הקבלה
      paint();
      markScrollable();
      // בנייה מחדש מאפסת turning ישירות ועוקפת את changeState — לכן משלימים כאן
      // בקשת יציאה שנרשמה בזמן היפוך/בנייה, כדי ש"חזרה לאתר" לא ייתקע (pendingExit)
      if (pendingExit) {
        pendingExit = false;
        exitFull();
      }
      // המנוע מאמץ מחדש את הדפים, ולכן אלמנט ממוקד שבתוכם מאבד מיקוד ל-body:
      // משתמש מקלדת היה מתחיל Tab מראש המסמך. מחזירים את המיקוד לתוך החוברת.
      if (engaged && !shell.contains(document.activeElement)) exitBtn.focus({ preventScroll: true });
    };

    let rebuildTimer = 0;
    const queueRebuild = () => {
      clearTimeout(rebuildTimer);
      rebuildTimer = window.setTimeout(() => {
        const { W, H } = pageSize();
        if (Math.abs(W - lastW) > 8 || Math.abs(H - lastH) > 8) build(cur);
      }, 160);
    };

    addEventListener('resize', queueRebuild);

    /* ===== ניווט ===== */
    const ourNext = () => pf?.flipPrev('bottom');
    const ourPrev = () => pf?.flipNext('bottom');

    /* הפרק שהמשתמש ביקש — נשמר בכתובת גם כשהוא הדף השמאלי בפריסה */
    let wantId = '';

    const goto = (id: string) => {
      const k = ids.indexOf(norm(id));
      if (k < 0 || !pf) return;
      wantId = ids[k];
      const target = k2e(Math.min(...spreadOf(k)));
      const d = target - pf.getCurrentPageIndex();
      // ספרד סמוך — היפוך עלה מונפש; קפיצה רחוקה — מעבר מיידי (כמו בספר)
      if (!reduced.matches && d >= -2 && d <= -1) pf.flipPrev('bottom');
      else if (!reduced.matches && d >= 1 && d <= 2) pf.flipNext('bottom');
      else pf.turnToPage(target);
    };

    const norm = (h: string) => {
      if (h === 'cover') return 'rashi';
      if (ids.includes(h)) return h;
      if (/^toc-[a-z]+$/.test(h)) return ids.find((id) => id.startsWith(`${h}-`)) ?? h;
      /* קישור עומק ישן לעמוד פרק (למשל toc-z-hozer) — המפתח מרוכז בכפולה
         אחת, ולכן הוא מפנה למפתח השכבה במקום למות בשקט (05/08/2026) */
      const m = /^(toc-[a-z]+)-/.exec(h);
      if (m && ids.includes(m[1])) return m[1];
      return h;
    };

    exitBtn.addEventListener('click', exitFull);
    navPrev.addEventListener('click', ourPrev);
    navNext.addEventListener('click', ourNext);
    shell.querySelectorAll<HTMLButtonElement>('.book-edge').forEach((b) =>
      b.addEventListener('click', () => (b.dataset.dir === 'next' ? ourNext() : ourPrev()))
    );
    // הצ'יפים, שורות השער, הלשוניות ופריטי התוכן — כולם קופצים דרך המנוע
    shell.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-jump]');
      if (b) goto(b.dataset.jump!);
    });

    // מקלדת: בעברית "קדימה" הוא שמאלה; Escape יוצא ממצב העבודה המלא
    addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 'Escape') {
        exitFull();
        return;
      }
      if (e.key === 'ArrowLeft' || e.key === 'PageDown') {
        e.preventDefault();
        ourNext();
      } else if (e.key === 'ArrowRight' || e.key === 'PageUp') {
        e.preventDefault();
        ourPrev();
      } else if (e.key === 'Home') {
        e.preventDefault();
        goto('rashi');
      } else if (e.key === 'End') {
        e.preventDefault();
        goto(ids[total - 1]);
      }
    });

    // מסך מלא אמיתי (⛶) — נפרד ממצב העבודה
    fsBtn?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      else shell.requestFullscreen?.().catch(() => {});
    });
    document.addEventListener('fullscreenchange', () => {
      if (fsBtn) fsBtn.textContent = document.fullscreenElement ? '✕' : '⛶';
      queueRebuild();
    });

    // העתקת קישור בעמודי המשאבים
    shell.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const status = btn.closest('.item-info')?.querySelector<HTMLElement>('[data-status]');
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          if (status) status.textContent = 'הקישור הועתק';
        } catch {
          if (status) status.textContent = 'ההעתקה נכשלה';
        }
      });
    });

    // עמוד פתיחה: hash עמוק גובר על ברירת המחדל של העמוד
    const fromHash = norm(location.hash.slice(1));
    const start = ids.includes(fromHash) ? fromHash : norm(shell.dataset.initial ?? 'rashi');
    build(Math.max(0, ids.indexOf(start)));
    addEventListener('hashchange', () => {
      const h = norm(location.hash.slice(1));
      if (ids.includes(h) && !spreadOf(cur).some((k) => ids[k] === h)) goto(h);
    });
  });
</script>
