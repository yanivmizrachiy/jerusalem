---
/**
 * הספר המדפדף של חטיבת הביניים (RULES 3.26, 3.29 — הוראות יניב 03/08/2026):
 * העמוד הראשי נקי עם שורות הכיתות בלבד; ברגע שמתחילים לעבוד על הספר הוא
 * משתלט על כל שטח המסך, עם כפתור זהב קבוע לחזרה לאתר; במסך רחב פריסה
 * כפולה תמיד. הדפדוף — עלה אחד רציף מעל השדרה בכיוון ספר עברי, מונע
 * פריים-אחר-פריים בלי תפר בין ההרמה לנחיתה, עם הצללת נייר על העלה וצל
 * מוטל נודד על העמודים הנייחים; גרירת דף אמיתית מאזורי השוליים משלימה או
 * מחזירה לפי מרחק ותנופה, ולחיצות מהירות מדפדפות ברצף. הדפים תופסים את
 * מרב שטח המסך — יחס עמוד גמיש בין A4 לאורך (210/297) ל־210/260 וסרגלים
 * מצומצמים בהשתלטות. מספור מודפס, לשוניות, מקלדת, מגע וקישור עומק.
 * הטמעה חכמה (3.29): preconnect למקורות, העמוד הפתוח נטען מיד, שכנים
 * מתחממים ברגעי סרק ועמוד שנטען נשאר חם; כל מה שלחיץ במקור לחיץ גם
 * בפנים — בלי שכבות מעל ההטמעה ובלי sandbox; רגישי תנועה — החלפה מיידית.
 */
import MafmarRange from './MafmarRange.astro';
import { choveret } from '../data/choveret';

interface Props {
  /** מזהה העמוד הפותח: rashi / toc-z / it-z-maf-02 ... */
  initial?: string;
}

const { initial = 'rashi' } = Astro.props;

const kindLabel: Record<string, string> = {
  site: 'אתר חי',
  doc: 'מסמך',
  drive: 'קובץ',
  pdf: 'PDF',
  canva: 'מצגת',
  flip: 'חוברת דפדוף',
  maf: 'מתוך החוזר',
  link: 'קישור',
};

interface PageDef {
  id: string;
  label: string;
}
/**
 * מבנה העמודים (הוראת יניב, 04/08/2026): תוכן העניינים של כל שכבה מפוצל
 * לעמודים אמיתיים — עמוד לכל פרק, עם כותרת מלאה של כיתה ונושא; אחרי עמודי
 * התוכן של השכבה באים עמודי המשאבים שלה. המספור נגזר אוטומטית מהנתונים.
 */
const pages: PageDef[] = [{ id: 'rashi', label: 'ראשי' }];
for (const g of choveret) {
  for (const ch of g.chapters) pages.push({ id: `toc-${g.slug}-${ch.id}`, label: `${g.title} — ${ch.title}` });
  for (const ch of g.chapters)
    for (const it of ch.items)
      if (!it.pageHref) pages.push({ id: `it-${g.slug}-${it.id}`, label: it.title });
}
const total = pages.length;
const pageNum = (id: string) => pages.findIndex((p) => p.id === id) + 1;
/** עמוד התוכן הראשון של שכבה — היעד של שורות השער ולשוניות הקפיצה */
const firstToc = (slug: string) => `toc-${slug}-${choveret.find((g) => g.slug === slug)!.chapters[0].id}`;

const site = 'https://jerusalem-virid.vercel.app';

// חיבור-מראש לכל מקורות ההטמעה החיצוניים — העמוד הראשון של כל משאב נפתח מהר (3.29)
const embedOrigins = [
  ...new Set(
    choveret
      .flatMap((g) => g.chapters.flatMap((ch) => ch.items))
      .map((it) => it.embed ?? '')
      .filter((u) => u.startsWith('https://'))
      .map((u) => new URL(u).origin)
  ),
];
---

<div class="book-shell" data-book data-initial={initial} data-total={total}>
  {embedOrigins.map((o) => <link rel="preconnect" href={o} />)}
  <!-- פס עליון קבוע: לשוניות קפיצה ומסך מלא; כפתור "חזרה לאתר" קיים
       אך ורק במצב העבודה המלא (הוראת יניב, 04/08/2026) -->
  <div class="book-bar">
    <button class="book-exit" type="button" data-exit hidden>
      <span class="book-exit-ico" aria-hidden="true">→</span>
      חזרה לאתר
    </button>
    <div class="book-tabs" role="group" aria-label="קפיצה מהירה">
      <button class="btab" type="button" data-jump="rashi">ראשי</button>
      {
        choveret.map((g) => (
          <button class="btab" type="button" data-jump={firstToc(g.slug)} data-grade={g.slug}>
            {g.letter}
          </button>
        ))
      }
    </div>
    <div class="book-tools">
      <button class="bfs" type="button" data-fullscreen aria-label="מסך מלא">⛶</button>
    </div>
  </div>

  <div class="book-stage">
    <div class="book" role="region" aria-roledescription="חוברת" aria-label="מתמטיקה לחטיבת הביניים — ספר מדפדף">
      <button class="book-edge book-edge-next" type="button" data-dir="next" tabindex="-1" aria-hidden="true"><span>‹</span></button>
      <button class="book-edge book-edge-prev" type="button" data-dir="prev" tabindex="-1" aria-hidden="true"><span>›</span></button>
      <div class="book-spine" aria-hidden="true"></div>

      <!-- העמוד הראשי — נקי, עם קווים דקים ושורות הכיתות בלבד (3.29) -->
      <section class="bpage bp-rashi" data-page="rashi" data-n="1" hidden>
        <div class="rashi-inner">
          <h2 class="rashi-title">מתמטיקה לחטיבת הביניים</h2>
          <div class="rashi-rows">
            {
              choveret.map((g) => (
                <button
                  class="rashi-row"
                  type="button"
                  data-jump={firstToc(g.slug)}
                  style={`--g-color:${g.color}; --g-dark:${g.dark}`}
                >
                  <span class:list={['rashi-letter', { 'is-wide': g.slug === 'klali' }]}>{g.letter}</span>
                  <span class="rashi-text">
                    <span class="rashi-name">{g.slug === 'klali' ? 'משותף לכל השכבות' : `כיתה ${g.letter}`}</span>
                    <span class="rashi-count">
                      <b class="rashi-count-num">{g.chapters.reduce((n, c) => n + c.items.length, 0)}</b>
                      קבצים, קישורים ופעילויות
                    </span>
                  </span>
                  <span class="rashi-dots" aria-hidden="true"></span>
                  <span class="rashi-pnum">עמוד {pageNum(firstToc(g.slug))}</span>
                </button>
              ))
            }
          </div>
        </div>
      </section>

      {
        choveret.map((g) => (
          <>
            {g.chapters.map((ch, ci) => (
              <section
                class="bpage bp-toc"
                data-page={`toc-${g.slug}-${ch.id}`}
                data-n={pageNum(`toc-${g.slug}-${ch.id}`)}
                style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}
                hidden
              >
                <header class="toc-head">
                  <h2 class="toc-title">
                    {g.title} — {ch.title}
                  </h2>
                  {ci === 0 && <p class="toc-intro">{g.intro}</p>}
                </header>
                {g.chapters.length > 1 && (
                  <nav class="toc-nav" aria-label={`תוכן העניינים של ${g.title}`}>
                    {g.chapters.map((c) => (
                      <button
                        type="button"
                        class:list={['toc-nav-chip', { 'is-here': c.id === ch.id }]}
                        style={`--nc:${c.color}; --nd:${c.dark}`}
                        data-jump={`toc-${g.slug}-${c.id}`}
                        aria-current={c.id === ch.id ? 'page' : undefined}
                      >
                        {c.title}
                        <b>{pageNum(`toc-${g.slug}-${c.id}`)}</b>
                      </button>
                    ))}
                  </nav>
                )}
                <div class="toc-chapter">
                  <ol class="toc-list">
                    {ch.items.map((item) => (
                      <li>
                        {item.pageHref ? (
                          <a class="toc-item" href={item.pageHref}>
                            <span class="toc-num" aria-hidden="true">◆</span>
                            <span class="toc-text">
                              <span class="toc-item-title">{item.title}</span>
                              {item.note && <span class="toc-item-note">{item.note}</span>}
                            </span>
                            <span class="toc-arrow" aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <button class="toc-item" type="button" data-jump={`it-${g.slug}-${item.id}`}>
                            <span class="toc-num">{pageNum(`it-${g.slug}-${item.id}`)}</span>
                            <span class="toc-text">
                              <span class="toc-item-title">{item.title}</span>
                              {item.note && <span class="toc-item-note">{item.note}</span>}
                            </span>
                            <span class="toc-arrow" aria-hidden="true">←</span>
                          </button>
                        )}
                      </li>
                    ))}
                  </ol>
                </div>
              </section>
            ))}

            {g.chapters.map((ch) =>
              ch.items
                .filter((it) => !it.pageHref)
                .map((item) => (
                  <section
                    class="bpage bp-item"
                    data-page={`it-${g.slug}-${item.id}`}
                    data-n={pageNum(`it-${g.slug}-${item.id}`)}
                    data-kind={item.kind}
                    data-toc={`toc-${g.slug}-${ch.id}`}
                    style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}
                    hidden
                  >
                    <div class="item-grid">
                      <div class="item-embed">
                        {item.kind === 'maf' && item.maf ? (
                          <MafmarRange sectionId={item.maf} accent={ch.color} />
                        ) : item.embed ? (
                          <>
                            <div class="item-frame">
                              <iframe
                                data-esrc={item.embed}
                                data-eurl={item.url}
                                data-etitle={item.title}
                                title={`${item.title} — תצוגה חיה`}
                                allow="fullscreen; clipboard-write"
                              />
                            </div>
                            {item.kind === 'pdf' && (
                              <div class="item-frame item-open-card" data-pdf-fb hidden>
                                <p>בדפדפן הזה קובצי PDF נפתחים לצפייה מלאה במסך נפרד:</p>
                                <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                                  פתיחת {item.title} ↗
                                </a>
                              </div>
                            )}
                          </>
                        ) : (
                          <div class="item-frame item-open-card">
                            <p>המשאב הזה נפתח באתר המקור:</p>
                            <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                              פתיחת {item.title} ↗
                            </a>
                          </div>
                        )}
                      </div>
                      <aside class="item-info">
                        <p class="item-chapter">{ch.title} · {g.slug === 'klali' ? 'כללי' : `כיתה ${g.letter}`}</p>
                        <h2 class="item-title">{item.title}</h2>
                        {item.note && <p class="item-note">{item.note}</p>}
                        <p class="item-kind">{kindLabel[item.kind]}</p>
                        <div class="item-actions" role="group" aria-label="פעולות">
                          {item.download && (
                            <a class="btn btn-primary" href={item.download} target="_blank" rel="noopener" download>
                              הורדה ⬇
                            </a>
                          )}
                          <a
                            class="btn btn-whatsapp"
                            href={`https://wa.me/?text=${encodeURIComponent(`${item.title} — ${g.title} — ${site}/chativat-beynayim/reader/${g.slug}/${item.id}/`)}`}
                            target="_blank"
                            rel="noopener"
                            aria-label={`שיתוף ${item.title} ב־WhatsApp`}
                          >
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                          </a>
                          <a
                            class="btn btn-gmail"
                            href={`mailto:?subject=${encodeURIComponent(item.title)}&body=${encodeURIComponent(`${item.title} — ${site}/chativat-beynayim/reader/${g.slug}/${item.id}/`)}`}
                            aria-label={`שליחת ${item.title} בדוא״ל`}
                          >
                            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                              <path fill="#4285F4" d="M1.636 20.5h3.819V11.73L0 7.64v11.223c0 .904.732 1.636 1.636 1.636Z" />
                              <path fill="#34A853" d="M18.545 20.5h3.819c.904 0 1.636-.732 1.636-1.636V7.64l-5.455 4.09Z" />
                              <path fill="#FBBC04" d="M18.545 5.457v6.273L24 7.64V6.275c0-2.023-2.309-3.178-3.927-1.964Z" />
                              <path fill="#EA4335" d="M5.455 11.73V5.457L12 10.366l6.545-4.909v6.273L12 16.639Z" />
                              <path fill="#C5221F" d="M0 6.275v1.365l5.455 4.09V5.457L4.073 4.42C2.309 3.098 0 4.252 0 6.275Z" />
                            </svg>
                          </a>
                          <button class="btn btn-ghost" type="button" data-copy={item.url.startsWith('/') ? `${site}${item.url}` : item.url}>
                            העתקת קישור
                          </button>
                          <a
                            class="btn btn-ghost"
                            href={item.url}
                            target={item.url.startsWith('/') ? undefined : '_blank'}
                            rel="noopener"
                          >
                            פתיחה במקור ↗
                          </a>
                        </div>
                        <p class="item-status" data-status role="status" aria-live="polite"></p>
                      </aside>
                    </div>
                  </section>
                ))
            )}
          </>
        ))
      }
    </div>
  </div>

  <!-- סרגל הדפדוף -->
  <div class="book-nav" role="group" aria-label="דפדוף בספר">
    <button class="bnav bnav-prev" type="button">
      <span class="bnav-arrow" aria-hidden="true">→</span> דף קודם
    </button>
    <div class="book-meter">
      <span class="book-counter" data-counter aria-live="polite">עמוד 1 מתוך {total}</span>
      <span class="book-progress"><span class="book-progress-fill" data-progress></span></span>
    </div>
    <button class="bnav bnav-next" type="button">
      דף הבא <span class="bnav-arrow" aria-hidden="true">←</span>
    </button>
  </div>
</div>

<style is:global>
  /* בזמן ההשתלטות על המסך — האתר שמאחור לא נגלל ואין מסילת גלילה */
  html.book-lock,
  html.book-lock body {
    overflow: hidden;
    scrollbar-gutter: auto;
  }
</style>

<style>
  /* הספר פרוס לרוחב מלא מתוך המיכל (3.29) */
  .book-shell {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-block: 1.2rem 2rem;
    inline-size: min(100vw - clamp(0.8rem, 3vw, 3rem) * 2, 1680px);
    margin-inline: calc((100% - min(100vw - clamp(0.8rem, 3vw, 3rem) * 2, 1680px)) / 2);
  }

  /* השתלטות על כל שטח המסך (3.29): שכבה קבועה מעל כל האתר */
  .book-shell.is-full {
    position: fixed;
    inset: 0;
    z-index: 90;
    margin: 0;
    inline-size: auto;
    padding: clamp(0.35rem, 1.2vh, 0.7rem) clamp(0.5rem, 1.4vw, 1.1rem);
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-soft) 100%);
    gap: 0.55rem;
    overflow: hidden;
    overscroll-behavior: contain;
  }

  /* ===== הפס העליון ===== */
  .book-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* כפתור הזהב "חזרה לאתר" — קיים אך ורק במצב העבודה המלא (הוראת יניב,
     04/08/2026); במצב שער ותוכן עניינים הוא hidden לחלוטין */
  .book-exit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 50px;
    padding: 0.55rem 1.35rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, #f3d68b 0%, #d4af5c 100%);
    color: #3c2f12;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 12px 26px -12px rgb(176 141 62 / 0.85);
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease);
  }

  .book-exit[hidden] { display: none; }

  .book-exit:hover { transform: translateY(-3px); color: #241b08; box-shadow: 0 16px 32px -12px rgb(176 141 62 / 0.95); }

  .book-exit-ico { font-size: 1.25em; line-height: 1; }

  .book-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-inline: auto;
  }

  .btab {
    min-block-size: 40px;
    min-inline-size: 46px;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
    font-weight: 800;
    cursor: pointer;
    transition: background-color 250ms var(--ease), color 250ms var(--ease);
  }

  .btab.is-current {
    background: linear-gradient(180deg, #16273f 0%, #0e1c31 100%);
    border-color: var(--gold);
    color: #f3d68b;
  }

  .book-tools { display: flex; align-items: center; gap: 0.6rem; }

  .bfs {
    flex: none;
    inline-size: 50px;
    block-size: 50px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--gold-deep);
    font-size: 1.3rem;
    cursor: pointer;
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease);
  }

  .bfs:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }

  /* בהשתלטות הסרגלים מצטמצמים — הדפים מקבלים את מרב הגובה (3.29) */
  .is-full .book-bar { gap: 0.55rem; }
  .is-full .book-exit { min-block-size: 44px; padding: 0.4rem 1.1rem; font-size: 0.95rem; }
  .is-full .btab { min-block-size: 34px; min-inline-size: 40px; padding: 0.15rem 0.7rem; font-size: 0.92rem; }
  .is-full .bfs { inline-size: 44px; block-size: 44px; font-size: 1.15rem; }
  .is-full .book-nav { gap: 0.7rem; }
  .is-full .bnav { min-block-size: 44px; padding: 0.45rem 1.15rem; font-size: 0.95rem; }
  .is-full .book-meter { gap: 0.2rem; }
  .is-full .book-counter { font-size: 0.8rem; }
  .is-full .book-progress { block-size: 5px; }

  /* ===== במת הספר — הדפים ממלאים את הגובה הפנוי ===== */
  .book-stage {
    position: relative;
    container-type: size;
    block-size: max(560px, calc(100dvh - var(--header-h) - 176px));
    display: grid;
    place-items: center;
  }

  .is-full .book-stage { flex: 1; min-block-size: 0; block-size: auto; }

  /* הדפים תופסים את מרב שטח המסך (3.29, הוראת יניב 03/08/2026): יחס
     העמוד גמיש בין A4 לאורך (210/297) לגבול מעט רחב יותר (210/260) —
     כשהבמה בתוך הטווח הספר ממלא אותה במלואה, ומעבר לו נצמד לגבול הקרוב.
     touch-action: גלילה אנכית חופשית — החלקה אופקית שמורה לדפדוף */
  .book { position: relative; perspective: 2200px; touch-action: pan-y pinch-zoom; }

  .mode-1 .book {
    block-size: min(100cqb, calc(100cqi * 297 / 210));
    inline-size: min(100cqi, calc(100cqb * 210 / 260));
  }

  /* פריסה כפולה ועמוד משאב רחב — אותן מידות ספר-פתוח, בלי קפיצות בדפדוף */
  .mode-2 .book,
  .book-shell.has-wide .book {
    block-size: min(100cqb, calc(100cqi * 297 / 420));
    inline-size: min(100cqi, calc(100cqb * 420 / 260));
  }

  /* במצב העבודה המלא הספר ממלא את כל השטח הפנוי — כמעט כל הרוחב וכמעט
     כל הגובה אחרי הסרגלים הקומפקטיים (הוראת יניב, 04/08/2026) */
  .book-shell.is-full .book,
  .book-shell.is-full.has-wide .book {
    block-size: 100cqb;
    inline-size: 100cqi;
  }

  /* אזורי דפדוף שקטים בשולי הדף — הקשה מדפדפת, גרירה אוחזת את העלה */
  .book-edge {
    position: absolute;
    inset-block: 0;
    inline-size: 34px;
    z-index: 4;
    border: 0;
    background: none;
    cursor: grab;
    touch-action: none;
    display: grid;
    place-items: center;
    color: transparent;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .book-edge:active { cursor: grabbing; }

  .book-edge-next { left: 0; border-radius: 18px 0 0 18px; }
  .book-edge-prev { right: 0; border-radius: 0 18px 18px 0; }

  /* בעמוד משאב שום שכבה של החוברת לא יושבת מעל ההטמעה — הקישורים
     שבפנים לחיצים תמיד, עד הפיקסל האחרון (3.29). ההטמעה היא החצי הימני,
     ולכן רק אזור הקצה הימני כבוי; הקצה השמאלי (מעל חצי המידע) ממשיך
     לדפדף ולגרור */
  .book-shell.on-embed .book-edge-prev { display: none; }

  .book-edge:hover {
    color: var(--gold-deep);
    background: linear-gradient(90deg, rgb(212 175 92 / 0.18), transparent);
  }

  .book-edge-prev:hover { background: linear-gradient(270deg, rgb(212 175 92 / 0.18), transparent); }

  /* השדרה באמצע הספר הפתוח */
  .book-spine { display: none; }

  /* השער: דף יחיד ענק לאורך — בלי שדרה, בלי ערימת דפים, בלי מראה של ספר פתוח
     (3.29, הוראת יניב 03/08/2026) */
  .book-shell.on-rashi .book-spine,
  .book-shell.on-rashi .book::before,
  .book-shell.on-rashi .book::after {
    display: none !important;
  }

  /* השער גדול ורחב ככל שניתן במסגרת יחס עמוד עומד (הוראת יניב, 04/08/2026) */
  .book-shell.on-rashi .book {
    aspect-ratio: 210 / 262;
    inline-size: auto;
    max-inline-size: min(96vw, 100%);
    margin-inline: auto;
  }

  .book-shell.on-rashi .bpage {
    border-radius: 18px;
    box-shadow: 0 26px 60px -28px rgb(31 41 61 / 0.45);
  }

  .mode-2 .book-spine,
  .book-shell.has-wide .book-spine {
    display: block;
    position: absolute;
    inset-block: 0;
    left: calc(50% - 28px);
    inline-size: 56px;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(31 25 12 / 0.1) 38%,
      rgb(31 25 12 / 0.2) 50%,
      rgb(31 25 12 / 0.1) 62%,
      transparent
    );
  }

  /* מספור מודפס בצד הימני ובצד השמאלי (3.29) — נגזר אוטומטית מתוכן הספר;
     גדול, ברור ונוח מאוד לקריאה (הוראת יניב, 04/08/2026) */
  .book :global(.bp-num) {
    position: absolute;
    inset-block-end: 10px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    pointer-events: none;
  }

  .book :global(.bp-num-l) { left: 18px; }
  .book :global(.bp-num-r) { right: 18px; }
  .bpage :global(.bp-num-r) { display: none; }
  .mode-2 .bpage.pg-right :global(.bp-num-r) { display: block; }
  .mode-2 .bpage.pg-right :global(.bp-num-l) { display: none; }
  .bpage.pg-wide :global(.bp-num-r) { display: block; }

  .bpage {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: linear-gradient(180deg, #fffdf9 0%, #fbf7ee 100%);
    border: 1px solid var(--line);
    border-radius: 18px 6px 6px 18px;
    box-shadow:
      -1px 0 0 #e7ddc8,
      -3px 0 0 #f2ead8,
      -5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    padding: clamp(1rem, 2.2vw, 1.7rem);
    transform-origin: 100% 50%; /* השדרה מימין — ספר עברי */
    backface-visibility: hidden;
  }

  .bpage[hidden] { display: none; }

  /* פריסה כפולה: העמוד הימני והשמאלי משני צידי השדרה */
  .mode-2 .bpage.pg-right {
    inset: 0 0 0 50%;
    border-radius: 4px 18px 18px 4px;
    box-shadow:
      1px 0 0 #e7ddc8,
      3px 0 0 #f2ead8,
      5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    transform-origin: 0% 50%; /* השדרה בקצה השמאלי של העמוד הימני */
  }

  .mode-2 .bpage.pg-left {
    inset: 0 50% 0 0;
    border-radius: 18px 4px 4px 18px;
    box-shadow:
      -1px 0 0 #e7ddc8,
      -3px 0 0 #f2ead8,
      -5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    transform-origin: 100% 50%; /* השדרה בקצה הימני של העמוד השמאלי */
  }

  /* עמוד משאב: נפרס על כל רוחב הספר — המסך נחלק ימין/שמאל (3.29) */
  .bpage.pg-wide {
    inset: 0;
    border-radius: 18px;
    box-shadow:
      -1px 0 0 #e7ddc8,
      -3px 0 0 #f2ead8,
      -5px 0 0 #e7ddc8,
      1px 0 0 #e7ddc8,
      3px 0 0 #f2ead8,
      5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
    transform-origin: 100% 50%;
  }

  .bpage.pg-wide .item-grid { column-gap: 56px; }

  /* עמוד חלק מול עמוד בודד — כמו בספר אמיתי */
  .mode-2 .book::before,
  .mode-2 .book::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inline-size: 50%;
    z-index: 0;
    background: linear-gradient(180deg, #fdfaf3 0%, #f7f1e3 100%);
    border: 1px solid var(--line);
  }

  .mode-2 .book::before { left: 0; border-radius: 18px 4px 4px 18px; }
  .mode-2 .book::after { right: 0; border-radius: 4px 18px 18px 4px; }

  /* הצללת הנייר על העלה המתהפך — המנוע קובע עומק (--shade) וכיוון
     (--shade-dir: הצד הכהה פונה לשדרה) פריים-אחר-פריים */
  .bpage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--shade, 0);
    background: linear-gradient(
      var(--shade-dir, 270deg),
      rgb(31 25 12 / 0.5),
      rgb(31 25 12 / 0.12) 55%,
      transparent 85%
    );
  }

  /* הצל שהעלה מטיל על העמודים הנייחים — מתעבה לקראת האנך ונמוג בנחיתה */
  .book :global(.book-cast) {
    position: absolute;
    inset-block: 0;
    inline-size: 50%;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
  }

  .book :global(.book-cast-l) {
    left: 0;
    background: linear-gradient(270deg, rgb(28 22 10 / 0.5), rgb(28 22 10 / 0.1) 60%, transparent 88%);
  }

  .book :global(.book-cast-r) {
    right: 0;
    background: linear-gradient(90deg, rgb(28 22 10 / 0.5), rgb(28 22 10 / 0.1) 60%, transparent 88%);
  }

  /* עלה חלק — כשמול דף בודד אין בן-זוג, מתהפך עמוד ריק כמו בספר אמיתי */
  .book :global(.bleaf) {
    position: absolute;
    inset: 0 50% 0 0;
    z-index: 1;
    background: linear-gradient(180deg, #fdfaf3 0%, #f7f1e3 100%);
    border: 1px solid var(--line);
    border-radius: 18px 4px 4px 18px;
    transform-origin: 100% 50%;
    backface-visibility: hidden;
  }

  .book :global(.bleaf[hidden]) { display: none; }

  .book :global(.bleaf)::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--shade, 0);
    background: linear-gradient(
      var(--shade-dir, 270deg),
      rgb(31 25 12 / 0.5),
      rgb(31 25 12 / 0.12) 55%,
      transparent 85%
    );
  }

  /* ===== דפדוף אמיתי (הוראת יניב, 04/08/2026): העלה מתהפך מעל השדרה =====
     שלב א׳ — הדף היוצא מתרומם עד ניצב; שלב ב׳ — הדף הנכנס נוחת ממנו.
     בספר עברי קדימה = העלה השמאלי עובר ימינה מעל השדרה, ולהפך אחורה.
     ההצללה (::after דרך --shade) נותנת לעלה הנע עומק נייר. */
  .bpage.sp-out-l { animation: leaf-out-l 300ms cubic-bezier(0.55, 0, 0.85, 0.4) forwards; }
  .bpage.sp-out-r { animation: leaf-out-r 300ms cubic-bezier(0.55, 0, 0.85, 0.4) forwards; }
  .bpage.sp-in-r { animation: leaf-in-r 340ms cubic-bezier(0.15, 0.6, 0.3, 1) backwards; }
  .bpage.sp-in-l { animation: leaf-in-l 340ms cubic-bezier(0.15, 0.6, 0.3, 1) backwards; }

  .bpage.sp-out-l,
  .bpage.sp-in-l { --shade: 0.4; }

  .bpage.sp-out-r,
  .bpage.sp-in-r { --shade: 0.4; --shade-dir: 90deg; }

  @keyframes leaf-out-l { to { transform: rotateY(89deg); } }
  @keyframes leaf-out-r { to { transform: rotateY(-89deg); } }
  @keyframes leaf-in-r { from { transform: rotateY(-89deg); } }
  @keyframes leaf-in-l { from { transform: rotateY(89deg); } }

  /* מעבר שמערב עמוד רחב (שער/משאב) — הגיליון מסתובב סביב השדרה שבמרכזו */
  .bpage.turn-out,
  .bpage.turn-out-back,
  .bpage.turn-in,
  .bpage.turn-in-back { transform-origin: 50% 50%; }

  .bpage.turn-out { animation: page-turn-out 460ms cubic-bezier(0.6, 0, 0.8, 0.5) forwards; }
  .bpage.turn-out-back { animation: page-turn-out-back 460ms cubic-bezier(0.6, 0, 0.8, 0.5) forwards; }
  .bpage.turn-in { animation: page-turn-in 460ms cubic-bezier(0.16, 0.6, 0.3, 1) backwards; }
  .bpage.turn-in-back { animation: page-turn-in-back 460ms cubic-bezier(0.16, 0.6, 0.3, 1) backwards; }

  @keyframes page-turn-out { to { transform: rotateY(74deg); opacity: 0; } }
  @keyframes page-turn-out-back { to { transform: rotateY(-74deg); opacity: 0; } }
  @keyframes page-turn-in { from { transform: rotateY(-74deg); opacity: 0; } }
  @keyframes page-turn-in-back { from { transform: rotateY(74deg); opacity: 0; } }

  /* מסך צר: הדפים בזרימה — היוצא מוסתר מיד והנכנס נכנס בעמעום עדין,
     בלי ערימת דפים */
  .bpage.fade-out { animation: bk-fade-out 150ms var(--ease) forwards; }
  .bpage.fade-in { animation: bk-fade-in 300ms var(--ease) backwards; }

  @keyframes bk-fade-out { to { opacity: 0; } }
  @keyframes bk-fade-in { from { opacity: 0; } }

  @media (max-width: 880px) {
    .bpage.turn-out,
    .bpage.turn-out-back { display: none; }

    .bpage.turn-in,
    .bpage.turn-in-back { animation: bk-fade-in 300ms var(--ease) backwards; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bpage.fade-out,
    .bpage.fade-in,
    .bpage.sp-out-l,
    .bpage.sp-out-r,
    .bpage.sp-in-l,
    .bpage.sp-in-r,
    .bpage.turn-out,
    .bpage.turn-out-back,
    .bpage.turn-in,
    .bpage.turn-in-back {
      animation: none;
    }
  }

  /* ===== העמוד הראשי — מודרני, נקי, קווים דקים לכל האורך (3.29) ===== */
  .bp-rashi { display: grid; place-items: center; }

  .bp-rashi::before {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid rgb(176 141 62 / 0.38);
    border-radius: 12px;
    pointer-events: none;
  }

  .rashi-inner {
    inline-size: 100%;
    max-inline-size: min(92%, 660px);
    padding-inline: clamp(0.4rem, 2cqi, 1.4rem);
  }

  .rashi-title {
    margin: 0 0 1.6rem;
    text-align: center;
    font-size: clamp(1.5rem, 6.5cqi, 2.5rem);
    color: var(--ink);
  }

  .rashi-title::after {
    content: '';
    display: block;
    inline-size: 100%;
    block-size: 2px;
    margin-block-start: 1rem;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .rashi-rows { border-block-end: 1px solid var(--line); }

  .rashi-row {
    inline-size: 100%;
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2.4cqi, 1.1rem);
    padding: clamp(0.7rem, 2.2cqb, 1.1rem) 0.4rem;
    border: 0;
    border-block-start: 1px solid var(--line);
    background: none;
    color: var(--ink);
    text-align: start;
    font: inherit;
    cursor: pointer;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .rashi-row:hover {
    background: color-mix(in srgb, var(--g-color, var(--gold)) 9%, #fff);
    transform: translateX(-4px);
  }

  .rashi-letter {
    flex: none;
    min-inline-size: 3.1em;
    block-size: 3.1em;
    display: grid;
    place-items: center;
    padding-inline: 0.45em;
    border: 2px solid var(--g-color, var(--gold));
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 3.4cqi, 1.45rem);
    font-weight: 700;
    color: var(--g-dark, var(--gold-deep));
    line-height: 1;
    background: color-mix(in srgb, var(--g-color, var(--gold)) 8%, #fff);
  }

  .rashi-letter.is-wide { font-size: clamp(0.85rem, 2.6cqi, 1.05rem); }

  .rashi-text { display: flex; flex-direction: column; gap: 0.15rem; min-inline-size: 0; }

  .rashi-name { font-weight: 800; font-size: clamp(1.02rem, 3cqi, 1.25rem); }

  .rashi-count {
    font-size: clamp(0.78rem, 2.2cqi, 0.9rem);
    color: var(--ink-soft);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }

  /* מספר הקבצים — גופן תלת-ממד ברור ובולט (3.29, הוראת יניב 03/08/2026) */
  .rashi-count-num {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4cqi, 1.8rem);
    font-weight: 800;
    line-height: 1;
    color: var(--g-color, var(--gold));
    text-shadow:
      1px 1px 0 var(--g-dark, var(--gold-deep)),
      2px 2px 0 var(--g-dark, var(--gold-deep)),
      3px 3px 0 color-mix(in srgb, var(--g-dark, var(--gold-deep)) 55%, transparent),
      4px 5px 8px rgb(31 25 12 / 0.35);
  }

  /* מוביל נקודות עד מספר העמוד — כמו בתוכן עניינים של חוברת אמיתית */
  .rashi-dots {
    flex: 1;
    min-inline-size: 24px;
    border-block-end: 2px dotted color-mix(in srgb, var(--g-color, var(--gold)) 55%, transparent);
    margin-inline: 0.5rem;
    transform: translateY(-0.35em);
  }

  .rashi-pnum {
    flex: none;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 2.4cqi, 1rem);
    font-weight: 700;
    color: var(--g-dark, var(--gold-deep));
    font-variant-numeric: tabular-nums;
  }


  /* ===== תוכן עניינים — עמוד לכל פרק, כותרת מלאה של כיתה ונושא
     (הוראת יניב, 04/08/2026) ===== */
  .toc-head { margin-block-end: 1rem; }

  .toc-title {
    margin: 0 0 0.6rem;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius);
    background: linear-gradient(120deg, var(--ch-color), color-mix(in srgb, var(--ch-color) 72%, #000));
    color: #fff;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    line-height: 1.3;
  }

  .toc-intro { margin: 0; color: var(--ink-soft); }

  /* תוכן עניינים לחיץ של השכבה — פרקי השכבה עם מספרי העמודים, בכל עמוד
     תוכן (הוראת יניב, 04/08/2026): קפיצה מיידית בין הפרקים כמו בחוברת
     אמיתית; הפרק הנוכחי מודגש בצבעו */
  .toc-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-end: 1rem;
  }

  .toc-nav-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 38px;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid color-mix(in srgb, var(--nc) 55%, #fff);
    background: color-mix(in srgb, var(--nc) 7%, #fff);
    color: var(--nd);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .toc-nav-chip:hover {
    background: color-mix(in srgb, var(--nc) 16%, #fff);
    transform: translateY(-2px);
  }

  .toc-nav-chip.is-here {
    background: linear-gradient(120deg, var(--nc), color-mix(in srgb, var(--nc) 72%, #000));
    border-color: var(--nc);
    color: #fff;
    cursor: default;
  }

  .toc-nav-chip b {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    opacity: 0.9;
  }

  .toc-chapter {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1.5px solid color-mix(in srgb, var(--ch-color) 45%, #fff);
    box-shadow: 0 14px 34px -22px color-mix(in srgb, var(--ch-color) 55%, transparent);
    background: #fff;
    margin-block-end: 1.1rem;
  }

  .toc-list { list-style: none; margin: 0; padding: 0.35rem 0.45rem 0.45rem; }

  .toc-item {
    inline-size: 100%;
    text-align: start;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.7rem;
    border: 0;
    background: none;
    border-radius: var(--radius);
    color: var(--ink);
    min-block-size: 50px;
    cursor: pointer;
    font: inherit;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .toc-item:hover {
    background: color-mix(in srgb, var(--ch-color) 8%, #fff);
    transform: translateX(-4px);
  }

  .toc-num {
    flex: none;
    inline-size: 2.2em;
    block-size: 2.2em;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--ch-color);
    color: var(--ch-dark);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    font-size: 1rem;
  }

  .toc-text { display: flex; flex-direction: column; gap: 0.05rem; min-inline-size: 0; }
  .toc-item-title { font-weight: 700; }
  .toc-item-note { font-size: 0.83rem; color: var(--ink-soft); }
  .toc-arrow { margin-inline-start: auto; color: var(--ch-dark); font-weight: 800; }

  /* ===== עמוד משאב ===== */
  .bp-item {
    border-block-start: 6px solid var(--ch-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .bp-item .item-grid { flex: 1; }

  /* חצי ימין — הטמעה, חצי שמאל — מידע (3.29, 8.2) */
  .item-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(0.8rem, 2vw, 1.4rem);
    block-size: 100%;
  }

  .item-embed { min-block-size: 0; display: flex; flex-direction: column; }

  .item-info { min-block-size: 0; overflow-y: auto; }

  /* במסך רחב עמוד משאב הוא spread אמיתי (הוראת יניב, 04/08/2026): שני
     דפי ספר נפרדים משני צידי השדרה — דף ימין להטמעה, דף שמאל למידע
     ולפעולות; לא מלבן אחד רחב המחולק לשתי עמודות */
  .bpage.pg-wide.bp-item {
    background: none;
    border: 0;
    border-block-start: 0;
    box-shadow: none;
    padding: 0;
    overflow: visible;
  }

  .pg-wide.bp-item .item-embed,
  .pg-wide.bp-item .item-info {
    background: linear-gradient(180deg, #fffdf9 0%, #fbf7ee 100%);
    border: 1px solid var(--line);
    border-block-start: 6px solid var(--ch-color);
    padding: clamp(0.9rem, 1.6vw, 1.4rem);
  }

  /* הדף הימני — ההטמעה; השדרה בקצהו השמאלי */
  .pg-wide.bp-item .item-embed {
    border-radius: 4px 18px 18px 4px;
    box-shadow:
      1px 0 0 #e7ddc8,
      3px 0 0 #f2ead8,
      5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
  }

  /* הדף השמאלי — כותרת, הסבר ופעולות; השדרה בקצהו הימני */
  .pg-wide.bp-item .item-info {
    border-radius: 18px 4px 4px 18px;
    box-shadow:
      -1px 0 0 #e7ddc8,
      -3px 0 0 #f2ead8,
      -5px 0 0 #e7ddc8,
      0 26px 60px -28px rgb(31 41 61 / 0.45);
  }

  .item-frame {
    position: relative;
    padding: 10px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgb(250 246 236 / 0.95) 0%, rgb(240 233 216 / 0.78) 45%, rgb(252 249 242 / 0.92) 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      inset 0 0 0 2px rgb(176 141 62 / 0.4),
      0 18px 44px -22px rgb(31 41 61 / 0.4);
    flex: 1;
    min-block-size: 0;
  }

  .item-frame iframe {
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    display: block;
    border-radius: 14px;
    background: #fff;
  }

  .item-open-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    block-size: auto;
    min-block-size: 240px;
  }

  .item-open-card p { margin: 0; font-weight: 600; color: var(--ink-soft); }

  .item-chapter { margin: 0 0 0.3rem; font-size: 0.8rem; font-weight: 800; color: var(--ch-dark); }
  .item-title { margin: 0 0 0.4rem; font-size: clamp(1.2rem, 2.4vw, 1.5rem); }
  .item-note { margin: 0 0 0.6rem; color: var(--ink-soft); line-height: 1.55; }

  .item-kind {
    display: inline-block;
    margin: 0 0 0.9rem;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    border: 1.5px solid var(--ch-dark);
    color: var(--ch-dark);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .item-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

  .item-status { min-block-size: 1.2em; margin: 0.45rem 0 0; font-size: 0.86rem; font-weight: 600; color: var(--olive); }

  /* ===== סרגל הדפדוף ===== */
  .book-nav {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .bnav {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 54px;
    padding: 0.7rem 1.4rem;
    border: 0;
    border-radius: 999px;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease), opacity 200ms var(--ease);
  }

  .bnav[disabled] { opacity: 0.4; cursor: not-allowed; }

  .bnav-prev {
    background: linear-gradient(180deg, #8e2740 0%, #7a1f33 100%);
    box-shadow: 0 8px 20px -10px rgb(122 31 51 / 0.7);
  }

  .bnav-next {
    background: linear-gradient(180deg, #0f6b3a 0%, #0b5d31 100%);
    box-shadow: 0 8px 20px -10px rgb(11 93 49 / 0.7);
  }

  .bnav:not([disabled]):hover { transform: translateY(-3px); }

  .bnav-arrow { font-size: 1.2em; }

  .book-meter {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    min-inline-size: 0;
  }

  .book-counter { font-weight: 800; font-size: 1.02rem; color: var(--ink); font-variant-numeric: tabular-nums; }

  .book-progress {
    inline-size: min(100%, 340px);
    block-size: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--gold) 22%, #fff);
    overflow: hidden;
  }

  .book-progress-fill {
    display: block;
    block-size: 100%;
    inline-size: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--gold-deep), var(--gold));
    transition: inline-size 400ms var(--ease);
  }

  /* נייד: עמוד אחד, זרימה טבעית, סרגלים נגישים לאגודל */
  @media (max-width: 880px) {
    .book-stage { container-type: normal; block-size: auto; display: block; }
    .mode-1 .book,
    .mode-2 .book,
    .book-shell.has-wide .book { block-size: auto; aspect-ratio: auto; min-block-size: 62vh; }
    .bpage { position: relative; inset: auto; }
    .bp-rashi { min-block-size: 62vh; }
    .book-edge { display: none; }
    .bp-item { display: block; overflow-y: auto; }
    /* בנייד הדף זורם טבעי — ההטמעה תחילה (8.6) ומקבלת את מרב השטח:
       שוליים מצומצמים וגובה יציב (svh — לא קופץ עם סרגל הדפדפן) */
    .bpage { padding: 0.9rem 0.7rem; }
    .item-grid { grid-template-columns: 1fr; block-size: auto; }
    .item-frame { flex: none; padding: 6px; border-radius: 16px; block-size: clamp(480px, 68svh, 820px); }
    .item-frame iframe { border-radius: 11px; }
    .book-nav { flex-wrap: wrap; justify-content: center; }
    .bnav { flex: 1; justify-content: center; min-inline-size: 140px; }
    .book-meter { order: 3; inline-size: 100%; }
    .book-shell.is-full { overflow: auto; }
    .is-full .book-stage { flex: none; }
    .is-full .book-bar {
      position: sticky;
      inset-block-start: 0;
      z-index: 7;
      background: var(--paper);
      padding-block: 0.4rem;
    }
    .is-full .book-nav {
      position: sticky;
      inset-block-end: 0;
      z-index: 7;
      background: var(--paper);
      padding-block: 0.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-book]').forEach((shell) => {
    const pages = [...shell.querySelectorAll<HTMLElement>('.bpage')];
    const ids = pages.map((p) => p.dataset.page!);
    const total = pages.length;
    const navPrev = shell.querySelector<HTMLButtonElement>('.bnav-prev')!;
    const navNext = shell.querySelector<HTMLButtonElement>('.bnav-next')!;
    const counter = shell.querySelector<HTMLElement>('[data-counter]')!;
    const progress = shell.querySelector<HTMLElement>('[data-progress]')!;
    const tabs = [...shell.querySelectorAll<HTMLButtonElement>('.btab')];
    const exitBtn = shell.querySelector<HTMLButtonElement>('[data-exit]')!;
    const fsBtn = shell.querySelector<HTMLButtonElement>('[data-fullscreen]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = matchMedia('(max-width: 880px)');

    let cur = -1;
    let busy = false;
    let engaged = false;
    let savedY = 0;
    let mode: 1 | 2 = 2;
    /** עמוד תוכן העניינים האחרון שנצפה — היעד של "חזרה לאתר" ממשאב פתוח */
    let lastToc = '';

    // תמיד תצוגה מקסימלית: שני עמודים במסך רחב, עמוד אחד במסך צר (3.29)
    const prefMode = (): 1 | 2 => (narrow.matches ? 1 : 2);

    // מספור מודפס בצד הימני ובצד השמאלי — נגזר מהתוכן; העמוד הראשי בלי מספר
    pages.forEach((p) => {
      if (p.dataset.page === 'rashi') return;
      for (const side of ['bp-num-l', 'bp-num-r']) {
        const n = document.createElement('span');
        n.className = `bp-num ${side}`;
        n.textContent = `עמוד ${p.dataset.n}`;
        p.appendChild(n);
      }
    });

    // ההטמעה נטענת רק כשהעמוד נפתח, ועמוד שנטען נשאר חם (3.29).
    // דפדפן בלי מציג PDF מובנה (בעיקר אנדרואיד) — כרטיס פתיחה אמיתי
    // במקום מסגרת ריקה (8.8)
    const noPdfViewer = 'pdfViewerEnabled' in navigator && !navigator.pdfViewerEnabled;
    const mount = (p: HTMLElement) => {
      if (noPdfViewer && p.dataset.kind === 'pdf') {
        const fb = p.querySelector<HTMLElement>('[data-pdf-fb]');
        const frame = p.querySelector<HTMLElement>('iframe[data-esrc]')?.closest<HTMLElement>('.item-frame');
        if (fb && frame) {
          frame.hidden = true;
          fb.hidden = false;
        }
        return;
      }
      p.querySelectorAll<HTMLIFrameElement>('iframe[data-esrc]').forEach((f) => {
        const esrc = f.dataset.esrc!;
        // הטמעות הפרוקסי המחוזי הן same-origin: דף אמיתי נושא את חותם המשמר
        // (window.__EM_PROXY__ מ-proxyGuard.ts). דף בלי חותם הוא דף שגיאה —
        // סביבה סטטית בלי פונקציות (שרת הבדיקות בפורט 4321) או כשל במקור —
        // ובמקומו מוצג כרטיס פתיחה אמיתי, לא 404 חשוף בתוך מסגרת (8.8).
        if (esrc.startsWith('/api/')) {
          f.addEventListener('load', () => {
            let dead = false;
            try {
              const w = f.contentWindow as (Window & { __EM_PROXY__?: 1 }) | null;
              dead =
                !!w &&
                w.location.href !== 'about:blank' &&
                w.location.origin === location.origin &&
                !w.__EM_PROXY__;
            } catch {
              /* חוצה-מקור — האפליקציה ניווטה למקור אחר; אין שיפוט */
            }
            if (!dead) return;
            const frame = f.closest<HTMLElement>('.item-frame');
            if (!frame || frame.dataset.fb) return;
            frame.dataset.fb = '1';
            frame.classList.add('item-open-card');
            const msg = document.createElement('p');
            msg.textContent = 'התצוגה החיה אינה זמינה כאן כרגע — האתר נפתח בחלון חדש:';
            const open = document.createElement('a');
            open.className = 'btn btn-primary';
            open.href = f.dataset.eurl ?? '#';
            open.target = '_blank';
            open.rel = 'noopener';
            open.textContent = `פתיחת ${f.dataset.etitle ?? 'האתר'} ↗`;
            frame.replaceChildren(msg, open);
          });
        }
        f.src = esrc;
        f.removeAttribute('data-esrc');
      });
    };

    // הטמעה חכמה: אחרי שהעמוד הפתוח נטען, העמודים השכנים מתחממים בשקט
    // ברגעי סרק — הדפדוף הבא מציג הטמעה שכבר חיה. רשת חסכונית לא מחוממת.
    const conn = (navigator as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const idle: (cb: () => void) => void =
      'requestIdleCallback' in window ? (cb) => requestIdleCallback(cb, { timeout: 2500 }) : (cb) => setTimeout(cb, 600);
    let warmTimer = 0;
    const warmNeighbors = () => {
      clearTimeout(warmTimer);
      if (conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
      warmTimer = window.setTimeout(
        () =>
          idle(() => {
            const around =
              mode === 1
                ? [cur + 1, cur - 1]
                : [...(views2[view2Of[cur] + 1] ?? []), ...(views2[view2Of[cur] - 1] ?? [])];
            for (const k of around) if (k >= 0 && k < total) mount(pages[k]);
          }),
        900
      );
    };

    const ANIM = [
      'pg-left',
      'pg-right',
      'pg-wide',
      'fade-out',
      'fade-in',
      'turn-in',
      'turn-in-back',
      'turn-out',
      'turn-out-back',
      'sp-in-l',
      'sp-in-r',
      'sp-out-l',
      'sp-out-r',
    ];

    // מצב "עלה באוויר" — חשוף כ-attribute לצורכי CSS ובדיקות דטרמיניסטיות.
    // יציאה (Escape / "חזרה לאתר") שנלחצה באמצע היפוך אינה נבלעת — היא
    // נדחית ומבוצעת מיד בנחיתת העלה.
    let pendingExit = false;
    const setBusy = (b: boolean) => {
      busy = b;
      shell.toggleAttribute('data-turning', b);
      if (!b && pendingExit) {
        pendingExit = false;
        exitFull();
      }
    };

    // תצוגת שני עמודים (3.29): עמוד משאב נפרס על שני חצאי המסך — ההטמעה
    // מימין והמידע משמאל; עמודי שער ותוכן סמוכים מזדווגים, ועמוד בודד
    // נפתח מימין מול עמוד חלק
    const isItem = (k: number) => ids[k].startsWith('it-');
    const views2: number[][] = [];
    {
      let k = 0;
      while (k < total) {
        // עמוד השער תמיד לבדו — נפתח כעמוד יחיד רחב (הוראת יניב, 03/08/2026)
        if (k !== 0 && !isItem(k) && k + 1 < total && !isItem(k + 1)) {
          views2.push([k, k + 1]);
          k += 2;
        } else {
          views2.push([k]);
          k += 1;
        }
      }
    }
    const view2Of: number[] = [];
    views2.forEach((v, vi) => v.forEach((k) => (view2Of[k] = vi)));

    const visOf = (i: number): number[] => (mode === 1 ? [i] : views2[view2Of[i]]);

    const paint = () => {
      const vis = visOf(cur);
      const lo = vis[0] + 1;
      const hi = vis[vis.length - 1] + 1;
      counter.textContent = vis.length > 1 ? `עמודים ${lo}–${hi} מתוך ${total}` : `עמוד ${lo} מתוך ${total}`;
      progress.style.inlineSize = `${(hi / total) * 100}%`;
      navPrev.disabled = lo <= 1;
      navNext.disabled = hi >= total;
      const visIds = vis.map((k) => ids[k]);
      tabs.forEach((t) => {
        const g = t.dataset.grade;
        t.classList.toggle(
          'is-current',
          visIds.some((id) => (g ? id.startsWith(`toc-${g}-`) || id.startsWith(`it-${g}-`) : id === t.dataset.jump))
        );
      });
      history.replaceState(null, '', `#${ids[cur]}`);
      // מכונת המצבים (הוראת יניב, 04/08/2026): ההשתלטות על המסך נגזרת
      // מהעמוד עצמו — רק עמוד משאב פתוח משתלט; שער ותוכן עניינים נשארים
      // בתוך זרימת האתר הרגילה, בכל מסלול הגעה (כולל deep link).
      if (isItem(cur)) engage();
      else disengage();
      if (ids[cur].startsWith('toc-')) lastToc = ids[cur];
      // הדף יושב מדויק: בכל מעבר, ההשתלטות חוזרת לראש (בנייד השכבה נגללת)
      if (engaged) shell.scrollTop = 0;
      // עמוד משאב פתוח לרוחב — אזורי הקצה כבויים, ההטמעה לחיצה עד הקצה
      shell.classList.toggle('on-embed', !narrow.matches && vis.length === 1 && isItem(vis[0]));
      warmNeighbors();
    };

    const applySides = (v: number[]) => {
      if (mode === 1) {
        // עמוד משאב נפרס על כל המסך גם בתצוגת עמוד אחד — במסך רחב בלבד;
        // בנייד הדף זורם טבעי (3.29)
        if (isItem(v[0]) && !narrow.matches) pages[v[0]].classList.add('pg-wide');
        return;
      }
      if (v.length === 2) {
        pages[v[0]].classList.add('pg-right');
        pages[v[1]].classList.add('pg-left');
      } else pages[v[0]].classList.add(isItem(v[0]) || ids[v[0]] === 'rashi' ? 'pg-wide' : 'pg-right');
    };

    const layout = () => {
      const view = visOf(cur);
      shell.classList.toggle(
        'has-wide',
        !narrow.matches && view.length === 1 && (isItem(view[0]) || ids[view[0]] === 'rashi')
      );
      const vis = new Set(view);
      pages.forEach((p, k) => {
        p.classList.remove(...ANIM);
        p.style.zIndex = '';
        if (vis.has(k)) {
          if (p.hidden) {
            p.hidden = false;
            p.scrollTop = 0;
          }
          mount(p);
        } else p.hidden = true;
      });
      applySides(view);
      shell.classList.toggle('mode-2', mode === 2);
      shell.classList.toggle('mode-1', mode === 1);
      shell.classList.toggle('on-rashi', ids[cur] === 'rashi');
      paint();
    };

    const show = (i: number, dir: 1 | -1 | 0) => {
      if (i < 0 || i >= total || busy) return;
      if (cur >= 0 && (i === cur || (mode === 2 && view2Of[i] === view2Of[cur]))) {
        if (i !== cur) {
          cur = i;
          paint();
        }
        return;
      }
      const prev = cur;
      cur = i;
      if (prev < 0 || dir === 0 || reduced.matches) {
        layout();
        return;
      }
      // מעבר בין עמוד רגיל לעמוד משאב רחב משנה את מידות הספר — החלפה נקייה
      if (mode === 1 && isItem(cur) !== isItem(prev)) {
        layout();
        return;
      }
      setBusy(true);
      if (mode === 1) {
        const from = pages[prev];
        const to = pages[cur];
        to.classList.remove(...ANIM);
        applySides([cur]);
        to.hidden = false;
        mount(to);
        to.scrollTop = 0;
        from.classList.add(dir === 1 ? 'turn-out' : 'turn-out-back');
        to.classList.add(dir === 1 ? 'turn-in' : 'turn-in-back');
        paint();
        setTimeout(() => {
          from.hidden = true;
          from.classList.remove(...ANIM);
          to.classList.remove(...ANIM);
          applySides([cur]);
          setBusy(false);
        }, 480);
        return;
      }
      const ov = views2[view2Of[prev]];
      const nv = views2[view2Of[cur]];
      const oldPages = ov.map((k) => pages[k]);
      const newPages = nv.map((k) => pages[k]);
      [...oldPages, ...newPages].forEach((p) => {
        p.classList.remove(...ANIM);
        p.style.zIndex = '';
      });
      applySides(ov);
      applySides(nv);
      newPages.forEach((p) => {
        mount(p);
        p.scrollTop = 0;
      });
      paint();
      if (ov.length === 2 && nv.length === 2) {
        // זוג מול זוג: העלה מתהפך מעל השדרה בשני שלבים רציפים
        const [oldR, oldL] = oldPages;
        const [newR, newL] = newPages;
        const done = () => {
          oldPages.forEach((p) => {
            if (!newPages.includes(p)) p.hidden = true;
          });
          [...oldPages, ...newPages].forEach((p) => {
            p.classList.remove('sp-out-l', 'sp-out-r', 'sp-in-l', 'sp-in-r');
            p.style.zIndex = '';
          });
          setBusy(false);
        };
        if (dir === 1) {
          newL.hidden = false;
          newL.style.zIndex = '1';
          oldL.style.zIndex = '6';
          oldL.classList.add('sp-out-l');
          setTimeout(() => {
            newR.hidden = false;
            newR.style.zIndex = '6';
            newR.classList.add('sp-in-r');
            oldR.style.zIndex = '1';
            setTimeout(done, 330);
          }, 260);
        } else {
          newR.hidden = false;
          newR.style.zIndex = '1';
          oldR.style.zIndex = '6';
          oldR.classList.add('sp-out-r');
          setTimeout(() => {
            newL.hidden = false;
            newL.style.zIndex = '6';
            newL.classList.add('sp-in-l');
            oldL.style.zIndex = '1';
            setTimeout(done, 330);
          }, 260);
        }
      } else {
        // מעבר שמערב עמוד רוחבי — היפוך דף יחיד גדול
        newPages.forEach((p) => {
          p.hidden = false;
          p.style.zIndex = '6';
          p.classList.add(dir === 1 ? 'turn-in' : 'turn-in-back');
        });
        oldPages.forEach((p) => {
          p.style.zIndex = '5';
          p.classList.add(dir === 1 ? 'turn-out' : 'turn-out-back');
        });
        setTimeout(() => {
          oldPages.forEach((p) => {
            if (!newPages.includes(p)) p.hidden = true;
          });
          [...oldPages, ...newPages].forEach((p) => {
            p.classList.remove(...ANIM);
            p.style.zIndex = '';
          });
          applySides(nv);
          setBusy(false);
        }, 480);
      }
    };

    const step = (d: 1 | -1) => {
      if (mode === 1) {
        show(cur + d, d);
        return;
      }
      const nv = view2Of[cur] + d;
      if (nv < 0 || nv >= views2.length) return;
      show(views2[nv][0], d);
    };

    // מזהים ישנים/מקוצרים: cover → rashi; toc-z → עמוד התוכן הראשון של השכבה
    const norm = (h: string) => {
      if (h === 'cover') return 'rashi';
      if (!ids.includes(h) && /^toc-[a-z]+$/.test(h)) return ids.find((id) => id.startsWith(`${h}-`)) ?? h;
      return h;
    };
    const goto = (id: string) => {
      const i = ids.indexOf(id);
      if (i >= 0) show(i, i >= cur ? 1 : -1);
    };

    // מצב העבודה המלא (3.29, הוראת יניב 04/08/2026): רק פתיחת משאב
    // משתלטת על כל שטח המסך; כפתור "חזרה לאתר" קיים אך ורק בתוכו
    const engage = () => {
      if (engaged) return;
      engaged = true;
      savedY = scrollY;
      shell.classList.add('is-full');
      document.documentElement.classList.add('book-lock');
      exitBtn.hidden = false;
    };

    const disengage = () => {
      exitBtn.hidden = true;
      if (!engaged) return;
      engaged = false;
      shell.classList.remove('is-full');
      document.documentElement.classList.remove('book-lock');
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      scrollTo(0, savedY);
    };

    // "חזרה לאתר": חזרה לאותו עמוד תוכן עניינים ולאותו מיקום שממנו נפתח
    // המשאב; ב-deep link — לעמוד התוכן של הפרק שאליו שייך המשאב
    const exitFull = () => {
      if (!engaged) return;
      if (busy) {
        pendingExit = true;
        return;
      }
      goto(lastToc || pages[cur].dataset.toc || 'rashi');
    };

    exitBtn.addEventListener('click', exitFull);

    navPrev.addEventListener('click', () => step(-1));
    navNext.addEventListener('click', () => step(1));
    shell.querySelectorAll<HTMLButtonElement>('.book-edge').forEach((b) =>
      b.addEventListener('click', () => step(b.dataset.dir === 'next' ? 1 : -1))
    );
    shell.querySelectorAll<HTMLButtonElement>('button[data-jump]').forEach((b) =>
      b.addEventListener('click', () => goto(norm(b.dataset.jump!)))
    );

    narrow.addEventListener('change', () => {
      const m = prefMode();
      if (m !== mode) {
        mode = m;
        layout();
      }
    });

    // מקלדת: בעברית "קדימה" הוא שמאלה; Home לעמוד הראשי, End לסוף;
    // Escape יוצא ממצב העבודה המלא חזרה לתוכן העניינים
    addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 'Escape') {
        exitFull();
        return;
      }
      if (e.key === 'ArrowLeft' || e.key === 'PageDown') {
        e.preventDefault();
        step(1);
      } else if (e.key === 'ArrowRight' || e.key === 'PageUp') {
        e.preventDefault();
        step(-1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        show(0, -1);
      } else if (e.key === 'End') {
        e.preventDefault();
        show(total - 1, 1);
      }
    });

    // מסך מלא אמיתי (⛶) — נפרד ממצב העבודה: פועל בכל עמוד
    fsBtn?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      else shell.requestFullscreen?.().catch(() => {});
    });
    document.addEventListener('fullscreenchange', () => {
      if (fsBtn) fsBtn.textContent = document.fullscreenElement ? '✕' : '⛶';
    });

    // החלקת מגע: דפדוף רק בתנועה אופקית מובהקת — גלילה אנכית לא מזיזה דף
    const bookEl = shell.querySelector<HTMLElement>('.book')!;
    let x0 = 0;
    let y0 = 0;
    bookEl.addEventListener('touchstart', (e) => {
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
    }, { passive: true });
    bookEl.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.8) return;
      step(dx < 0 ? 1 : -1);
    }, { passive: true });

    // העתקת קישור בעמודי המשאבים
    shell.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const status = btn.closest('.item-info')?.querySelector<HTMLElement>('[data-status]');
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          if (status) status.textContent = 'הקישור הועתק';
        } catch {
          if (status) status.textContent = 'ההעתקה נכשלה';
        }
      });
    });

    // עמוד פתיחה: hash עמוק גובר על ברירת המחדל של העמוד
    mode = prefMode();
    const fromHash = norm(location.hash.slice(1));
    const start = ids.includes(fromHash) ? fromHash : norm(shell.dataset.initial ?? 'rashi');
    show(Math.max(0, ids.indexOf(start)), 0);
    addEventListener('hashchange', () => {
      const h = norm(location.hash.slice(1));
      if (ids.includes(h) && h !== ids[cur]) goto(h);
    });
  });
</script>
