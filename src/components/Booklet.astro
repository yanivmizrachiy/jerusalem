---
/**
 * החוברת הדיגיטלית של חטיבת הביניים (RULES 3.26, 3.29 — הוראות יניב 04/08/2026):
 * שכבת התצוגה מונעת על ידי מנוע page-flip ייעודי (StPageFlip, MIT) —
 * גרירת פינה אמיתית בעכבר ובמגע, קיפול נראה לעין, חזית וגב דף, צל דינמי
 * לפי זווית — לא rotateY של מלבן. ספר עברי אמיתי: העמודים ניזונים למנוע
 * בסדר הפוך, כך שהדפדוף קדימה מתהפך מעל השדרה ימינה כמו בספר עברי, בלי
 * שיקוף CSS ובלי לגעת בתוכן.
 *
 * מבנה העמודים נגזר כולו מ-src/data/choveret.ts (מקור יחיד):
 * שער (דף קשיח בודד) ← עמודי תוכן-עניינים (עמוד לפרק, עם דף ריק ליישור
 * זוגות כשמספר הפרקים אי-זוגי) ← עמודי משאב (זוג אמיתי: דף הטמעה מימין,
 * דף מידע משמאל) ← כריכה אחורית (דף קשיח). סה"כ זוגי — כל spread מיושר.
 *
 * מכונת המצבים נשמרת: שער ותוכן עניינים בזרימת האתר; רק עמוד משאב משתלט
 * על המסך (is-full) עם "חזרה לאתר"/Escape שחוזרים לפרק ולמיקום המדויקים.
 * הטמעות נטענות רק כשהעמוד נפתח, שכנים מתחממים ברגעי סרק, ודפדפן בלי
 * מציג PDF מקבל כרטיס פתיחה (8.8).
 */
import MafmarRange from './MafmarRange.astro';
import { choveret } from '../data/choveret';

interface Props {
  /** מזהה העמוד הפותח: rashi / toc-z-hozer / it-z-maf-02 ... */
  initial?: string;
}

const { initial = 'rashi' } = Astro.props;

const kindLabel: Record<string, string> = {
  site: 'אתר חי',
  doc: 'מסמך',
  drive: 'קובץ',
  pdf: 'PDF',
  canva: 'מצגת',
  flip: 'חוברת דפדוף',
  maf: 'מתוך החוזר',
  link: 'קישור',
};

interface PageDef {
  id: string;
  label: string;
}

/**
 * סדר העמודים הלוגי (מספור רציף אוטומטי — אסור ידני):
 * לכל שכבה: עמודי הפרקים, דף ריק אם מספרם אי-זוגי, ואז זוגות המשאבים.
 * דף אחרון: כריכה אחורית — הסך הכולל זוגי וכל spread מיושר.
 */
const pages: PageDef[] = [{ id: 'rashi', label: 'ראשי' }];
for (const g of choveret) {
  // עמוד תוכן העניינים של השכבה — הכותרת היא שם השכבה (הוראת יניב, 04/08/2026)
  pages.push({ id: `toc-${g.slug}`, label: g.title });
  for (const ch of g.chapters) pages.push({ id: `toc-${g.slug}-${ch.id}`, label: `${g.title} — ${ch.title}` });
  if (g.chapters.length % 2 === 0) pages.push({ id: `blank-${g.slug}`, label: '' });
  for (const ch of g.chapters)
    for (const it of ch.items)
      if (!it.pageHref) {
        pages.push({ id: `it-${g.slug}-${it.id}`, label: it.title });
        pages.push({ id: `it-${g.slug}-${it.id}-info`, label: it.title });
      }
}
pages.push({ id: 'back', label: '' });

const total = pages.length;
const pageNum = (id: string) => pages.findIndex((p) => p.id === id) + 1;
/** תוכן העניינים של השכבה — היעד של שורות השער ולשוניות הקפיצה */
const firstToc = (slug: string) => `toc-${slug}`;
/** צד הדף בפריסה: אינדקס אי-זוגי = דף ימין, זוגי = דף שמאל (השער והכריכה בודדים) */
const folioSide = (id: string) => (pageNum(id) % 2 === 0 ? 'folio-r' : 'folio-l');

const site = 'https://jerusalem-virid.vercel.app';

// חיבור-מראש לכל מקורות ההטמעה החיצוניים — העמוד הפתוח נטען מהר (3.29)
const embedOrigins = [
  ...new Set(
    choveret
      .flatMap((g) => g.chapters.flatMap((ch) => ch.items))
      .map((it) => it.embed ?? '')
      .filter((u) => u.startsWith('https://'))
      .map((u) => new URL(u).origin)
  ),
];
---

<div class="book-shell" data-book data-initial={initial} data-total={total}>
  {embedOrigins.map((o) => <link rel="preconnect" href={o} />)}

  <!-- פס עליון קומפקטי: לשוניות קפיצה ומסך מלא; "חזרה לאתר" רק במצב מלא -->
  <div class="book-bar">
    <button class="book-exit" type="button" data-exit hidden>
      <span class="book-exit-ico" aria-hidden="true">→</span>
      חזרה לאתר
    </button>
    <div class="book-tabs" role="group" aria-label="קפיצה מהירה">
      <button class="btab" type="button" data-jump="rashi">ראשי</button>
      {
        choveret.map((g) => (
          <button class="btab" type="button" data-jump={firstToc(g.slug)} data-grade={g.slug}>
            {g.letter}
          </button>
        ))
      }
    </div>
    <div class="book-tools">
      <button class="bfs" type="button" data-fullscreen aria-label="מסך מלא">⛶</button>
    </div>
  </div>

  <div class="book-stage" data-stage>
    <button class="book-edge book-edge-next" type="button" data-dir="next" aria-label="הדף הבא"><span aria-hidden="true">‹</span></button>
    <button class="book-edge book-edge-prev" type="button" data-dir="prev" aria-label="הדף הקודם"><span aria-hidden="true">›</span></button>

    <div class="flip-host" data-host aria-roledescription="חוברת" aria-label="מתמטיקה לחטיבת הביניים — ספר מדפדף">
      <!-- העמוד הראשי — שער החוברת: דף קשיח בודד, גדול וקריא (3.29) -->
      <section class="bpage bp-rashi" data-page="rashi" data-n="1" data-density="hard">
        <div class="page-face">
          <div class="rashi-inner">
            <h2 class="rashi-title">מתמטיקה לחטיבת הביניים</h2>
            <div class="rashi-rows">
              {
                choveret.map((g) => (
                  <button
                    class="rashi-row"
                    type="button"
                    data-jump={firstToc(g.slug)}
                    style={`--g-color:${g.color}; --g-dark:${g.dark}`}
                  >
                    <span class:list={['rashi-letter', { 'is-wide': g.slug === 'klali' }]}>{g.letter}</span>
                    <span class="rashi-text">
                      <span class="rashi-name">{g.slug === 'klali' ? 'משותף לכל השכבות' : `כיתה ${g.letter}`}</span>
                      <span class="rashi-count">
                        <b class="rashi-count-num">{g.chapters.reduce((n, c) => n + c.items.length, 0)}</b>
                        קבצים, קישורים ופעילויות
                      </span>
                    </span>
                    <span class="rashi-dots" aria-hidden="true"></span>
                    <span class="rashi-pnum">עמוד {pageNum(firstToc(g.slug))}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      {
        choveret.map((g) => (
          <>
            <!-- תוכן העניינים של השכבה — הכותרת היא שם השכבה (הוראת יניב, 04/08/2026) -->
            <section
              class:list={['bpage', 'bp-gtoc', folioSide(`toc-${g.slug}`)]}
              data-page={`toc-${g.slug}`}
              data-n={pageNum(`toc-${g.slug}`)}
            >
              <div class="page-face" style={`--g-color:${g.color}; --g-dark:${g.dark}`}>
                <header class="gtoc-head">
                  <h2 class="gtoc-title">{g.title}</h2>
                  <p class="gtoc-sub">תוכן העניינים</p>
                  <p class="toc-intro">{g.intro}</p>
                </header>
                <ol class="gtoc-rows">
                  {g.chapters.map((ch) => (
                    <li>
                      <button
                        class="gtoc-row"
                        type="button"
                        data-jump={`toc-${g.slug}-${ch.id}`}
                        style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}
                      >
                        <span class="gtoc-name">{ch.title}</span>
                        <span class="gtoc-count">{ch.items.length} קבצים</span>
                        <span class="gtoc-dots" aria-hidden="true"></span>
                        <span class="gtoc-pnum">עמוד {pageNum(`toc-${g.slug}-${ch.id}`)}</span>
                      </button>
                    </li>
                  ))}
                </ol>
                <span class="folio" aria-hidden="true">{pageNum(`toc-${g.slug}`)}</span>
              </div>
            </section>

            {g.chapters.map((ch, ci) => (
              <section
                class:list={['bpage', 'bp-toc', folioSide(`toc-${g.slug}-${ch.id}`)]}
                data-page={`toc-${g.slug}-${ch.id}`}
                data-n={pageNum(`toc-${g.slug}-${ch.id}`)}
              >
                <!-- משתני הצבע על ה-face — המנוע דורס את ה-style של הדף עצמו -->
                <div class="page-face" style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}>
                  <header class="toc-head">
                    <h2 class="toc-title">
                      {g.title} — {ch.title}
                    </h2>
                    {ci === 0 && <p class="toc-intro">{g.intro}</p>}
                  </header>
                  {g.chapters.length > 1 && (
                    <nav class="toc-nav" aria-label={`תוכן העניינים של ${g.title}`}>
                      {g.chapters.map((c) => (
                        <button
                          type="button"
                          class:list={['toc-nav-chip', { 'is-here': c.id === ch.id }]}
                          style={`--nc:${c.color}; --nd:${c.dark}`}
                          data-jump={`toc-${g.slug}-${c.id}`}
                          aria-current={c.id === ch.id ? 'page' : undefined}
                        >
                          {c.title}
                          <b>{pageNum(`toc-${g.slug}-${c.id}`)}</b>
                        </button>
                      ))}
                    </nav>
                  )}
                  <ol class="toc-list">
                    {ch.items.map((item) => (
                      <li>
                        {item.pageHref ? (
                          <a class="toc-item" href={item.pageHref}>
                            <span class="toc-num" aria-hidden="true">◆</span>
                            <span class="toc-text">
                              <span class="toc-item-title">{item.title}</span>
                              {item.note && <span class="toc-item-note">{item.note}</span>}
                            </span>
                            <span class="toc-arrow" aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <button class="toc-item" type="button" data-jump={`it-${g.slug}-${item.id}`}>
                            <span class="toc-num">{pageNum(`it-${g.slug}-${item.id}`)}</span>
                            <span class="toc-text">
                              <span class="toc-item-title">{item.title}</span>
                              {item.note && <span class="toc-item-note">{item.note}</span>}
                            </span>
                            <span class="toc-arrow" aria-hidden="true">←</span>
                          </button>
                        )}
                      </li>
                    ))}
                  </ol>
                  <span class="folio" aria-hidden="true">{pageNum(`toc-${g.slug}-${ch.id}`)}</span>
                </div>
              </section>
            ))}

            {g.chapters.length % 2 === 0 && (
              <section
                class:list={['bpage', 'bp-blank', folioSide(`blank-${g.slug}`)]}
                data-page={`blank-${g.slug}`}
                data-n={pageNum(`blank-${g.slug}`)}
              >
                <div class="page-face">
                  <span class="folio" aria-hidden="true">{pageNum(`blank-${g.slug}`)}</span>
                </div>
              </section>
            )}

            {g.chapters.map((ch) =>
              ch.items
                .filter((it) => !it.pageHref)
                .map((item) => (
                  <>
                    <section
                      class:list={['bpage', 'bp-item', 'bp-item-embed', folioSide(`it-${g.slug}-${item.id}`)]}
                      data-page={`it-${g.slug}-${item.id}`}
                      data-n={pageNum(`it-${g.slug}-${item.id}`)}
                      data-kind={item.kind}
                      data-toc={`toc-${g.slug}-${ch.id}`}
                    >
                      <div class="page-face" style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}>
                        <div class="item-embed">
                          {item.kind === 'maf' && item.maf ? (
                            <MafmarRange sectionId={item.maf} accent={ch.color} />
                          ) : item.embed ? (
                            <>
                              <div class="item-frame">
                                <iframe
                                  data-esrc={item.embed}
                                  data-eurl={item.url}
                                  data-etitle={item.title}
                                  title={`${item.title} — תצוגה חיה`}
                                  allow="fullscreen; clipboard-write"
                                />
                              </div>
                              {item.kind === 'pdf' && (
                                <div class="item-frame item-open-card" data-pdf-fb hidden>
                                  <p>בדפדפן הזה קובצי PDF נפתחים לצפייה מלאה במסך נפרד:</p>
                                  <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                                    פתיחת {item.title} ↗
                                  </a>
                                </div>
                              )}
                            </>
                          ) : (
                            <div class="item-frame item-open-card">
                              <p>המשאב הזה נפתח באתר המקור:</p>
                              <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                                פתיחת {item.title} ↗
                              </a>
                            </div>
                          )}
                        </div>
                        <span class="folio" aria-hidden="true">{pageNum(`it-${g.slug}-${item.id}`)}</span>
                      </div>
                    </section>

                    <section
                      class:list={['bpage', 'bp-item', 'bp-item-info', folioSide(`it-${g.slug}-${item.id}-info`)]}
                      data-page={`it-${g.slug}-${item.id}-info`}
                      data-n={pageNum(`it-${g.slug}-${item.id}-info`)}
                      data-toc={`toc-${g.slug}-${ch.id}`}
                    >
                      <div class="page-face" style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`}>
                        <aside class="item-info">
                          <p class="item-chapter">{ch.title} · {g.slug === 'klali' ? 'כללי' : `כיתה ${g.letter}`}</p>
                          <h2 class="item-title">{item.title}</h2>
                          {item.note && <p class="item-note">{item.note}</p>}
                          <p class="item-kind">{kindLabel[item.kind]}</p>
                          <div class="item-actions" role="group" aria-label="פעולות">
                            {item.download && (
                              <a class="btn btn-primary" href={item.download} target="_blank" rel="noopener" download>
                                הורדה ⬇
                              </a>
                            )}
                            <a
                              class="btn btn-whatsapp"
                              href={`https://wa.me/?text=${encodeURIComponent(`${item.title} — ${g.title} — ${site}/chativat-beynayim/reader/${g.slug}/${item.id}/`)}`}
                              target="_blank"
                              rel="noopener"
                              aria-label={`שיתוף ${item.title} ב־WhatsApp`}
                            >
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                            </a>
                            <a
                              class="btn btn-gmail"
                              href={`mailto:?subject=${encodeURIComponent(item.title)}&body=${encodeURIComponent(`${item.title} — ${site}/chativat-beynayim/reader/${g.slug}/${item.id}/`)}`}
                              aria-label={`שליחת ${item.title} בדוא״ל`}
                            >
                              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="#4285F4" d="M1.636 20.5h3.819V11.73L0 7.64v11.223c0 .904.732 1.636 1.636 1.636Z" />
                                <path fill="#34A853" d="M18.545 20.5h3.819c.904 0 1.636-.732 1.636-1.636V7.64l-5.455 4.09Z" />
                                <path fill="#FBBC04" d="M18.545 5.457v6.273L24 7.64V6.275c0-2.023-2.309-3.178-3.927-1.964Z" />
                                <path fill="#EA4335" d="M5.455 11.73V5.457L12 10.366l6.545-4.909v6.273L12 16.639Z" />
                                <path fill="#C5221F" d="M0 6.275v1.365l5.455 4.09V5.457L4.073 4.42C2.309 3.098 0 4.252 0 6.275Z" />
                              </svg>
                            </a>
                            <button class="btn btn-ghost" type="button" data-copy={item.url.startsWith('/') ? `${site}${item.url}` : item.url}>
                              העתקת קישור
                            </button>
                            <a
                              class="btn btn-ghost"
                              href={item.url}
                              target={item.url.startsWith('/') ? undefined : '_blank'}
                              rel="noopener"
                            >
                              פתיחה במקור ↗
                            </a>
                          </div>
                          <p class="item-status" data-status role="status" aria-live="polite"></p>
                        </aside>
                        <span class="folio" aria-hidden="true">{pageNum(`it-${g.slug}-${item.id}-info`)}</span>
                      </div>
                    </section>
                  </>
                ))
            )}
          </>
        ))
      }

      <!-- כריכה אחורית — דף קשיח, מיישר את הסך הכולל לזוגי -->
      <section class="bpage bp-back" data-page="back" data-n={total} data-density="hard">
        <div class="page-face">
          <div class="back-inner">
            <p class="back-title">מתמטיקה לחטיבת הביניים</p>
            <p class="back-sub">מחוז ירושלים</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- סרגל הדפדוף -->
  <div class="book-nav" role="group" aria-label="דפדוף בספר">
    <button class="bnav bnav-prev" type="button">
      <span class="bnav-arrow" aria-hidden="true">→</span> דף קודם
    </button>
    <div class="book-meter">
      <span class="book-counter" data-counter aria-live="polite">עמוד 1 מתוך {total}</span>
      <span class="book-progress"><span class="book-progress-fill" data-progress></span></span>
    </div>
    <button class="bnav bnav-next" type="button">
      דף הבא <span class="bnav-arrow" aria-hidden="true">←</span>
    </button>
  </div>
</div>

<style is:global>
  /* בזמן ההשתלטות על המסך — האתר שמאחור לא נגלל ואין מסילת גלילה */
  html.book-lock,
  html.book-lock body {
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  /* ===== שכבת המנוע (StPageFlip) — עמודי החוברת ===== */
  /* לפני אתחול המנוע העמודים (ילדים ישירים של ה-host) מוסתרים — אין
     הבזק של ערימת דפים; ברגע שהמנוע מאמץ אותם הוא שולט בתצוגה */
  [data-book] .flip-host > .bpage { display: none; }

  [data-book] .stf__parent { margin-inline: auto; }

  /* דף = נייר: המשטח חי על .page-face כדי שהמנוע ישלוט בחיצוני */
  [data-book] .bpage { background: transparent; }

  [data-book] .page-face {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
