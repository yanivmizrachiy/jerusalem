    </button>
    <div class="book-meter">
      <span class="book-counter" data-counter aria-live="polite">עמוד 1 מתוך {total}</span>
      <span class="book-progress"><span class="book-progress-fill" data-progress></span></span>
    </div>
    <button class="bnav bnav-next" type="button">
      דף הבא <span class="bnav-arrow" aria-hidden="true">←</span>
    </button>
  </div>

  <!-- מעבר מהיר לאזורים אחרים באתר — מחוץ לחוברת (05/08/2026);
       מוסתר במצב העבודה המלא של משאב -->
  <nav class="book-links" aria-label="מעבר לאזורים אחרים באתר">
    <span class="book-links-eyebrow">מעבר מהיר לאזורים נוספים באתר</span>
    <div class="book-links-row">
      {
        siteLinks.map((l) => (
          <a class="book-link" href={l.href} style={`--lk:${l.accent}`}>
            <span class="book-link-ico" aria-hidden="true" set:html={l.icon} />
            <span class="book-link-label">{l.label}</span>
            <span class="book-link-cta" aria-hidden="true">←</span>
          </a>
        ))
      }
    </div>
  </nav>
</div>

<style is:global>
  /* בזמן ההשתלטות על המסך — האתר שמאחור לא נגלל ואין מסילת גלילה */
  html.book-lock,
  html.book-lock body {
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  /* ===== שכבת המנוע (StPageFlip) — עמודי החוברת ===== */
  /* לפני אתחול המנוע העמודים (ילדים ישירים של ה-host) מוסתרים — אין
     הבזק של ערימת דפים; ברגע שהמנוע מאמץ אותם הוא שולט בתצוגה */
  [data-book] .flip-host > .bpage { display: none; }

  [data-book] .stf__parent { margin-inline: auto; }

  /* דף = נייר: המשטח חי על .page-face כדי שהמנוע ישלוט בחיצוני */
  [data-book] .bpage { background: transparent; }

  [data-book] .page-face {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    overflow: hidden;
    background:
      linear-gradient(105deg, rgb(31 25 12 / 0.045) 0%, transparent 7%),
      linear-gradient(180deg, #fffdf9 0%, #fbf6ec 100%);
    border: 1px solid #e8e0cd;
    padding: clamp(0.85rem, 1.7vw, 1.5rem);
    display: flex;
    flex-direction: column;
  }

  /* צד פנימי (שדרה): הצללה עדינה במקום גרדיאנט רחב — שדרה דקה ואמינה */
  /* עמק השדרה מעמיק (רק שכבת רקע — הגאומטריה נשמרת, השדרה נשארת דקה) */
  [data-book] .folio-r .page-face {
    border-radius: 4px 14px 14px 4px;
    background:
      linear-gradient(270deg, rgb(31 25 12 / 0.16) 0%, rgb(31 25 12 / 0.05) 3%, transparent 8%),
      linear-gradient(180deg, #fffdf9 0%, #fbf6ec 100%);
  }

  [data-book] .folio-l .page-face {
    border-radius: 14px 4px 4px 14px;
    background:
      linear-gradient(90deg, rgb(31 25 12 / 0.16) 0%, rgb(31 25 12 / 0.05) 3%, transparent 8%),
      linear-gradient(180deg, #fffdf9 0%, #fbf6ec 100%);
  }

  /* דפים קשיחים — שער וכריכה: שיפוע לוח (bevel) עדין ב-inset (בלי scrollHeight) */
  [data-book] .bp-rashi .page-face,
  [data-book] .bp-back .page-face {
    border-radius: 14px;
    border: 1px solid #ddd2b8;
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(201 155 63 / 0.1), transparent 55%),
      linear-gradient(180deg, #fffdf9 0%, #f7f1e2 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      inset 0 -20px 34px -22px rgb(119 96 42 / 0.30);
  }

  /* המנוע מצייר צל גרירה משלו; מרככים את צל ברירת המחדל של העטיפה */
  /* צל-מגע צמוד + צל רך — הספר "נח" ולא מרחף (filter בלבד; בלי שינוי גאומטריה) */
  [data-book] .stf__block {
    filter:
      drop-shadow(0 1.5px 2px rgb(31 41 61 / 0.20))
      drop-shadow(0 28px 46px rgb(31 41 61 / 0.28));
  }

  /* השער והכריכה — דף בודד ממורכז בבמה, לא חצי-במה ריקה; הפתיחה עצמה
     מחליקה את הספר למרכז בזמן שהעלה מתהפך */
  [data-book] .stf__block { transition: translate 460ms cubic-bezier(0.22, 0.8, 0.3, 1); }
  [data-book].on-rashi:not(.is-portrait) .stf__block { translate: 25% 0; }
  [data-book].on-back:not(.is-portrait) .stf__block { translate: -25% 0; }

  @media (prefers-reduced-motion: reduce) {
    [data-book] .stf__block { transition: none; }
  }
</style>

<style>
  /* הספר פרוס כמעט לכל רוחב החלון (הוראת יניב, 04/08/2026: ≥90%) */
  .book-shell {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-block: 1rem 1.6rem;
    inline-size: min(100vw - 2 * clamp(0.4rem, 1vw, 1rem), 1880px);
    margin-inline: calc((100% - min(100vw - 2 * clamp(0.4rem, 1vw, 1rem), 1880px)) / 2);
  }

  /* השתלטות על כל שטח המסך — מצב משאב (3.29) */
  .book-shell.is-full {
    position: fixed;
    inset: 0;
    z-index: 90;
    margin: 0;
    inline-size: auto;
    padding: clamp(0.3rem, 1vh, 0.6rem) clamp(0.4rem, 1vw, 0.9rem);
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-soft) 100%);
    gap: 0.45rem;
    overflow: hidden;
    overscroll-behavior: contain;
  }

  /* ===== הפס העליון — קומפקטי ===== */
  .book-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    min-block-size: 46px;
  }

  .book-exit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 46px;
    padding: 0.45rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, #f3d68b 0%, #d4af5c 100%);
    color: #3c2f12;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 12px 26px -12px rgb(176 141 62 / 0.85);
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease);
  }

  .book-exit[hidden] { display: none; }

  .book-exit:hover { transform: translateY(-2px); color: #241b08; }

  .book-exit-ico { font-size: 1.2em; line-height: 1; }

  .book-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    margin-inline: auto;
  }

  .btab {
    min-block-size: 44px;
    min-inline-size: 48px;
    padding: 0.25rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 250ms var(--ease), color 250ms var(--ease);
  }

  .btab.is-current {
    background: linear-gradient(180deg, #16273f 0%, #0e1c31 100%);
    border-color: var(--gold);
    color: #f3d68b;
  }

  .book-tools { display: flex; align-items: center; gap: 0.5rem; }

  .bfs {
    flex: none;
    inline-size: 46px;
    block-size: 46px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--gold-deep);
    font-size: 1.2rem;
    cursor: pointer;
    transition: transform 300ms var(--ease-lift), box-shadow 300ms var(--ease);
  }

  .bfs:hover { transform: translateY(-2px); box-shadow: var(--shadow-soft); }

  /* ===== הבמה — הספר מקבל כמעט את כל הגובה הפנוי =====
     הגובה המדויק נקבע בזמן ריצה לפי החלון והסרגלים (fallback ב-CSS) */
  .book-stage {
    position: relative;
    block-size: max(520px, calc(100dvh - var(--header-h) - 138px));
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 40px; /* מסדרונות ההקשה בצדדים */
  }

  .book-shell { scroll-margin-block-start: calc(var(--header-h) + 6px); }

  .is-full .book-stage { flex: 1; min-block-size: 0; block-size: auto; }

  .flip-host { inline-size: 100%; block-size: 100%; }

  /* מסדרונות הקשה שקטים בשולי הבמה — מחוץ לדפים, לא מעל הטמעות */
  .book-edge {
    position: absolute;
    inset-block: 6%;
    inline-size: 38px;
    z-index: 6;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: transparent;
    font-size: 1.7rem;
    font-weight: 700;
    border-radius: 14px;
    transition: color 250ms var(--ease), background-color 250ms var(--ease);
  }

  .book-edge-next { left: 0; }
  .book-edge-prev { right: 0; }

  .book-edge:hover,
  .book-edge:focus-visible {
    color: var(--gold-deep);
    background: rgb(212 175 92 / 0.14);
  }

  /* ===== השער ===== */
  .bp-rashi .page-face { padding: clamp(1.1rem, 2.4vw, 2rem); }

  .rashi-inner {
    margin: auto;
    inline-size: 100%;
    max-inline-size: 620px;
  }

  .rashi-title {
    margin: 0 0 1.4rem;
    text-align: center;
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    color: var(--ink);
  }

  .rashi-title::after {
    content: '';
    display: block;
    inline-size: 100%;
    block-size: 2px;
    margin-block-start: 0.9rem;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .rashi-rows { border-block-end: 1px solid var(--line); }

  .rashi-row {
    inline-size: 100%;
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.6vw, 1.1rem);
    padding: clamp(0.65rem, 1.7vh, 1.05rem) 0.4rem;
    border: 0;
    border-block-start: 1px solid var(--line);
    background: none;
    color: var(--ink);
    text-align: start;
    font: inherit;
    cursor: pointer;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .rashi-row:hover {
    background: color-mix(in srgb, var(--g-color, var(--gold)) 9%, #fff);
    transform: translateX(-4px);
  }

  .rashi-letter {
    flex: none;
    min-inline-size: 3em;
    block-size: 3em;
    display: grid;
    place-items: center;
    padding-inline: 0.45em;
    border: 2px solid var(--g-color, var(--gold));
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    font-weight: 700;
    color: var(--g-dark, var(--gold-deep));
    line-height: 1;
    background: color-mix(in srgb, var(--g-color, var(--gold)) 8%, #fff);
  }

  .rashi-letter.is-wide { font-size: clamp(0.85rem, 1.5vw, 1rem); }

  .rashi-text { display: flex; flex-direction: column; gap: 0.15rem; min-inline-size: 0; }

  .rashi-name { font-weight: 800; font-size: clamp(1.05rem, 1.8vw, 1.3rem); }

  .rashi-count {
    font-size: clamp(0.8rem, 1.3vw, 0.92rem);
    color: var(--ink-soft);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }

  /* מספר הקבצים — גופן תלת-ממד ברור ובולט (3.29) */
  .rashi-count-num {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    font-weight: 800;
    line-height: 1;
    color: var(--g-color, var(--gold));
    text-shadow:
      1px 1px 0 var(--g-dark, var(--gold-deep)),
      2px 2px 0 var(--g-dark, var(--gold-deep)),
      3px 3px 0 color-mix(in srgb, var(--g-dark, var(--gold-deep)) 55%, transparent),
      4px 5px 8px rgb(31 25 12 / 0.35);
  }

  .rashi-dots {
    flex: 1;
    min-inline-size: 24px;
    border-block-end: 2px dotted color-mix(in srgb, var(--g-color, var(--gold)) 55%, transparent);
    margin-inline: 0.5rem;
    transform: translateY(-0.35em);
  }

  .rashi-pnum {
    flex: none;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    font-weight: 700;
    color: var(--g-dark, var(--gold-deep));
    font-variant-numeric: tabular-nums;
  }

  /* ===== כריכה אחורית ===== */
  .bp-back .page-face { align-items: center; justify-content: center; }

  .back-inner { text-align: center; color: var(--ink-soft); }

  .back-title {
    margin: 0 0 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 700;
    color: var(--gold-deep);
  }

  .back-sub { margin: 0; font-size: 0.95rem; letter-spacing: 0.14em; }

  /* ===== מספרי עמודים מודפסים — גדולים ונוחים מאוד ===== */
  .folio {
    position: absolute;
    inset-block-end: 10px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    pointer-events: none;
  }

  .folio-r .folio { right: 16px; }
  .folio-l .folio { left: 16px; }

  /* ===== תוכן העניינים של השכבה — כותרת השכבה ושורות הפרקים ===== */
  .bp-gtoc .page-face { padding: clamp(1rem, 2.2vw, 1.8rem); }

  .gtoc-head { text-align: center; margin-block-end: 0.9rem; }

  .gtoc-title {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2.3rem);
    color: var(--g-dark, var(--ink));
  }

  .gtoc-sub {
    margin: 0.15rem 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gold-deep);
  }

  .gtoc-head::after {
    content: '';
    display: block;
    inline-size: 100%;
    block-size: 2px;
    margin-block-start: 0.8rem;
    background: linear-gradient(90deg, transparent, var(--g-color, var(--gold)), transparent);
  }

  .gtoc-rows { list-style: none; margin: 0; padding: 0 0 1.4rem; }

  .gtoc-row {
    inline-size: 100%;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: clamp(0.65rem, 1.6vh, 1rem) 0.4rem;
    border: 0;
    border-block-end: 1px solid var(--line);
    background: none;
    color: var(--ink);
    text-align: start;
    font: inherit;
    cursor: pointer;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .gtoc-row:hover {
    background: color-mix(in srgb, var(--ch-color) 8%, #fff);
    transform: translateX(-4px);
  }

  .gtoc-name {
    font-weight: 800;
    font-size: clamp(1.02rem, 1.7vw, 1.25rem);
    color: var(--ch-dark);
  }

  .gtoc-count { font-size: 0.85rem; color: var(--ink-soft); white-space: nowrap; }

  .gtoc-dots {
    flex: 1;
    min-inline-size: 24px;
    border-block-end: 2px dotted color-mix(in srgb, var(--ch-color) 55%, transparent);
    margin-inline: 0.4rem;
    transform: translateY(-0.2em);
  }

  .gtoc-pnum {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 700;
    color: var(--ch-dark);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }


  /* ===== מפתח השכבה — כפולה אחת, כל הפרקים והקבצים (הוראת יניב 05/08/2026) ===== */
  .idx {
    flex: 1;
    min-block-size: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1.1vh, 0.95rem);
    padding-block-end: 1.4rem;
