---
/**
 * אתר ההמחשות של איילת קריספין (RULES 3.3, 9.1): הטמעה חיה דרך הפרוקסי
 * המחוזי (/api/mam/), במסגרת האחידה (8.26), עם כפתור עגול להעתקת הקישור הקנוני.
 * שני מצבים: ברירת המחדל — הטמעה גבוהה בעמודי המבוא של השכבות; `compact` —
 * הפאנל שבמסך הראשון של שער חטיבת הביניים, לצד טבלת הקישורים (הוראת יניב,
 * 10/08/2026). הרכיב חי בתוך המיכל של העמוד — אין לו מיכל משלו.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class:list={['hamchashot-section', { 'is-compact': compact }]} id="hamchashot" data-reveal>
  <div class="section-head">
    <h2>אתר ההמחשות של איילת קריספין</h2>
    <p class="lede">
      המחשות דינמיות למושגי המתמטיקה — לצפייה ולשימוש ישירות מכאן, או במקור בכרטיסייה
      נפרדת.
    </p>
  </div>
  <div class="mam-frame embed-frame">
    <iframe
      src="/api/mam/"
      title="אתר ההמחשות של איילת קריספין — גלישה חיה בתוך האתר"
      loading="lazy"
      allow="fullscreen"
      sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-downloads"
    ></iframe>
  </div>
  <div class="mam-actions">
    <button class="mam-copy" type="button" id="mam-copy" aria-label="העתקת הקישור לאתר ההמחשות">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
        <path d="M10.5 13.5a4.2 4.2 0 0 0 6 0l3-3a4.24 4.24 0 0 0-6-6l-1.6 1.6" />
        <path d="M13.5 10.5a4.2 4.2 0 0 0-6 0l-3 3a4.24 4.24 0 0 0 6 6l1.6-1.6" />
      </svg>
    </button>
    <button class="mam-note" type="button" id="mam-note" aria-live="polite">העתקת הקישור לאתר ההמחשות</button>
  </div>
</section>

<style>
  .hamchashot-section { margin-block-start: clamp(2.4rem, 5vw, 3.6rem); }

  /* הדפדפן הפנימי של ההמחשות (9.1) — גדול ומרווח, מציג עמוד ראשי שלם */
  .mam-frame { block-size: var(--embed-site-height); }

  .hamchashot-section .section-head { max-width: 640px; margin-block-end: clamp(1.2rem, 3vw, 1.8rem); }

  /* הדפדפן הפנימי של ההמחשות (9.1) — מסגרת זכוכית יוקרתית אחידה (8.26) */

  /* קו-אור אלכסוני על הזכוכית — ספקולר עדין; אינו חוסם אינטראקציה (8.26) */

  .mam-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-block-start: 0.9rem;
  }

  .mam-copy {
    inline-size: 46px;
    block-size: 46px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--gold-deep);
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-soft);
    transition: transform 400ms var(--ease-lift), box-shadow 300ms var(--ease), color 300ms var(--ease);
  }

  .mam-copy:hover { transform: translateY(-3px) scale(1.05); color: var(--ink); box-shadow: var(--shadow-lift); }

  .mam-note {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 600;
    min-block-size: 44px;
  }

  .mam-note:hover { color: var(--gold-deep); text-decoration: underline; }

  /* מצב קומפקטי — המסך הראשון של שער חטיבת הביניים (הוראת יניב, 10/08/2026):
     ההטמעה נכנסת כולה במסך הראשון לצד טבלת הקישורים; הגובה המדויק נמדד
     בזמן ריצה בעמוד השער (innerHeight פחות ראש המסגרת), והכלל כאן הוא
     ה-fallback לפני ה-JS ולמסכים צרים. המסגרת המשותפת (8.26) ללא שינוי. */
  .is-compact { margin-block-start: 0; }
  .is-compact .section-head { max-width: none; margin-block-end: 0.75rem; }
  .is-compact .section-head h2 { margin: 0 0 0.3rem; font-size: clamp(1.14rem, 1.5vw, 1.42rem); line-height: 1.25; }
  .is-compact .section-head .lede { margin: 0; font-size: 0.92rem; line-height: 1.55; }
  .is-compact .mam-frame { block-size: clamp(360px, 100dvh - 470px, 680px); }
  .is-compact .mam-actions { margin-block-start: 0.7rem; }

  @media (max-width: 1119px) {
    /* בערימה הצרה אין "מסך ראשון" לשמור — גובה נוח וקבוע (8.12) */
    .is-compact .mam-frame { block-size: min(72dvh, 600px); }
  }
</style>

<script>
  import { hamchashot } from '../data/resources';
  const note = document.getElementById('mam-note');
  for (const el of [document.getElementById('mam-copy'), note]) {
    el?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(hamchashot.url);
        note!.textContent = 'הקישור הועתק';
      } catch {
        note!.textContent = 'ההעתקה נכשלה';
      }
    });
  }
</script>
