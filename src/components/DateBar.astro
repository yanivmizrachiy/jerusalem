---
/**
 * הפס העליון (RULES 7.22, הוראת יניב 03/08/2026): בראש כל עמוד, העליון
 * ביותר — הלוגו וכיתוב המחוז על המלבן עצמו, לצד התאריך העברי (גימטריה)
 * והלועזי בכחול־אור זוהר. מחושב לפי שעון ירושלים ומתעדכן בחציית חצות.
 */
---

<section class="datebar" aria-label="הדרכה במחוז ירושלים — התאריך היום">
  <div class="container datebar-inner">
    <a class="datebar-brand" href="/" aria-label="הדרכה במחוז ירושלים והעיר ירושלים — לעמוד הראשי">
      <img id="site-logo" src="/logo.png" alt="" width="44" height="44" loading="eager" fetchpriority="high" />
      <span class="datebar-title">הדרכה במחוז ירושלים והעיר ירושלים — מנח״י <small>בהובלת איילת קריספין</small></span>
    </a>
    <div class="datebar-dates">
      <p class="date-he" id="date-he" dir="rtl"></p>
      <p class="date-greg" id="date-greg" dir="ltr"></p>
    </div>
  </div>
</section>

<style>
  .datebar {
    background: linear-gradient(180deg, #0b1524 0%, #0e1c31 100%);
    border-block-end: 1px solid #17293f;
  }

  .datebar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.4rem;
    min-block-size: 64px;
    padding-block: 0.55rem;
  }

  .datebar-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #eaf4ff;
  }

  .datebar-brand img {
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(126 210 255 / 0.35), 0 2px 12px rgb(0 0 0 / 0.45);
  }

  .datebar-title {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 2.2vw, 1.12rem);
    font-weight: 700;
    line-height: 1.2;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-inline-size: 34ch;
  }

  /* הכיתוב הקטן — תכלת מוארת באיכות של שעון דיגיטלי (7.22) */
  .datebar-title small {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    color: #8fd9ff;
    letter-spacing: 0.09em;
    text-shadow:
      0 0 2px rgb(126 210 255 / 0.9),
      0 0 12px rgb(126 210 255 / 0.55),
      0 0 26px rgb(64 156 255 / 0.35);
  }

  .datebar-dates {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.3rem;
    justify-content: flex-end;
  }

  .date-he,
  .date-greg {
    margin: 0;
    color: #7ed2ff;
    font-weight: 600;
    font-size: clamp(0.92rem, 2vw, 1.15rem);
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 0 2px rgb(126 210 255 / 0.9),
      0 0 14px rgb(126 210 255 / 0.5),
      0 0 34px rgb(64 156 255 / 0.35);
  }

  /* אנימציית הכתיבה מימין לשמאל (7.22, הוראת יניב 03/08/2026):
     האותיות נוצרות ב-JS ולכן :global */
  .date-he :global(.dw-ch),
  .date-greg :global(.dw-ch) {
    display: inline-block;
    white-space: pre;
    opacity: 0;
    filter: blur(7px);
    transform: translateY(0.18em);
    animation: dw-in 780ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  @keyframes dw-in {
    55% {
      opacity: 1;
      filter: blur(0.5px);
      text-shadow:
        0 0 4px rgb(126 210 255 / 1),
        0 0 22px rgb(126 210 255 / 0.9),
        0 0 44px rgb(64 156 255 / 0.6);
    }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .date-he :global(.dw-ch),
    .date-greg :global(.dw-ch) {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .datebar-inner { justify-content: center; text-align: center; }
    .datebar-dates { justify-content: center; }
  }
</style>

<script>
  const heEl = document.getElementById('date-he')!;
  const gregEl = document.getElementById('date-greg')!;

  const TZ = 'Asia/Jerusalem';

  const GEMATRIA: readonly (readonly [number, string])[] = [
    [400, 'ת'], [300, 'ש'], [200, 'ר'], [100, 'ק'], [90, 'צ'], [80, 'פ'],
    [70, 'ע'], [60, 'ס'], [50, 'נ'], [40, 'מ'], [30, 'ל'], [20, 'כ'],
    [10, 'י'], [9, 'ט'], [8, 'ח'], [7, 'ז'], [6, 'ו'], [5, 'ה'],
    [4, 'ד'], [3, 'ג'], [2, 'ב'], [1, 'א'],
  ];

  const toGematria = (n: number): string => {
    let s = '';
    let r = n;
    while (r > 0) {
      if (r === 15) { s += 'טו'; break; }
      if (r === 16) { s += 'טז'; break; }
      const pair = GEMATRIA.find(([v]) => v <= r)!;
      s += pair[1];
      r -= pair[0];
    }
    return s.length === 1 ? `${s}׳` : `${s.slice(0, -1)}״${s.slice(-1)}`;
  };

  // כתיבה אות-אות בכיוון הקריאה — עברית מימין לשמאל; איטית ויוקרתית (7.22)
  const write = (el: HTMLElement, text: string, delay: number, step: number): number => {
    el.innerHTML = '';
    const wrap = document.createElement('span');
    [...text].forEach((ch) => {
      const c = document.createElement('span');
      c.className = 'dw-ch';
      c.textContent = ch;
      c.style.animationDelay = `${delay}ms`;
      delay += step;
      wrap.appendChild(c);
    });
    el.appendChild(wrap);
    return delay;
  };

  let lastHe = '';

  const render = () => {
    const now = new Date();
    const heNames = Object.fromEntries(
      new Intl.DateTimeFormat('he-u-ca-hebrew', { timeZone: TZ, weekday: 'long', month: 'long' })
        .formatToParts(now).map((p) => [p.type, p.value])
    );
    const heNums = Object.fromEntries(
      new Intl.DateTimeFormat('en-u-ca-hebrew', { timeZone: TZ, day: 'numeric', year: 'numeric' })
        .formatToParts(now).map((p) => [p.type, p.value])
    );
    const heText = `היום ${heNames.weekday}, ${toGematria(Number(heNums.day))} ב${heNames.month} ה${toGematria(Number(heNums.year) % 1000)}`;
    if (heText === lastHe) return; // אותו יום — בלי כתיבה מחדש בכל דקה
    lastHe = heText;

    const g = Object.fromEntries(
      new Intl.DateTimeFormat('en-GB', { timeZone: TZ, day: 'numeric', month: 'numeric', year: '2-digit' })
        .formatToParts(now).map((p) => [p.type, p.value])
    );
    const after = write(heEl, heText, 200, 60);
    write(gregEl, `${Number(g.day)}/${Number(g.month)}/${g.year}`, after + 350, 85);
  };

  render();
  setInterval(render, 60_000);
</script>
