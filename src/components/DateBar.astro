---
/**
 * הפס העליון (RULES 7.22, הוראת יניב 03/08/2026): בראש כל עמוד, העליון
 * ביותר — הלוגו וכיתוב המחוז על המלבן עצמו, לצד התאריך העברי (גימטריה)
 * והלועזי כתצוגת LED שבעה-מקטעים אמיתית: גופן DSEG7 (רישיון OFL,
 * self-hosted) על פאנל כהה עם מקטעי-רפאים, כמו רכיב חומרה. מחושב לפי
 * שעון ירושלים ומתעדכן בחציית חצות.
 */
---

<section class="datebar" aria-label="הדרכה במחוז ירושלים — התאריך היום">
  <div class="container datebar-inner">
    <a class="datebar-brand" href="/" aria-label="הדרכה במחוז ירושלים והעיר ירושלים — לעמוד הראשי">
      <img id="site-logo" src="/logo.png" alt="" width="44" height="44" loading="eager" fetchpriority="high" />
      <span class="datebar-title">הדרכה במחוז ירושלים והעיר ירושלים — מנח״י <small>בהובלת איילת קריספין</small></span>
    </a>
    <div class="datebar-dates">
      <p class="date-he" id="date-he" dir="rtl"></p>
      <div class="led-panel">
        <span class="led-ghost" id="led-ghost" aria-hidden="true"></span>
        <p class="date-greg" id="date-greg" dir="ltr"></p>
      </div>
    </div>
  </div>
</section>

<style>
  .datebar {
    background: linear-gradient(180deg, #0b1524 0%, #0e1c31 100%);
    border-block-end: 1px solid #17293f;
  }

  .datebar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.4rem;
    min-block-size: 64px;
    padding-block: 0.55rem;
  }

  .datebar-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #eaf4ff;
  }

  /* הסמל מסתובב לאט ובקצב קבוע (17.4, הוראת יניב 03/08/2026);
     ההשהיה מניחה למסך הפתיחה להיעלם לפני שהסיבוב מתחיל */
  .datebar-brand img {
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(126 210 255 / 0.35), 0 2px 12px rgb(0 0 0 / 0.45);
    animation: logo-spin 26s linear 2.5s infinite;
  }

  @keyframes logo-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .datebar-brand img { animation: none; }
  }

  .datebar-title {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 2.2vw, 1.12rem);
    font-weight: 700;
    line-height: 1.2;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-inline-size: 34ch;
  }

  /* הכיתוב הקטן — תכלת מוארת באיכות של שעון דיגיטלי (7.22) */
  .datebar-title small {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    color: #8fd9ff;
    letter-spacing: 0.09em;
    text-shadow:
      0 0 2px rgb(126 210 255 / 0.9),
      0 0 12px rgb(126 210 255 / 0.55),
      0 0 26px rgb(64 156 255 / 0.35);
  }

  .datebar-dates {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.3rem;
    justify-content: flex-end;
  }

  .date-he {
    margin: 0;
    color: #7ed2ff;
    font-weight: 600;
    font-size: clamp(0.92rem, 2vw, 1.15rem);
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 0 2px rgb(126 210 255 / 0.9),
      0 0 14px rgb(126 210 255 / 0.5),
      0 0 34px rgb(64 156 255 / 0.35);
  }

  /* פאנל LED — לוח כהה שקוע כמו רכיב תצוגה אמיתי (7.22) */
  .led-panel {
    position: relative;
    padding: 0.4rem 0.75rem 0.3rem;
    border-radius: 8px;
    background: linear-gradient(180deg, #04060b 0%, #070b12 100%);
    border: 1px solid #1b2634;
    box-shadow:
      inset 0 2px 10px rgb(0 0 0 / 0.9),
      inset 0 0 1px #000,
      0 1px 0 rgb(126 210 255 / 0.08);
  }

  /* זיגוג זכוכית דק על הפאנל — כמו חלון תצוגה אמיתי */
  .led-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
    pointer-events: none;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.09) 0%, transparent 38%);
  }

  /* מקטעי הרפאים הכבויים שמאחורי הספרות — חתימת תצוגת LED אמיתית */
  .led-ghost {
    position: absolute;
    inset: 0.4rem 0.75rem 0.3rem;
    font-family: 'DSEG7', monospace;
    font-size: clamp(1rem, 2vw, 1.28rem);
    letter-spacing: 0.1em;
    color: rgb(100 160 255 / 0.09);
    direction: ltr;
    text-align: left;
    pointer-events: none;
    user-select: none;
  }

  .date-greg {
    position: relative;
    margin: 0;
    font-family: 'DSEG7', monospace;
    font-size: clamp(1rem, 2vw, 1.28rem);
    letter-spacing: 0.1em;
    color: #4db2ff;
    text-shadow:
      0 0 2px rgb(77 178 255 / 1),
      0 0 12px rgb(77 178 255 / 0.75),
      0 0 30px rgb(43 107 255 / 0.55);
    animation: led-breathe 4.6s ease-in-out 4s infinite alternate;
  }

  /* נשימת זוהר עדינה — תצוגת LED חיה, לא סטטית */
  @keyframes led-breathe {
    from {
      text-shadow:
        0 0 2px rgb(77 178 255 / 1),
        0 0 12px rgb(77 178 255 / 0.75),
        0 0 30px rgb(43 107 255 / 0.55);
    }
    to {
      text-shadow:
        0 0 3px rgb(77 178 255 / 1),
        0 0 18px rgb(77 178 255 / 0.9),
        0 0 44px rgb(43 107 255 / 0.7);
    }
  }

  /* אנימציית הכתיבה מימין לשמאל (7.22, הוראת יניב 03/08/2026):
     האותיות נוצרות ב-JS ולכן :global */
  .date-he :global(.dw-ch) {
    display: inline-block;
    white-space: pre;
    opacity: 0;
    filter: blur(7px);
    transform: translateY(0.18em);
    animation: dw-in 1150ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  /* ספרת LED נדלקת עם הבהוב אתחול קצר — כמו חומרה שמקבלת מתח */
  .date-greg :global(.dw-led) {
    display: inline-block;
    white-space: pre;
    opacity: 0;
    animation: led-boot 1050ms ease-out forwards;
  }

  .date-greg :global(.dw-sep) {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.82em;
  }

  @keyframes led-boot {
    0% { opacity: 0; }
    30% { opacity: 1; }
    42% { opacity: 0.12; }
    58% { opacity: 1; }
    70% { opacity: 0.35; }
    100% { opacity: 1; }
  }

  @keyframes dw-in {
    55% {
      opacity: 1;
      filter: blur(0.5px);
      text-shadow:
        0 0 4px rgb(126 210 255 / 1),
        0 0 22px rgb(126 210 255 / 0.9),
        0 0 44px rgb(64 156 255 / 0.6);
    }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .date-greg { animation: none; }

    .date-he :global(.dw-ch),
    .date-greg :global(.dw-led) {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .datebar-inner { justify-content: center; text-align: center; }
    .datebar-dates { justify-content: center; }
  }
</style>

<script>
  const heEl = document.getElementById('date-he')!;
  const gregEl = document.getElementById('date-greg')!;

  const TZ = 'Asia/Jerusalem';

  const GEMATRIA: readonly (readonly [number, string])[] = [
    [400, 'ת'], [300, 'ש'], [200, 'ר'], [100, 'ק'], [90, 'צ'], [80, 'פ'],
    [70, 'ע'], [60, 'ס'], [50, 'נ'], [40, 'מ'], [30, 'ל'], [20, 'כ'],
    [10, 'י'], [9, 'ט'], [8, 'ח'], [7, 'ז'], [6, 'ו'], [5, 'ה'],
    [4, 'ד'], [3, 'ג'], [2, 'ב'], [1, 'א'],
  ];

  const toGematria = (n: number): string => {
    let s = '';
    let r = n;
    while (r > 0) {
      if (r === 15) { s += 'טו'; break; }
      if (r === 16) { s += 'טז'; break; }
      const pair = GEMATRIA.find(([v]) => v <= r)!;
      s += pair[1];
      r -= pair[0];
    }
    return s.length === 1 ? `${s}׳` : `${s.slice(0, -1)}״${s.slice(-1)}`;
  };

  // כתיבה אות-אות בכיוון הקריאה — עברית מימין לשמאל; איטית ויוקרתית (7.22)
  const write = (el: HTMLElement, text: string, delay: number, step: number, cls = 'dw-ch'): number => {
    el.innerHTML = '';
    const wrap = document.createElement('span');
    [...text].forEach((ch) => {
      const c = document.createElement('span');
      c.className = ch === '/' ? `${cls} dw-sep` : cls;
      c.textContent = ch;
      c.style.animationDelay = `${delay}ms`;
      delay += step;
      wrap.appendChild(c);
    });
    el.appendChild(wrap);
    return delay;
  };

  let lastHe = '';

  const render = () => {
    const now = new Date();
    const heNames = Object.fromEntries(
      new Intl.DateTimeFormat('he-u-ca-hebrew', { timeZone: TZ, weekday: 'long', month: 'long' })
        .formatToParts(now).map((p) => [p.type, p.value])
    );
    const heNums = Object.fromEntries(
      new Intl.DateTimeFormat('en-u-ca-hebrew', { timeZone: TZ, day: 'numeric', year: 'numeric' })
        .formatToParts(now).map((p) => [p.type, p.value])
    );
    const heText = `היום ${heNames.weekday}, ${toGematria(Number(heNums.day))} ב${heNames.month} ה${toGematria(Number(heNums.year) % 1000)}`;
    if (heText === lastHe) return; // אותו יום — בלי כתיבה מחדש בכל דקה
    lastHe = heText;

    const g = Object.fromEntries(
      new Intl.DateTimeFormat('en-GB', { timeZone: TZ, day: 'numeric', month: 'numeric', year: '2-digit' })
        .formatToParts(now).map((p) => [p.type, p.value])
    );
    const gregText = `${Number(g.day)}/${Number(g.month)}/${g.year}`;
    const ghost = document.getElementById('led-ghost');
    if (ghost) ghost.textContent = gregText.replace(/\d/g, '8');
    const after = write(heEl, heText, 250, 95);
    write(gregEl, gregText, after + 450, 150, 'dw-led');
  };

  render();
  setInterval(render, 60_000);
</script>
