---
/**
 * פס התאריך (RULES 7.22): שעון דיגיטלי יוקרתי בכחול־אור —
 * מימין התאריך העברי המלא, משמאל הלועזי בסגנון 23/5/26.
 * מחושב לפי שעון ירושלים ומתעדכן אוטומטית מדי דקה (חוצה חצות אמיתי).
 */
---

<section class="datebar" aria-label="התאריך היום">
  <div class="container datebar-inner">
    <p class="date-he" id="date-he" dir="rtl"></p>
    <p class="date-greg" id="date-greg" dir="ltr"></p>
  </div>
</section>

<style>
  .datebar {
    background: linear-gradient(180deg, #0b1524 0%, #0e1c31 100%);
    border-block: 1px solid #17293f;
  }

  .datebar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1.4rem;
    min-block-size: 62px;
    padding-block: 0.7rem;
  }

  .date-he,
  .date-greg {
    margin: 0;
    color: #7ed2ff;
    font-weight: 600;
    font-size: clamp(1rem, 2.3vw, 1.3rem);
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 0 2px rgb(126 210 255 / 0.9),
      0 0 14px rgb(126 210 255 / 0.5),
      0 0 34px rgb(64 156 255 / 0.35);
  }

  @media (max-width: 560px) {
    .datebar-inner { justify-content: center; text-align: center; }
  }
</style>

<script>
  const heEl = document.getElementById('date-he')!;
  const gregEl = document.getElementById('date-greg')!;

  const TZ = 'Asia/Jerusalem';

  // גימטריה מדויקת (Intl אינו תומך בספרות עבריות אלגוריתמיות): כ׳, ט״ו, תשפ״ו
  const GEMATRIA: readonly (readonly [number, string])[] = [
    [400, 'ת'], [300, 'ש'], [200, 'ר'], [100, 'ק'], [90, 'צ'], [80, 'פ'],
    [70, 'ע'], [60, 'ס'], [50, 'נ'], [40, 'מ'], [30, 'ל'], [20, 'כ'],
    [10, 'י'], [9, 'ט'], [8, 'ח'], [7, 'ז'], [6, 'ו'], [5, 'ה'],
    [4, 'ד'], [3, 'ג'], [2, 'ב'], [1, 'א'],
  ];

  const toGematria = (n: number): string => {
    let s = '';
    let r = n;
    while (r > 0) {
      if (r === 15) { s += 'טו'; break; }
      if (r === 16) { s += 'טז'; break; }
      const pair = GEMATRIA.find(([v]) => v <= r)!;
      s += pair[1];
      r -= pair[0];
    }
    return s.length === 1 ? `${s}׳` : `${s.slice(0, -1)}״${s.slice(-1)}`;
  };

  const render = () => {
    const now = new Date();

    // שם היום והחודש בעברית מ־Intl; היום והשנה כמספרים → גימטריה
    const heNames = Object.fromEntries(
      new Intl.DateTimeFormat('he-u-ca-hebrew', {
        timeZone: TZ,
        weekday: 'long',
        month: 'long',
      })
        .formatToParts(now)
        .map((p) => [p.type, p.value])
    );
    const heNums = Object.fromEntries(
      new Intl.DateTimeFormat('en-u-ca-hebrew', {
        timeZone: TZ,
        day: 'numeric',
        year: 'numeric',
      })
        .formatToParts(now)
        .map((p) => [p.type, p.value])
    );
    const day = toGematria(Number(heNums.day));
    const year = toGematria(Number(heNums.year) % 1000);
    heEl.textContent = `היום ${heNames.weekday}, ${day} ב${heNames.month} ה${year}`;

    // לועזי: "23/5/26"
    const g = Object.fromEntries(
      new Intl.DateTimeFormat('en-GB', {
        timeZone: TZ,
        day: 'numeric',
        month: 'numeric',
        year: '2-digit',
      })
        .formatToParts(now)
        .map((p) => [p.type, p.value])
    );
    gregEl.textContent = `${Number(g.day)}/${Number(g.month)}/${g.year}`; // בלי אפסים מובילים — 23/5/26
  };

  render();
  setInterval(render, 60_000); // מתעדכן אוטומטית — חוצה חצות בזמן אמת
</script>
