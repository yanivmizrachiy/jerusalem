---
/**
 * עמוד משאב מחולק (RULES 8.2; הוראת יניב 05/08/2026 — מחליף את עמוד
 * המשאב שבתוך החוברת): בצד אחד של המסך המשאב עצמו מוטמע חי, ובצד השני
 * כותרת, הסבר, מקור ולוח הפעולות שלו. בנייד ההטמעה ראשונה וההסבר אחריה
 * (8.6). ההטמעה נטענת רק כשהעמוד נגלל אליה, עם שלד טעינה יוקרתי (8.9),
 * ודפדפן בלי מציג PDF מקבל כרטיס פתיחה אמיתי ולא מסגרת ריקה (8.8).
 */
import Breadcrumbs from './Breadcrumbs.astro';
import MafmarRange from './MafmarRange.astro';
import {
  gradeHref,
  gradeMaterialsHref,
  gradeLabel,
  itemHref,
  itemNeighbours,
  kindLabel,
  type ChoveretChapter,
  type ChoveretGrade,
  type ChoveretItem,
} from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
  chapter: ChoveretChapter;
  item: ChoveretItem;
}

const { grade, chapter, item } = Astro.props;

const site = 'https://jerusalem-virid.vercel.app';
const canonical = `${site}${itemHref(grade.slug, item)}`;
const copyTarget = item.url.startsWith('/') ? `${site}${item.url}` : item.url;
const { prev, next } = itemNeighbours(grade, item.id);
const waText = `${item.title} — ${grade.title} — ${canonical}`;
---

<div
  class="res-page"
  style={`--grade:${grade.color}; --grade-dark:${grade.dark}; --ch:${chapter.color}; --ch-dark:${chapter.dark}`}
>
  <Breadcrumbs
    items={[
      { label: 'ראשי', href: '/' },
      { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
      { label: gradeLabel(grade), href: gradeHref(grade.slug) },
      { label: 'חומרים להוראה', href: gradeMaterialsHref(grade.slug) },
      { label: item.title },
    ]}
  />

  <div class="res-split">
    <aside class="res-panel">
      <p class="res-eyebrow">
        <a href={gradeHref(grade.slug)}>{gradeLabel(grade)}</a>
        <span aria-hidden="true">·</span>
        <a href={`${gradeMaterialsHref(grade.slug)}#${chapter.id}`}>{chapter.title}</a>
      </p>

      <h1 class="res-title">{item.title}</h1>

      <p class="res-kind">{kindLabel[item.kind]}</p>

      {item.note && <p class="res-note">{item.note}</p>}
      {item.source && <p class="res-source">{item.source}</p>}

      <div class="res-actions" role="group" aria-label="פעולות">
        {item.download && (
          <a class="btn btn-primary" href={item.download} target="_blank" rel="noopener" download>
            הורדה ⬇
          </a>
        )}
        <a
          class="btn btn-whatsapp"
          href={`https://wa.me/?text=${encodeURIComponent(waText)}`}
          target="_blank"
          rel="noopener"
          aria-label={`שיתוף ${item.title} ב־WhatsApp`}
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>
        <a
          class="btn btn-gmail"
          href={`mailto:?subject=${encodeURIComponent(item.title)}&body=${encodeURIComponent(`${item.title} — ${canonical}`)}`}
          aria-label={`שליחת ${item.title} בדוא״ל`}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M1.636 20.5h3.819V11.73L0 7.64v11.223c0 .904.732 1.636 1.636 1.636Z" />
            <path fill="#34A853" d="M18.545 20.5h3.819c.904 0 1.636-.732 1.636-1.636V7.64l-5.455 4.09Z" />
            <path fill="#FBBC04" d="M18.545 5.457v6.273L24 7.64V6.275c0-2.023-2.309-3.178-3.927-1.964Z" />
            <path fill="#EA4335" d="M5.455 11.73V5.457L12 10.366l6.545-4.909v6.273L12 16.639Z" />
            <path fill="#C5221F" d="M0 6.275v1.365l5.455 4.09V5.457L4.073 4.42C2.309 3.098 0 4.252 0 6.275Z" />
          </svg>
        </a>
        <button class="btn btn-ghost" type="button" data-copy={copyTarget}>העתקת קישור</button>
        <button class="btn btn-ghost" type="button" data-share={canonical} data-share-title={item.title} hidden>
          שיתוף
        </button>
        <a
          class="btn btn-ghost"
          href={item.url}
          target={item.url.startsWith('/') ? undefined : '_blank'}
          rel="noopener"
        >
          פתיחה במקור ↗
        </a>
        {item.embed && item.kind !== 'maf' && (
          <button class="btn btn-ghost" type="button" data-fs hidden>מסך מלא ⛶</button>
        )}
      </div>

      <p class="res-status" data-status role="status" aria-live="polite"></p>

      <nav class="res-pager" aria-label="ניווט בין הקבצים">
        {
          prev ? (
            <a class="pager-link" href={itemHref(grade.slug, prev.item)}>
              <span class="pager-tag">הקובץ הקודם</span>
              <span class="pager-title">{prev.item.title}</span>
            </a>
          ) : (
            <span class="pager-spacer" />
          )
        }
        {
          next ? (
            <a class="pager-link" href={itemHref(grade.slug, next.item)}>
              <span class="pager-tag">הקובץ הבא</span>
              <span class="pager-title">{next.item.title}</span>
            </a>
          ) : (
            <span class="pager-spacer" />
          )
        }
      </nav>

      <a class="btn btn-ghost res-back" href={`${gradeMaterialsHref(grade.slug)}#${chapter.id}`}>
        חזרה לחומרים של {grade.title}
      </a>
    </aside>

    <div class="res-view" data-view data-kind={item.kind}>
      {
        item.kind === 'maf' && item.maf ? (
          <MafmarRange sectionId={item.maf} accent={chapter.color} fill />
        ) : item.embed ? (
          <>
            <div class="res-frame" data-frame>
              <iframe
                data-esrc={item.embed}
                title={`${item.title} — תצוגה חיה`}
                allow="fullscreen; clipboard-write"
                loading="lazy"
              />
              <span class="res-skel" aria-hidden="true">
                <span class="res-skel-spin"></span>
                <span class="res-skel-txt">טוען את {item.title}…</span>
              </span>
            </div>
            {item.kind === 'pdf' && (
              <div class="res-frame res-open-card" data-pdf-fb hidden>
                <p>בדפדפן הזה קובצי PDF נפתחים לצפייה מלאה במסך נפרד:</p>
                <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                  פתיחת {item.title} ↗
                </a>
              </div>
            )}
          </>
        ) : (
          <div class="res-frame res-open-card">
            <p>המשאב הזה נפתח באתר המקור:</p>
            <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
              פתיחת {item.title} ↗
            </a>
          </div>
        )
      }
    </div>
  </div>
</div>

<style>
  /* מיכל רחב במיוחד — המשאב והפעולות מנצלים את המסך, בלי לגלוש לקצוות */
  .res-page {
    inline-size: var(--embed-page-inline);
    margin-inline: auto;
    padding-block: 1.2rem clamp(2.6rem, 5vw, 4rem);
  }

  /* ===== חצי-חצי במסך רחב: המשאב מימין, הפעולות משמאל (8.2) =====
     לוח המידע קודם ב-DOM כדי שה-h1 של המשאב יופיע לפני כותרות המשנה
     שבתוך ההטמעה (סדר כותרות תקין לקורא מסך), והסדר החזותי נשמר
     באמצעות order: ההטמעה בעמודה הראשונה — הימנית ב-RTL. */
  .res-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--embed-column-gap);
    margin-block-start: clamp(1.4rem, 3vw, 2.4rem);
    align-items: start;
  }

  .res-view { order: 1; }
  .res-panel { order: 2; }

  /* ===== פס גלילה אחד בלבד (הוראת יניב, 06/08/2026) =====
     כשהמשאב מוטמע, העמוד עצמו נכנס בדיוק לגובה החלון ואינו נגלל — כך
     נראה פס גלילה אחד, של המשאב עצמו, ולא שניים זה לצד זה שנראים
     כמו דפדפן בתוך דפדפן. הפאנל גולל בפנים אם התוכן שלו ארוך. */
  .res-split { block-size: var(--fit, auto); }

  .res-view {
    min-inline-size: 0;
    block-size: 100%;
    min-block-size: 0;
  }

  .res-panel {
    block-size: 100%;
    min-block-size: 0;
    /* auto — פס גלילה מופיע רק כשהתוכן באמת ארוך מהצד */
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .res-frame:not(.res-open-card) { block-size: 100%; }

  /* ===== התאמה לפי סוג המשאב (הוראת יניב, 06/08/2026) =====
     סרטון שומר 16/9 ואינו נמתח לגובה של מסמך; מצגת מקבלת יחס מצגת;
     מסמך, PDF ואתר חי ממלאים את הצד לגובה מלא. */
  .res-view[data-kind='video'] .res-frame,
  .res-view[data-kind='canva'] .res-frame,
  .res-view[data-kind='flip'] .res-frame {
    block-size: auto;
    align-self: start;
  }

  .res-view[data-kind='video'] .res-frame iframe { aspect-ratio: 16 / 9; block-size: auto; }
  .res-view[data-kind='canva'] .res-frame iframe,
  .res-view[data-kind='flip'] .res-frame iframe { aspect-ratio: 16 / 10; block-size: auto; }

  /* פריט מהחוזר ממלא את הצד שלו באותו אופן */
  .res-view :global(.mrange.is-fill) { block-size: 100%; }

  /* ===== מסגרת הזכוכית האחידה (8.26) ===== */
  .res-frame {
    position: relative;
    padding: var(--embed-pad);
    border-radius: var(--embed-radius);
    background: linear-gradient(155deg, rgb(255 253 248 / 0.72), rgb(245 241 232 / 0.5));
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    box-shadow:
      inset 0 0 0 1px var(--embed-border),
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      var(--embed-shadow);
    overflow: hidden;
  }

  /* חוט זהב בתחתית + קו-אור אלכסוני — לעולם לא חוסמים לחיצה */
  .res-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 42%, rgb(255 255 255 / 0.22) 50%, transparent 58%);
  }

  .res-frame iframe {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 320px;
    border: 0;
    border-radius: 14px;
    background: #fff;
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }

  .res-frame.is-loaded iframe { opacity: 1; }

  .res-skel {
    position: absolute;
    inset: 10px;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    pointer-events: none;
    background: linear-gradient(180deg, #fff, var(--paper-soft));
    transition: opacity 420ms var(--ease);
  }

  .res-frame.is-loaded .res-skel { opacity: 0; }

  .res-skel-spin {
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    border: 3px solid rgb(212 175 92 / 0.22);
    border-block-start-color: var(--gold);
    animation: res-spin 900ms linear infinite;
  }

  .res-skel-txt { color: var(--ink-faint); font-size: 0.88rem; }

  @keyframes res-spin { to { rotate: 360deg; } }

  .res-open-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-block-size: min(58svh, 460px);
    text-align: center;
    padding: 2rem;
  }

  .res-frame[hidden] { display: none !important; }

  .res-open-card p { margin: 0; font-weight: 600; color: var(--ink-soft); }

  /* ===== לוח המידע והפעולות ===== */
  .res-panel {
    padding: var(--embed-panel-padding);
    border-radius: var(--embed-radius);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-soft);
    border-inline-start: 5px solid var(--ch);
  }

  /* גוון קריא של צבע הפרק — עומד ב-AA גם בטקסט קטן על הגוון הרך שלו */
  .res-panel { --ch-ink: color-mix(in srgb, var(--ch-dark) 76%, #10141c); }

  .res-eyebrow {
    margin: 0 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ch-ink);
  }

  .res-eyebrow a { color: inherit; text-decoration: none; border-block-end: 1px solid transparent; }
  .res-eyebrow a:hover { border-block-end-color: currentColor; }

  .res-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    line-height: 1.15;
    color: var(--navy);
  }

  .res-kind {
    display: inline-block;
    margin: 0.7rem 0 0;
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ch) 9%, #fff);
    color: var(--ch-ink);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .res-note { margin: 1.2rem 0 0; color: var(--ink-soft); line-height: 1.75; }
  .res-source { margin: 0.6rem 0 0; color: var(--ink-faint); font-size: 0.83rem; }

  .res-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: clamp(1.5rem, 2.6vw, 2.1rem);
  }

  .res-status { margin: 0.7rem 0 0; min-block-size: 1.2rem; font-size: 0.85rem; color: var(--gold-deep); font-weight: 600; }

  .res-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-block-start: clamp(1.6rem, 3vw, 2.4rem);
    padding-block-start: clamp(1.2rem, 2.2vw, 1.7rem);
    border-block-start: 1px solid var(--line);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
  }

  .pager-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }
  .pager-link:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .pager-tag { font-size: 0.75rem; font-weight: 700; color: var(--gold-deep); }
  .pager-title { font-weight: 600; font-size: 0.92rem; line-height: 1.4; }
  .pager-spacer { display: none; }

  .res-back { margin-block-start: 1.1rem; inline-size: 100%; justify-content: center; }

  /* ===== נייד: ההטמעה ראשונה, ההסבר והפעולות אחריה (8.6) =====
     כאן העמוד זורם וגולל כרגיל — אין חלוקה לשני צדדים ולכן אין
     שני פסי גלילה זה לצד זה. */
  @media (max-width: 1099px) {
    .res-split { grid-template-columns: 1fr; block-size: auto; gap: clamp(1.4rem, 4vw, 2.2rem); }
    .res-view { block-size: auto; }
    .res-panel { block-size: auto; overflow: visible; }
    .res-frame:not(.res-open-card) { block-size: auto; }
    .res-frame iframe { block-size: min(66svh, 560px); }
    .res-pager { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .res-frame iframe { opacity: 1; transition: none; }
    .res-skel { transition: none; }
    .res-skel-spin { animation: none; border-block-start-color: rgb(212 175 92 / 0.26); }
    .pager-link:hover { transform: none; }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('.res-page');
  if (page) {
    /* פס גלילה אחד בלבד (הוראת יניב, 06/08/2026): במסך רחב החלוקה
       נכנסת בדיוק לגובה שנשאר בחלון, כך שהעמוד עצמו אינו נגלל ולא
       נוצרים שני פסי גלילה זה לצד זה. במסך צר העמוד זורם כרגיל. */
    const split = page.querySelector<HTMLElement>('.res-split');
    if (split) {
      const wide = matchMedia('(min-width: 901px)');
      const fit = () => {
        split.style.removeProperty('--fit');
        if (!wide.matches) return;
        const doc = document.documentElement;
        const top = split.getBoundingClientRect().top + window.scrollY;
        // כל מה שיושב מתחת לחלוקה — ריפוד העמוד ופס התחתית — נכנס לחשבון,
        // אחרת הפוטר דוחף את העמוד וחוזר פס גלילה שני
        const below = Math.max(0, doc.scrollHeight - (top + split.offsetHeight));
        split.style.setProperty('--fit', `${Math.max(420, Math.round(innerHeight - top - below))}px`);
      };
      fit();
      addEventListener('resize', fit, { passive: true });
      addEventListener('load', fit, { once: true });
      wide.addEventListener('change', fit);
      document.fonts?.ready.then(fit);
    }

    const status = page.querySelector<HTMLElement>('[data-status]');
    const say = (text: string) => {
      if (!status) return;
      status.textContent = text;
      setTimeout(() => {
        if (status.textContent === text) status.textContent = '';
      }, 3200);
    };

    // דפדפן בלי מציג PDF מובנה — כרטיס פתיחה אמיתי, לא מסגרת ריקה (8.8)
    const fb = page.querySelector<HTMLElement>('[data-pdf-fb]');
    const frame = page.querySelector<HTMLElement>('[data-frame]');
    const noPdf = 'pdfViewerEnabled' in navigator && navigator.pdfViewerEnabled === false;
    if (fb && frame && noPdf) {
      frame.hidden = true;
      fb.hidden = false;
    }

    // ההטמעה נטענת כשהעמוד באמת מוצג, ונחשפת בעדינות אחרי load (8.9)
    const iframe = frame?.querySelector<HTMLIFrameElement>('iframe[data-esrc]');
    if (frame && iframe && !frame.hidden) {
      const load = () => {
        if (iframe.src) return;
        iframe.addEventListener('load', () => frame.classList.add('is-loaded'), { once: true });
        iframe.src = iframe.dataset.esrc ?? '';
        // רשת ביטחון: לא משאירים שלד טעינה תקוע אם ה-load לא נורה
        setTimeout(() => frame.classList.add('is-loaded'), 8000);
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              load();
            }
          },
          { rootMargin: '300px' }
        );
        io.observe(frame);
      } else load();
    }

    page.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
          say('הקישור הועתק');
        } catch {
          say('ההעתקה נחסמה בדפדפן');
        }
      });
    });

    // שיתוף במנגנון המכשיר — מוצג רק כשהוא באמת נתמך (8.22)
    const shareBtn = page.querySelector<HTMLButtonElement>('[data-share]');
    if (shareBtn && typeof navigator.share === 'function') {
      shareBtn.hidden = false;
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.share({ title: shareBtn.dataset.shareTitle, url: shareBtn.dataset.share });
          say('הועבר למנגנון השיתוף');
        } catch {
          /* המשתמש ביטל — אין מה לדווח */
        }
      });
    }

    const fsBtn = page.querySelector<HTMLButtonElement>('[data-fs]');
    if (fsBtn && frame && frame.requestFullscreen) {
      fsBtn.hidden = false;
      fsBtn.addEventListener('click', async () => {
        try {
          await frame.requestFullscreen();
        } catch {
          say('המסך המלא נחסם בדפדפן');
        }
      });
    }
  }
</script>
