---
/**
 * עמוד משאב מחולק: ההטמעה מימין ולוח מידע/פעולות משמאל במסך רחב,
 * ובנייד ההטמעה קודמת למידע. כל metadata גלוי נגזר מהמודל הפדגוגי
 * הקנוני; פעולות משותפות לכל משאב רגיל דרך ResourceActions — למעט
 * מקטעי חוזר מפמ״ר ומסמכי plan/prisa, שיש להם ניווט משלהם ואין
 * לצדם לוח פעולות גנרי (הוראת יניב, 10/08/2026).
 */
import Breadcrumbs from './Breadcrumbs.astro';
import AuthorAttribution from './AuthorAttribution.astro';
import ResourceBrand from './ResourceBrand.astro';
import MafmarRange from './MafmarRange.astro';
import ResourceActions from './ResourceActions.astro';
import PlanPrisaWeb from './PlanPrisaWeb.astro';
import { embedLayoutFor } from '../data/embed-layout';
import { planPrisaDocumentFor } from '../data/plan-prisa-web';
import { resourceDisplayLabel } from '../data/resource-labels';
import {
  chapterHref,
  gradeHref,
  gradeMaterialsHref,
  gradeLabel,
  itemHref,
  itemNeighbours,
  type ChoveretChapter,
  type ChoveretGrade,
  type ChoveretItem,
} from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
  chapter: ChoveretChapter;
  item: ChoveretItem;
}

const { grade, chapter, item } = Astro.props;

const site = 'https://jerusalem-virid.vercel.app';
const canonical = `${site}${itemHref(grade.slug, item)}`;
const { prev, next } = itemNeighbours(grade, item.id);
const chapterBackHref =
  chapter.materials === false
    ? (chapter.redirectHref ?? gradeMaterialsHref(grade.slug))
    : chapterHref(grade.slug, chapter.id);
const waText = `${item.title} — ${grade.title} — ${canonical}`;
const semanticKind = resourceDisplayLabel(item);
const embedLayout = embedLayoutFor(item);
const embedStyle = `--resource-aspect:${embedLayout.aspectRatio ?? 'auto'}; --resource-min-h:${embedLayout.minHeight ?? '520px'}`;
const planPrisaDoc = planPrisaDocumentFor(item.download);
/** מפמ״ר ומסמכי plan/prisa נושאים ניווט וגלילת מקור משלהם — לוח הפעולות
    הגנרי מכפיל אותם (הוראת יניב, 10/08/2026). ראו MafmarRange/PlanPrisaWeb. */
const showActions = item.kind !== 'maf' && !planPrisaDoc;
---

<div
  class="res-page"
  style={`--grade:${grade.color}; --grade-dark:${grade.dark}; --ch:${chapter.color}; --ch-dark:${chapter.dark}`}
>
  <Breadcrumbs
    items={[
      { label: 'ראשי', href: '/' },
      { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
      { label: gradeLabel(grade), href: gradeHref(grade.slug) },
      { label: 'חומרים להוראה', href: gradeMaterialsHref(grade.slug) },
      { label: chapter.title, href: chapterBackHref },
      { label: item.title },
    ]}
  />

  <div class:list={['res-split', { 'is-web-doc': Boolean(planPrisaDoc) }]}>
    <aside class="res-panel">
      <p class="res-eyebrow">
        <a href={gradeHref(grade.slug)}>{gradeLabel(grade)}</a>
        <span aria-hidden="true">·</span>
        <a href={chapterBackHref}>{chapter.title}</a>
      </p>

      <h1 class="res-title">{item.title}</h1>
      <p class="res-kind">{semanticKind}</p>

      <ResourceBrand resourceId={item.id} />
      <AuthorAttribution resourceId={item.id} />

      {item.note && <p class="res-note">{item.note}</p>}
      {item.source && <p class="res-source">{item.source}</p>}

      {showActions && (
        <>
          <ResourceActions
            downloadUrl={item.download}
            whatsappText={waText}
            emailSubject={item.title}
            emailBody={`${item.title} — ${canonical}`}
            copyUrl={canonical}
            shareUrl={canonical}
            shareTitle={item.title}
            sourceUrl={item.url}
            sourceInternal={item.url.startsWith('/')}
            fullscreen={Boolean(item.embed)}
            fullscreenTarget="[data-frame]"
            statusTarget="[data-status]"
          />

          <p class="res-status" data-status role="status" aria-live="polite"></p>
        </>
      )}

      <nav class="res-pager" aria-label="ניווט בין המשאבים">
        {
          prev ? (
            <a class="pager-link" href={itemHref(grade.slug, prev.item)}>
              <span class="pager-tag">המשאב הקודם →</span>
              <span class="pager-title">{prev.item.title}</span>
            </a>
          ) : (
            <span class="pager-spacer" />
          )
        }
        {
          next ? (
            <a class="pager-link" href={itemHref(grade.slug, next.item)}>
              <span class="pager-tag">← המשאב הבא</span>
              <span class="pager-title">{next.item.title}</span>
            </a>
          ) : (
            <span class="pager-spacer" />
          )
        }
      </nav>

      <a class="btn btn-ghost res-back" href={chapterBackHref}>
        חזרה ל{chapter.title}
      </a>
    </aside>

    <div
      class="res-view"
      data-view
      data-kind={item.kind}
      data-orientation={embedLayout.orientation}
      data-web-document={planPrisaDoc ? 'true' : undefined}
      style={embedStyle}
    >
      {
        item.kind === 'maf' && item.maf ? (
          <MafmarRange sectionId={item.maf} accent={chapter.color} fill />
        ) : planPrisaDoc ? (
          <PlanPrisaWeb document={planPrisaDoc} accent={chapter.color} sourceUrl={item.url} />
        ) : item.embed ? (
          <>
            <div class="res-frame embed-frame" data-frame aria-busy="true">
              <iframe
                data-esrc={item.embed}
                title={`${item.title} — תצוגה חיה`}
                allow="fullscreen; clipboard-write"
                loading="lazy"
              />
              <span class="res-skel" aria-hidden="true">
                <span class="res-skel-spin"></span>
                <span class="res-skel-txt">טוען את {item.title}…</span>
              </span>
            </div>
            {item.kind === 'pdf' && (
              <div class="res-frame embed-frame res-open-card" data-pdf-fb hidden>
                <p>בדפדפן הזה קובצי PDF נפתחים לצפייה מלאה במסך נפרד:</p>
                <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
                  פתיחת {item.title} ↗
                </a>
              </div>
            )}
          </>
        ) : (
          <div class="res-frame embed-frame res-open-card">
            <p>המשאב הזה נפתח באתר המקור:</p>
            <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener">
              פתיחת {item.title} ↗
            </a>
          </div>
        )
      }
    </div>
  </div>
</div>

<style>
  .res-page {
    inline-size: var(--embed-page-inline);
    margin-inline: auto;
    padding-block: 1.2rem clamp(2.6rem, 5vw, 4rem);
  }

  .res-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--embed-column-gap);
    margin-block-start: clamp(1.4rem, 3vw, 2.4rem);
    align-items: start;
  }


  .res-view { order: 1; min-inline-size: 0; }
  .res-panel { order: 2; align-self: start; }

  .res-frame iframe { block-size: auto; }

  .res-view[data-orientation='portrait'] .res-frame iframe,
  .res-view[data-orientation='landscape'] .res-frame iframe {
    aspect-ratio: var(--resource-aspect);
    min-block-size: var(--resource-min-h);
    max-block-size: 1180px;
  }

  .res-view[data-orientation='interactive'] .res-frame iframe {
    block-size: var(--resource-min-h);
    min-block-size: var(--resource-min-h);
  }

  .res-view[data-kind='maf'] :global(.mrange.is-fill .mrange-shell) {
    aspect-ratio: 1 / 1.3;
    block-size: auto;
    min-block-size: 620px;
    max-block-size: 1120px;
  }

  .res-view :global(.mrange.is-fill) { block-size: 100%; }

  .res-frame iframe {
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }

  .res-frame.is-loaded iframe { opacity: 1; }

  .res-skel {
    position: absolute;
    inset: var(--embed-pad);
    border-radius: var(--embed-inner-radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    pointer-events: none;
    background: linear-gradient(180deg, #fff, var(--paper-soft));
    transition: opacity 420ms var(--ease);
  }

  .res-frame.is-loaded .res-skel { opacity: 0; }

  .res-skel-spin {
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    border: 3px solid rgb(212 175 92 / 0.22);
    border-block-start-color: var(--gold);
    animation: res-spin 900ms linear infinite;
  }

  .res-skel-txt { color: var(--ink-faint); font-size: 0.88rem; }
  @keyframes res-spin { to { rotate: 360deg; } }

  .res-open-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-block-size: min(78svh, 720px);
    text-align: center;
    padding: 2rem;
  }

  .res-frame[hidden] { display: none !important; }
  .res-open-card p { margin: 0; font-weight: 600; color: #eef1f7; }

  .res-panel {
    padding: var(--embed-panel-padding);
    border-radius: var(--embed-radius);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-soft);
    border-inline-start: 5px solid var(--ch);
    --ch-ink: color-mix(in srgb, var(--ch-dark) 76%, #10141c);
  }

  .res-eyebrow {
    margin: 0 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ch-ink);
  }

  .res-eyebrow a { color: inherit; text-decoration: none; border-block-end: 1px solid transparent; }
  .res-eyebrow a:hover { border-block-end-color: currentColor; }

  .res-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    line-height: 1.15;
    color: var(--navy);
  }

  .res-kind {
    display: inline-block;
    margin: 0.7rem 0 0;
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ch) 9%, #fff);
    color: var(--ch-ink);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .res-panel :global(.author-attribution) { margin-block-start: 0.8rem; }
  .res-note { margin: 1.2rem 0 0; color: var(--ink-soft); line-height: 1.75; }
  .res-source { margin: 0.6rem 0 0; color: var(--ink-faint); font-size: 0.83rem; }
  .res-status { margin: 0.7rem 0 0; min-block-size: 1.2rem; font-size: 0.85rem; color: var(--gold-deep); font-weight: 600; }

  .res-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-block-start: clamp(1.6rem, 3vw, 2.4rem);
    padding-block-start: clamp(1.2rem, 2.2vw, 1.7rem);
    border-block-start: 1px solid var(--line);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
  }

  .pager-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }
  .pager-link:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .pager-tag { font-size: 0.75rem; font-weight: 700; color: var(--gold-deep); }
  .pager-title { font-weight: 600; font-size: 0.92rem; line-height: 1.4; }
  .pager-spacer { display: none; }
  .res-back { margin-block-start: 1.1rem; inline-size: 100%; justify-content: center; }

  @media (max-width: 1099px) {
    .res-split { grid-template-columns: 1fr; block-size: auto; gap: clamp(1.4rem, 4vw, 2.2rem); }
    .res-view { block-size: auto; }
    .res-panel { block-size: auto; overflow: visible; }
    .res-view[data-orientation] .res-frame iframe {
      min-block-size: clamp(420px, 72svh, 640px);
      max-block-size: none;
    }
    .res-pager { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .res-frame iframe { opacity: 1; transition: none; }
    .res-skel { transition: none; }
    .res-skel-spin { animation: none; border-block-start-color: rgb(212 175 92 / 0.26); }
    .pager-link:hover { transform: none; }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('.res-page');
  if (page) {
    const fb = page.querySelector<HTMLElement>('[data-pdf-fb]');
    const frame = page.querySelector<HTMLElement>('[data-frame]');
    const noPdf = 'pdfViewerEnabled' in navigator && navigator.pdfViewerEnabled === false;
    if (fb && frame && noPdf) {
      frame.hidden = true;
      frame.setAttribute('aria-busy', 'false');
      fb.hidden = false;
    }

    // הצלחת טעינה נקבעת רק מאירוע load אמיתי של ה-iframe. אין timeout
    // שמסמן הצלחה מלאכותית; כך כשל חיצוני לא הופך ל-false green.
    const iframe = frame?.querySelector<HTMLIFrameElement>('iframe[data-esrc]');
    if (frame && iframe && !frame.hidden) {
      const load = () => {
        if (iframe.src) return;
        iframe.addEventListener(
          'load',
          () => {
            frame.classList.add('is-loaded');
            frame.setAttribute('aria-busy', 'false');
          },
          { once: true }
        );
        iframe.src = iframe.dataset.esrc ?? '';
      };

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              io.disconnect();
              load();
            }
          },
          { rootMargin: '300px' }
        );
        io.observe(frame);
      } else load();
    }
  }
</script>
