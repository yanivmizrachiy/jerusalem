---
/**
 * שורת התחתית (RULES 7.24, הוראת יניב 05/08/2026): בלוק הניווט התחתון
 * — "מחוז ירושלים", רשימת הקישורים וכפתור "חזרה לראש העמוד" — נמחק,
 * משום ששכפל את הניווט העליון. מה שנשאר הוא פס כחול־כהה בתחתית המסך
 * ממש, באותה שפה של הפס העליון, ועליו הקרדיט בשם מודגש בזהב.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-navy">
    <div class="container footer-line">
      <span>© {year} מחוז ירושלים — הדרכת מתמטיקה</span>
      <span class="footer-managed">האתר מנוהל על ידי <strong>יניב רז</strong></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-block-start: clamp(4rem, 8vw, 6rem); }

  /* רצועת הווטסאפ הירוקה צמודה לפס הכחול — בלי רווח לבן ביניהם
     (הוראת יניב, 05/08/2026). הרצועה היא תמיד הרכיב האחרון בעמוד שמציג
     אותה (העמוד הראשי ובחירת החטיבה), ולכן די בקיומה בתוך main. */
  :global(main:has(.wa-band-wrap)) + .site-footer { margin-block-start: 0; }

  /* החלק הכי תחתון של המסך — כחול כהה באותה שפה של הפס העליון (7.22, 7.24) */
  .footer-navy {
    background: linear-gradient(180deg, #0e1c31 0%, #0b1524 100%);
    /* קו זהב עדין על מלוא הרוחב, מעל הכיתובים (7.24) */
    border-block-start: 1px solid rgb(232 200 119 / 0.32);
  }

  .footer-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1.2rem;
    min-block-size: 64px;
    padding-block: 1.1rem;
    color: #cfe1f5;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .footer-managed strong {
    color: #e8c877;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .footer-line { justify-content: center; text-align: center; }
  }
</style>
