---
import Breadcrumbs from './Breadcrumbs.astro';
import HamchashotEmbed from './HamchashotEmbed.astro';
import GradeNav from './GradeNav.astro';
import { canonicalGrade, canonicalPublishedGradeCount } from '../data/canonical-content';
import { authorsForResource } from '../data/authors';
import {
  MONTHLY_DOC_LABEL,
  gradeLabel,
  gradeMainDocs,
  gradeMaterialsHref,
  itemHref,
  materialChapters,
  type ChoveretGrade,
} from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
}

const { grade: sourceGrade } = Astro.props;
const grade = canonicalGrade(sourceGrade);
const { plan, prisa, monthly } = gradeMainDocs(grade);
// שם היוצר נשאב ממערכת הייחוס — אין קרדיט מוקשח ברכיב (24.1.4)
const monthlyAuthor = monthly ? authorsForResource(monthly.item.id)[0]?.name : undefined;
const letter = grade.letter;
const movedChapterIds = materialChapters(grade).map((chapter) => chapter.id).join(',');
const materialsCount = canonicalPublishedGradeCount(grade);
---

<div class="container grade-intro" style={`--grade:${grade.color}; --grade-dark:${grade.dark}`}>
  <Breadcrumbs
    items={[
      { label: 'ראשי', href: '/' },
      { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
      { label: gradeLabel(grade) },
    ]}
  />

  <header class="intro-head" data-reveal>
    <h1 class="grade-title">{grade.title}</h1>
    <span class="grade-rule" aria-hidden="true"></span>
  </header>

  <section class="band band-teach" id="ma-melamdim" data-reveal aria-labelledby="ma-melamdim-title">
    <span id="tichnun" class="legacy-fragment-anchor" aria-hidden="true"></span>
    <h2 class="band-title" id="ma-melamdim-title">מה אנחנו מלמדים?</h2>

    <div class="doc-row">
      {
        plan && (
          <a class="doc-btn" href={itemHref(grade.slug, plan.item)} data-main-plan>
            <span class="doc-name">תוכנית ההוראה לכיתה {letter}</span>
            <span class="doc-sub">{plan.item.title} · תשפ״ז</span>
          </a>
        )
      }
      {
        prisa && (
          <a class="doc-btn" href={itemHref(grade.slug, prisa.item)} data-main-prisa>
            <span class="doc-name">פריסת ההוראה לכיתה {letter}</span>
            <span class="doc-sub">{prisa.item.title} · תשפ״ז</span>
          </a>
        )
      }
      {
        monthly && (
          <a class="doc-btn" href={itemHref(grade.slug, monthly.item)} data-main-monthly>
            <span class="doc-name">{MONTHLY_DOC_LABEL}</span>
            <span class="doc-sub">{monthlyAuthor ? `${monthly.item.title} · ${monthlyAuthor}` : monthly.item.title}</span>
          </a>
        )
      }
    </div>
  </section>

  <a
    class="band band-materials"
    href={gradeMaterialsHref(grade.slug)}
    data-materials
    data-moved-chapters={movedChapterIds}
  >
    <span class="band-title">חומרים להוראה</span>
    <span class="band-sub">דפי עבודה, מבחנים, משחקים, קישורים ועוד...</span>
    <span class="band-count">{materialsCount} קבצים, קישורים ופעילויות</span>
  </a>

  {
    grade.pages && grade.pages.length > 0 && (
      <section class="band band-pages" data-reveal aria-labelledby="grade-pages-title">
        <h2 class="band-title" id="grade-pages-title">קישורים נוספים</h2>
        <div class="doc-row">
          {grade.pages.map((page) => (
            <a class="doc-btn" href={page.href} data-grade-page>
              <span class="doc-name">{page.title}</span>
              <span class="doc-sub">{page.count ? `${page.count} קבצים וקישורים · ${page.note}` : page.note}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <HamchashotEmbed />

  <GradeNav grade={grade} here="intro" />
</div>

<script>
  {
    const el = document.querySelector<HTMLAnchorElement>('[data-materials]');
    const moved = new Set((el?.dataset.movedChapters ?? '').split(',').filter(Boolean));

    const redirectMovedChapter = () => {
      const hash = location.hash.slice(1);
      if (el && moved.has(hash)) location.replace(el.href + location.hash);
    };

    redirectMovedChapter();
    addEventListener('hashchange', redirectMovedChapter);
  }
</script>

<style>
  .grade-intro { padding-block: 1.2rem 2.6rem; }
  .intro-head { max-width: 820px; margin-block: 0.8rem 1.4rem; }
  .legacy-fragment-anchor { display: block; block-size: 0; scroll-margin-block-start: 6rem; }

  .grade-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.08;
    color: var(--navy);
  }

  .grade-rule {
    display: block;
    margin-block-start: 1rem;
    block-size: 3px;
    inline-size: 128px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--grade), color-mix(in srgb, var(--gold) 70%, transparent));
  }

  .band {
    display: block;
    inline-size: 100%;
    padding: clamp(1.2rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-soft);
    margin-block-end: clamp(1.2rem, 2.6vw, 1.8rem);
    border-inline-start: 5px solid var(--grade);
  }

  .band-title {
    display: block;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.2;
    color: var(--navy);
  }

  .band-sub { display: block; margin-block-start: 0.45rem; color: var(--ink-soft); font-size: clamp(0.95rem, 1.4vw, 1.05rem); }
  .band-count { display: block; margin-block-start: 0.35rem; color: var(--ink-faint); font-size: 0.85rem; }
  .band-materials { text-decoration: none; color: inherit; }
  .band-materials:hover { border-color: color-mix(in srgb, var(--grade) 45%, var(--line)); }
  .band-materials:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .doc-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(0.7rem, 1.6vw, 1rem);
    margin-block-start: clamp(0.9rem, 2vw, 1.3rem);
  }

  .doc-btn {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-block-size: 64px;
    justify-content: center;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }

  .doc-btn:hover { border-color: color-mix(in srgb, var(--grade) 45%, var(--line)); }
  .doc-btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .doc-name { font-family: var(--font-display); font-size: 1.05rem; color: var(--navy); }
  .doc-sub { color: var(--ink-faint); font-size: 0.82rem; }
</style>
