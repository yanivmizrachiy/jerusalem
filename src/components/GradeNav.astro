---
/**
 * ניווט אחיד לשלוש שכבות חטיבת הביניים (הוראת יניב, 06/08/2026):
 * אותה לוגיקה ואותו רכיב בז׳, ח׳ וט׳ — חזרה לשער, מעבר בין עמוד המבוא
 * לתצוגת החומרים, ומעבר לשכבה הקודמת/הבאה. `here` קובע איזה יעד מודגש
 * ואיזה מוסתר, כדי שלא יוצג קישור אל העמוד שכבר פתוח (5.13).
 */
import { choveret, gradeHref, gradeMaterialsHref, type ChoveretGrade } from '../data/choveret';

interface Props {
  grade: ChoveretGrade;
  /** באיזה עמוד אנחנו — המבוא של השכבה או תצוגת החומרים שלה */
  here: 'intro' | 'materials';
}

const { grade, here } = Astro.props;

const order = choveret.findIndex((g) => g.slug === grade.slug);
const prev = order > 0 ? choveret[order - 1] : undefined;
const next = order < choveret.length - 1 ? choveret[order + 1] : undefined;
const sideLabel = (g: ChoveretGrade) => `מעבר לשכבת ${g.letter}`;
const sideHref = (g: ChoveretGrade) => (here === 'materials' ? gradeMaterialsHref(g.slug) : gradeHref(g.slug));
---

<nav class="grade-nav" aria-label="ניווט בחטיבת הביניים">
  <div class="gnav-main lux-control-group">
    <a class="btn btn-ghost" style="--btn-accent:var(--gold)" href="/chativat-beynayim/">חזרה לחטיבת ביניים</a>
    {
      here === 'materials' ? (
        <a class="btn btn-ghost" style={`--btn-accent:${grade.color}`} href={gradeHref(grade.slug)} data-to-intro>
          חזרה ל{grade.title}
        </a>
      ) : (
        <a class="btn btn-ghost" style={`--btn-accent:${grade.color}`} href={gradeMaterialsHref(grade.slug)} data-to-materials>
          חומרים להוראה
        </a>
      )
    }
  </div>

  <div class="gnav-sides">
    {
      prev ? (
        <a class="pager-link" href={sideHref(prev)} style={`--p:${prev.color}`}>
          <span class="pager-copy">
            <span class="pager-tag">{sideLabel(prev)}</span>
            <span class="pager-title">{prev.title}</span>
          </span>
          <span class="pager-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="pager-spacer" />
      )
    }
    {
      next ? (
        <a class="pager-link" href={sideHref(next)} style={`--p:${next.color}`}>
          <span class="pager-copy">
            <span class="pager-tag">{sideLabel(next)}</span>
            <span class="pager-title">{next.title}</span>
          </span>
          <span class="pager-arrow" aria-hidden="true">←</span>
        </a>
      ) : (
        <span class="pager-spacer" />
      )
    }
  </div>
</nav>

<style>
  .grade-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(2rem, 5vw, 3rem);
    padding-block-start: 1.6rem;
    border-block-start: 1px solid color-mix(in srgb, var(--gold) 20%, var(--line));
  }

  .gnav-main,
  .gnav-sides { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; }

  .gnav-main { padding: 0.34rem; }

  .pager-link {
    --p: var(--sky);
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    min-inline-size: 210px;
    min-block-size: 60px;
    padding: 0.72rem 0.92rem 0.72rem 1rem;
    overflow: hidden;
    border-radius: calc(var(--radius) + 5px);
    border: 1px solid color-mix(in srgb, var(--p) 28%, var(--line));
    background:
      radial-gradient(90% 160% at 100% 0%, color-mix(in srgb, var(--p) 11%, transparent), transparent 70%),
      linear-gradient(180deg, #fff, color-mix(in srgb, var(--p) 3%, #fff));
    box-shadow:
      inset 0 1px 0 #fff,
      0 14px 32px -26px color-mix(in srgb, var(--p) 70%, rgb(31 41 61 / 0.4));
    color: var(--ink);
    text-decoration: none;
    transition: transform 460ms var(--ease-lift), border-color 300ms var(--ease), box-shadow 300ms var(--ease);
  }

  .pager-link::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 4px;
    background: var(--p);
    transition: inline-size 380ms var(--ease-lift), opacity 300ms var(--ease);
    opacity: 0.88;
  }

  .pager-copy { display: flex; flex-direction: column; gap: 0.1rem; min-inline-size: 0; }

  .pager-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--p) 52%, var(--line));
    box-shadow: 0 20px 42px -24px color-mix(in srgb, var(--p) 58%, rgb(31 41 61 / 0.45));
  }
  .pager-link:hover::before { inline-size: 7px; }
  .pager-link:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .pager-tag { font-size: 0.76rem; font-weight: 750; color: color-mix(in srgb, var(--p) 72%, var(--ink)); }
  .pager-title { font-family: var(--font-display); font-size: 1.08rem; font-weight: 700; }
  .pager-arrow {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--p) 13%, #fff);
    color: color-mix(in srgb, var(--p) 72%, var(--ink));
    font-weight: 900;
    transition: transform 420ms var(--ease-lift), background-color 280ms var(--ease);
  }
  .pager-link:hover .pager-arrow { transform: scale(1.08); background: color-mix(in srgb, var(--p) 19%, #fff); }
  .pager-spacer { display: none; }

  @media (max-width: 720px) {
    .grade-nav { flex-direction: column; align-items: stretch; }
    .gnav-main, .gnav-sides { flex-direction: column; align-items: stretch; }
    .gnav-main .btn { inline-size: 100%; }
    .pager-link { min-inline-size: 0; inline-size: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pager-link,
    .pager-link::before,
    .pager-arrow { transition-duration: 1ms; }
    .pager-link:hover,
    .pager-link:hover .pager-arrow { transform: none; }
  }
</style>
