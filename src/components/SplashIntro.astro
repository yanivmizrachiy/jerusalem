---
/**
 * פתיחת העמוד (RULES 7.23, הוראת יניב 03/08/2026): מסך הפתיחה משתלט על
 * המסך כולו — שום כפתור אינו נראה או לחיץ מתחתיו (הדף קפוא: בלי גלילה,
 * מיקוד או קליקים) עד שהוא נעלם כליל. הלוגו נוכח כשנייה ואז מתאייד
 * בהדרגה מדורגת — מתרחב, מיטשטש ונמוג אל הילת זהב פורחת — והמסך מתבהר
 * אחרון. סה"כ ~2.5 שניות, כמו קודם. פעם אחת לביקור (sessionStorage);
 * רגישי תנועה מדלגים לגמרי.
 */
---

<div class="splash" id="splash" aria-hidden="true">
  <img class="splash-logo" id="splash-logo" src="/logo.png" alt="" width="360" height="360" />
</div>

<style>
  /* אין כאן pointer-events: none — המסך בולע כל לחיצה עד שהוא מוסתר */
  .splash {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(180deg, #fdfcf9 0%, var(--paper) 100%);
  }

  /* הילת הזהב — שכבה נפרדת מהרקע כדי שתוכל לפרוח ולהתרחב ביציאה */
  .splash::before {
    content: '';
    position: absolute;
    inset: -25%;
    background: radial-gradient(closest-side at 50% 47%, rgb(201 155 63 / 0.16), transparent 68%);
  }

  .splash-logo {
    position: relative;
    inline-size: min(52vmin, 390px);
    block-size: auto;
    border-radius: 50%;
    box-shadow: 0 40px 90px -30px rgb(42 37 32 / 0.45);
    opacity: 0;
    scale: 0.86;
    animation: splash-in 800ms var(--ease) forwards;
    will-change: transform, filter;
  }

  @keyframes splash-in {
    to { opacity: 1; scale: 1; }
  }

  /* היציאה המדורגת: הלוגו שואף פנימה רגע ואז מתאייד — גדל, מיטשטש ונמוג */
  .splash.is-leaving .splash-logo {
    animation: logo-evaporate 1250ms cubic-bezier(0.55, 0, 0.3, 1) forwards;
  }

  @keyframes logo-evaporate {
    0% { opacity: 1; scale: 1; filter: blur(0); }
    28% { opacity: 1; scale: 1.035; filter: blur(0); }
    100% { opacity: 0; scale: 1.17; filter: blur(16px); }
  }

  /* ההילה פורחת ומתרחבת בזמן שהלוגו נמוג לתוכה */
  .splash.is-leaving::before {
    animation: aura-bloom 1200ms var(--ease) forwards;
  }

  @keyframes aura-bloom {
    35% { opacity: 1; }
    100% { opacity: 0; scale: 1.85; }
  }

  /* המסך מתבהר אחרון — העמוד נחשף רק כשהלוגו כבר כמעט איננו */
  .splash.is-leaving {
    animation: veil-clear 850ms var(--ease) 750ms forwards;
  }

  @keyframes veil-clear {
    to { opacity: 0; }
  }

  .splash[hidden] { display: none; }
</style>

<script>
  const splash = document.getElementById('splash')!;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = sessionStorage.getItem('ycc-splash');

  if (reduced || seen) {
    splash.hidden = true;
  } else {
    sessionStorage.setItem('ycc-splash', '1');

    // השתלטות מלאה: בלי גלילה, ובלי מיקוד או קליקים על שום דבר מתחת
    // למסך הפתיחה — עד שהוא נעלם כליל
    document.documentElement.style.overflow = 'hidden';
    const frozen = [
      ...document.body.children,
      ...(splash.parentElement?.children ?? []),
    ].filter((el): el is HTMLElement => el instanceof HTMLElement && el !== splash && !el.contains(splash));
    for (const el of frozen) el.inert = true;

    // כשנייה של נוכחות מלאה, ואז ההתאיידות המדורגת (1650ms) — סה"כ ~2.5ש
    setTimeout(() => {
      splash.classList.add('is-leaving');
      setTimeout(() => {
        splash.hidden = true;
        document.documentElement.style.overflow = '';
        for (const el of frozen) el.inert = false;
      }, 1650);
    }, 900);
  }
</script>
