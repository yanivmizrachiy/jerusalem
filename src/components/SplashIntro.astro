---
/**
 * פתיחת העמוד (RULES 7.23, הוראת יניב 03/08/2026): הלוגו מופיע גדול
 * לשנייה, מוקטן בתנועת FLIP חלקה אל מקומו האמיתי בפס העליון — והעמוד
 * נחשף. פעם אחת לביקור (sessionStorage); רגישי תנועה מדלגים לגמרי.
 */
---

<div class="splash" id="splash" aria-hidden="true">
  <img class="splash-logo" id="splash-logo" src="/logo.png" alt="" width="360" height="360" />
</div>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 50% 20%, rgb(201 155 63 / 0.12), transparent 60%),
      linear-gradient(180deg, #fdfcf9 0%, var(--paper) 100%);
    transition: opacity 700ms var(--ease), visibility 0s linear 700ms;
  }

  .splash.is-done { opacity: 0; visibility: hidden; pointer-events: none; }

  .splash-logo {
    inline-size: min(46vmin, 340px);
    block-size: auto;
    border-radius: 50%;
    box-shadow: 0 40px 90px -30px rgb(42 37 32 / 0.45);
    opacity: 0;
    scale: 0.86;
    animation: splash-in 800ms var(--ease) forwards;
    will-change: transform;
  }

  @keyframes splash-in {
    to { opacity: 1; scale: 1; }
  }

  .splash[hidden] { display: none; }
</style>

<script>
  const splash = document.getElementById('splash')!;
  const logo = document.getElementById('splash-logo') as HTMLImageElement;
  const target = document.getElementById('site-logo');

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = sessionStorage.getItem('ycc-splash');

  if (reduced || seen || !target) {
    splash.hidden = true;
  } else {
    sessionStorage.setItem('ycc-splash', '1');
    document.documentElement.style.overflow = 'hidden';

    // שנייה של נוכחות מלאה, ואז FLIP מדויק אל הלוגו שבפס העליון
    setTimeout(() => {
      const from = logo.getBoundingClientRect();
      const to = target.getBoundingClientRect();
      const dx = to.left + to.width / 2 - (from.left + from.width / 2);
      const dy = to.top + to.height / 2 - (from.top + from.height / 2);
      const s = to.width / from.width;

      logo.animate(
        [
          { transform: 'translate(0, 0) scale(1)' },
          { transform: `translate(${dx}px, ${dy}px) scale(${s})` },
        ],
        { duration: 850, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'forwards' }
      ).finished.finally(() => {
        splash.classList.add('is-done');
        document.documentElement.style.overflow = '';
        setTimeout(() => { splash.hidden = true; }, 750);
      });
    }, 1000);
  }
</script>
