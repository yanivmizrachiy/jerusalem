---
/**
 * הטמעת אתר חי בגדול (הוראת יניב, 03/08/2026): המסגרת הכחולה־כהה של
 * הבית — האתר עצמו גלישה חופשית בפנים, וכפתור עגול ועדין להעתקת הקישור
 * הקנוני המדויק. בלי כרטיסים, בלי כפתורי כניסה.
 */
interface Props {
  id: string;
  title: string;
  url: string;
  /** מקור הטמעה חלופי (פרוקסי same-origin) כשהאתר חוסם iframe ישיר */
  embedSrc?: string;
  /** גובה מלא במיוחד */
  tall?: boolean;
}

const { id, title, url, embedSrc, tall = false } = Astro.props;
---

<div class="semb" id={id}>
  <div class:list={['semb-frame', { 'is-tall': tall }]}>
    <iframe src={embedSrc ?? url} title={`${title} — גלישה חיה בתוך האתר`} loading="lazy" allow="fullscreen"
    ></iframe>
  </div>
  <div class="semb-actions">
    <button class="semb-copy" type="button" data-copy={url} aria-label={`העתקת קישור אל ${title}`}>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
        <path d="M10.5 13.5a4.2 4.2 0 0 0 6 0l3-3a4.24 4.24 0 0 0-6-6l-1.6 1.6" />
        <path d="M13.5 10.5a4.2 4.2 0 0 0-6 0l-3 3a4.24 4.24 0 0 0 6 6l1.6-1.6" />
      </svg>
    </button>
    <button class="semb-note" type="button" data-copy={url} data-note aria-live="polite">העתקת קישור אל {title}</button>
  </div>
</div>

<style>
  /* זכוכית יוקרתית (8.26, הוראת יניב 03/08/2026) */
  .semb-frame {
    position: relative;
    padding: 14px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.72) 0%, rgb(250 246 236 / 0.4) 45%, rgb(255 255 255 / 0.6) 100%);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.85),
      inset 0 -1px 0 rgb(176 141 62 / 0.4),
      inset 1px 1px 0 rgb(255 255 255 / 0.6),
      0 0 55px -14px rgb(126 210 255 / 0.4),
      0 24px 70px -28px rgb(176 141 62 / 0.5),
      0 34px 80px -34px rgb(31 41 61 / 0.4);
    block-size: clamp(540px, 74vh, 880px);
  }

  /* קו-אור אלכסוני על הזכוכית — ספקולר עדין */
  .semb-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 32%, rgb(255 255 255 / 0.42) 45%, transparent 57%);
  }


  .semb-frame.is-tall { block-size: clamp(620px, 86vh, 1020px); }

  .semb-frame iframe { inline-size: 100%; block-size: 100%; border: 0; display: block; border-radius: 16px; background: #fff; }

  .semb-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-block-start: 0.9rem;
  }

  .semb-copy {
    inline-size: 46px;
    block-size: 46px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--gold-deep);
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-soft);
    transition: transform 400ms var(--ease-lift), box-shadow 300ms var(--ease), color 300ms var(--ease);
  }

  .semb-copy:hover { transform: translateY(-3px) scale(1.05); color: var(--ink); box-shadow: var(--shadow-lift); }

  /* המלל לחיץ ומעתיק אף הוא (הוראת יניב, 03/08/2026) */
  .semb-note {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 600;
    min-block-size: 44px;
  }

  .semb-note:hover { color: var(--gold-deep); text-decoration: underline; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.semb-copy, .semb-note').forEach((btn) => {
    const note = btn.parentElement?.querySelector<HTMLElement>('[data-note]');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (note) note.textContent = 'הקישור הועתק';
      } catch {
        if (note) note.textContent = 'ההעתקה נכשלה';
      }
    });
  });
</script>
