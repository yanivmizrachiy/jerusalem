---
/**
 * תוכן העניינים של החוברת הדיגיטלית (RULES 3.29, הוראת יניב 03/08/2026):
 * כל פרק בצבע חזק משלו — עז מהפלטה הרגילה של האתר; כל שורה לחיצה
 * שפותחת את הקורא המפוצל (או עמוד פנימי), עם ניווט מצוין לשכבות האחרות.
 */
import { choveret } from '../data/choveret';

interface Props {
  slug: 'z' | 'h' | 't';
}

const { slug } = Astro.props;
const grade = choveret.find((g) => g.slug === slug)!;
const others = choveret.filter((g) => g.slug !== slug);
const readerHref = (i: string) => `/chativat-beynayim/reader/${slug}/${i}/`;
let n = 0;
---

<nav class="toc-grades" aria-label="מעבר בין שכבות">
  {
    choveret.map((g) => (
      <a class:list={['toc-grade-btn', { 'is-current': g.slug === slug }]} href={`/chativat-beynayim/kita-${g.slug}/`} aria-current={g.slug === slug ? 'page' : undefined}>
        כיתה {g.letter}
      </a>
    ))
  }
</nav>

<div class="toc" data-reveal>
  {
    grade.chapters.map((ch) => (
      <section class="toc-chapter" style={`--ch-color:${ch.color}; --ch-dark:${ch.dark}`} aria-label={ch.title}>
        <h2 class="toc-chapter-title">{ch.title}</h2>
        <ol class="toc-list">
          {ch.items.map((item) => {
            n += 1;
            return (
              <li>
                <a class="toc-item" href={item.pageHref ?? readerHref(item.id)}>
                  <span class="toc-num">{n}</span>
                  <span class="toc-text">
                    <span class="toc-item-title">{item.title}</span>
                    <span class="toc-item-note">{item.note}</span>
                  </span>
                  <span class="toc-arrow" aria-hidden="true">←</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</div>

<nav class="toc-grades toc-grades-bottom" aria-label="מעבר בין שכבות">
  {
    others.map((g) => (
      <a class="toc-grade-btn" href={`/chativat-beynayim/kita-${g.slug}/`}>
        לחוברת כיתה {g.letter} ←
      </a>
    ))
  }
  <a class="toc-grade-btn toc-back" href="/chativat-beynayim/">שער חטיבת הביניים</a>
</nav>

<style>
  .toc-grades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block: 1.2rem 1.8rem;
  }

  .toc-grade-btn {
    flex: 1;
    min-inline-size: 130px;
    min-block-size: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
    font-weight: 800;
    font-size: 1.02rem;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
  }

  .toc-grade-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-soft); }

  .toc-grade-btn.is-current {
    background: linear-gradient(180deg, #16273f 0%, #0e1c31 100%);
    border-color: var(--gold);
    color: #f3d68b;
  }

  .toc { display: flex; flex-direction: column; gap: clamp(1.4rem, 3vw, 2rem); }

  /* פרק צבעוני — עז מהפלטה הרגילה (3.29) */
  .toc-chapter {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1.5px solid color-mix(in srgb, var(--ch-color) 45%, #fff);
    box-shadow: 0 18px 44px -24px color-mix(in srgb, var(--ch-color) 55%, transparent);
    background: #fff;
  }

  .toc-chapter-title {
    margin: 0;
    padding: 0.85rem 1.3rem;
    background: linear-gradient(120deg, var(--ch-color), color-mix(in srgb, var(--ch-color) 72%, #000));
    color: #fff;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    letter-spacing: 0.02em;
  }

  .toc-list { list-style: none; margin: 0; padding: 0.4rem 0.5rem 0.5rem; }

  .toc-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius);
    color: var(--ink);
    min-block-size: 52px;
    transition: background-color 250ms var(--ease), transform 250ms var(--ease);
  }

  .toc-item:hover {
    background: color-mix(in srgb, var(--ch-color) 8%, #fff);
    transform: translateX(-4px);
  }

  .toc-num {
    flex: none;
    inline-size: 2.1em;
    block-size: 2.1em;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--ch-color);
    color: var(--ch-dark);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .toc-text { display: flex; flex-direction: column; gap: 0.1rem; min-inline-size: 0; }

  .toc-item-title { font-weight: 700; }

  .toc-item-note { font-size: 0.85rem; color: var(--ink-soft); }

  .toc-arrow { margin-inline-start: auto; color: var(--ch-dark); font-weight: 800; }

  .toc-grades-bottom { margin-block-start: 2.2rem; }

  .toc-back { background: var(--paper-soft); }
</style>
