---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

// אין להציג שתי רמות סמוכות שמובילות לאותה כתובת. הדבר חשוב במיוחד
// ב"כללי", שבו עמוד השכבה ועמוד החומרים הם אותו מסלול.
const visibleItems = items.filter((crumb, index) => {
  if (!crumb.href || index === 0) return true;
  return items[index - 1]?.href !== crumb.href;
});
---

<nav class="crumbs" aria-label="פירורי לחם">
  <ol>
    {
      visibleItems.map((c, i) => (
        <li style={`--depth:${i}`}>
          {c.href && i < visibleItems.length - 1 ? (
            <a href={c.href}>{c.label}</a>
          ) : i === visibleItems.length - 1 ? (
            <span aria-current="page">{c.label}</span>
          ) : (
            <span>{c.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* היררכיה מדורגת (5.26): הכללי ביותר הגדול ביותר, ויורד עם העומק */
  .crumbs li {
    display: inline-flex;
    align-items: baseline;
    font-size: clamp(0.8rem, calc(1.14rem - var(--depth, 0) * 0.09rem), 1.14rem);
  }

  .crumbs li:first-child a { font-weight: 800; color: var(--ink); }

  .crumbs li + li::before {
    content: '‹';
    margin-inline: 0.55rem;
    color: var(--ink-faint);
  }

  .crumbs a {
    color: var(--ink-soft);
    font-weight: 600;
    min-block-size: 34px;
    display: inline-flex;
    align-items: center;
  }
  .crumbs a:hover { color: var(--gold-deep); }

  .crumbs [aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }
</style>
