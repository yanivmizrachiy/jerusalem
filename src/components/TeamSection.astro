---
/**
 * צוות ההדרכה (RULES §7): איילת בבולטות (7.1); לכל כרטיס פעולות WhatsApp
 * ודוא״ל נפרדות (7.16–7.19). מונוגרמה מעוצבת עד קליטת קובצי התמונות (7.21).
 */
import { team } from '../data/team';

const waPath =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
---

<section class="section" id="tzevet">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">כאן בשבילכם</p>
      <h2>צוות ההדרכה המחוזי</h2>
      <p class="lede">מדריכות ומדריכי המתמטיקה של מחוז ירושלים — בלחיצה אחת ל־WhatsApp או לדוא״ל.</p>
    </div>

    <div class="team-grid">
      {
        team.map((m, i) => (
          <article
            class:list={['card', 'card-accent', 'team-card', { 'is-featured': m.featured }]}
            style={`--card-accent:${m.accent}; --reveal-delay:${i * 90}ms`}
            data-reveal
          >
            {
              m.photo ? (
                <img
                  class="avatar avatar-photo"
                  style={`--accent:${m.accent}`}
                  src={m.photo}
                  alt={`תמונתה של ${m.name}`}
                  width="118"
                  height="118"
                  loading="lazy"
                />
              ) : (
                <div class="avatar" style={`--accent:${m.accent}`} aria-hidden="true">
                  <span>{m.initial}</span>
                </div>
              )
            }
            <h3 class="member-name">{m.name}</h3>
            <p class="member-role">{m.role}</p>
            <a class="member-phone" href={`tel:+${m.phoneIntl}`} aria-label={`חיוג אל ${m.name}`}>
              {m.phoneDisplay}
            </a>
            <div class="member-actions">
              <a
                class="btn btn-whatsapp"
                href={`https://wa.me/${m.phoneIntl}`}
                target="_blank"
                rel="noopener"
                aria-label={`שליחת WhatsApp אל ${m.name}`}
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={waPath} />
                </svg>
              </a>
              {m.facebook && (
                <a
                  class="btn btn-facebook"
                  href={m.facebook}
                  target="_blank"
                  rel="noopener"
                  aria-label={`הדפים של יניב — פייסבוק`}
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
                  </svg>
                </a>
              )}
              {m.email && (
                <a class="btn btn-ghost" href={`mailto:${m.email}`} aria-label={`שליחת דוא״ל אל ${m.name}`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
                    <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
                  </svg>
                  דוא״ל
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <a class="btn btn-ghost team-back" href="#main">↑ חזרה לראש העמוד</a>
  </div>
</section>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
    align-items: stretch;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.4rem 1.6rem;
  }

  /* איילת — בולטות חזותית (7.1) */
  .team-card.is-featured {
    background: linear-gradient(180deg, #fff 0%, #fdf9f0 100%);
  }
  .team-card.is-featured .avatar {
    inline-size: 118px;
    block-size: 118px;
    font-size: 3rem;
  }

  /* רספונסיביות מדויקת: טור אחד → שני טורים (איילת פרושה למעלה) → ארבעה */
  @media (min-width: 680px) and (max-width: 1199px) {
    .team-grid { grid-template-columns: 1fr 1fr; }
    .team-card.is-featured { grid-column: 1 / -1; }
  }

  /* איילת מעל כולם — שורה עליונה משלה גם במחשב (7.1) */
  @media (min-width: 1200px) {
    .team-grid { grid-template-columns: repeat(3, 1fr); }
    .team-card.is-featured { grid-column: 1 / -1; }
    .team-card.is-featured .avatar {
      inline-size: 150px;
      block-size: 150px;
      font-size: 3.4rem;
    }
    .team-card.is-featured .member-name { font-size: 1.6rem; }
  }

  /* תמונה אמיתית: חיתוך תצוגה ב-CSS בלבד — המקור אינו נחתך (7.10) */
  .avatar-photo {
    object-fit: cover;
    object-position: top center;
  }

  .avatar {
    inline-size: 92px;
    block-size: 92px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 2.3rem;
    font-weight: 700;
    color: var(--ink);
    background:
      linear-gradient(var(--paper-soft), var(--paper-soft)) padding-box,
      conic-gradient(from 200deg, var(--accent), color-mix(in srgb, var(--accent) 30%, #fff), var(--accent)) border-box;
    border: 3px solid transparent;
    margin-block-end: 1.1rem;
  }

  .member-name { margin: 0 0 0.2rem; font-size: 1.35rem; }

  .member-role {
    color: var(--ink-soft);
    font-size: 0.95rem;
    min-block-size: 3em;
    margin: 0 0 0.4rem;
  }

  .member-phone {
    color: var(--ink);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    margin-block-end: 1.1rem;
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
  }
  .member-phone:hover { color: var(--gold-deep); }

  .team-back { margin-block-start: 2rem; }

  .member-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-block-start: auto;
  }
</style>
