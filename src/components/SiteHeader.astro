---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'ראשי' },
  { href: '/chativat-beynayim/', label: 'חטיבת ביניים' },
  { href: '/chativa-elyona/', label: 'חטיבה עליונה' },
  { href: '/hozer-mafmar/', label: 'חוזר מפמ״ר' },
  { href: '/israel-realit/', label: 'ישראל ריאלית' },
  { href: '/luach/', label: 'לוח שנה' },
  { href: '/chativat-beynayim/#hamchashot', label: 'אתר ההמחשות' },
  // ‎#tzevet‎ הוא מקטע פרטי הקשר, שמוסתר דרך קבע ונחשף רק בלחיצה על חבר
  // צוות (RULES 6.5) — קישור אליו הוביל ליעד שאינו נראה לעולם (5.13).
  // צוות ההדרכה מוצג ב-hero שאחרי הסרטון, וזה היעד הנכון.
  { href: '/#hero-after', label: 'צוות ההדרכה' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href);
---

<header class:list={['site-header', { 'is-transparent': transparent }]} id="site-header">
  <div class="container header-inner">
    <nav aria-label="ניווט ראשי">
      <ul class="nav-list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    min-block-size: var(--header-h);
    display: flex;
    align-items: center;
    padding-inline: max(0px, env(safe-area-inset-right)) max(0px, env(safe-area-inset-left));
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid var(--line);
    transition: background-color 400ms var(--ease), border-color 400ms var(--ease);
  }

  .site-header.is-transparent:not(.is-scrolled) {
    background: transparent;
    border-block-end-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.4rem;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    color: var(--ink-soft);
    font-weight: 600;
    font-variation-settings: 'wght' 600; /* פונט משתנה — מעבר משקל חלק */
    font-size: 0.98rem;
    transition: color 250ms var(--ease), background-color 250ms var(--ease),
      font-variation-settings 300ms var(--ease);
  }

  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    font-variation-settings: 'wght' 720;
  }

  .nav-list a:hover {
    color: var(--ink);
    background: var(--paper-soft);
  }

  .nav-list a[aria-current='page'] {
    color: var(--ink); /* ניגודיות מלאה — הזהות נשמרת ברקע המוזהב */
    background: color-mix(in srgb, var(--gold) 16%, transparent);
  }

  @media (max-width: 640px) {
    .nav-list a { padding-inline: 0.7rem; font-size: 0.92rem; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>
