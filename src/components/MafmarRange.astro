---
import MafmarWeb from './MafmarWeb.astro';
import { mafmarSections } from '../data/mafmar';

interface Props {
  sectionId: string;
  accent?: string;
  fill?: boolean;
}

const {
  sectionId,
  accent = 'var(--gold)',
  fill = false,
} = Astro.props;

const section = mafmarSections.find((item) => item.id === sectionId);

if (!section) {
  throw new Error(`MafmarRange: unknown manifest id — ${sectionId}`);
}
---

<section
  class:list={['mrange', 'card-accent', fill && 'is-fill']}
  style={`--card-accent:${accent}`}
  id={section.id.toLowerCase()}
  data-mafrange
  data-start={section.startPage}
  data-end={section.endPage}
  data-title={section.title}
>
  <header class="mrange-head">
    <p class="mrange-badge">
      מתוך חוזר מפמ״ר תשפ״ז · עמודים {section.startPage}–{section.endPage}
    </p>
    <h3 class="mrange-title">{section.title}</h3>
    {section.note && <p class="mrange-note">{section.note}</p>}
  </header>

  <MafmarWeb
    startPage={section.startPage}
    endPage={section.endPage}
    compact={fill}
    showSearch={false}
  />
</section>

<style>
  .mrange {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .mrange-head {
    padding: 1.15rem 1.25rem 0.75rem;
  }

  .mrange-badge {
    margin: 0 0 0.35rem;
    color: var(--gold-deep);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .mrange-title {
    margin: 0;
    color: var(--navy);
    font-size: 1.25rem;
  }

  .mrange-note {
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .mrange :global(.mafweb) {
    padding: 0 1rem 1rem;
  }

  .mrange.is-fill {
    block-size: 100%;
    overflow: auto;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .mrange.is-fill .mrange-head {
    padding: 0 0 0.55rem;
  }

  .mrange.is-fill :global(.mafweb) {
    padding: 0;
  }
</style>
