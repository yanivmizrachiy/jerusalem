---
/**
 * הטמעת טווח ממוקד מתוך חוזר מפמ״ר תשפ״ז (RULES 3.17, 9.3.11):
 * כותרת + הסימון "מתוך חוזר מפמ״ר תשפ״ז" + הטווח המאומת, ניווט
 * עמוד קודם/הבא הכלוא לטווח, מחוון "עמוד X מתוך Y בטווח זה",
 * פתיחת החוזר המלא, פתיחה במקור, העתקה ושיתוף יציב (9.3.12).
 * המקור: ה־PDF הרשמי החי בלבד — לא נשמר עותק (9.3.4).
 */
import { MAFMAR_URL, MAFMAR_LOCAL, mafmarSections } from '../data/mafmar';

interface Props {
  /** מזהה מתוך ה־manifest המאומת, למשל "MAF-02" */
  sectionId: string;
  accent?: string;
  /** בתוך החוברת: ממלא את דף ההטמעה — בלי כרטיס מקונן ובלי גובה קבוע (RULES 3.29) */
  fill?: boolean;
}

const { sectionId, accent = 'var(--gold)', fill = false } = Astro.props;
const s = mafmarSections.find((x) => x.id === sectionId);
if (!s) throw new Error(`MafmarRange: מזהה לא קיים ב-manifest — ${sectionId}`);
const anchorId = s.id.toLowerCase();
---

<section
  class:list={['mrange', 'card-accent', { 'is-fill': fill }]}
  style={`--card-accent:${accent}`}
  id={anchorId}
  data-mafrange
  data-start={s.startPage}
  data-end={s.endPage}
  data-title={s.title}
>
  <header class="mrange-head">
    <p class="mrange-badge">מתוך חוזר מפמ״ר תשפ״ז · עמודים {s.startPage}–{s.endPage}</p>
    <h3 class="mrange-title">{s.title}</h3>
    {s.note && <p class="mrange-note">{s.note}</p>}
  </header>

  <div class="mrange-shell" data-shell>
    <iframe
      src={`${MAFMAR_LOCAL}#page=${s.startPage}&toolbar=0&navpanes=0&view=FitH`}
      title={`${s.title} — מתוך חוזר מפמ״ר תשפ״ז`}
      loading="lazy"
    ></iframe>
    <div class="mrange-fallback" data-fallback hidden>
      <p>בדפדפן הזה קובצי PDF נפתחים לצפייה מלאה במסך נפרד:</p>
      <a class="btn btn-primary" data-fb-open href={`${MAFMAR_LOCAL}#page=${s.startPage}`} target="_blank" rel="noopener">
        פתיחת הטווח (מעמוד {s.startPage}) ↗
      </a>
    </div>
  </div>

  <div class="mrange-pager" role="group" aria-label={`ניווט עמודים בתוך ${s.title}`}>
    <button class="btn btn-ghost" type="button" data-prev>→ עמוד קודם</button>
    <span class="mrange-ind" data-ind aria-live="polite">
      עמוד 1 מתוך {s.endPage - s.startPage + 1} בטווח זה
    </span>
    <button class="btn btn-ghost" type="button" data-next>עמוד הבא ←</button>
  </div>

  <div class="mrange-actions" role="group" aria-label={`פעולות עבור ${s.title}`}>
    <a class="btn btn-primary" href={`/hozer-mafmar/#${s.id}`}>פתיחת החוזר המלא</a>
    <a class="btn btn-ghost" href={MAFMAR_URL} target="_blank" rel="noopener">המקור הרשמי ↗</a>
    <button class="btn btn-ghost" type="button" data-copy>העתקת קישור</button>
    <a class="btn btn-whatsapp" data-wa href="#" target="_blank" rel="noopener" aria-label="שיתוף המקטע ב־WhatsApp"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
    <a class="btn btn-ghost" data-mail href="#">דוא״ל</a>
  </div>

  <p class="mrange-status" data-status role="status" aria-live="polite"></p>
</section>

<style>
  .mrange {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .mrange-head { padding: 1.3rem 1.4rem 1rem; }

  .mrange-badge {
    margin: 0 0 0.45rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--gold-deep);
  }

  .mrange-title { margin: 0 0 0.5rem; font-size: 1.25rem; }

  .mrange-note { margin: 0 0 0.4rem; color: var(--ink-soft); font-size: 0.92rem; }

  .mrange-shell {
    position: relative;
    padding: 14px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgb(250 246 236 / 0.95) 0%, rgb(240 233 216 / 0.78) 45%, rgb(252 249 242 / 0.92) 100%);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      inset 0 0 0 2.5px rgb(176 141 62 / 0.4),
      inset 0 -1px 0 rgb(176 141 62 / 0.55),
      0 0 55px -14px rgb(126 210 255 / 0.35),
      0 24px 70px -28px rgb(176 141 62 / 0.45),
      0 34px 80px -34px rgb(31 41 61 / 0.35);
    block-size: clamp(360px, 60dvh, 680px);
  }

  /* קו-אור אלכסוני על הזכוכית — ספקולר עדין */
    .mrange-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 36%, rgb(255 255 255 / 0.22) 46%, transparent 55%);
    pointer-events: none;
  }


  .mrange-shell iframe {
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    display: block;
    border-radius: 16px;
    background: #fff;
    /* חשיפה בעדינות כשה-PDF חי — במקום הבזק לבן (RULES 8.9) */
    opacity: 0;
    transition: opacity 480ms var(--ease);
  }

  .mrange-shell.is-loaded iframe { opacity: 1; }

  /* display:block היה גובר על hidden — הכלל הזה סוגר את הפרצה */
  .mrange-shell iframe[hidden] { display: none; }

  /* בלי מציג PDF — ה-shell מתכווץ לגובה התוכן, בלי שכבה סמויה */
  .mrange-shell.no-viewer { block-size: auto; }

  /* שלד טעינה יוקרתי — זהה לחוברת; תמיד pointer-events:none (3.29) */
  .mrange-skel {
    position: absolute;
    inset: 14px;
    border-radius: 16px;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    overflow: hidden;
    background: linear-gradient(180deg, #fffdf9 0%, #fbf6ec 100%);
    opacity: 1;
    transition: opacity 420ms var(--ease);
  }

  .mrange-skel::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgb(212 175 92 / 0.16) 48%, rgb(255 255 255 / 0.55) 50%, rgb(212 175 92 / 0.16) 52%, transparent 70%);
    background-size: 220% 100%;
    animation: mrange-shimmer 1.5s ease-in-out infinite;
  }

  .mrange-shell.is-loaded .mrange-skel { opacity: 0; }

  .mrange-skel-spin {
    position: relative;
    z-index: 1;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    border: 3px solid rgb(212 175 92 / 0.26);
    border-block-start-color: var(--gold-deep);
    animation: mrange-spin 0.9s linear infinite;
  }

  .mrange-skel-txt {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: var(--gold-deep);
  }

  @keyframes mrange-shimmer { from { background-position: 150% 0; } to { background-position: -50% 0; } }
  @keyframes mrange-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .mrange-shell iframe { opacity: 1; transition: none; }
    .mrange-skel { transition: none; }
    .mrange-skel::before { animation: none; background: none; }
    .mrange-skel-spin { animation: none; border-block-start-color: rgb(212 175 92 / 0.26); }
  }

  /* ===== מצב fill: בתוך החוברת דף ההטמעה ממלא את כל גובה הדף =====
     בלי כרטיס לבן מקונן ובלי גובה קבוע — ה-PDF מקבל את מרב השטח (3.29) */
  .mrange.is-fill {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    background: transparent;
    border: 0;
    box-shadow: none;
    overflow: visible;
  }

  .mrange.is-fill .mrange-head { padding: 0 0 0.5rem; }
  .mrange.is-fill .mrange-shell { flex: 1; block-size: auto; min-block-size: 0; }
  .mrange.is-fill .mrange-pager { padding: 0.5rem 0 0; }
  .mrange.is-fill .mrange-actions { padding: 0.55rem 0 0; }
  .mrange.is-fill .mrange-status { padding: 0.3rem 0 0.2rem; }

  /* דפדפן בלי מציג PDF מובנה (navigator.pdfViewerEnabled=false) — חלופה אמיתית */
  .mrange-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 1.4rem;
  }

  /* `hidden` מנצח את ה-display של המחלקה (הוראת יניב, 05/08/2026) — אחרת
     כרטיס הפתיחה מוצג מתחת להטמעה החיה וגונב חצי עמוד */
  .mrange-fallback[hidden] { display: none !important; }

  .mrange-fallback p { margin: 0; font-weight: 600; color: var(--ink-soft); }

  .mrange-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.9rem 1.4rem 0;
  }

  .mrange-ind { font-weight: 700; font-size: 0.92rem; color: var(--ink-soft); }

  .mrange-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.8rem 1.4rem 0.3rem;
  }

  .mrange-status {
    min-block-size: 1.3em;
    margin: 0;
    padding: 0.4rem 1.4rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--olive);
  }

  @media (max-width: 640px) {
    .mrange-pager { justify-content: center; }
  }
</style>

<script>
  import { MAFMAR_LOCAL as LOCAL } from '../data/mafmar';

  document.querySelectorAll<HTMLElement>('[data-mafrange]').forEach((root) => {
    const start = Number(root.dataset.start);
    const end = Number(root.dataset.end);
    const title = root.dataset.title ?? '';
    const frame = root.querySelector('iframe')!;
    const ind = root.querySelector<HTMLElement>('[data-ind]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const wa = root.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const mail = root.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;

    let page = start;

    // דפדפן ללא מציג PDF מובנה (בעיקר אנדרואיד) — חלופה גלויה במקום לוח ריק
    const fallback = root.querySelector<HTMLElement>('[data-fallback]')!;
    const fbOpen = root.querySelector<HTMLAnchorElement>('[data-fb-open]')!;
    const noViewer = 'pdfViewerEnabled' in navigator && !navigator.pdfViewerEnabled;
    const shell = frame.closest<HTMLElement>('[data-shell]');
    if (noViewer) {
      frame.hidden = true;
      fallback.hidden = false;
      shell?.classList.add('no-viewer');
    } else if (shell) {
      // שלד טעינה + חשיפה בעדינות של ה-PDF (כמו החוברת; RULES 8.9)
      const skel = document.createElement('div');
      skel.className = 'mrange-skel';
      skel.setAttribute('aria-hidden', 'true');
      const spin = document.createElement('span');
      spin.className = 'mrange-skel-spin';
      const txt = document.createElement('span');
      txt.className = 'mrange-skel-txt';
      txt.textContent = 'טוען תצוגה חיה…';
      skel.append(spin, txt);
      shell.appendChild(skel);
      shell.setAttribute('aria-busy', 'true');
      let revealed = false;
      const reveal = () => {
        if (revealed) return;
        revealed = true;
        shell.classList.add('is-loaded');
        shell.setAttribute('aria-busy', 'false');
      };
      frame.addEventListener('load', reveal, { once: true });
      window.setTimeout(reveal, 8000);
    }

    const pageUrl = () => `${location.origin}${location.pathname}#${root.id}`;

    const render = (reload: boolean) => {
      if (reload) frame.src = `${LOCAL}#page=${page}&toolbar=0&navpanes=0&view=FitH`;
      fbOpen.href = `${LOCAL}#page=${page}`;
      ind.textContent = `עמוד ${page - start + 1} מתוך ${end - start + 1} בטווח זה`;
      prev.disabled = page <= start;
      next.disabled = page >= end;
    };

    prev.addEventListener('click', () => { if (page > start) { page -= 1; render(true); } });
    next.addEventListener('click', () => { if (page < end) { page += 1; render(true); } });

    const shareText = `${title} — מתוך חוזר מפמ״ר תשפ״ז — ${pageUrl()}`;
    wa.href = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
    mail.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(shareText)}`;
    wa.addEventListener('click', () => { status.textContent = 'נפתח WhatsApp — ההודעה מוכנה לשליחה'; });
    mail.addEventListener('click', () => { status.textContent = 'נפתחה הודעת דוא״ל חדשה'; });

    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pageUrl());
        status.textContent = 'הקישור הועתק';
      } catch {
        status.textContent = 'ההעתקה נכשלה';
      }
    });

    render(false);
  });
</script>
