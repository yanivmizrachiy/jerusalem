---
/**
 * משמר הקשר לעמוד משאב קנוני ומיישר metadata שנגזר מהפריט הקנוני.
 *
 * משאב יכול להיות מוצב בכמה נושאים, אבל יש לו URL קנוני יחיד. ההקשר
 * נשמר ב-sessionStorage רגע לפני הניווט, ובכניסה לעמוד מאומת שוב מול
 * הפרקים שבהם המשאב באמת מפורסם. document.referrer הוא fallback טבעי.
 */
import { chapterHref, type ChoveretGrade, type ChoveretItem } from '../data/choveret';
import { resourceDisplayLabel } from '../data/resource-labels';

interface Props {
  grade: ChoveretGrade;
  item: ChoveretItem;
}

const { grade, item } = Astro.props;
const resourceLabel = resourceDisplayLabel(item);
const contexts = grade.chapters
  .filter(
    (chapter) =>
      chapter.materials !== false &&
      chapter.items.some((candidate) => candidate.id === item.id && candidate.needsReview !== true)
  )
  .map((chapter) => ({
    id: chapter.id,
    title: chapter.title,
    href: chapterHref(grade.slug, chapter.id),
    color: chapter.color,
    dark: chapter.dark,
  }));
---

<span hidden data-resource-contexts={JSON.stringify(contexts)} data-resource-label={resourceLabel}></span>

<script>
  interface ResourceContextEntry {
    id: string;
    title: string;
    href: string;
    color: string;
    dark: string;
  }

  const payload = document.querySelector<HTMLElement>('[data-resource-contexts]');
  if (payload) {
    // ה-badge בעמוד המשאב הוא פדגוגי (משחק/מבחן/דף עבודה וכו׳), לא סוג
    // אחסון טכני כמו PDF/Drive/מסמך.
    const kind = document.querySelector<HTMLElement>('.res-kind');
    if (kind && payload.dataset.resourceLabel) kind.textContent = payload.dataset.resourceLabel;

    // ניווט בין משאבים אינו משתמש במונח הטכני "קובץ".
    document.querySelectorAll<HTMLElement>('.res-pager .pager-tag').forEach((tag) => {
      if (tag.textContent?.includes('הקובץ הקודם')) tag.textContent = 'המשאב הקודם →';
      if (tag.textContent?.includes('הקובץ הבא')) tag.textContent = '← המשאב הבא';
    });

    let contexts: ResourceContextEntry[] = [];
    try {
      contexts = JSON.parse(payload.dataset.resourceContexts ?? '[]') as ResourceContextEntry[];
    } catch {
      contexts = [];
    }

    let referrerPath = '';
    try {
      referrerPath = document.referrer ? new URL(document.referrer).pathname : '';
    } catch {
      referrerPath = '';
    }

    const storageKey = `resource-context:${location.pathname}`;
    let storedId = '';
    try {
      storedId = sessionStorage.getItem(storageKey) ?? '';
    } catch {
      storedId = '';
    }

    // referrer עדיף על state ישן; בכל מקרה ההקשר נבחר רק מתוך allowlist
    // שנגזר מהדאטה של המשאב והשכבה הנוכחיים.
    const context =
      contexts.find((entry) => entry.href === referrerPath) ??
      contexts.find((entry) => entry.id === storedId);

    if (context) {
      try {
        sessionStorage.setItem(storageKey, context.id);
      } catch {
        // אין תלות חובה ב-storage; העמוד עדיין תקין עם ההקשר ברירת המחדל.
      }

      const page = document.querySelector('.res-page');
      if (page instanceof HTMLElement) {
        page.style.setProperty('--ch', context.color);
        page.style.setProperty('--ch-dark', context.dark);
        page.dataset.resourceContext = context.id;
      }

      const crumb = document.querySelector('.crumbs li:nth-last-child(2) a');
      if (crumb instanceof HTMLAnchorElement) {
        crumb.href = context.href;
        crumb.textContent = context.title;
      }

      const eyebrow = document.querySelector('.res-eyebrow a:last-of-type');
      if (eyebrow instanceof HTMLAnchorElement) {
        eyebrow.href = context.href;
        eyebrow.textContent = context.title;
      }

      const back = document.querySelector('.res-back');
      if (back instanceof HTMLAnchorElement) {
        back.href = context.href;
        back.textContent = `חזרה ל${context.title}`;
      }
    }
  }
</script>
