---
/**
 * "מה צפוי?" — פס עדכונים בצד שמאל של המסך הרחב.
 * המונה בראש הפס נגזר בזמן build ממקור הנתונים הקנוני ואינו hardcoded.
 */
import { news } from '../data/news';
import { whatsappCommunity } from '../data/resources';
import { middleSchoolResourceCountText } from '../data/site-counts';

const accents = ['var(--amber)', 'var(--sky)', 'var(--terracotta)', 'var(--olive)', 'var(--rose)', 'var(--lilac)'];
const liveNews = [{ date: 'מתעדכן אוטומטית', text: middleSchoolResourceCountText }, ...news];
---

<aside class="rail" id="ma-chadash" aria-label="מה צפוי?">
  <h2 class="rail-title">מה צפוי?</h2>
  <p class="rail-countdown" data-countdown>
    <span class="cd-label">פתיחת שנת הלימודים תשפ״ז: 1/9/2026</span>
  </p>
  <div class="rail-wa">
    <a
      class="btn btn-whatsapp rail-wa-btn"
      href={whatsappCommunity.url}
      target="_blank"
      rel="noopener"
      aria-label="הצטרפות מיידית לקבוצת המורים בווטסאפ"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
    </a>
    <span class="rail-wa-texts">
      <a class="rail-wa-head" href={whatsappCommunity.url} target="_blank" rel="noopener">הצטרפו לקבוצת המורים בווטסאפ</a>
    </span>
  </div>
  <div class="rail-viewport">
    <div class="rail-track">
      <ul class="rail-list">
        {liveNews.map((n, i) => (
          <li class="rail-item" style={`--item-accent:${accents[i % accents.length]}`}>
            <time class="rail-date">{n.date}</time>
            <p class="rail-text">{n.text}</p>
          </li>
        ))}
      </ul>
      <ul class="rail-list rail-dup" aria-hidden="true">
        {liveNews.map((n, i) => (
          <li class="rail-item" style={`--item-accent:${accents[i % accents.length]}`}>
            <time class="rail-date">{n.date}</time>
            <p class="rail-text">{n.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</aside>

<style>
  .rail { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-soft); padding: 1.3rem 1.2rem 0.6rem; }
  .rail-title { font-size: 1.25rem; margin: 0 0 0.9rem; padding-block-end: 0.7rem; border-block-end: 2px solid transparent; border-image: linear-gradient(90deg, var(--amber), var(--terracotta), var(--sky)) 1; border-image-slice: 0 0 1 0; }
  .rail-countdown { margin: 0 0 0.9rem; padding: 0.7rem 0.8rem 0.65rem; border-radius: 10px; background: linear-gradient(180deg, #0b1524, #0e1c31); color: #7ed2ff; font-weight: 700; text-align: center; line-height: 1.4; font-variant-numeric: tabular-nums; text-shadow: 0 0 2px rgb(126 210 255 / 0.9), 0 0 12px rgb(126 210 255 / 0.5); }
  .rail-countdown :global(.cd-num) { display: block; font-family: var(--font-display); font-size: 2rem; font-weight: 800; line-height: 1.1; letter-spacing: 0.04em; text-shadow: 0 0 3px rgb(126 210 255 / 0.95), 0 0 18px rgb(126 210 255 / 0.55), 0 0 38px rgb(64 156 255 / 0.4); }
  .rail-countdown :global(.cd-label) { display: block; font-size: 0.88rem; }
  .rail-wa { display: flex; align-items: center; gap: 0.65rem; margin: 0 0 0.9rem; padding: 0.55rem 0.7rem; border-radius: 10px; background: var(--vacation-soft); border: 1px solid color-mix(in srgb, var(--whatsapp) 45%, transparent); }
  .rail-wa-btn { flex: none; inline-size: 44px; block-size: 44px; }
  .rail-wa-texts { display: flex; flex-direction: column; gap: 0.1rem; min-inline-size: 0; }
  .rail-wa-head { font-size: 0.9rem; font-weight: 800; color: var(--vacation); text-decoration: none; }
  .rail-wa-head:hover { color: #0a5230; }
  .rail-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .rail-item { border-inline-start: 3px solid var(--item-accent, var(--gold)); padding-inline-start: 0.8rem; padding-block: 0.15rem; }
  .rail-date { display: inline-block; font-size: 0.78rem; font-weight: 700; color: var(--ink-faint); letter-spacing: 0.03em; margin-block-end: 0.15rem; }
  .rail-text { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--ink-soft); }
  .rail-dup { display: none; }

  @media (min-width: 1280px) {
    .rail { position: fixed; left: clamp(0.9rem, 2vw, 1.6rem); top: calc(var(--header-h) + 1.4rem); bottom: 1.4rem; width: var(--rail-w); z-index: 60; display: flex; flex-direction: column; overflow: hidden; }
    .rail-viewport { flex: 1; overflow: hidden; mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 90%, transparent 100%); }
    .rail-track { display: flex; flex-direction: column; gap: 0.9rem; animation: rail-rise 32s linear infinite; }
    .rail-dup { display: flex; }
    .rail:hover .rail-track, .rail:focus-within .rail-track { animation-play-state: paused; }
  }

  @keyframes rail-rise { from { transform: translateY(0); } to { transform: translateY(calc(-50% - 0.45rem)); } }

  @media (prefers-reduced-motion: reduce) {
    .rail-track { animation: none !important; }
    .rail-dup { display: none !important; }
    .rail-viewport { mask-image: none; overflow-y: auto; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el) {
    const dayInJerusalem = (d: Date) => {
      const p = Object.fromEntries(
        new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Asia/Jerusalem',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).formatToParts(d).map((x) => [x.type, x.value])
      );
      return Date.UTC(Number(p.year), Number(p.month) - 1, Number(p.day));
    };

    const OPENING = Date.UTC(2026, 8, 1);
    const render = () => {
      const days = Math.round((OPENING - dayInJerusalem(new Date())) / 86_400_000);
      el.innerHTML =
        days > 1
          ? `<span class="cd-num">עוד ${days} ימים</span> <span class="cd-label">לפתיחת שנת הלימודים תשפ״ז</span>`
          : days === 1
            ? '<span class="cd-label">מחר נפתחת שנת הלימודים תשפ״ז!</span>'
            : days === 0
              ? '<span class="cd-label">היום נפתחת שנת הלימודים תשפ״ז — בהצלחה!</span>'
              : '<span class="cd-label">שנת הלימודים תשפ״ז בעיצומה — בהצלחה!</span>';
    };

    render();
    setInterval(render, 60_000);
  }
</script>
