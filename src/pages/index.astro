---
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.astro';
import SplashIntro from '../components/SplashIntro.astro';
import NewsRail from '../components/NewsRail.astro';
import TeamSection from '../components/TeamSection.astro';
import WhatsAppBand from '../components/WhatsAppBand.astro';

// שני שערי-הענק של העמוד הראשי (הוראת יניב, 04/08/2026): מתחת לצוות
// ההדרכה — כפתורי ענק לחטיבת הביניים ולחטיבה העליונה בלבד.
const gates = [
  {
    href: '/chativat-beynayim/',
    title: 'חטיבת ביניים',
    desc: 'החוברת המרכזית של החטיבה, אתר ההמחשות של איילת קריספין וכל הקבצים לכיתות ז׳–ט׳.',
    accent: 'var(--olive)',
  },
  {
    href: '/chativa-elyona/',
    title: 'חטיבה עליונה',
    desc: 'התוכנית החדשה, רמות 3/4/5 יח״ל, בחינות הבגרות והמידע המנהלי לתשפ״ז.',
    accent: 'var(--terracotta)',
  },
];
---

<Base
  title="מחוז ירושלים — הדרכת מתמטיקה"
  description="המרכז המחוזי להוראת מתמטיקה במחוז ירושלים: סרטון הפתיחה, צוות ההדרכה, שערי חטיבת הביניים והחטיבה העליונה ועדכונים שוטפים."
  transparentHeader
>
  <link slot="head" rel="preload" as="image" href="/media/hero-poster-880.avif" fetchpriority="high" />
  <SplashIntro />
  <HeroVideo />

  <div class="rail-slot">
    <div class="container">
      <NewsRail />
    </div>
  </div>

  <div class="rail-offset">
    <TeamSection />

    <section class="section" id="shearim">
      <div class="container">
        <div class="gates-grid">
          {
            gates.map((g, i) => (
              <a
                class="card card-accent gate-card"
                style={`--card-accent:${g.accent}; --reveal-delay:${i * 120}ms`}
                href={g.href}
                data-reveal
              >
                <h2>{g.title}</h2>
                <p>{g.desc}</p>
                <span class="gate-cta">כניסה לשער ←</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <WhatsAppBand />
  </div>
</Base>

<style>
  /* פינוי מקום לפס "מה צפוי?" הקבוע במסכים רחבים (7.20) */
  @media (min-width: 1280px) {
    .rail-offset { padding-inline-end: calc(var(--rail-w) + 2.2rem); }
    .rail-slot .container { display: contents; } /* הפס עצמו הופך קבוע; אין רווח מיותר */
  }

  .rail-slot { margin-block-start: clamp(1.6rem, 4vw, 2.8rem); }

  /* שני כפתורי-ענק בלבד — חטיבת ביניים וחטיבה עליונה (הוראת יניב, 04/08/2026) */
  .gates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(1.2rem, 3vw, 2rem);
  }

  .gate-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-block-size: clamp(200px, 26vw, 260px);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.8rem, 3.4vw, 2.6rem);
    color: var(--ink);
    text-align: start;
  }

  .gate-card h2 {
    margin: 0;
    font-size: clamp(1.9rem, 4.4vw, 2.8rem);
    line-height: 1.1;
  }

  .gate-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    max-inline-size: 34ch;
  }

  .gate-card .gate-cta {
    margin-block-start: auto;
    padding-block-start: 1rem;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--gold-deep);
    transition: translate 300ms var(--ease);
  }

  .gate-card:hover .gate-cta { translate: -8px 0; }
</style>
