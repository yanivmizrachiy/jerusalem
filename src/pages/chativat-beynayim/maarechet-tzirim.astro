---
/**
 * עמוד משאב קנוני של מערכת צירים — מיוצר מ-choveret.ts
 * דרך reader/[grade]/[item].astro (RULES 3.29, הוראת יניב 05/08/2026).
 * הכתובת הישנה (/maarechet-tzirim/) מפנה לכתובת הקנונית
 * כדי שקישורים ששותפו בעבר ימשיכו לעבוד.
 */
const target = '/chativat-beynayim/reader/z/tzirim/';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>מערכת צירים — רביע ראשון — מחוז ירושלים</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://jerusalem-virid.vercel.app/chativat-beynayim/reader/z/tzirim/" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center;">
      העמוד עבר לכתובת החדשה —
      <a href={target}>מעבר מיידי</a>
    </p>
  </body>
</html>
