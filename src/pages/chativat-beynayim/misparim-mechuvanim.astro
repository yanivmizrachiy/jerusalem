---
import Base from '../../layouts/Base.astro';
import ResourcePageShell from '../../components/ResourcePageShell.astro';
import { grade7Resources } from '../../data/resources';

const resource = grade7Resources.find((r) => r.id === 'misparim')!;
const next = grade7Resources.find((r) => r.id === 'zaviyot')!;
---

<Base
  title={`${resource.title} — חטיבת ביניים — מחוז ירושלים`}
  description={resource.short}
>
  <ResourcePageShell resource={resource} next={{ label: next.title, href: next.path }} />
</Base>
