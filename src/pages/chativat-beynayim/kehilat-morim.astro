---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { whatsappCommunity } from '../../data/resources';
---

<Base
  title="קהילת מורים ותקשורת — חטיבת ביניים — מחוז ירושלים"
  description="קבוצת ה־WhatsApp הרשמית למורי חטיבות הביניים בעיר ירושלים ובמחוז ירושלים — הצטרפות בלחיצה אחת."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: 'קהילת מורים ותקשורת' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">קהילת מורים ותקשורת</p>
      <h1>הקהילה המחוזית ב־WhatsApp</h1>
    </header>

    <section class="card card-accent join-card" style="--card-accent:var(--olive)" data-reveal>
      <h2>{whatsappCommunity.title}</h2>
      <p>
        קבוצת ה־WhatsApp היא ערוץ התקשורת השוטף של קהילת מורי המתמטיקה בחטיבות הביניים:
        עדכונים מהמחוז, שאלות מקצועיות, רעיונות לשיעורים ושיתוף חומרים.
      </p>
      <p class="join-note">ההצטרפות פותחת את WhatsApp עם הזמנה לקבוצה — האישור הסופי אצלכם.</p>
      <a
        class="btn btn-whatsapp join-btn"
        href={whatsappCommunity.url}
        target="_blank"
        rel="noopener"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
        הצטרפות לקבוצה
      </a>
    </section>

    <section class="card card-accent fb-card" style="--card-accent:var(--sky)" data-reveal>
      <h2>פורום המורים הארצי בפייסבוק</h2>
      <p>
        קבוצת הפייסבוק הרשמית של הפיקוח למורי המתמטיקה בחטיבות הביניים — מוזכרת בחוזר
        מפמ״ר תשפ״ז (עמ׳ 9) כערוץ לשאלות מקצועיות.
      </p>
      <a class="btn btn-primary" href="https://facebook.com/groups/324706402455298/" target="_blank" rel="noopener">
        לקבוצת הפייסבוק ↗
      </a>
    </section>

    <nav class="back-nav" aria-label="ניווט חזרה">
      <a class="btn btn-ghost" href="/chativat-beynayim/">חזרה לחטיבת ביניים</a>
      <a class="btn btn-ghost" href="/">לעמוד הראשי</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }

  .page-head { margin-block: 1.6rem 2rem; }

  .join-card {
    max-width: 720px;
    padding: clamp(1.8rem, 4vw, 2.6rem);
  }

  .join-card h2 { font-size: 1.35rem; margin-block-end: 0.8rem; }

  .join-card p { color: var(--ink-soft); }

  .join-note { font-size: 0.92rem; color: var(--ink-faint); }

  .join-btn { font-size: 1.08rem; padding-inline: 2rem; margin-block-start: 0.6rem; }

  .fb-card { max-width: 720px; padding: clamp(1.6rem, 3.5vw, 2.2rem); margin-block-start: 1.6rem; }
  .fb-card h2 { font-size: 1.25rem; margin-block-end: 0.6rem; }
  .fb-card p { color: var(--ink-soft); }

  .back-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block-start: 2.4rem;
  }
</style>
