---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import UnitPlaylist from '../../components/UnitPlaylist.astro';
import { hafifaUnit } from '../../data/units';
---

<Base
  title="חפיפת משולשים — חטיבת ביניים — מחוז ירושלים"
  description="יחידת חפיפת משולשים לכיתה ח׳: שלושת משפטי החפיפה, תרגול מדורג, הוכחות, אוריינות, קטעים מיוחדים במשולש ובוחן מסכם — 26 משאבים בדוקים."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: hafifaUnit.grade },
        { label: hafifaUnit.domain },
        { label: 'חפיפת משולשים' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">{hafifaUnit.grade} · {hafifaUnit.domain}</p>
      <h1>{hafifaUnit.title}</h1>
      <p class="lede">{hafifaUnit.intro}</p>
    </header>

    <div data-reveal>
      <UnitPlaylist unit={hafifaUnit} />
    </div>

    <nav class="pager-nav" aria-label="ניווט חזרה">
      <a class="btn btn-ghost" href="/chativat-beynayim/kita-h/">חזרה לכיתה ח׳</a>
      <a class="btn btn-ghost" href="/chativat-beynayim/">חזרה לחטיבת ביניים</a>
      <a class="btn btn-ghost" href="/">לעמוד הראשי</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 680px; margin-block: 1.6rem 2rem; }
  .pager-nav { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-block-start: clamp(2.2rem, 5vw, 3rem); }
</style>
