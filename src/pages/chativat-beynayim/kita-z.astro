---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MafmarRange from '../../components/MafmarRange.astro';
import { grade7Resources } from '../../data/resources';

const sorted = [...grade7Resources].sort((a, b) => a.order - b.order);
---

<Base
  title="כיתה ז׳ — חטיבת ביניים — מחוז ירושלים"
  description="כיתה ז׳ בתשפ״ז: הדגשים הרשמיים מחוזר המפמ״ר — פריסות, Moodle, הערכה ופרויקט 720 — לצד המשאבים הקנוניים של השכבה."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: 'כיתה ז׳' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">חטיבת ביניים · תשפ״ז</p>
      <h1>כיתה ז׳</h1>
      <p class="lede">
        השכבה הראשונה שלומדת לפי תוכנית הלימודים המעודכנת — עם Moodle מחייבת, ספרי לימוד
        חדשים ופרויקט 720. הדגשים הרשמיים מוצגים כאן ישירות מתוך החוזר.
      </p>
    </header>

    <div data-reveal>
      <MafmarRange sectionId="MAF-02" accent="var(--olive)" />
    </div>

    <section class="section-block" aria-labelledby="z-res">
      <h2 id="z-res" data-reveal>המשאבים הקנוניים של כיתה ז׳</h2>
      <div class="res-grid">
        {
          sorted.map((r, i) => (
            <a
              class="card card-accent res-card"
              style={`--card-accent:${r.accent}; --reveal-delay:${i * 100}ms`}
              href={r.path}
              data-reveal
            >
              <span class="res-domain">{r.domain}</span>
              <h3>{r.title}</h3>
              <p>{r.short}</p>
              <span class="res-cta">לעמוד המשאב ←</span>
            </a>
          ))
        }
        <a
          class="card card-accent res-card"
          style="--card-accent:var(--amber); --reveal-delay:300ms"
          href="/chativat-beynayim/mishvaot/"
          data-reveal
        >
          <span class="res-domain">אלגברה · יחידת הוראה</span>
          <h3>הוראת משוואות ללא מספרים שליליים</h3>
          <p>19 משאבים בדוקים: המחשות, שקילות, פתרון, דפי עבודה, חידות ומשחק.</p>
          <span class="res-cta">ליחידה ←</span>
        </a>
      </div>
    </section>

    <section class="section-block" data-reveal>
      <h2>עוד בחוזר על כיתה ז׳ ועל חט״ב</h2>
      <div class="chip-links">
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-05">אירועי הערכה ומבחנים בחט״ב</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-06">Moodle ולמידה דיגיטלית</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-08">חומרי למידה וספרי לימוד</a>
      </div>
    </section>

    <nav class="pager-nav" aria-label="ניווט בין שכבות">
      <span></span>
      <a class="btn btn-ghost" href="/chativat-beynayim/">חזרה לחטיבת ביניים</a>
      <a class="btn btn-primary" href="/chativat-beynayim/kita-h/">השכבה הבאה: כיתה ח׳ ←</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 660px; margin-block: 1.6rem 2rem; }
  .section-block { margin-block-start: clamp(2.4rem, 5vw, 3.4rem); }
  .section-block h2 { margin-block-end: 1.2rem; }

  .res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: clamp(1rem, 2.4vw, 1.5rem);
  }

  .res-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.6rem 1.4rem 1.3rem; color: var(--ink); }
  .res-domain { font-size: 0.8rem; font-weight: 700; color: var(--ink-faint); }
  .res-card h3 { margin: 0; }
  .res-card p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .res-cta { margin-block-start: auto; padding-block-start: 0.7rem; font-weight: 700; color: var(--gold-deep); }

  .chip-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .pager-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-block-start: clamp(2.2rem, 5vw, 3rem);
  }
</style>
