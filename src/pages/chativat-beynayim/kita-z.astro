---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Booklet from '../../components/Booklet.astro';
---

<Base
  title="מתמטיקה לכיתה ז׳ — מחוז ירושלים"
  description="החוברת הדיגיטלית של כיתה ז׳: תוכן עניינים צבעוני — החוזר הרשמי, האתרים החיים, יחידת הדגל, תכנון והוראה מחוזי."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: 'כיתה ז׳' },
      ]}
    />

    <h1 class="sr-only">מתמטיקה לכיתה ז׳</h1>
    <Booklet initial="toc-z" />
  </div>
</Base>

<style>
  .page { padding-block: 1.6rem 2.5rem; }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
