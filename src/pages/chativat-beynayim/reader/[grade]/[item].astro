---
/**
 * קישור עומק לעמוד בחוברת (RULES 3.29): כל משאב נשאר עם כתובת קנונית
 * לשיתוף — העמוד פותח את הספר המדפדף ישירות בעמוד הנכון.
 */
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Booklet from '../../../../components/Booklet.astro';
import { choveret, readerItems } from '../../../../data/choveret';

export function getStaticPaths() {
  return readerItems.map(({ grade, chapter, item }) => ({
    params: { grade: grade.slug, item: item.id },
    props: { gradeSlug: grade.slug, itemId: item.id },
  }));
}

const { gradeSlug, itemId } = Astro.props;
const grade = choveret.find((g) => g.slug === gradeSlug)!;
const item = grade.chapters.flatMap((c) => c.items).find((i) => i.id === itemId)!;
---

<Base title={`${item.title} — ${grade.title} — מחוז ירושלים`} description={item.note}>
  <div class="container-wide page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: `כיתה ${grade.letter}`, href: `/chativat-beynayim/kita-${grade.slug}/` },
        { label: item.title },
      ]}
    />
    <h1 class="sr-only">{item.title}</h1>
    <Booklet initial={`it-${gradeSlug}-${itemId}`} />
  </div>
</Base>

<style>
  .page { padding-block: 1.6rem 2.5rem; }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
