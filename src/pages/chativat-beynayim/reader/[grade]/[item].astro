---
import Base from '../../../../layouts/Base.astro';
import ResourceContext from '../../../../components/ResourceContext.astro';
import ResourceSplit from '../../../../components/ResourceSplit.astro';
import { authorsForResource } from '../../../../data/authors';
import { isPublishableMaterial } from '../../../../data/publishing';
import { canonicalGrades, canonicalReaderItems } from '../../../../data/canonical-content';
import { gradeMaterialsHref } from '../../../../data/choveret';
import { visibleResourceNote, visibleResourceSource, visibleResourceTitle } from '../../../../data/resource-copy';

export function getStaticPaths() {
  return canonicalReaderItems.map(({ grade, item }) => ({
    params: { grade: grade.slug, item: item.id },
    props: { gradeSlug: grade.slug, itemId: item.id },
  }));
}

const { gradeSlug, itemId } = Astro.props;
const grade = canonicalGrades.find((candidate) => candidate.slug === gradeSlug)!;
const publicGrade = {
  ...grade,
  chapters: grade.chapters.map((currentChapter) => ({
    ...currentChapter,
    items: currentChapter.items.filter(isPublishableMaterial),
  })),
};
const chapter = publicGrade.chapters.find((candidate) => candidate.items.some((item) => item.id === itemId))!;
const item = chapter.items.find((candidate) => candidate.id === itemId)!;
const creators = authorsForResource(item.id);
const creatorAliases = creators.flatMap((creator) => [creator.name, ...creator.aliases]);
const displayItem = {
  ...item,
  title: visibleResourceTitle(item),
  note: visibleResourceNote(item),
  source: visibleResourceSource(item, creatorAliases),
};

/**
 * נושא עם משאב ציבורי יחיד מפנה 301 ישירות לעמוד המשאב, ולכן קישור "חזרה
 * לנושא" היה מחזיר מיד לאותו עמוד ויוצר לולאת ניווט. ResourceSplit כבר
 * יודע להשתמש ב-redirectHref כאשר materials=false; כאן מעבירים לו עותק
 * לצורכי ניווט בלבד, בלי לשנות את נתוני הפרק הקנוניים.
 */
const navigationChapter =
  chapter.items.length === 1 && chapter.materials !== false
    ? { ...chapter, materials: false, redirectHref: gradeMaterialsHref(grade.slug) }
    : chapter;

const description =
  displayItem.note || displayItem.source || `${displayItem.title} — ${chapter.title}, ${grade.title}, מחוז ירושלים.`;
---

<Base title={`${displayItem.title} — ${grade.title} — מחוז ירושלים`} description={description}>
  <ResourceSplit grade={publicGrade} chapter={navigationChapter} item={displayItem} />
  <ResourceContext grade={publicGrade} item={item} />
</Base>