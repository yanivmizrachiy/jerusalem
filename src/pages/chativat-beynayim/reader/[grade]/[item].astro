---
/**
 * עמוד המשאב הקנוני (RULES 8.2; הוראת יניב 05/08/2026): כתובת יציבה
 * לשיתוף לכל קובץ — המשאב מוטמע בצד אחד של המסך והפעולות בצד השני.
 * פריט `needsReview` אינו מקבל route פומבי עד לאימות אנושי.
 */
import Base from '../../../../layouts/Base.astro';
import ResourceContext from '../../../../components/ResourceContext.astro';
import ResourceSplit from '../../../../components/ResourceSplit.astro';
import { isPublishableMaterial } from '../../../../data/publishing';
import { choveret, readerItems } from '../../../../data/choveret';

export function getStaticPaths() {
  return readerItems
    .filter(({ item }) => isPublishableMaterial(item))
    .map(({ grade, item }) => ({
      params: { grade: grade.slug, item: item.id },
      props: { gradeSlug: grade.slug, itemId: item.id },
    }));
}

const { gradeSlug, itemId } = Astro.props;
const grade = choveret.find((g) => g.slug === gradeSlug)!;
const chapter = grade.chapters.find((c) => c.items.some((i) => i.id === itemId && isPublishableMaterial(i)))!;
const item = chapter.items.find((i) => i.id === itemId && isPublishableMaterial(i))!;

// פריטי החוזר אינם נושאים note (הכותרת והטווח מדברים בעד עצמם), ובלי
// גיבוי הם נבנו עם description ריק — כלומר גם og:description ריק (18.1)
const description =
  item.note || item.source || `${item.title} — ${chapter.title}, ${grade.title}, מחוז ירושלים.`;
---

<Base title={`${item.title} — ${grade.title} — מחוז ירושלים`} description={description}>
  <ResourceSplit grade={grade} chapter={chapter} item={item} />
  <ResourceContext grade={grade} item={item} />
</Base>
