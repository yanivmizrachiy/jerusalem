---
import Base from '../../layouts/Base.astro';
import ResourcePageShell from '../../components/ResourcePageShell.astro';
import { grade7Resources } from '../../data/resources';

const resource = grade7Resources.find((r) => r.id === 'zaviyot')!;
const next = grade7Resources.find((r) => r.id === 'tzirim')!;
---

<Base
  title={`${resource.title} — חטיבת ביניים — מחוז ירושלים`}
  description={resource.short}
>
  <ResourcePageShell
    resource={resource}
    prev={{ label: 'הוראת משוואות ללא מספרים שליליים', href: '/chativat-beynayim/mishvaot/' }}
    next={{ label: next.title, href: next.path }}
  />
</Base>
