---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import UnitPlaylist from '../../components/UnitPlaylist.astro';
import { mishvaotUnit } from '../../data/units';
---

<Base
  title="הוראת משוואות ללא מספרים שליליים — חטיבת ביניים — מחוז ירושלים"
  description="יחידה מלאה להוראת משוואות עוד לפני המספרים המכוונים: המחשות, שקילות, פתרון, אביזרים, דפי עבודה, חידות ומשחק — 19 קבצים."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: mishvaotUnit.grade },
        { label: mishvaotUnit.domain },
        { label: 'הוראת משוואות ללא מספרים שליליים' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">{mishvaotUnit.grade} · {mishvaotUnit.domain}</p>
      <h1>{mishvaotUnit.title}</h1>
    </header>

    <div data-reveal>
      <UnitPlaylist unit={mishvaotUnit} />
    </div>

    <nav class="back-nav" aria-label="חזרה לנושא">
      <a class="btn btn-ghost" href="/chativat-beynayim/nose/z/z-equations/">חזרה לנושא משוואות בכיתה ז׳</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 680px; margin-block: 1.6rem 2rem; }
  .back-nav { display: flex; justify-content: center; margin-block-start: clamp(2.2rem, 5vw, 3rem); }
</style>
