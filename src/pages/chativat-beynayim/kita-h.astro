---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MafmarRange from '../../components/MafmarRange.astro';
---

<Base
  title="כיתה ח׳ — חטיבת ביניים — מחוז ירושלים"
  description="כיתה ח׳ בתשפ״ז: פריסת הוראה ארצית מיוחדת, Moodle מחייבת, משימות הערכה ומבחן מפמ״ר, והמשך פיילוט פרויקט 720 — ישירות מחוזר המפמ״ר."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: 'כיתה ח׳' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">חטיבת ביניים · תשפ״ז</p>
      <h1>כיתה ח׳</h1>
      <p class="lede">
        שנת התאמה בין התוכנית המעודכנת לספרי הלימוד הקיימים — פריסה ארצית מיוחדת עם
        תרגולים משלימים, ‏Moodle מחייבת ומשימות הערכה לאורך השנה. חשוב: נושאי כיתה ח׳
        יופיעו במבחן תנופה ט׳ של תשפ״ח.
      </p>
    </header>

    <div data-reveal>
      <MafmarRange sectionId="MAF-03" accent="var(--sky)" />
    </div>

    <section class="section-block" data-reveal>
      <h2>יחידת הדגל של השכבה</h2>
      <a class="card card-accent unit-card" style="--card-accent:var(--sky)" href="/chativat-beynayim/hafifat-meshulashim/">
        <span class="unit-domain">גאומטריה · 26 משאבים בדוקים</span>
        <h3>חפיפת משולשים</h3>
        <p>שלושת משפטי החפיפה, תרגול מדורג, הוכחות ואוריינות, קטעים מיוחדים במשולש ובוחן מסכם — הכול בנגן יחידה אחד.</p>
        <span class="unit-cta">ליחידה המלאה ←</span>
      </a>
    </section>

    <section class="section-block" data-reveal>
      <h2>עוד בחוזר הרלוונטי לכיתה ח׳</h2>
      <div class="chip-links">
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-05">אירועי הערכה ומבחני מפמ״ר</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-06">Moodle ולמידה דיגיטלית</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-09">חלוקה לרמות והדרכה</a>
      </div>
    </section>

    <nav class="pager-nav" aria-label="ניווט בין שכבות">
      <a class="btn btn-ghost" href="/chativat-beynayim/kita-z/">→ השכבה הקודמת: כיתה ז׳</a>
      <a class="btn btn-ghost" href="/chativat-beynayim/">חזרה לחטיבת ביניים</a>
      <a class="btn btn-primary" href="/chativat-beynayim/kita-t/">השכבה הבאה: כיתה ט׳ ←</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 660px; margin-block: 1.6rem 2rem; }
  .section-block { margin-block-start: clamp(2.4rem, 5vw, 3.4rem); }
  .section-block h2 { margin-block-end: 1.2rem; }
  .chip-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .unit-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.7rem 1.5rem 1.4rem; color: var(--ink); max-width: 560px; }
  .unit-domain { font-size: 0.8rem; font-weight: 700; color: var(--ink-faint); }
  .unit-card h3 { margin: 0; }
  .unit-card p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .unit-cta { margin-block-start: 0.4rem; font-weight: 700; color: var(--gold-deep); }
  .pager-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-block-start: clamp(2.2rem, 5vw, 3rem);
  }
</style>
