---
/**
 * העמוד המרוכז של המשחקים הוחלף בפרקי "משחקים לאורך השנה" ו"העשרה
 * ואתרים" שבעמוד "משותף לכל השכבות"
 * (RULES 1.10, 3.29 — הוראת יניב, 05/08/2026). הכתובת הישנה
 * נשארת חיה לקישורים ששותפו, ומפנה מיידית לעמוד החדש.
 */
const target = '/chativat-beynayim/nose/klali/mischakim/';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>החומרים עברו לעמוד המשותף — מחוז ירושלים</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://jerusalem-virid.vercel.app/chativat-beynayim/" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center;">
      המשחקים וההעשרה עברו אל העמוד המשותף לכל השכבות —
      <a href={target}>מעבר מיידי</a>
    </p>
  </body>
</html>
