---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { grade7Resources, whatsappCommunity } from '../../data/resources';

const sorted = [...grade7Resources].sort((a, b) => a.order - b.order);
---

<Base
  title="חטיבת ביניים — מחוז ירושלים"
  description="שער חטיבת הביניים של מחוז ירושלים: משאבים קנוניים לכיתה ז׳ — מספרים מכוונים, זוויות ומערכת צירים — וקהילת המורים המחוזית."
>
  <div class="container page">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'חטיבת ביניים' }]} />

    <header class="page-head" data-reveal>
      <p class="eyebrow">השער של חטיבות הביניים</p>
      <h1>חטיבת ביניים</h1>
      <p class="lede">
        המשאבים הקנוניים לכיתה ז׳ וקהילת המורים המחוזית. השער ימשיך לגדול — כיתות ח׳–ט׳,
        בחינות והערכה וחומרי הוראה נוספים בדרך.
      </p>
    </header>

    <section class="section-block" aria-labelledby="grades-title">
      <h2 id="grades-title" data-reveal>שכבות הגיל — הדגשים הרשמיים לתשפ״ז</h2>
      <div class="res-grid">
        <a class="card card-accent res-card" style="--card-accent:var(--olive)" href="/chativat-beynayim/kita-z/" data-reveal>
          <span class="res-domain">התוכנית המעודכנת · Moodle מחייבת</span>
          <h3>כיתה ז׳</h3>
          <p>פריסות, דגשים, הערכה, פרויקט 720 והמשאבים הקנוניים של השכבה.</p>
          <span class="res-cta">לעמוד השכבה ←</span>
        </a>
        <a class="card card-accent res-card" style="--card-accent:var(--sky); --reveal-delay:100ms" href="/chativat-beynayim/kita-h/" data-reveal>
          <span class="res-domain">שנת התאמה · Moodle מחייבת</span>
          <h3>כיתה ח׳</h3>
          <p>פריסה ארצית מיוחדת, משימות הערכה ומבחן מפמ״ר, והמשך פיילוט 720.</p>
          <span class="res-cta">לעמוד השכבה ←</span>
        </a>
        <a class="card card-accent res-card" style="--card-accent:var(--terracotta); --reveal-delay:200ms" href="/chativat-beynayim/kita-t/" data-reveal>
          <span class="res-domain">תנופה 25.11.26 · מעבר לחט״ע</span>
          <h3>כיתה ט׳</h3>
          <p>שתי פריסות, קדם־אנליזה, מבחן תנופה והשיבוץ לרמות 3/4/5.</p>
          <span class="res-cta">לעמוד השכבה ←</span>
        </a>
      </div>
    </section>

    <section class="section-block" aria-labelledby="grade7-title">
      <h2 id="grade7-title" data-reveal>כיתה ז׳ — משאבים קנוניים</h2>
      <div class="res-grid">
        {
          sorted.map((r, i) => (
            <a
              class="card card-accent res-card"
              style={`--card-accent:${r.accent}; --reveal-delay:${i * 100}ms`}
              href={r.path}
              data-reveal
            >
              <span class="res-domain">{r.domain}</span>
              <h3>{r.title}</h3>
              <p>{r.short}</p>
              <span class="res-cta">לעמוד המשאב ←</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section-block" aria-labelledby="units-title">
      <h2 id="units-title" data-reveal>יחידות הוראה ובחינות — כל קישור בדוק</h2>
      <div class="res-grid">
        <a class="card card-accent res-card" style="--card-accent:var(--amber)" href="/chativat-beynayim/mishvaot/" data-reveal>
          <span class="res-domain">כיתה ז׳ · אלגברה · 19 משאבים</span>
          <h3>הוראת משוואות ללא מספרים שליליים</h3>
          <p>המחשות, שקילות, פתרון, אביזרים, דפי עבודה, חידות ומשחק — בנגן יחידה אחד.</p>
          <span class="res-cta">ליחידה ←</span>
        </a>
        <a class="card card-accent res-card" style="--card-accent:var(--sky); --reveal-delay:100ms" href="/chativat-beynayim/hafifat-meshulashim/" data-reveal>
          <span class="res-domain">כיתה ח׳ · גאומטריה · 26 משאבים</span>
          <h3>חפיפת משולשים</h3>
          <p>שלושת משפטי החפיפה, תרגול מדורג, הוכחות, קטעים מיוחדים ובוחן מסכם.</p>
          <span class="res-cta">ליחידה ←</span>
        </a>
        <a class="card card-accent res-card" style="--card-accent:var(--lilac); --reveal-delay:200ms" href="/chativat-beynayim/mivchanim/" data-reveal>
          <span class="res-domain">כיתות ז׳–ט׳ · 7 משאבים</span>
          <h3>בחינות והערכה — נוסחאות והנחיות</h3>
          <p>דפי הנוסחאות הרשמיים לכל שכבה, מבחן דמוי מיצ״ב עם מחוון והנחיות.</p>
          <span class="res-cta">לעמוד ←</span>
        </a>
        <a class="card card-accent res-card" style="--card-accent:var(--rose); --reveal-delay:300ms" href="/chativat-beynayim/mischakim/" data-reveal>
          <span class="res-domain">כיתות ז׳–ט׳ · 8 משאבים</span>
          <h3>משחקים והעשרה</h3>
          <p>משחקים לפי הפריסות, חנוכה, מתמטיקה בפרשה ואתרי העשרה מחוזיים.</p>
          <span class="res-cta">לעמוד ←</span>
        </a>
      </div>
    </section>

    <section class="section-block" aria-labelledby="rohav-title">
      <h2 id="rohav-title" data-reveal>משאבי רוחב ולמידה דיגיטלית — נכרו מהאתר הקודם ואומתו</h2>
      <div class="chip-links" data-reveal>
        <a class="btn btn-ghost" href="https://sites.google.com/view/moodlemath/%D7%9E%D7%95%D7%A8%D7%99%D7%9D-%D7%95%D7%A6%D7%95%D7%95%D7%AA/%D7%9E%D7%93%D7%A8%D7%99%D7%9A-%D7%9C%D7%9E%D7%95%D7%A8%D7%94" target="_blank" rel="noopener">אתר המודל — מדריך למורה ↗</a>
        <a class="btn btn-ghost" href="https://docs.google.com/spreadsheets/d/1l8-7V7DMQSMkWNCFj3Y1OTnrJmaoOuRPWFkIP0a0_OE/edit" target="_blank" rel="noopener">מצגות מהמודל לפי נושאים ↗</a>
        <a class="btn btn-ghost" href="https://docs.google.com/document/d/1RYQQdKawSDPYYCDlUrm2MzcrNskv1SZQKHTNf8JJPuo/edit" target="_blank" rel="noopener">חומרים ברוח התוכנית החדשה ↗</a>
        <a class="btn btn-ghost" href="https://docs.google.com/document/d/1u98c3VxZYCvuy9LPV-MzZyLKzYB6vI1I/edit" target="_blank" rel="noopener">נושאי עמ״ט לפי שכבות ↗</a>
        <a class="btn btn-ghost" href="https://docs.google.com/document/d/1D4JdPdoOMc23XgMCbAv24D28tW7VkUyoK19U3ZVHAQE/edit" target="_blank" rel="noopener">תכני חובה לפי חודשים ↗</a>
        <a class="btn btn-ghost" href="https://docs.google.com/document/d/1ILL7bpo4LLNmXfE0Kaz1ApoWmDIzk6ILDX3HpDeFd5o/edit" target="_blank" rel="noopener">קבצים לפי נושאים ↗</a>
        <a class="btn btn-ghost" href="https://www.canva.com/design/DAGXwB1tskI/-SQYskyIRJmt8i4W8A806w/edit" target="_blank" rel="noopener">שאלות חשיבה מסדר גבוה ↗</a>
      </div>
    </section>

    <section class="section-block" aria-labelledby="kehila-title">
      <h2 id="kehila-title" data-reveal>קהילת מורים ותקשורת</h2>
      <div class="card card-accent kehila-card" style="--card-accent:var(--olive)" data-reveal>
        <div class="kehila-text">
          <h3>{whatsappCommunity.title}</h3>
          <p>
            הערוץ המהיר לעדכונים, שאלות ושיתוף בין מורות ומורי המתמטיקה בעיר ובמחוז.
          </p>
        </div>
        <a class="btn btn-primary" href={whatsappCommunity.path}>לעמוד הקהילה ←</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }

  .page-head { max-width: 640px; margin-block: 1.6rem 2.4rem; }

  .section-block { margin-block-end: clamp(2.6rem, 6vw, 4rem); }

  .section-block h2 { margin-block-end: 1.4rem; }

  .res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }

  .res-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.7rem 1.5rem 1.4rem;
    color: var(--ink);
  }

  .res-domain {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .res-card h3 { margin: 0; }

  .res-card p { margin: 0; color: var(--ink-soft); font-size: 0.96rem; }

  .res-cta {
    margin-block-start: auto;
    padding-block-start: 0.8rem;
    font-weight: 700;
    color: var(--gold-deep);
    transition: translate 300ms var(--ease);
  }

  .res-card:hover .res-cta { translate: -6px 0; }

  .kehila-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.8rem 1.6rem;
  }

  .kehila-text { max-width: 60ch; }

  .kehila-card h3 { margin: 0 0 0.4rem; font-size: 1.15rem; }

  .kehila-card p { margin: 0; color: var(--ink-soft); }
</style>
