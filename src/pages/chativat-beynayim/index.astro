---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArtBanner from '../../components/ArtBanner.astro';
import HamchashotEmbed from '../../components/HamchashotEmbed.astro';
import MiddleSchoolQuickLinks from '../../components/MiddleSchoolQuickLinks.astro';
import { whatsappCommunity } from '../../data/resources';
import { choveret, gradeHref } from '../../data/choveret';

const stamp = Object.fromEntries(
  new Intl.DateTimeFormat('he', {
    timeZone: 'Asia/Jerusalem',
    weekday: 'long',
    day: 'numeric',
    month: 'numeric',
    year: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  })
    .formatToParts(new Date())
    .map((p) => [p.type, p.value])
);
const updatedLine = `מאגר הקבצים עודכן ב${stamp.weekday}, ${Number(stamp.day)}/${Number(stamp.month)}/${stamp.year}, בשעה ${stamp.hour}:${stamp.minute}`;

/* גוני הקיצורים (הוראת יניב, 10/08/2026): ז׳ סגול, ח׳ כחול, ט׳ טורקיז.
   שני עצירי כל גרדיאנט עומדים בניגודיות AA מול המלל הלבן. */
const shortcutTones: Record<string, { from: string; to: string; dot: string }> = {
  z: { from: '#7c3aed', to: '#5b21b6', dot: '#c4b5fd' },
  h: { from: '#2563eb', to: '#1d4ed8', dot: '#93c5fd' },
  t: { from: '#0d7f72', to: '#0a6155', dot: '#2dd4bf' },
};
---

<Base
  title="מתמטיקה לחטיבת הביניים — מחוז ירושלים"
  description="מתמטיקה לחטיבת הביניים במחוז ירושלים: כל הקבצים, הקישורים והפעילויות של כיתות ז׳, ח׳ ו-ט׳."
>
  <div class="container gate-top page-top">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'חטיבת ביניים' }]} />

    <!-- המסך הראשון (הוראת יניב, 10/08/2026): הכותרת, טבלת הקישורים
         וההטמעה הקומפקטית של ההמחשות — יחד, בלי גלילה במסך רחב. -->
    <div class="gate-first">
      <div class="gate-main">
        <header class="page-head" data-reveal>
          <h1 class="big-title">מתמטיקה לחטיבת הביניים</h1>
          <p class="updated-line">{updatedLine}</p>
        </header>

        <MiddleSchoolQuickLinks />
      </div>

      <HamchashotEmbed compact />
    </div>
  </div>

  <!-- ארבעה קיצורים קומפקטיים (הוראת יניב, 10/08/2026): שלוש השכבות מתוך
       choveret ומאגר המבחנים — הקישור היחיד בעמוד ליעד המאגר. -->
  <nav class="container grade-shortcuts" aria-label="שכבות הלימוד ומאגר המבחנים" data-reveal>
    {
      choveret.map((g) => (
        <a
          class="gs-btn"
          style={`--gs-from:${shortcutTones[g.slug].from}; --gs-to:${shortcutTones[g.slug].to}; --gs-dot:${shortcutTones[g.slug].dot}`}
          href={gradeHref(g.slug)}
        >
          <span class="gs-dot" aria-hidden="true" />
          {g.title}
        </a>
      ))
    }
    <a class="gs-btn gs-exams" href="/chativat-beynayim/mivchanim/">
      <span class="gs-dot" aria-hidden="true" />
      מאגר המבחנים
    </a>
  </nav>

  <div class="container page-rest">
    <hr class="section-rule" aria-hidden="true" />

    <ArtBanner
      art="festival"
      alt="איור אמנותי: פסטיבל מתמטיקה צבעוני ברחבת שער יפו בירושלים — קהל לומדים סביב דודקהדרון ענק"
      fullImage
      width={1600}
      height={906}
    />

    <section class="section-block" data-reveal>
      <div class="wa-row">
        <a class="wa-join" href={whatsappCommunity.url} target="_blank" rel="noopener" aria-label="הצטרפות לקבוצת ה־WhatsApp של מורי המתמטיקה בחטיבת הביניים">
          <span class="btn btn-whatsapp" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </span>
          <span class="wa-text">הצטרפו לקבוצת הווטסאפ של המורים למתמטיקה בחט״ב</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-top { padding-block: 1rem 0; }
  .page-head { max-width: 760px; margin-block: 0.35rem 0; }
  .page-head .updated-line { margin-block: 0.3rem 0; }
  .page-rest { padding-block: 0 2.2rem; }

  /* המסך הראשון (הוראת יניב, 10/08/2026): רצועה רחבה — הכותרת וטבלת
     הקישורים מימין, ההטמעה הקומפקטית של ההמחשות משמאל; הכול בלי גלילה. */
  .gate-top { width: min(1520px, 100% - 2 * clamp(1.1rem, 4vw, 2.5rem)); }
  .gate-first {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(340px, 1fr);
    gap: clamp(1.4rem, 2.4vw, 2.4rem);
    align-items: start;
  }
  .gate-main { min-inline-size: 0; }

  @media (max-width: 1119px) {
    .gate-first { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  }

  /* ארבעת הקיצורים (הוראת יניב, 10/08/2026): שורה אחת במסך רחב, רשת 2×2
     בנייד; מטרת מגע ≥44px. עצירי הגרדיאנטים נבחרו לניגודיות AA מול לבן. */
  .grade-shortcuts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.7rem, 1.6vw, 1.1rem);
    max-inline-size: 1060px;
    margin-block-start: clamp(1.7rem, 3.2vw, 2.6rem);
  }

  .gs-btn {
    min-block-size: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.7rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background-color: var(--gs-to, var(--navy));
    background-image: linear-gradient(135deg, var(--gs-from, var(--navy)), var(--gs-to, var(--navy)));
    color: #fff;
    font-weight: 800;
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 14px 30px -18px rgb(31 41 61 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.28);
  }

  .gs-dot {
    flex: 0 0 auto;
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background: var(--gs-dot, var(--gold));
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gs-dot, var(--gold)) 22%, transparent);
  }

  /* המאגר — הגרדיאנט המשוחזר והנקודה המוזהבת (10/08/2026) */
  .gs-exams {
    --gs-dot: #ffe18a;
    background-color: #2563eb;
    background-image: linear-gradient(135deg, #7c3aed 0%, #2563eb 52%, #0f9f8f 100%);
    text-shadow: 0 1px 2px rgb(9 18 32 / 0.3);
  }

  .gs-btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  @media (prefers-reduced-motion: no-preference) {
    .gs-btn {
      transition: transform 220ms var(--ease), box-shadow 220ms var(--ease), filter 220ms var(--ease);
    }
    .gs-btn:hover {
      transform: translateY(-2px);
      filter: saturate(1.1);
      box-shadow: 0 18px 36px -18px rgb(31 41 61 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.3);
    }
  }

  @media (max-width: 700px) {
    .grade-shortcuts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .section-rule {
    inline-size: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(3rem, 7vw, 5.5rem);
    border: 0;
    block-size: 3px;
    background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--navy) 45%, transparent) 12%, var(--navy) 50%, color-mix(in srgb, var(--navy) 45%, transparent) 88%, transparent 100%);
    position: relative;
  }

  .section-rule::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    block-size: 1px;
    background: linear-gradient(90deg, transparent 20%, color-mix(in srgb, var(--gold) 55%, transparent) 50%, transparent 80%);
  }

  .wa-row { display: flex; justify-content: center; }
  .wa-join { display: inline-flex; align-items: center; gap: 0.9rem; text-decoration: none; border-radius: 999px; }
  .wa-text { font-weight: 700; color: var(--vacation); transition: color 300ms var(--ease); }
  .wa-join:hover .wa-text { color: #0a5230; }
  .wa-join:hover .btn-whatsapp { transform: translateY(-3px) scale(1.05); box-shadow: 0 12px 26px -10px rgb(37 211 102 / 0.75); }
  .wa-join:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
  .section-block { margin-block-start: clamp(2rem, 4vw, 2.8rem); }

</style>

<style is:global>
  /* כיווץ עדין של הטבלה בתוך המסך הראשון בלבד (10/08/2026) — כדי שהכותרת,
     הטבלה המלאה וההטמעה ייכנסו יחד במסך אחד. הסלקטורים מעוגנים ל-.gate-first
     ואינם משפיעים על שום עמוד אחר; מטרות המגע נשארות ≥44px בכל קישור.  */
  .gate-first .quick-links { margin-block: 0.75rem 0; }
  .gate-first .quick-head { margin-block-end: 0.6rem; }
  .gate-first .quick-head h2 { font-size: clamp(1.3rem, 1.8vw, 1.55rem); line-height: 1.2; }

  .gate-first .quick-links th {
    min-block-size: 0;
    padding: 0.6rem 0.5rem;
    font-size: clamp(0.94rem, 1.1vw, 1.08rem);
  }
  /* העמודה הראשונה רחבה מעט יותר — שלוש גלולות "רגע לפני" בשורה אחת */
  .gate-first .quick-links th:first-child { inline-size: 30%; }
  .gate-first .quick-links th small { margin-block-start: 0.2rem; font-size: 0.62rem; }
  .gate-first .quick-links td > a,
  .gate-first .quick-links .empty {
    min-block-size: 56px;
    padding: 0.55rem 0.7rem;
    font-size: 0.94rem;
    line-height: 1.35;
  }
  .gate-first .quick-links .multi { min-block-size: 56px; padding: 0.5rem 0.4rem; gap: 0.3rem; }
  .gate-first .quick-links .multi-label { font-size: 0.94rem; }
  .gate-first .quick-links .multi-links { gap: 0.28rem; }
  .gate-first .quick-links .multi-links a { padding: 0.3rem 0.5rem; font-size: 0.84rem; }
</style>

<script>
  /* המסך הראשון (10/08/2026): גובה ההטמעה נמדד בפועל כך שהיא — יחד עם
     שורת ההעתקה שמתחתיה — נגמרת בתוך גובה החלון, בלי גלילה. במסכים
     צרים ההערמה חוזרת ל-fallback שב-CSS. */
  const mamFrame = document.querySelector<HTMLElement>('.gate-first .mam-frame');
  if (mamFrame) {
    const actions = document.querySelector<HTMLElement>('.gate-first .mam-actions');
    const fitMam = () => {
      if (!matchMedia('(min-width: 1120px)').matches) {
        mamFrame.style.removeProperty('block-size');
        return;
      }
      const top = mamFrame.getBoundingClientRect().top + scrollY;
      const reserve = (actions?.getBoundingClientRect().height ?? 46) + 40;
      mamFrame.style.blockSize = `${Math.min(680, Math.max(360, Math.round(innerHeight - top - reserve)))}px`;
    };
    fitMam();
    addEventListener('resize', fitMam, { passive: true });
    addEventListener('load', fitMam, { once: true });
    document.fonts?.ready.then(fitMam);
  }
</script>
