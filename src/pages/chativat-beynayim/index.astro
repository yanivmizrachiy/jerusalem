---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArtBanner from '../../components/ArtBanner.astro';
import Booklet from '../../components/Booklet.astro';
import { whatsappCommunity } from '../../data/resources';

// חותמת עדכון אמת (3.25): זמן הבנייה בפועל — מתחדשת אוטומטית בכל פריסה
const stamp = Object.fromEntries(
  new Intl.DateTimeFormat('he', {
    timeZone: 'Asia/Jerusalem',
    weekday: 'long',
    day: 'numeric',
    month: 'numeric',
    year: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  })
    .formatToParts(new Date())
    .map((p) => [p.type, p.value])
);
const updatedLine = `מאגר הקבצים עודכן ב${stamp.weekday}, ${Number(stamp.day)}/${Number(stamp.month)}/${stamp.year}, בשעה ${stamp.hour}:${stamp.minute}`;
---

<Base
  title="מתמטיקה לחטיבת הביניים — מחוז ירושלים"
  description="מתמטיקה לחטיבת הביניים במחוז ירושלים: כל הקבצים, הקישורים והפעילויות של כיתות ז׳–ט׳ בספר מדפדף אחד."
>
  <div class="container page">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'חטיבת ביניים' }]} />

    <header class="page-head" data-reveal>
      <h1 class="big-title">מתמטיקה לחטיבת הביניים</h1>
      <p class="updated-line">{updatedLine}</p>
    </header>

    <Booklet initial="rashi" />

    <ArtBanner
      art="festival"
      alt="איור אמנותי: פסטיבל מתמטיקה צבעוני ברחבת שער יפו בירושלים — קהל לומדים סביב דודקהדרון ענק"
      fullImage
      width={1600}
      height={906}
    />

    <section class="section-block" data-reveal>
      <div class="wa-row">
        <a class="wa-join" href={whatsappCommunity.url} target="_blank" rel="noopener" aria-label="הצטרפות לקבוצת ה־WhatsApp של מורי המתמטיקה בחטיבת הביניים">
          <span class="btn btn-whatsapp" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </span>
          <span class="wa-text">הצטרפו לקבוצת הווטסאפ של המורים למתמטיקה בחט״ב</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ראש קומפקטי — הספר מקבל את מרב הגובה מעל הקו הראשון של המסך */
  .page { padding-block: 1rem 2.2rem; }

  .page-head { max-width: 760px; margin-block: 0.6rem 0.9rem; }

  .wa-row {
    display: flex;
    justify-content: center;
  }

  /* לחיצה על הלוגו ועל הכיתוב כאחד מובילה ישירות לקבוצה (9.2) */
  .wa-join {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    border-radius: 999px;
  }

  .wa-text {
    font-weight: 700;
    color: var(--vacation);
    transition: color 300ms var(--ease);
  }

  .wa-join:hover .wa-text { color: #0a5230; }
  .wa-join:hover .btn-whatsapp {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 12px 26px -10px rgb(37 211 102 / 0.75);
  }
  .wa-join:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }

  .section-block { margin-block-start: clamp(2rem, 4vw, 2.8rem); }
</style>
