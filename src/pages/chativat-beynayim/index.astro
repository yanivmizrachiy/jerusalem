---
/**
 * שער חטיבת הביניים (הוראת יניב, 05/08/2026): החוברת המדפדפת בוטלה.
 * במקומה — מסך מחולק שליש־שליש־שליש בין כיתה ז׳, כיתה ח׳ וכיתה ט׳,
 * באותה שפה של מסך בחירת החטיבה (7.29), ומתחתיו רצועת "כללי" עם
 * החומרים המשותפים לכל השכבות.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArtBanner from '../../components/ArtBanner.astro';
import HamchashotEmbed from '../../components/HamchashotEmbed.astro';
import { whatsappCommunity } from '../../data/resources';
import { choveret, gradeCounts, gradeHref } from '../../data/choveret';

// חותמת עדכון אמת (3.25): זמן הבנייה בפועל — מתחדשת אוטומטית בכל פריסה
const stamp = Object.fromEntries(
  new Intl.DateTimeFormat('he', {
    timeZone: 'Asia/Jerusalem',
    weekday: 'long',
    day: 'numeric',
    month: 'numeric',
    year: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  })
    .formatToParts(new Date())
    .map((p) => [p.type, p.value])
);
const updatedLine = `מאגר הקבצים עודכן ב${stamp.weekday}, ${Number(stamp.day)}/${Number(stamp.month)}/${stamp.year}, בשעה ${stamp.hour}:${stamp.minute}`;

// שלושת השלישים נגזרים מהנתונים — כולל המניין האמיתי (3.27)
const thirds = choveret;
---

<Base
  title="מתמטיקה לחטיבת הביניים — מחוז ירושלים"
  description="מתמטיקה לחטיבת הביניים במחוז ירושלים: כל הקבצים, הקישורים והפעילויות של כיתות ז׳, ח׳ ו-ט׳."
>
  <div class="container page-top">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'חטיבת ביניים' }]} />

    <header class="page-head" data-reveal>
      <h1 class="big-title">מתמטיקה לחטיבת הביניים</h1>
      <p class="updated-line">{updatedLine}</p>
    </header>
  </div>

  <section class="split3" aria-label="בחירת שכבה">
    {
      thirds.map((g, i) => (
        <a
          class:list={['third', i % 2 === 0 ? 'is-navy' : 'is-paper']}
          style={`--i:${i}; --grade:${g.color}`}
          href={gradeHref(g.slug)}
        >
          {i > 0 && <span class="split-rule" aria-hidden="true" />}
          <span class="third-glow" aria-hidden="true" />
          <span class="third-inner">
            <span class="third-mark" aria-hidden="true" />
            <h2 class="third-title">{g.title}</h2>
            <span class="third-count">{gradeCounts[g.slug]} קבצים, קישורים ופעילויות</span>
            <span class="third-cta" aria-hidden="true">
              <svg viewBox="0 0 44 16" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M43 8H2M9 1.5 2 8l7 6.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>
      ))
    }
  </section>

  <div class="container page-rest">
    <hr class="section-rule" aria-hidden="true" />

    <HamchashotEmbed />

    <ArtBanner
      art="festival"
      alt="איור אמנותי: פסטיבל מתמטיקה צבעוני ברחבת שער יפו בירושלים — קהל לומדים סביב דודקהדרון ענק"
      fullImage
      width={1600}
      height={906}
    />

    <section class="section-block" data-reveal>
      <div class="wa-row">
        <a class="wa-join" href={whatsappCommunity.url} target="_blank" rel="noopener" aria-label="הצטרפות לקבוצת ה־WhatsApp של מורי המתמטיקה בחטיבת הביניים">
          <span class="btn btn-whatsapp" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </span>
          <span class="wa-text">הצטרפו לקבוצת הווטסאפ של המורים למתמטיקה בחט״ב</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-top { padding-block: 1rem 0; }
  .page-head { max-width: 760px; margin-block: 0.6rem 1.2rem; }
  .page-rest { padding-block: 0 2.2rem; }

  /* ===== מסך השלישים (הוראת יניב, 05/08/2026) =====
     אותה שפה של מסך בחירת החטיבה — רק בשלושה חלקים שווים */
  .split3 {
    position: relative;
    display: flex;
    inline-size: 100vw;
    margin-inline: calc(50% - 50vw);
    min-block-size: var(--split-h, 66svh);
    border-block: 1px solid var(--line);
    overflow: hidden;
  }

  .third {
    position: relative;
    flex: 1 1 33.333%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.8rem, 3.6vw, 3.2rem) clamp(1.1rem, 2.6vw, 2.4rem);
    text-decoration: none;
    isolation: isolate;
    transition: flex-basis 700ms var(--ease), filter 400ms var(--ease);
  }

  .third.is-navy {
    background:
      radial-gradient(120% 130% at 80% -10%, rgb(110 159 195 / 0.2) 0%, transparent 58%),
      radial-gradient(100% 120% at 10% 115%, rgb(176 141 62 / 0.22) 0%, transparent 62%),
      linear-gradient(200deg, #26324a 0%, var(--navy) 55%, #172033 100%);
    background-color: var(--navy);
    --tone-text: var(--paper);
    --tone-soft: rgb(251 249 245 / 0.82);
    --tone-cta: #e8c877;
    --tone-line: rgb(232 200 119 / 0.55);
  }

  .third.is-paper {
    background:
      radial-gradient(120% 130% at 20% -10%, rgb(31 41 61 / 0.07) 0%, transparent 58%),
      radial-gradient(100% 120% at 90% 115%, rgb(176 141 62 / 0.16) 0%, transparent 62%),
      linear-gradient(200deg, var(--paper) 0%, var(--paper-soft) 55%, var(--stone) 100%);
    background-color: var(--paper-soft);
    --tone-text: var(--navy);
    --tone-soft: var(--ink-soft);
    --tone-cta: var(--gold-deep);
    --tone-line: rgb(31 41 61 / 0.35);
  }

  .third-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    inline-size: min(24ch, 100%);
    color: var(--tone-text);
  }

  .third-mark {
    inline-size: 62px;
    block-size: 2px;
    background: linear-gradient(90deg, var(--tone-line), transparent);
    transition: inline-size 600ms var(--ease);
  }

  .third-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--tone-text);
  }

  .third-count { color: var(--tone-soft); font-size: clamp(0.92rem, 1.15vw, 1.04rem); line-height: 1.6; }

  .third-cta {
    display: inline-flex;
    margin-block-start: 0.5rem;
    color: var(--tone-cta);
    opacity: 0.85;
    transition: translate 380ms var(--ease), opacity 380ms var(--ease);
  }

  .third-cta svg { inline-size: clamp(44px, 4.4vw, 60px); block-size: auto; display: block; }

  .third:hover .third-cta,
  .third:focus-visible .third-cta { translate: -10px 0; opacity: 1; }
  .third:hover .third-mark,
  .third:focus-visible .third-mark { inline-size: 108px; }
  .third:focus-visible { outline: 3px solid var(--tone-cta); outline-offset: -8px; }

  /* הילת צבע השכבה — מה שמבדיל בין השלישים מעבר לניגוד נייבי/נייר */
  .third-glow {
    position: absolute;
    inset: -20%;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(45% 45% at 50% 50%, var(--grade) 0%, transparent 70%);
    transition: opacity 600ms var(--ease);
  }

  .third:hover .third-glow { opacity: 0.2; }

  .split-rule {
    position: absolute;
    z-index: 3;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 2px;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, var(--gold) 22%, #e8c877 50%, var(--gold) 78%, transparent 100%);
  }

  @media (min-width: 1000px) and (pointer: fine) {
    .split3:hover .third { flex-basis: 29%; filter: saturate(0.94); }
    .split3 .third:hover { flex-basis: 42%; filter: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .third { animation: third-in 900ms var(--ease) both; animation-delay: calc(var(--i) * 120ms); }
    .third-inner {
      animation: third-content-in 800ms var(--ease) both;
      animation-delay: calc(300ms + var(--i) * 120ms);
    }
    .split-rule { animation: rule-in 1100ms var(--ease) both; animation-delay: 160ms; }

    @keyframes third-in {
      from { clip-path: inset(0 0 100% 0); opacity: 0; }
      to { clip-path: inset(0 0 0 0); opacity: 1; }
    }
    @keyframes third-content-in {
      from { opacity: 0; translate: 0 22px; }
      to { opacity: 1; translate: none; }
    }
    @keyframes rule-in {
      from { scale: 1 0; opacity: 0; }
      to { scale: 1 1; opacity: 1; }
    }
  }

  /* ===== המפריד בין האזורים (הוראת יניב, 05/08/2026) ===== */
  .section-rule {
    inline-size: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(3rem, 7vw, 5.5rem);
    border: 0;
    block-size: 3px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--navy) 45%, transparent) 12%,
      var(--navy) 50%,
      color-mix(in srgb, var(--navy) 45%, transparent) 88%,
      transparent 100%
    );
    position: relative;
  }

  .section-rule::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    block-size: 1px;
    background: linear-gradient(90deg, transparent 20%, color-mix(in srgb, var(--gold) 55%, transparent) 50%, transparent 80%);
  }

  .wa-row { display: flex; justify-content: center; }

  .wa-join {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    border-radius: 999px;
  }

  .wa-text { font-weight: 700; color: var(--vacation); transition: color 300ms var(--ease); }

  .wa-join:hover .wa-text { color: #0a5230; }
  .wa-join:hover .btn-whatsapp {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 12px 26px -10px rgb(37 211 102 / 0.75);
  }
  .wa-join:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }

  .section-block { margin-block-start: clamp(2rem, 4vw, 2.8rem); }

  /* נייד: השלישים נערמים ונשארים גדולים ונוחים */
  @media (max-width: 860px) {
    .split3 { flex-direction: column; min-block-size: 0; }
    .third { flex: 1 1 auto; min-block-size: 190px; }

    .split-rule {
      inset-block: 0 auto;
      inset-inline: 0;
      inline-size: auto;
      block-size: 2px;
      background: linear-gradient(90deg, transparent 0%, var(--gold) 22%, #e8c877 50%, var(--gold) 78%, transparent 100%);
    }

    @media (prefers-reduced-motion: no-preference) {
      .split-rule { animation-name: rule-in-h; }
    }

    @keyframes rule-in-h {
      from { scale: 0 1; opacity: 0; }
      to { scale: 1 1; opacity: 1; }
    }
  }
</style>

<script>
  // גובה מדויק: השלישים ממלאים את מה שנשאר מהמסך, בלי שטח מת מתחתיהם
  const split = document.querySelector<HTMLElement>('.split3');
  if (split && matchMedia('(min-width: 861px)').matches) {
    const fit = () => {
      const top = split.getBoundingClientRect().top;
      split.style.setProperty('--split-h', `${Math.max(380, Math.round(innerHeight - top - 96))}px`);
    };
    fit();
    addEventListener('resize', fit, { passive: true });
    addEventListener('load', fit, { once: true });
    document.fonts?.ready.then(fit);
  }
</script>
