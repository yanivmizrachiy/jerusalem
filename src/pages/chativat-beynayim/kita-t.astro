---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ChoveretToc from '../../components/ChoveretToc.astro';
import { choveret } from '../../data/choveret';

const grade = choveret.find((g) => g.slug === 't')!;
---

<Base
  title="מתמטיקה לכיתה ט׳ — מחוז ירושלים"
  description="החוברת הדיגיטלית של כיתה ט׳: תוכן עניינים צבעוני — החוזר הרשמי, תכנון והוראה, הכנה ל-4 יח״ל והמעבר לחטיבה העליונה."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבת ביניים', href: '/chativat-beynayim/' },
        { label: 'כיתה ט׳' },
      ]}
    />

    <header class="page-head" data-reveal>
      <h1 class="big-title">{grade.title}</h1>
      <p class="lede">{grade.intro}</p>
    </header>

    <ChoveretToc slug="t" />
  </div>
</Base>

<style>
  .page { padding-block: 1.6rem 2.5rem; }
  .page-head { max-width: 660px; margin-block: 1.6rem 0.6rem; }
</style>
