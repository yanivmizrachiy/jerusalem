---
/**
 * בחירת החטיבה — כפתורי יוקרה קטנים, עדינים וצבעוניים (הוראת יניב,
 * 10/08/2026 — מחליפה את מסך חצי-חצי מ-05/08/2026): במקום שני חצאי-ענק,
 * סצנה בהירה ורגועה עם שני כרטיסי בחירה קומפקטיים בצבעי הפלטה המאושרת
 * (5.19) — מושכי לב, עדינים וחכמים.
 * נשמרים: בלי פירורי לחם (הצבע מתחיל מיד מתחת לניווט), h1 סמוי, כפתור
 * חזרה בתחתית, רצועת הווטסאפ ופס התחתית הכחול (7.24, 7.27, 7.29).
 */
import Base from '../../layouts/Base.astro';
import WhatsAppBand from '../../components/WhatsAppBand.astro';

const gates = [
  {
    href: '/chativat-beynayim/',
    title: 'חטיבת ביניים',
    range: 'כיתות ז׳–ט׳',
    accent: 'var(--sky)',
    accentDeep: '#155fa8',
  },
  {
    href: '/chativa-elyona/',
    title: 'חטיבה עליונה',
    range: 'כיתות י׳–י״ב',
    accent: 'var(--amber)',
    accentDeep: '#9a6a12',
  },
];
---

<Base
  title="בחירת החטיבה — מחוז ירושלים"
  description="הכניסה לאתר הדרכת המתמטיקה של מחוז ירושלים: חטיבת ביניים או חטיבה עליונה."
>
  <h1 class="visually-hidden">בחירת החטיבה</h1>

  <section class="gate-scene" aria-label="בחירת החטיבה">
    <span class="scene-thread" aria-hidden="true"></span>

    <div class="scene-inner">
      <p class="scene-kicker">הדרכת מתמטיקה · מחוז ירושלים</p>

      <div class="choice-row">
        {
          gates.map((g, i) => (
            <a
              class="choice-card"
              style={`--accent:${g.accent}; --accent-deep:${g.accentDeep}; --i:${i}`}
              href={g.href}
            >
              <span class="card-chip">{g.range}</span>
              <span class="card-title">{g.title}</span>
              <span class="card-cta" aria-hidden="true">
                <svg viewBox="0 0 44 16" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M43 8H2M9 1.5 2 8l7 6.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="card-wash" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>

    <a class="back-home" href="/">
      <svg viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M1 6h31M26 1l6 5-6 5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>חזרה לעמוד הראשי</span>
    </a>
  </section>

  <WhatsAppBand />
</Base>

<style>
  /* הצבע נוגע ברצועת הווטסאפ — בלי רצועה לבנה ביניהם */
  :global(main .gate-scene + .wa-band-wrap) { margin-block-start: 0; }

  /* מהניווט העליון ועד רצועת הווטסאפ — סצנה אחת בהירה, בלי שטח מת */
  .gate-scene {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: var(--split-h, calc(100svh - var(--header-h) - 65px));
    padding: clamp(1.4rem, 4vh, 3rem) clamp(1rem, 4vw, 2.5rem) clamp(5.5rem, 11vh, 7.5rem);
    background:
      radial-gradient(120% 90% at 85% 8%, color-mix(in srgb, var(--sky) 13%, transparent), transparent 55%),
      radial-gradient(110% 85% at 12% 92%, color-mix(in srgb, var(--amber) 14%, transparent), transparent 55%),
      radial-gradient(90% 70% at 50% 45%, color-mix(in srgb, var(--rose, #e7b9c4) 7%, transparent), transparent 60%),
      linear-gradient(180deg, #fffdf9, var(--paper));
    border-block-end: 1px solid var(--line);
    overflow: hidden;
  }

  /* חוט זהב עדין שנמתח בראש הסצנה */
  .scene-thread {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--gold) 65%, transparent), transparent);
  }

  .scene-inner { display: grid; justify-items: center; gap: clamp(1.3rem, 3.5vh, 2.2rem); }

  .scene-kicker {
    margin: 0;
    color: var(--gold-deep);
    font-weight: 850;
    font-size: clamp(0.82rem, 1.6vw, 0.95rem);
    letter-spacing: 0.14em;
  }

  .choice-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 1.8rem);
    inline-size: min(100%, 760px);
  }

  /* כרטיס בחירה — קטן, עדין, צבעוני; כולו קישור אחד */
  .choice-card {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.7rem;
    min-block-size: 200px;
    padding: clamp(1.4rem, 3.5vh, 2.2rem) 1.2rem;
    border-radius: 22px;
    text-decoration: none;
    background-color: #fffefc;
    background-image: linear-gradient(165deg, #fffefc, color-mix(in srgb, var(--accent) 9%, #fff));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 38%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.85),
      inset 0 -2px 0 0 color-mix(in srgb, var(--gold) 42%, transparent),
      0 20px 44px -30px rgb(42 37 32 / 0.5);
    /* כניסה עדינה ב-backwards: אחרי הריצה הכרטיס חוזר למצב הבסיס,
       כך שריחוף ההרמה (translate) אינו ננעל על ידי ה-animation */
    animation: card-in 700ms var(--ease) backwards;
    animation-delay: calc(140ms + var(--i) * 130ms);
    transition: translate 320ms var(--ease), box-shadow 320ms var(--ease);
  }
  @keyframes card-in { from { opacity: 0; translate: 0 14px; } }

  .card-chip {
    padding: 0.28rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 16%, #fff);
    color: var(--accent-deep);
    font-size: 0.82rem;
    font-weight: 850;
  }

  .card-title {
    color: var(--navy);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    font-weight: 700;
    line-height: 1.12;
  }

  .card-cta { color: var(--gold-deep); }
  .card-cta svg { inline-size: clamp(30px, 3.4vw, 40px); block-size: auto; transition: translate 320ms var(--ease); }

  .card-wash {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(75% 60% at 50% 110%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 70%);
    pointer-events: none;
  }

  .choice-card:hover {
    translate: 0 -5px;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 62%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.95),
      inset 0 -2px 0 0 var(--gold),
      0 30px 56px -30px rgb(42 37 32 / 0.55);
  }
  .choice-card:hover .card-cta svg { translate: -5px 0; }
  .choice-card:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }

  /* כפתור חזרה — גלולה עדינה על התפר התחתון */
  .back-home {
    position: absolute;
    inset-block-end: clamp(1.1rem, 3vh, 2rem);
    inset-inline: 0;
    margin-inline: auto;
    inline-size: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 44px;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    background: #fffefb;
    color: var(--navy);
    font-weight: 750;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--gold) 55%, transparent),
      0 12px 28px -18px rgb(42 37 32 / 0.45);
    transition: box-shadow 320ms var(--ease);
  }
  .back-home svg { inline-size: 26px; block-size: auto; color: var(--gold-deep); }
  .back-home:hover { box-shadow: 0 0 0 1px var(--gold), 0 16px 32px -16px rgb(42 37 32 / 0.5); }
  .back-home:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }

  /* נייד: הכרטיסים נערמים וגדולים ונוחים; אפס גלילה אופקית (19.32) */
  @media (max-width: 720px) {
    .choice-row { grid-template-columns: 1fr; inline-size: min(100%, 420px); }
    .choice-card { min-block-size: 168px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .choice-card { animation: none; opacity: 1; translate: none; transition: none; }
    .card-cta svg, .back-home { transition: none; }
  }
</style>

<script>
  // גובה מדויק: הצבע יורד עד תחתית המסך ונוגע ברצועת הווטסאפ (7.29)
  const scene = document.querySelector<HTMLElement>('.gate-scene');
  if (scene) {
    const fit = () => {
      const top = scene.getBoundingClientRect().top + window.scrollY;
      scene.style.setProperty('--split-h', `${Math.max(420, Math.round(innerHeight - top))}px`);
    };
    fit();
    addEventListener('resize', fit, { passive: true });
    addEventListener('load', fit, { once: true });
    document.fonts?.ready.then(fit);
  }
</script>
