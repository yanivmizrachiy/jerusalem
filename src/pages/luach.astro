---
/**
 * לוח שנה ירושלמי (RULES §23, הוראת יניב 03/08/2026):
 * לוח חודשי לתשפ״ז — תאריך עברי (גימטריה) ולועזי בכל תא, חופשות מוסדות
 * החינוך בירוק יוקרתי עם סיבת החופשה, פתיחת שנה״ל בזהב, וימים ירושלמיים
 * מיוחדים (שושן פורים, יום ירושלים). כל התאריכים מחושבים במדויק בלוח
 * העברי דרך Intl — אפס ניחושים. כפתור "לוח חופשות" פותח פירוט מלא:
 * מיום… עד יום… והלימודים יתחדשו ביום…
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<Base
  title="לוח שנה ירושלמי — מחוז ירושלים"
  description="לוח השנה של שנת הלימודים תשפ״ז: חופשות מוסדות החינוך, פתיחת השנה, מבחן תנופה, שושן פורים ויום ירושלים — עברי ולועזי, מחושב במדויק."
>
  <div class="container page">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'לוח שנה ירושלמי' }]} />

    <header class="luach-head" data-reveal>
      <picture>
        <source srcset="/media/art/tower-night.avif" type="image/avif" />
        <img
          class="tower"
          src="/media/art/tower-night.jpg"
          alt="מגדל דוד מואר בלילה, נשקף מבעד לקשת אבן"
          width="480"
          height="480"
          loading="eager"
          title="צילום: Micha Y Shamir, ויקישיתוף, CC BY-SA 4.0"
        />
      </picture>
      <div>
        <h1>לוח שנה ירושלמי</h1>
        <p class="luach-sub">מה צפוי? · שנת הלימודים תשפ״ז</p>
      </div>
    </header>

    <div class="luach-toolbar" data-reveal>
      <h2 class="month-title" id="month-title" aria-live="polite"></h2>
      <div class="luach-nav">
        <button class="btn nav-prev" id="prev-month" data-nav="prev" type="button">→ חודש קודם</button>
        <button class="btn nav-next" id="next-month" data-nav="next" type="button">חודש הבא ←</button>
      </div>
    </div>

    <div class="luach-legend" data-reveal>
      <button class="vac-btn" id="open-vacations" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="3" />
          <path d="M3 10h18M8 3v4M16 3v4" />
          <path d="M8 15h3M13 15h3M8 18h3" />
        </svg>
        לוח חופשות
      </button>
    </div>

    <div class="cal-wrap" data-reveal tabindex="0" role="region" aria-labelledby="month-title">
      <table class="cal" aria-labelledby="month-title">
        <thead>
          <tr id="cal-head"></tr>
        </thead>
        <tbody id="cal-body"></tbody>
      </table>
    </div>

    <div class="luach-nav-bottom" data-reveal>
      <button class="btn nav-prev" data-nav="prev" type="button">→ חודש קודם</button>
      <button class="btn nav-next" data-nav="next" type="button">חודש הבא ←</button>
    </div>

    <p class="luach-note" data-reveal>
      צילום מגדל דוד:
      <a href="https://commons.wikimedia.org/wiki/File:Tower_of_David_at_night.jpg" target="_blank" rel="noopener">Micha Y Shamir, ויקישיתוף (CC BY-SA 4.0)</a>
    </p>

    <dialog id="vac-dialog" class="vac-dialog" aria-labelledby="vac-title">
      <div class="vac-head">
        <h2 id="vac-title">לוח החופשות — שנה״ל התשפ״ז</h2>
        <button class="btn btn-ghost vac-close" id="vac-close" type="button" aria-label="סגירה">✕</button>
      </div>
      <ol id="vac-list" class="vac-list"></ol>
    </dialog>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }

  .luach-head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-block: 1.6rem 1.8rem;
  }

  .tower {
    inline-size: clamp(72px, 10vw, 104px);
    block-size: clamp(72px, 10vw, 104px);
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid transparent;
    background:
      linear-gradient(var(--paper), var(--paper)) padding-box,
      conic-gradient(from 210deg, var(--gold), #f3d68b, var(--gold-deep), var(--gold)) border-box;
    box-shadow: 0 10px 28px -10px rgb(176 141 62 / 0.55);
  }

  .luach-head h1 { margin: 0; }

  .luach-sub { margin: 0.2rem 0 0; color: var(--gold-deep); font-weight: 700; }

  .luach-toolbar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    margin-block-end: 1rem;
  }

  .month-title { margin: 0; font-size: clamp(1.2rem, 3vw, 1.7rem); text-align: center; }

  .luach-nav {
    display: flex;
    gap: 0.7rem;
    inline-size: min(100%, 480px);
  }

  /* זוג הניווט — בורדו וירוק כהה, בולטים (23.9, הוראת יניב 03/08/2026) */
  .luach-nav button,
  .luach-nav-bottom button {
    flex: 1;
    min-block-size: 50px;
    font-size: 1.02rem;
    font-weight: 700;
    color: #fff;
    border: 0;
  }

  .nav-prev {
    background: linear-gradient(180deg, #8e2740 0%, #7a1f33 100%);
    box-shadow: 0 8px 20px -10px rgb(122 31 51 / 0.7);
  }

  .nav-prev:hover { background: linear-gradient(180deg, #a02c48 0%, #8a2339 100%); }

  .nav-next {
    background: linear-gradient(180deg, #0f6b3a 0%, #0b5d31 100%);
    box-shadow: 0 8px 20px -10px rgb(11 93 49 / 0.7);
  }

  .nav-next:hover { background: linear-gradient(180deg, #127a43 0%, #0d6a38 100%); }

  .luach-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-block-end: 1.2rem;
  }

  /* כפתור לוח החופשות — נייבי עמוק, מסגרת זהב וזוהר עדין, בשפת האתר (23.5) */
  .vac-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 48px;
    padding: 0.65rem 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--gold);
    background: linear-gradient(180deg, #16273f 0%, #0e1c31 100%);
    color: #f3d68b;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    box-shadow:
      0 0 0 1px rgb(212 175 92 / 0.25),
      0 10px 26px -12px rgb(11 21 36 / 0.65);
    transition: transform 400ms var(--ease-lift), box-shadow 300ms var(--ease), color 300ms var(--ease);
  }

  .vac-btn:hover,
  .vac-btn:focus-visible {
    transform: translateY(-3px);
    color: #ffe9b3;
    box-shadow:
      0 0 0 1px rgb(212 175 92 / 0.5),
      0 0 22px rgb(212 175 92 / 0.4),
      0 16px 32px -14px rgb(11 21 36 / 0.7);
  }

  /* מסגרת הלוח — הנייבי-זהב של שפת האתר (23.12) */
  .cal-wrap {
    overflow-x: auto;
    background: #fff;
    border: 8px solid #0e1c31;
    outline: 1px solid #24406b;
    border-radius: calc(var(--radius-lg) + 6px);
    box-shadow:
      0 0 0 1px rgb(126 210 255 / 0.15),
      0 26px 60px -26px rgb(11 21 36 / 0.5);
  }

  .cal {
    inline-size: 100%;
    min-inline-size: 640px;
    table-layout: fixed;
    border-collapse: collapse;
    background: #fff;
  }

  td.is-mark .d-tag { color: var(--ink-soft); }

  /* ניווט תחתון — כפתורים גדולים, ברורים ומהירים (23.9) */
  .luach-nav-bottom {
    display: flex;
    gap: 0.8rem;
    margin-block-start: 1.1rem;
  }

  .luach-note { color: var(--ink-faint); font-size: 0.85rem; margin-block-start: 1rem; }
  .luach-note a { text-decoration: underline; }

  /* דיאלוג החופשות */
  .vac-dialog {
    inline-size: min(680px, calc(100vw - 2rem));
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.2rem, 3vw, 1.8rem);
    box-shadow: var(--shadow-lift);
  }

  .vac-dialog::backdrop { background: rgb(20 18 14 / 0.45); backdrop-filter: blur(3px); }

  .vac-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-block-end: 1rem; }
  .vac-head h2 { margin: 0; font-size: 1.3rem; }
  .vac-close { min-block-size: 40px; padding-inline: 0.9rem; }

  .vac-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }

</style>

<style is:global>
  /* תאי הלוח, כותרות הימים ופריטי דיאלוג החופשות נבנים ב-JS בזמן ריצה,
     ולכן style מגודר של Astro לא חל עליהם — החוקים כאן גלובליים במתכוון,
     מתוחמים ל-.cal ול-.vac-* בלבד (23.2). */
  .cal th {
    background: linear-gradient(180deg, #f7f1e3 0%, #efe6d0 100%);
    padding: 0.7rem 0.4rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--gold-deep);
    border: 1px solid var(--line);
    border-block-end: 2px solid color-mix(in srgb, var(--gold) 55%, var(--line));
  }

  .cal th:last-child {
    background: linear-gradient(180deg, #f7ecec 0%, #f0dfdf 100%);
    color: color-mix(in srgb, var(--rose) 70%, var(--ink));
  }

  .cal td {
    position: relative;
    border: 1px solid var(--line);
    vertical-align: top;
    padding: 0.5rem 0.55rem 0.45rem;
    height: clamp(88px, 11vh, 112px);
    inline-size: 14.28%;
    overflow: hidden;
    transition: background-color 250ms var(--ease);
  }

  .cal td.is-out { background: color-mix(in srgb, var(--paper-soft) 60%, #fff); color: var(--ink-faint); }
  .cal td.is-shabbat { background: color-mix(in srgb, var(--paper-soft) 85%, #fff); }
  .cal td:not(.is-out):hover { background: color-mix(in srgb, var(--gold) 6%, #fff); }

  .cal td.is-today {
    outline: 2px solid var(--gold);
    outline-offset: -2px;
    background: color-mix(in srgb, var(--gold) 10%, #fff);
  }

  .cal td.is-today .d-greg { color: var(--gold-deep); font-weight: 700; }

  .cal .d-greg {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.55rem, 2.8vw, 2rem);
    line-height: 1.05;
    color: var(--ink);
  }

  /* האות העברית — קטנה, באדום, בפינה השמאלית-תחתונה (23.2) */
  .cal .d-heb {
    position: absolute;
    left: 0.5rem;
    bottom: 0.4rem;
    font-size: 0.74rem;
    font-weight: 800;
    color: #b3262e;
  }

  .cal .d-tag {
    display: block;
    margin-block-start: 0.3rem;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .cal .d-reason { display: block; font-size: 0.66rem; font-weight: 600; color: #5c5346; }

  .cal td.is-vac { background: linear-gradient(180deg, #eaf6ef 0%, var(--vacation-soft) 100%); }
  .cal td.is-vac .d-greg { color: #0b5d31; }

  .cal td.is-open {
    background:
      radial-gradient(120% 100% at 50% 0%, rgb(212 175 92 / 0.5), transparent 65%),
      color-mix(in srgb, var(--gold) 28%, #fff);
    outline: 2px solid var(--gold);
    outline-offset: -2px;
    box-shadow:
      inset 0 0 22px rgb(212 175 92 / 0.55),
      0 0 18px rgb(212 175 92 / 0.5);
    animation: open-glow 2.6s ease-in-out infinite alternate;
  }

  .cal td.is-open .d-greg { color: var(--gold-deep); }

  .cal td.is-open .d-tag {
    color: var(--gold-deep);
    font-size: 0.78rem;
    text-shadow: 0 0 8px rgb(212 175 92 / 0.85);
  }

  @keyframes open-glow {
    from { box-shadow: inset 0 0 14px rgb(212 175 92 / 0.4), 0 0 10px rgb(212 175 92 / 0.35); }
    to { box-shadow: inset 0 0 26px rgb(212 175 92 / 0.7), 0 0 26px rgb(212 175 92 / 0.65); }
  }

  .cal td.is-jlm { background: color-mix(in srgb, var(--sky) 14%, #fff); }
  .cal td.is-jlm .d-tag { color: #2d5a7a; }

  .cal td.is-exam { background: color-mix(in srgb, var(--terracotta) 13%, #fff); }

  /* מבחן ארצי — הכיתוב בתוך עיגול (23.7, הוראת יניב 03/08/2026) */
  .cal .d-circ {
    position: absolute;
    left: 50%;
    top: 56%;
    transform: translate(-50%, -50%);
    inline-size: 4.9em;
    block-size: 4.9em;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 50%;
    border: 2px solid #8a3f28;
    background: rgb(255 255 255 / 0.82);
    color: #8a3f28;
    font-size: 0.66rem;
    font-weight: 800;
    line-height: 1.25;
    padding: 0.25rem;
  }
  .cal td.is-exam .d-tag { color: #8a3f28; }
  .cal td.is-exam .d-greg { color: #8a3f28; }

  .vac-list li {
    border-inline-start: 4px solid var(--vacation);
    background: var(--vacation-soft);
    border-radius: 10px;
    padding: 0.8rem 1rem;
  }

  .vac-name { font-weight: 800; color: #0b5d31; }
  .vac-list .g-red { color: #b3262e; font-weight: 700; font-variant-numeric: tabular-nums; }
  .vac-range { display: block; font-size: 0.92rem; color: var(--ink); margin-block-start: 0.2rem; }
  .vac-resume { display: block; font-size: 0.86rem; color: var(--ink-soft); margin-block-start: 0.15rem; }

  @media (max-width: 700px) {
    .cal td { height: 84px; padding: 0.3rem 0.35rem; }
    .cal .d-tag { font-size: 0.6rem; }
    .cal .d-reason { font-size: 0.56rem; }
    .cal .vac-banner-main { font-size: 0.56rem; letter-spacing: 0.08em; }
    .cal .vac-banner-sub { font-size: 0.52rem; letter-spacing: 0.04em; }
    .cal .rc-banner { font-size: 0.54rem; letter-spacing: 0.04em; }
  }

  /* ראש חודש — כיתוב צהוב-כהה אחד על פני הרצף, בלי עיגולים (23.10) */
  .cal td.rc-run-start { overflow: visible; }

  .cal td.is-rc .d-heb { bottom: auto; top: 0.45rem; }

  .cal .rc-banner {
    position: absolute;
    inset-inline-start: 4px;
    inline-size: calc(var(--run) * 100% - 8px);
    bottom: 4px;
    z-index: 1;
    text-align: center;
    padding: 0.18rem 0.3rem;
    border-radius: 8px;
    background: #fdf3d1;
    box-shadow: inset 0 0 0 1.5px #a8790f;
    color: #7a5f13;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  /* רק ב-1 בספטמבר — "בספטמבר" בקטן ליד המספר (23.11) */
  .cal .d-gm {
    font-size: 0.55em;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* באנר חופשה אחד על פני הרצף — ממורכז, אותיות מרווחות (23.3) */
  .cal td.vac-run-start { overflow: visible; }

  .cal .vac-banner {
    position: absolute;
    inset-inline-start: 4px;
    inline-size: calc(var(--run) * 100% - 8px);
    bottom: 4px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.05rem;
    text-align: center;
    padding: 0.22rem 0.25rem;
    border-radius: 8px;
    background: #d3ecdd;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--vacation) 34%, transparent);
    pointer-events: none;
  }

  .cal .vac-banner-main {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #0b5d31;
    line-height: 1.25;
  }

  .cal .vac-banner-sub {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: #0b5d31;
    line-height: 1.2;
  }

  /* בתא חופשה האות האדומה עולה לפינה העליונה-שמאלית — הרצועה למטה (23.3) */
  .cal td.is-vac .d-heb {
    bottom: auto;
    top: 0.45rem;
  }
</style>

<script>
  // ===== ליבת הלוח העברי — Intl בלבד, מדויק =====
  const TZ = 'Asia/Jerusalem';
  const heNames = new Intl.DateTimeFormat('he-u-ca-hebrew', { timeZone: TZ, month: 'long' });
  const heNums = new Intl.DateTimeFormat('en-u-ca-hebrew', { timeZone: TZ, day: 'numeric', year: 'numeric' });
  const wdFmt = new Intl.DateTimeFormat('he', { timeZone: TZ, weekday: 'long' });

  const G: readonly (readonly [number, string])[] = [
    [400, 'ת'], [300, 'ש'], [200, 'ר'], [100, 'ק'], [90, 'צ'], [80, 'פ'], [70, 'ע'],
    [60, 'ס'], [50, 'נ'], [40, 'מ'], [30, 'ל'], [20, 'כ'], [10, 'י'], [9, 'ט'],
    [8, 'ח'], [7, 'ז'], [6, 'ו'], [5, 'ה'], [4, 'ד'], [3, 'ג'], [2, 'ב'], [1, 'א'],
  ];
  const gem = (n: number): string => {
    let s = '', r = n;
    while (r > 0) {
      if (r === 15) { s += 'טו'; break; }
      if (r === 16) { s += 'טז'; break; }
      const p = G.find(([v]) => v <= r)!; s += p[1]; r -= p[0];
    }
    return s.length === 1 ? s + '׳' : s.slice(0, -1) + '״' + s.slice(-1);
  };

  interface HebInfo { hd: number; hm: string; hy: number; }
  const hebOf = (d: Date): HebInfo => {
    const m = heNames.formatToParts(d).find((p) => p.type === 'month')!.value;
    const parts = Object.fromEntries(heNums.formatToParts(d).map((p) => [p.type, p.value]));
    return { hd: Number(parts.day), hm: m, hy: Number(parts.year) };
  };

  // אינדקס שנת תשפ״ז: תאריך עברי → Date (סריקה חד-פעמית, מדויקת)
  const DAY = 86_400_000;
  const START = Date.UTC(2026, 7, 1);
  const END = Date.UTC(2027, 7, 31);
  const hebIndex = new Map<string, number>();
  const hebByTime = new Map<number, HebInfo>();
  for (let t = START; t <= END; t += DAY) {
    const d = new Date(t);
    const h = hebOf(d);
    hebByTime.set(t, h);
    hebIndex.set(`${h.hm}|${h.hd}`, t);
  }
  const hebToTime = (hm: string, hd: number): number | undefined => {
    if (hebIndex.has(`${hm}|${hd}`)) return hebIndex.get(`${hm}|${hd}`);
    for (const [k, v] of hebIndex) if (k.startsWith(hm.replace('׳', '')) && k.endsWith(`|${hd}`)) return v;
    return undefined;
  };
  const adarB = [...hebIndex.keys()].find((k) => k.includes('אדר ב'))?.split('|')[0] ?? 'אדר ב׳';

  // ===== חופשות מוסדות החינוך (ימי החג הקבועים) =====
  interface Vac { name: string; startT: number; endT: number; jlm?: boolean; }
  const between = (hm1: string, d1: number, hm2: string, d2: number) =>
    [hebToTime(hm1, d1)!, hebToTime(hm2, d2)!] as const;

  const hanukkaStart = hebToTime('כסלו', 25)!;
  const atzmaut = (() => {
    let t = hebToTime('אייר', 5)!;
    const wd = new Date(t).getUTCDay(); // 5=שישי 6=שבת 1=שני
    if (wd === 5) t -= DAY;
    else if (wd === 6) t -= 2 * DAY;
    else if (wd === 1) t += DAY;
    return t;
  })();

  const vacations: Vac[] = [
    { name: 'ראש השנה', startT: hebToTime('אלול', 29)!, endT: hebToTime('תשרי', 2)! },
    { name: 'יום כיפור', startT: hebToTime('תשרי', 9)!, endT: hebToTime('תשרי', 10)! },
    { name: 'סוכות ושמחת תורה', startT: hebToTime('תשרי', 14)!, endT: hebToTime('תשרי', 22)! },
    { name: 'חנוכה', startT: hanukkaStart, endT: hanukkaStart + 7 * DAY },
    { name: 'פורים', startT: hebToTime(adarB, 14)!, endT: hebToTime(adarB, 14)! },
    { name: 'שושן פורים', startT: hebToTime(adarB, 15)!, endT: hebToTime(adarB, 15)!, jlm: true },
    { name: 'פסח', startT: hebToTime('ניסן', 14)!, endT: hebToTime('ניסן', 21)! },
    { name: 'יום העצמאות', startT: atzmaut, endT: atzmaut },
    { name: 'ל״ג בעומר', startT: hebToTime('אייר', 18)!, endT: hebToTime('אייר', 18)! },
    { name: 'שבועות', startT: hebToTime('סיוון', 5)!, endT: hebToTime('סיוון', 6)! },
  ];

  const specials = new Map<number, { cls: string; tag: string; reason?: string; circle?: boolean }>();
  specials.set(Date.UTC(2026, 8, 1), { cls: 'is-open', tag: 'פתיחת שנת הלימודים', reason: 'תשפ״ז — בהצלחה!' });
  specials.set(Date.UTC(2026, 8, 16), { cls: 'is-mark', tag: 'מפגש מובילי קהילה ראשון' });
  specials.set(Date.UTC(2026, 10, 25), { cls: 'is-exam', tag: 'מבחן תנופה ט׳', circle: true });
  specials.set(hebToTime('ניסן', 27) ?? 0, { cls: 'is-mark', tag: 'יום הזיכרון לשואה ולגבורה' });
  specials.set(atzmaut - DAY, { cls: 'is-mark', tag: 'יום הזיכרון' });
  specials.set(hebToTime('אייר', 28) ?? 0, { cls: 'is-jlm', tag: 'יום ירושלים', reason: 'החג של העיר שלנו' });
  specials.set(Date.UTC(2027, 5, 20), { cls: 'is-mark', tag: 'סיום שנה״ל בחט״ע' });
  specials.set(Date.UTC(2027, 5, 30), { cls: 'is-mark', tag: 'סיום שנת הלימודים' });

  const vacOf = (t: number): Vac | undefined => vacations.find((v) => t >= v.startT && t <= v.endT);

  // ===== רינדור הלוח =====
  const head = document.getElementById('cal-head')!;
  const body = document.getElementById('cal-body')!;
  const title = document.getElementById('month-title')!;
  ['ראשון', 'שני', 'שלישי', 'רביעי', 'חמישי', 'שישי', 'שבת'].forEach((w) => {
    const th = document.createElement('th'); th.textContent = w; head.appendChild(th);
  });

  const todayT = (() => {
    const p = Object.fromEntries(
      new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' })
        .formatToParts(new Date()).map((x) => [x.type, x.value])
    );
    return Date.UTC(Number(p.year), Number(p.month) - 1, Number(p.day));
  })();

  let ym = todayT >= START && todayT <= END
    ? [new Date(todayT).getUTCFullYear(), new Date(todayT).getUTCMonth()]
    : [2026, 8];

  const monthName = new Intl.DateTimeFormat('he', { month: 'long', year: 'numeric', timeZone: 'UTC' });

  const render = () => {
    const [y, m] = ym;
    const first = Date.UTC(y, m, 1);
    const last = Date.UTC(y, m + 1, 0);
    const hFirst = hebByTime.get(first)!;
    const hLast = hebByTime.get(last)!;
    title.textContent = `${monthName.format(new Date(first))} · ${hFirst.hm}–${hLast.hm} ${gem(hLast.hy % 1000)}`;

    body.innerHTML = '';
    let t = first - new Date(first).getUTCDay() * DAY;
    for (let w = 0; w < 6; w++) {
      const tr = document.createElement('tr');
      for (let i = 0; i < 7; i++, t += DAY) {
        const td = document.createElement('td');
        const d = new Date(t);
        const inMonth = d.getUTCMonth() === m;
        if (!inMonth) td.classList.add('is-out');
        if (d.getUTCDay() === 6) td.classList.add('is-shabbat');
        if (t === todayT) td.classList.add('is-today');

        const h = hebByTime.get(t);
        const gm = t === Date.UTC(2026, 8, 1) ? ' <small class="d-gm">בספטמבר</small>' : '';
        td.innerHTML = `<span class="d-greg">${d.getUTCDate()}${gm}</span>` +
          (h ? `<span class="d-heb">${gem(h.hd)}</span>` : '');

        const vac = vacOf(t);
        if (vac) td.classList.add('is-vac');
        const sp = specials.get(t);
        if (sp && !vac) {
          td.classList.add(sp.cls);
          td.innerHTML += sp.circle
            ? `<span class="d-circ">${sp.tag}</span>`
            : `<span class="d-tag">${sp.tag}</span>` + (sp.reason ? `<span class="d-reason">${sp.reason}</span>` : '');
        }
        tr.appendChild(td);
      }
      // כיתוב אחד ממורכז לכל רצף — חופשות (23.3) וראש חודש (23.10)
      const weekStart = t - 7 * DAY;
      const rcLabelOf = (tt: number): string | undefined => {
        const hh = hebByTime.get(tt);
        if (!hh || vacOf(tt)) return undefined;
        if (hh.hd === 1) return `ראש חודש ${hh.hm}`;
        if (hh.hd === 30) {
          const nx = hebByTime.get(tt + DAY);
          return nx ? `ראש חודש ${nx.hm}` : undefined;
        }
        return undefined;
      };
      for (let i = 0; i < 7; ) {
        const lab = rcLabelOf(weekStart + i * DAY);
        if (!lab) { i++; continue; }
        let n = 1;
        while (i + n < 7 && rcLabelOf(weekStart + (i + n) * DAY) === lab) n++;
        for (let k = i; k < i + n; k++) tr.children[k].classList.add('is-rc');
        const cell = tr.children[i] as HTMLElement;
        cell.classList.add('rc-run-start');
        cell.innerHTML += `<span class="rc-banner" style="--run:${n}">${lab}</span>`;
        i += n;
      }
      for (let i = 0; i < 7; ) {
        const v = vacOf(weekStart + i * DAY);
        if (!v) { i++; continue; }
        let n = 1;
        while (i + n < 7 && vacOf(weekStart + (i + n) * DAY) === v) n++;
        const cell = tr.children[i] as HTMLElement;
        cell.classList.add('vac-run-start');
        const tag = v.jlm ? 'חופשה בירושלים' : 'חופשה במוסדות החינוך';
        cell.innerHTML += `<span class="vac-banner" style="--run:${n}"><span class="vac-banner-main">${tag}</span><span class="vac-banner-sub">${v.name}</span></span>`;
        i += n;
      }
      body.appendChild(tr);
      if (t > last && new Date(t).getUTCDay() === 0) break;
    }
  };

  const goPrev = () => {
    if (Date.UTC(ym[0], ym[1], 1) > START) { ym = ym[1] === 0 ? [ym[0] - 1, 11] : [ym[0], ym[1] - 1]; render(); }
  };
  const goNext = () => {
    if (Date.UTC(ym[0], ym[1] + 1, 1) < END) { ym = ym[1] === 11 ? [ym[0] + 1, 0] : [ym[0], ym[1] + 1]; render(); }
  };
  document.querySelectorAll('[data-nav="prev"]').forEach((b) => b.addEventListener('click', goPrev));
  document.querySelectorAll('[data-nav="next"]').forEach((b) => b.addEventListener('click', goNext));

  render();

  // ===== דיאלוג לוח החופשות =====
  const dialog = document.getElementById('vac-dialog') as HTMLDialogElement;
  const list = document.getElementById('vac-list')!;

  const fmtDay = (t: number) => {
    const d = new Date(t);
    const h = hebByTime.get(t)!;
    const g = `${d.getUTCDate()}/${d.getUTCMonth() + 1}/${String(d.getUTCFullYear()).slice(-2)}`;
    return `${wdFmt.format(d)}, ${gem(h.hd)} ב${h.hm} (<span class="g-red">${g}</span>)`;
  };

  const resumeAfter = (endT: number) => {
    let t = endT + DAY;
    if (new Date(t).getUTCDay() === 6) t += DAY; // שבת → ראשון
    return t;
  };

  list.innerHTML = vacations
    .sort((a, b) => a.startT - b.startT)
    .map((v) => {
      const single = v.startT === v.endT;
      const range = single
        ? `ב${fmtDay(v.startT)}`
        : `מ${fmtDay(v.startT)} עד ${fmtDay(v.endT)}`;
      return `<li><span class="vac-name">${v.name}${v.jlm ? ' — חופשה בירושלים' : ''}</span>
        <span class="vac-range">${range}</span>
        <span class="vac-resume">הלימודים יתחדשו ב${fmtDay(resumeAfter(v.endT))}</span></li>`;
    })
    .join('');

  document.getElementById('open-vacations')!.addEventListener('click', () => dialog.showModal());
  document.getElementById('vac-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
