---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArtBanner from '../components/ArtBanner.astro';
import MafmarPresentation from '../components/MafmarPresentation.astro';
import MafmarPresentationEnhancer from '../components/MafmarPresentationEnhancer.astro';
import { MAFMAR_LOCAL, MAFMAR_VIEW, MAFMAR_PAGE_W, MAFMAR_PAGE_H } from '../data/mafmar';
import { feedDated, feedStanding } from '../data/hodaot';
---

<Base
  title="הודעות שוטפות — מחוז ירושלים"
  description="הודעות שוטפות של הדרכת המתמטיקה במחוז ירושלים, כולל חוזר מפמ״ר תשפ״ז והמצגת המלווה, עדכוני מדיניות, הערכה, תוכניות לימודים ופיתוח מקצועי."
>
  <div class="container page">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'הודעות שוטפות' }]} />

    <header class="page-head" data-reveal>
      <p class="eyebrow">מה קורה במחוז</p>
      <h1>הודעות שוטפות</h1>
      <p class="lede">
        חוזר מפמ״ר תשפ״ז והמצגת המלווה במקום אחד, ובהמשך עדכוני הדרכת המתמטיקה של המחוז לפי תאריך וקטגוריה.
      </p>
    </header>

    <section class="mafmar-feature" aria-labelledby="mafmar-feature-title" data-reveal>
      <div class="feature-head">
        <div>
          <p class="eyebrow">מידע מרכזי לשנת תשפ״ז</p>
          <h2 id="mafmar-feature-title">חוזר מפמ״ר — מסמך ומצגת</h2>
          <p>אפשר לעיין בחוזר הרשמי או לדפדף במצגת המסכמת את 23 המקטעים לפי ארבעת חלקי החוזר.</p>
        </div>
        <div class="feature-actions">
          <a class="btn btn-primary" href="/hozer-mafmar/">חוזר המפמ״ר ←</a>
          <a class="btn btn-ghost" href="/hozer-mafmar-presentation/">חוזר המפמ״ר במצגת ←</a>
        </div>
      </div>

      <div class="mafmar-embeds">
        <article class="embed-card circular-card">
          <div class="embed-card-head">
            <div>
              <span class="embed-tag">המסמך המלא</span>
              <h3>חוזר מפמ״ר תשפ״ז</h3>
            </div>
            <a href="/hozer-mafmar/">לצפייה מלאה ←</a>
          </div>
          <div class="pdf-shell embed-frame" style={`--pw:${MAFMAR_PAGE_W}; --ph:${MAFMAR_PAGE_H}`}>
            <iframe
              src={`${MAFMAR_LOCAL}#page=1&${MAFMAR_VIEW}`}
              title="חוזר מפמ״ר תשפ״ז — המסמך המלא"
              loading="lazy"
            ></iframe>
          </div>
        </article>

        <article class="embed-card presentation-card">
          <div class="embed-card-head">
            <div>
              <span class="embed-tag">מצגת מלווה</span>
              <h3>חוזר המפמ״ר במצגת</h3>
            </div>
            <a href="/hozer-mafmar-presentation/">למצגת המלאה ←</a>
          </div>
          <MafmarPresentation compact />
        </article>
      </div>
    </section>

    <MafmarPresentationEnhancer />

    <ArtBanner
      art="city"
      alt="ציור שמן צבעוני: הרחבה שליד מגדל דוד הומה לומדים, לוחות משוואות וכרזת Math is Everywhere"
      position="center 60%"
    />

    <section class="feed-block" aria-labelledby="dated-title">
      <h2 id="dated-title" data-reveal>עדכוני תשפ״ז</h2>
      <ol class="feed">
        {
          feedDated.map((f, i) => (
            <li
              class="card card-accent feed-item"
              style={`--card-accent:${f.accent}; --reveal-delay:${i * 90}ms`}
              data-reveal
            >
              <div class="feed-meta">
                <time class="feed-date">{f.date}</time>
                <span class="feed-cat" style={`--cat:${f.accent}`}>{f.category}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
              {f.external ? (
                <a class="btn btn-ghost" href={f.href} target="_blank" rel="noopener">
                  לפרטים ↗
                </a>
              ) : (
                <a class="btn btn-ghost" href={f.href}>
                  לפרטים ←
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="feed-block" aria-labelledby="standing-title">
      <h2 id="standing-title" data-reveal>הודעות והנחיות עומדות</h2>
      <p class="standing-note" data-reveal>הודעות והנחיות קבועות של המחוז.</p>
      <ol class="feed">
        {
          feedStanding.map((f, i) => (
            <li
              class="card card-accent feed-item"
              style={`--card-accent:${f.accent}; --reveal-delay:${i * 80}ms`}
              data-reveal
            >
              <div class="feed-meta">
                <span class="feed-cat" style={`--cat:${f.accent}`}>{f.category}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
              {f.external ? (
                <a class="btn btn-ghost" href={f.href} target="_blank" rel="noopener">
                  לפרטים ↗
                </a>
              ) : (
                <a class="btn btn-ghost" href={f.href}>
                  לפרטים ←
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 720px; margin-block: 1.6rem 2.2rem; }

  .mafmar-feature {
    margin-block: 0 clamp(2.8rem, 6vw, 4.5rem);
    padding: clamp(1.2rem, 3vw, 2.2rem);
    border: 1px solid color-mix(in srgb, var(--gold) 42%, var(--line));
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 90% 8%, rgb(110 159 195 / 0.13), transparent 28%),
      radial-gradient(circle at 10% 92%, rgb(176 141 62 / 0.12), transparent 28%),
      #fff;
    box-shadow: var(--shadow-soft);
  }

  .feature-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.2rem;
    margin-block-end: clamp(1.3rem, 3vw, 2rem);
  }

  .feature-head h2 { margin: 0.1rem 0 0; color: var(--navy); font-size: clamp(1.55rem, 3vw, 2.25rem); }
  .feature-head p:not(.eyebrow) { max-width: 760px; margin: 0.55rem 0 0; color: var(--ink-soft); }

  .feature-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; flex: 0 0 auto; }

  .mafmar-embeds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.6vw, 2rem);
    align-items: start;
  }

  .embed-card {
    min-width: 0;
    padding: clamp(0.8rem, 1.6vw, 1.15rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgb(251 249 245 / 0.72);
  }

  .embed-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-block-end: 0.8rem;
  }

  .embed-card-head h3 { margin: 0.15rem 0 0; color: var(--navy); font-size: 1.05rem; }
  .embed-card-head a { color: var(--gold-deep); font-size: 0.85rem; font-weight: 900; }

  .embed-tag {
    color: var(--ink-faint);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .pdf-shell {
    aspect-ratio: var(--pw) / var(--ph);
    block-size: auto;
    min-height: 480px;
    overflow: hidden;
  }

  .pdf-shell iframe { background: #fff; }

  .feed-block { margin-block-end: clamp(2.4rem, 5vw, 3.6rem); }
  .feed-block h2 { margin-block-end: 0.6rem; }

  .standing-note { color: var(--ink-faint); font-size: 0.9rem; margin-block-end: 1.2rem; }

  .feed {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: clamp(1rem, 2.2vw, 1.4rem);
  }

  .feed-item { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem 1.4rem 1.3rem; }

  .feed-meta { display: flex; align-items: center; gap: 0.7rem; }

  .feed-date { font-weight: 800; font-size: 0.85rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }

  .feed-cat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    background: color-mix(in srgb, var(--cat) 16%, #fff);
    border: 1px solid color-mix(in srgb, var(--cat) 45%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
  }

  .feed-item h3 { margin: 0; font-size: 1.15rem; }
  .feed-item p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; flex: 1; }
  .feed-item .btn { align-self: flex-start; margin-block-start: 0.4rem; }

  @media (max-width: 1050px) {
    .feature-head { align-items: start; flex-direction: column; }
    .mafmar-embeds { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .mafmar-feature { padding: 0.9rem; }
    .feature-actions { inline-size: 100%; }
    .feature-actions .btn { flex: 1 1 100%; justify-content: center; }
    .pdf-shell { min-height: clamp(420px, 120vw, 640px); }
  }
</style>