---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArtBanner from '../components/ArtBanner.astro';
import { feedDated, feedStanding } from '../data/hodaot';
---

<Base
  title="הודעות ועדכונים — מחוז ירושלים"
  description="פיד ההודעות של הדרכת המתמטיקה במחוז ירושלים: עדכוני מדיניות, הערכה, תוכניות לימודים, פיתוח מקצועי וקהילה — כל קישור בדוק."
>
  <div class="container page">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'הודעות ועדכונים' }]} />

    <header class="page-head" data-reveal>
      <p class="eyebrow">מה קורה במחוז</p>
      <h1>הודעות ועדכונים</h1>
      <p class="lede">
        עדכוני הדרכת המתמטיקה של המחוז — לפי תאריך וקטגוריה.
      </p>
    </header>

    <ArtBanner
      art="city"
      alt="ציור שמן צבעוני: הרחבה שליד מגדל דוד הומה לומדים, לוחות משוואות וכרזת Math is Everywhere"
      position="center 60%"
    />

    <section class="feed-block" aria-labelledby="dated-title">
      <h2 id="dated-title" data-reveal>עדכוני תשפ״ז</h2>
      <ol class="feed">
        {
          feedDated.map((f, i) => (
            <li
              class="card card-accent feed-item"
              style={`--card-accent:${f.accent}; --reveal-delay:${i * 90}ms`}
              data-reveal
            >
              <div class="feed-meta">
                <time class="feed-date">{f.date}</time>
                <span class="feed-cat" style={`--cat:${f.accent}`}>{f.category}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
              {f.external ? (
                <a class="btn btn-ghost" href={f.href} target="_blank" rel="noopener">
                  לפרטים ↗
                </a>
              ) : (
                <a class="btn btn-ghost" href={f.href}>
                  לפרטים ←
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="feed-block" aria-labelledby="standing-title">
      <h2 id="standing-title" data-reveal>הודעות והנחיות עומדות</h2>
      <p class="standing-note" data-reveal>הודעות והנחיות קבועות של המחוז.</p>
      <ol class="feed">
        {
          feedStanding.map((f, i) => (
            <li
              class="card card-accent feed-item"
              style={`--card-accent:${f.accent}; --reveal-delay:${i * 80}ms`}
              data-reveal
            >
              <div class="feed-meta">
                <span class="feed-cat" style={`--cat:${f.accent}`}>{f.category}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
              {f.external ? (
                <a class="btn btn-ghost" href={f.href} target="_blank" rel="noopener">
                  לפרטים ↗
                </a>
              ) : (
                <a class="btn btn-ghost" href={f.href}>
                  לפרטים ←
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 640px; margin-block: 1.6rem 2.2rem; }

  .feed-block { margin-block-end: clamp(2.4rem, 5vw, 3.6rem); }
  .feed-block h2 { margin-block-end: 0.6rem; }

  .standing-note { color: var(--ink-faint); font-size: 0.9rem; margin-block-end: 1.2rem; }

  .feed {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: clamp(1rem, 2.2vw, 1.4rem);
  }

  .feed-item { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem 1.4rem 1.3rem; }

  .feed-meta { display: flex; align-items: center; gap: 0.7rem; }

  .feed-date { font-weight: 800; font-size: 0.85rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }

  .feed-cat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    background: color-mix(in srgb, var(--cat) 16%, #fff);
    border: 1px solid color-mix(in srgb, var(--cat) 45%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
  }

  .feed-item h3 { margin: 0; font-size: 1.15rem; }
  .feed-item p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; flex: 1; }
  .feed-item .btn { align-self: flex-start; margin-block-start: 0.4rem; }
</style>
