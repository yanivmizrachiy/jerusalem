---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MafmarRange from '../../components/MafmarRange.astro';
---

<Base
  title="5 יח״ל — חטיבה עליונה — מחוז ירושלים"
  description="רמת 5 יח״ל בתשפ״ז: שליטה טכנית לצד חשיבה והנמקה, שאלון 35571 במספור החדש (1–4 קצרות, 5–11 משולבות) — הדגשים מחוזר המפמ״ר."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבה עליונה', href: '/chativa-elyona/' },
        { label: '5 יח״ל' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">חטיבה עליונה · תשפ״ז</p>
      <h1>5 יח״ל</h1>
      <p class="lede">
        שליטה טכנית לצד קישוריות, הנמקה ופתרון בעיות מורכבות — עם דגש על קדם־אנליזה.
        בשאלון 35571 עודכן מספור השאלות: 1–4 בפרק הקצרות, 5–11 בפרק המשולב. ספרי הלימוד
        אינם מוחלפים בשלב זה.
      </p>
    </header>

    <div data-reveal>
      <MafmarRange sectionId="MAF-14" accent="var(--terracotta)" />
    </div>

    <section class="section-block" data-reveal>
      <h2>עוד בחוזר הרלוונטי לרמה</h2>
      <div class="chip-links">
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-16">נוסחאון 5 יח״ל</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-21">סמסטר ראשון כבר בתיכון</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-19">רשת ביטחון 5→4</a>
      </div>
    </section>

    <nav class="pager-nav" aria-label="ניווט בין רמות">
      <a class="btn btn-ghost" href="/chativa-elyona/4-yahal/">→ הרמה הקודמת: 4 יח״ל</a>
      <a class="btn btn-ghost" href="/chativa-elyona/">חזרה לחטיבה העליונה</a>
      <span></span>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 660px; margin-block: 1.6rem 2rem; }
  .section-block { margin-block-start: clamp(2.4rem, 5vw, 3.4rem); }
  .section-block h2 { margin-block-end: 1.2rem; }
  .chip-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pager-nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; margin-block-start: clamp(2.2rem, 5vw, 3rem); }
</style>
