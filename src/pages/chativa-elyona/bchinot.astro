---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MafmarRange from '../../components/MafmarRange.astro';
---

<Base
  title="בחינות ומידע מנהלי — חטיבה עליונה — מחוז ירושלים"
  description="בגרויות תשפ״ז: עקרונות בדיקה וטוהר בחינות, חוקי מענה, נוסחאוני התוכנית החדשה, רשת ביטחון, מועדים, גמולים וצירופים — ישירות מחוזר המפמ״ר."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבה עליונה', href: '/chativa-elyona/' },
        { label: 'בחינות ומידע מנהלי' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">חטיבה עליונה · תשפ״ז</p>
      <h1>בחינות בגרות ומידע מנהלי</h1>
      <p class="lede">
        ארבעת המקטעים הרשמיים למנהלת הבגרות: בדיקה וטוהר בחינות וחוקי מענה, נוסחאונים,
        רשת ביטחון, ומועדים־גמולים־צירופים. חשוב: הקלות תשפ״ו חלות רק עד מועד חורף
        תשפ״ז.
      </p>
    </header>

    <div class="stack" data-reveal>
      <MafmarRange sectionId="MAF-15" accent="var(--terracotta)" />
    </div>
    <div class="stack" data-reveal>
      <MafmarRange sectionId="MAF-16" accent="var(--gold)" />
    </div>
    <div class="stack" data-reveal>
      <MafmarRange sectionId="MAF-19" accent="var(--olive)" />
    </div>
    <div class="stack" data-reveal>
      <MafmarRange sectionId="MAF-20" accent="var(--sky)" />
    </div>

    <section class="admin-links" data-reveal>
      <h2>המסמכים הרשמיים מתוך החוזר — נחלצו מקישורי ה־PDF ונבדקו ב־3/8/26</h2>
      <div class="chip-links">
        <a class="btn btn-primary" href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/mafmar/exams-time.pdf" target="_blank" rel="noopener" title="מקור: החוזר, עמ׳ 14">חוקי מענה, מבנה וזמני הבחינות ↗</a>
        <a class="btn btn-primary" href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/mafmar/Topics-not-be-taught-in-Tashpaz.pdf" target="_blank" rel="noopener" title="מקור: החוזר, עמ׳ 14">הנושאים שלא יילמדו בתשפ״ז ↗</a>
        <a class="btn btn-ghost" href="https://meyda.education.gov.il/files/Exams/SafetyNet4or5GradeMath.pdf" target="_blank" rel="noopener" title="מקור: החוזר, עמ׳ 15">רשת ביטחון — המסמך הרשמי ↗</a>
        <a class="btn btn-ghost" href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/ekronot-anhayot-bdika-bagrut.pdf" target="_blank" rel="noopener" title="מקור: החוזר, עמ׳ 13">עקרונות והנחיות בדיקת בגרות ↗</a>
        <a class="btn btn-ghost" href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/tashpav/PossibleCombinationsMathExams2025.pdf" target="_blank" rel="noopener" title="מקור: החוזר, עמ׳ 15">טבלת הצירופים המעודכנת ↗</a>
        <a class="btn btn-ghost" href="https://students.education.gov.il/matriculation-exams/solutions" target="_blank" rel="noopener" title="מקור: החוזר, עמ׳ 15">בחינות שנים קודמות עם פתרונות ↗</a>
        <a class="btn btn-ghost" href="https://meyda.education.gov.il/files/Sherut/hozershe.pdf" target="_blank" rel="noopener">גמולי בגרות ↗</a>
        <a class="btn btn-ghost" href="https://meyda.education.gov.il/bagmgr/default.html" target="_blank" rel="noopener">שאלוני בגרות בשפות שונות ↗</a>
        <a class="btn btn-ghost" href="https://exams.education.gov.il" target="_blank" rel="noopener">אגף בחינות הבגרות ↗</a>
      </div>

      <h3 class="formula-title">הנוסחאונים הרשמיים של התוכנית החדשה (החוזר, עמ׳ 15)</h3>
      <div class="table-wrap">
        <table class="formula-table">
          <thead>
            <tr><th>רמה</th><th>עברית</th><th>ערבית</th><th>צרפתית</th><th>אנגלית</th><th>רוסית</th></tr>
          </thead>
          <tbody>
            <tr>
              <th>3 יח״ל</th>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/new-curriculum/3-MATH-Formula_NEW.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/new-curriculum/AR-3-MATH-Formula_NEW.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/3-MATH-Formula_FR.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/3-MATH-Formula_EN.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/3-MATH-Formula_RU.pdf" target="_blank" rel="noopener">PDF</a></td>
            </tr>
            <tr>
              <th>4 יח״ל</th>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/new-curriculum/4-MATH-Formula_NEW.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/new-curriculum/AR-4-MATH-Formula_NEW.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/4-MATH-Formula_FR.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/4-MATH-Formula_EN.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/4-MATH-Formula_RU.pdf" target="_blank" rel="noopener">PDF</a></td>
            </tr>
            <tr>
              <th>5 יח״ל</th>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/new-curriculum/5-MATH-Formula_NEW.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/new-curriculum/AR-5-MATH-Formula_NEW.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/5-MATH-Formula_FR.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/5-MATH-Formula_EN.pdf" target="_blank" rel="noopener">PDF</a></td>
              <td><a href="https://meyda.education.gov.il/files/Pop/0files/matmatika/Chativa-Elyona/5-MATH-Formula_RU.pdf" target="_blank" rel="noopener">PDF</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <nav class="pager-nav" aria-label="ניווט חזרה">
      <a class="btn btn-ghost" href="/chativa-elyona/">חזרה לחטיבה העליונה</a>
      <a class="btn btn-ghost" href="/hozer-mafmar/">לחוזר המלא</a>
      <a class="btn btn-ghost" href="/">לעמוד הראשי</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 680px; margin-block: 1.6rem 2rem; }
  .stack { margin-block-end: clamp(1.8rem, 4vw, 2.6rem); }
  .admin-links h2 { font-size: 1.2rem; margin-block-end: 1rem; }
  .chip-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .formula-title { font-size: 1.05rem; margin-block: 1.8rem 0.8rem; }
  .table-wrap { overflow-x: auto; }
  .formula-table { border-collapse: collapse; min-inline-size: 480px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .formula-table th, .formula-table td { padding: 0.55rem 0.9rem; border: 1px solid var(--line); text-align: center; font-size: 0.92rem; }
  .formula-table thead th { background: var(--paper-soft); font-weight: 700; }
  .formula-table tbody th { background: var(--paper-soft); font-weight: 700; }
  .formula-table a { font-weight: 700; }
  .pager-nav { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-block-start: clamp(2.2rem, 5vw, 3rem); }
</style>
