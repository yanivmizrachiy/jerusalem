---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MafmarRange from '../../components/MafmarRange.astro';
---

<Base
  title="4 יח״ל — חטיבה עליונה — מחוז ירושלים"
  description="רמת 4 יח״ל בתשפ״ז: דגשי כיתה י׳ בגאומטריה ובסטטיסטיקה, שאלון 35471 עם שני נושאים בלבד וללא פרמטרים, ובדיקת השערות לא תילמד — מחוזר המפמ״ר."
>
  <div class="container page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'חטיבה עליונה', href: '/chativa-elyona/' },
        { label: '4 יח״ל' },
      ]}
    />

    <header class="page-head" data-reveal>
      <p class="eyebrow">חטיבה עליונה · תשפ״ז</p>
      <h1>4 יח״ל</h1>
      <p class="lede">
        הבנה מושגית וגמישות בכלים מתמטיים, עם דגש על קדם־אנליזה לקראת חשבון דיפרנציאלי
        ואינטגרלי. בכיתה י׳: שילוב גאומטריה במישור, אנליטית וטריגונומטריה.
      </p>
    </header>

    <div data-reveal>
      <MafmarRange sectionId="MAF-13" accent="var(--sky)" />
    </div>

    <section class="section-block" data-reveal>
      <h2>עוד בחוזר הרלוונטי לרמה</h2>
      <div class="chip-links">
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-16">נוסחאון 4 יח״ל</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-18">קמפוס IL</a>
        <a class="btn btn-ghost" href="/hozer-mafmar/#MAF-19">רשת ביטחון 5→4 ו־4→3</a>
      </div>
    </section>

    <nav class="pager-nav" aria-label="ניווט בין רמות">
      <a class="btn btn-ghost" href="/chativa-elyona/3-yahal/">→ הרמה הקודמת: 3 יח״ל</a>
      <a class="btn btn-ghost" href="/chativa-elyona/">חזרה לחטיבה העליונה</a>
      <a class="btn btn-primary" href="/chativa-elyona/5-yahal/">הרמה הבאה: 5 יח״ל ←</a>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block-start: 1.6rem; }
  .page-head { max-width: 660px; margin-block: 1.6rem 2rem; }
  .section-block { margin-block-start: clamp(2.4rem, 5vw, 3.4rem); }
  .section-block h2 { margin-block-end: 1.2rem; }
  .chip-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pager-nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; margin-block-start: clamp(2.2rem, 5vw, 3rem); }
</style>
