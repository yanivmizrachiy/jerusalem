---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<Base
  title="חטיבה עליונה — מחוז ירושלים"
  description="עמוד החטיבה העליונה יעודכן בהמשך."
>
  <main class="container placeholder-page">
    <Breadcrumbs items={[{ label: 'ראשי', href: '/' }, { label: 'חטיבה עליונה' }]} />

    <section class="placeholder" data-reveal aria-labelledby="upper-title">
      <p class="eyebrow">חטיבה עליונה</p>
      <h1 id="upper-title">העמוד יתעדכן בהמשך</h1>
      <p>התוכן לחטיבה העליונה נמצא בתהליך עדכון. בשלב זה הכניסה הציבורית נשארת נקייה ופשוטה.</p>
      <a class="btn btn-primary" href="/">חזרה לעמוד הראשי</a>
    </section>
  </main>
</Base>

<style>
  .placeholder-page { padding-block: 1rem 4rem; }
  .placeholder {
    min-block-size: min(62svh, 620px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    max-width: 920px;
    margin-inline: auto;
    padding: clamp(2rem, 7vw, 5rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-lg) + 6px);
    background:
      radial-gradient(110% 130% at 85% -10%, rgb(110 159 195 / 0.13), transparent 58%),
      radial-gradient(100% 120% at 10% 110%, rgb(176 141 62 / 0.14), transparent 60%),
      var(--paper);
    box-shadow: var(--shadow-soft);
  }
  .eyebrow { margin: 0 0 0.45rem; color: var(--gold-deep); font-weight: 850; }
  h1 {
    margin: 0;
    color: var(--navy);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1.03;
  }
  .placeholder p:not(.eyebrow) { max-width: 58ch; margin-block: 1rem 1.6rem; color: var(--ink-soft); font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.75; }
</style>
