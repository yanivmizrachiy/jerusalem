---
/**
 * חוזר מפמ״ר תשפ״ז (RULES 9.3): ההטמעה המלאה היחידה של החוזר.
 *
 * פריסה (הוראת יניב, 06/08/2026): מסך מחולק כמו כל עמוד משאב באתר (8.2) —
 * בחצי הימני החוזר עצמו מוטמע חי (עמוד שלם ביחס A4, עם דפדוף עמוד-עמוד),
 * ובחצי השמאלי לוח המידע והפעולות. מתחת לפריסה — מדריך ניווט מסודר: 4
 * כפתורי החלקים, 23 המקטעים (9.3.8, 9.3.20) ומה שהתבטל. התמונה אחרונה.
 * לחיצה על חלק/מקטע במדריך מזיזה את ההטמעה שלמעלה לעמוד הנכון.
 *
 * הטקסט הגלוי נקי מכיתובי דמו (8.25) ומשורת "מחליף" (8.26) — מיפוי
 * ההחלפות חי ב-src/data/mafmar.ts וב-RULES בלבד.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArtBanner from '../components/ArtBanner.astro';
import {
  MAFMAR_URL,
  MAFMAR_TOTAL_PAGES,
  mafmarParts,
  mafmarSections,
  mafmarObsoletes,
  MAFMAR_LOCAL,
  MAFMAR_VIEW,
  MAFMAR_PAGE_W,
  MAFMAR_PAGE_H,
} from '../data/mafmar';

const partAccents = ['var(--olive)', 'var(--terracotta)', 'var(--sky)', 'var(--lilac)'];
const audiences = [
  { key: 'חט״ב', label: 'חטיבת ביניים', accent: 'var(--olive)' },
  { key: 'מעבר', label: 'המעבר לחטיבה העליונה', accent: 'var(--terracotta)' },
  { key: 'חט״ע', label: 'חטיבה עליונה', accent: 'var(--sky)' },
  { key: 'משותף', label: 'משותף לשתי החטיבות', accent: 'var(--lilac)' },
] as const;
---

<Base
  title="חוזר מפמ״ר תשפ״ז — מחוז ירושלים"
  description="חוזר המפמ״ר לשנת תשפ״ז — צפייה בעמוד מלא בחצי המסך ולוח פעולות בחציו השני, עם ניווט לארבעת החלקים ולכל אחד מ־23 המקטעים לפי טווח העמודים שלו."
>
  <div class="page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'מידע רשמי ומדיניות' },
        { label: 'חוזר מפמ״ר תשפ״ז' },
      ]}
    />

    <div class="res-split" data-reveal>
      <aside class="res-panel">
        <p class="res-eyebrow">מידע רשמי ומדיניות · תשפ״ז</p>
        <h1 class="res-title">חוזר מפמ״ר</h1>
        <p class="res-lede">
          חוזר הפיקוח על הוראת המתמטיקה לשנת הלימודים תשפ״ז — {MAFMAR_TOTAL_PAGES}
          עמודים בארבעה חלקים. דפדפו בחוזר שלצד, או קפצו לחלק ולמקטע מהמדריך שמתחת.
        </p>

        <div class="res-actions" role="group" aria-label="פעולות על החוזר">
          <a class="btn btn-primary" href={MAFMAR_URL} target="_blank" rel="noopener">
            פתיחה במקור ↗
          </a>
          <a class="btn btn-whatsapp" id="wa-share" href="#" target="_blank" rel="noopener" aria-label="שיתוף החוזר ב־WhatsApp"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
          <a class="btn btn-gmail" id="mail-share" href="#" aria-label="שליחת החוזר בדוא״ל">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M1.636 20.5h3.819V11.73L0 7.64v11.223c0 .904.732 1.636 1.636 1.636Z" />
              <path fill="#34A853" d="M18.545 20.5h3.819c.904 0 1.636-.732 1.636-1.636V7.64l-5.455 4.09Z" />
              <path fill="#FBBC04" d="M18.545 5.457v6.273L24 7.64V6.275c0-2.023-2.309-3.178-3.927-1.964Z" />
              <path fill="#EA4335" d="M5.455 11.73V5.457L12 10.366l6.545-4.909v6.273L12 16.639Z" />
              <path fill="#C5221F" d="M0 6.275v1.365l5.455 4.09V5.457L4.073 4.42C2.309 3.098 0 4.252 0 6.275Z" />
            </svg>
          </a>
          <button class="btn btn-ghost" type="button" id="copy-link">העתקת קישור לקטע הנוכחי</button>
          <button class="btn btn-ghost" type="button" id="fullscreen-btn" hidden>מסך מלא ⛶</button>
        </div>

        <p class="res-status" id="viewer-status" role="status" aria-live="polite">
          מציג את החוזר המלא — {MAFMAR_TOTAL_PAGES} עמודים
        </p>
      </aside>

      <div class="res-view">
        <section class="viewer">
          <div class="viewer-stage">
            <div
              class="viewer-shell embed-frame"
              id="viewer-shell"
              style={`--pw:${MAFMAR_PAGE_W}; --ph:${MAFMAR_PAGE_H}`}
            >
              <iframe
                id="mafmar-frame"
                src={`${MAFMAR_LOCAL}#page=1&${MAFMAR_VIEW}`}
                title="חוזר מפמ״ר תשפ״ז — המסמך המלא"
                loading="lazy"
              ></iframe>
              <div class="viewer-skel" id="viewer-skel" aria-hidden="true">
                <span class="viewer-skel-spin"></span>
                <span class="viewer-skel-txt">טוען את החוזר…</span>
              </div>
            </div>
            <div class="viewer-open-card embed-frame" id="viewer-open-card" hidden>
              <p>בדפדפן הזה קובצי PDF נפתחים לצפייה במסך נפרד:</p>
              <a class="btn btn-primary" id="open-card-link" href={MAFMAR_LOCAL} target="_blank" rel="noopener">
                פתיחת החוזר ↗
              </a>
            </div>
          </div>
          <div class="viewer-pager" role="group" aria-label="דפדוף בחוזר">
            <button class="btn vpg-prev" id="pg-prev" type="button">→ עמוד קודם</button>
            <span class="vpg-counter" id="pg-counter" aria-live="polite">עמוד 1 מתוך {MAFMAR_TOTAL_PAGES}</span>
            <button class="btn vpg-next" id="pg-next" type="button">עמוד הבא ←</button>
          </div>
        </section>
      </div>
    </div>

    <header class="directory-head" data-reveal>
      <h2>ניווט בחוזר</h2>
      <p class="directory-note">קפצו לחלק או למקטע — ההטמעה שלמעלה תיפתח בעמוד המתאים.</p>
    </header>

    <nav class="part-jumps" aria-label="קפיצה לחלקי החוזר" data-reveal>
      {
        mafmarParts.map((p, i) => (
          <button
            class="part-btn"
            id={p.id}
            style={`--part-accent:${partAccents[i]}`}
            type="button"
            data-goto={p.startPage}
            data-frag={p.id}
            data-label={`${p.title} — מעמוד ${p.startPage}`}
          >
            <span class="part-num">{i + 1}</span>
            <span class="part-title">{p.title}</span>
            <span class="part-page">מעמוד {p.startPage}</span>
          </button>
        ))
      }
    </nav>

    <section class="sections-block" aria-label="מקטעי החוזר לפי קהל">
      {
        audiences.map((a) => (
          <div class="aud-group" data-reveal>
            <h3 class="aud-title" style={`--aud-accent:${a.accent}`}>{a.label}</h3>
            <ul class="maf-list">
              {mafmarSections
                .filter((s) => s.audience === a.key)
                .map((s) => (
                  <li class="maf-item" id={s.id} style={`--aud-accent:${a.accent}`}>
                    <button
                      class="maf-btn"
                      type="button"
                      data-goto={s.startPage}
                      data-frag={s.id}
                      data-label={`${s.title} — עמודים ${s.startPage}–${s.endPage} מתוך חוזר מפמ״ר תשפ״ז`}
                    >
                      <span class="maf-id">{s.id}</span>
                      <span class="maf-text">
                        <span class="maf-title">{s.title}</span>
                        <span class="maf-meta">
                          עמודים {s.startPage}–{s.endPage} · מתוך חוזר מפמ״ר תשפ״ז
                        </span>
                        {s.note && <span class="maf-note">{s.note}</span>}
                      </span>
                    </button>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="obsolete card-accent" style="--card-accent:var(--terracotta)" data-reveal>
      <h2>מה התבטל מהשנה שעברה</h2>
      <ul>
        {
          mafmarObsoletes.map((o) => (
            <li>
              <button class="obs-btn" type="button" data-goto={o.page} data-frag="" data-label={`${o.fact} — עמוד ${o.page}`}>
                {o.fact} <span class="obs-page">(עמ׳ {o.page})</span>
              </button>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="back-nav" aria-label="ניווט חזרה">
      <a class="btn btn-ghost" href="/chativat-beynayim/">לשער חטיבת הביניים</a>
      <a class="btn btn-ghost" href="/">לעמוד הראשי</a>
    </nav>

    <ArtBanner
      art="golden"
      alt="איור אמנותי: ירושלים זהובה בשקיעה — מגדל דוד, גשר המיתרים וגופים גאומטריים זוהרים"
      position="center 45%"
    />
  </div>
</Base>

<style>
  /* מיכל רחב במיוחד — הפריסה והמדריך מנצלים את המסך, בלי לגלוש לקצוות (8.2) */
  .page {
    inline-size: var(--embed-page-inline);
    margin-inline: auto;
    padding-block: 1.2rem clamp(2.6rem, 5vw, 4rem);
  }

  /* ===== חצי-חצי במסך רחב: החוזר מימין, לוח הפעולות משמאל (8.2) =====
     לוח המידע קודם ב-DOM כדי שה-h1 יופיע לפני כותרות המשנה שבתוך
     ההטמעה (סדר כותרות תקין), והסדר החזותי נשמר ב-order: ההטמעה
     בעמודה הראשונה — הימנית ב-RTL. בנייד ההטמעה ראשונה (order:1). */
  .res-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--embed-column-gap);
    margin-block-start: clamp(1.4rem, 3vw, 2.4rem);
    align-items: start;
  }

  .res-view { order: 1; min-inline-size: 0; }
  .res-panel { order: 2; align-self: start; }

  /* ===== לוח המידע והפעולות ===== */
  .res-panel {
    padding: var(--embed-panel-padding);
    border-radius: var(--embed-radius);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-soft);
    border-inline-start: 5px solid var(--gold);
  }

  .res-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gold-deep);
  }

  .res-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.12;
    color: var(--navy);
  }

  .res-lede { margin: 1rem 0 0; color: var(--ink-soft); line-height: 1.75; }

  .res-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: clamp(1.5rem, 2.6vw, 2.1rem);
  }

  .res-status {
    margin: 0.9rem 0 0;
    min-block-size: 1.2rem;
    font-size: 0.9rem;
    color: var(--gold-deep);
    font-weight: 600;
  }

  /* ===== הצופה (הצד הימני) ===== */
  .viewer { display: block; }

  /* ===== עמוד שלם ממש, ביחס A4 (הוראת יניב, 06/08/2026) =====
     ההטמעה ממלאת את רוחב הצד, וגובהה נגזר מיחס העמוד האמיתי של המסמך
     (--pw/--ph מ-MAFMAR_PAGE_W/H) — כך נראה עמוד שלם ולא חלק ממנו. */
  .viewer-stage {
    position: relative;
    /* הכלל הגלובלי scroll-margin חל על [id]; לזה יש class בלבד, ובלי
       השורה קפיצה למקטע מנחיתה את ראש ההטמעה מתחת לכותרת הדביקה */
    scroll-margin-block-start: calc(var(--header-h) + 1.2rem);
  }

  .viewer-shell {
    inline-size: 100%;
    aspect-ratio: var(--pw) / var(--ph);
    block-size: auto;
    min-block-size: 520px;
    margin-inline: auto;
  }

  /* המידות והרקע מגיעים מ-.embed-frame > iframe; כאן רק מה שייחודי */
  .viewer-shell iframe {
    display: block;
    border-radius: var(--embed-inner-radius);
    background: #fff;
    /* חשיפה בעדינות כשה-PDF חי — במקום הבזק לבן (8.9) */
    opacity: 0;
    transition: opacity 460ms var(--ease);
  }

  .viewer-shell.is-loaded iframe { opacity: 1; }

  .viewer-shell:fullscreen {
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    padding: 0;
  }

  .viewer-shell:fullscreen iframe { border-radius: 0; }

  /* שלד טעינה — לעולם אינו חוסם לחיצה בהטמעה (8.9, 3.29) */
  .viewer-skel {
    position: absolute;
    inset: var(--embed-pad);
    border-radius: var(--embed-inner-radius);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    overflow: hidden;
    background: linear-gradient(180deg, #fffdf9 0%, #fbf6ec 100%);
    opacity: 1;
    transition: opacity 420ms var(--ease);
  }

  .viewer-skel::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgb(212 175 92 / 0.16) 48%, rgb(255 255 255 / 0.55) 50%, rgb(212 175 92 / 0.16) 52%, transparent 70%);
    background-size: 220% 100%;
    animation: viewer-shimmer 1.5s ease-in-out infinite;
  }

  .viewer-shell.is-loaded .viewer-skel { opacity: 0; }

  .viewer-skel-spin {
    position: relative;
    z-index: 1;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    border: 3px solid rgb(212 175 92 / 0.26);
    border-block-start-color: var(--gold-deep);
    animation: viewer-spin 0.9s linear infinite;
  }

  .viewer-skel-txt {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--gold-deep);
  }

  @keyframes viewer-shimmer { from { background-position: 150% 0; } to { background-position: -50% 0; } }
  @keyframes viewer-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .viewer-shell iframe { opacity: 1; transition: none; }
    .viewer-skel { transition: none; }
    .viewer-skel::before { animation: none; background: none; }
    .viewer-skel-spin { animation: none; }
  }

  /* דפדפן בלי מציג PDF מובנה (8.8, 8.26): כרטיס פתיחה אמיתי — והוא
     היחיד על הדף, לעולם לא מתחת להטמעה חיה. */
  .viewer-open-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    inline-size: 100%;
    min-block-size: min(70svh, 640px);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    text-align: center;
  }

  .viewer-open-card p { margin: 0; color: var(--ink-soft); }

  /* הכלל הגלובלי [hidden]{display:none!important} ב-global.css מטפל
     בכל הסתרה בעמוד הזה — כולל כרטיס הפתיחה, סרגל הדפדוף וכפתור מסך מלא. */

  /* דפדוף עמוד-עמוד (3.29): צבעי הניווט הבולטים */
  .viewer-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding-block-start: 0.9rem;
  }

  .viewer-pager button {
    flex: 1;
    max-inline-size: 220px;
    min-block-size: 50px;
    border: 0;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
  }

  .vpg-prev {
    background: linear-gradient(180deg, #8e2740 0%, #7a1f33 100%);
    box-shadow: 0 8px 20px -10px rgb(122 31 51 / 0.7);
  }

  .vpg-next {
    background: linear-gradient(180deg, #0f6b3a 0%, #0b5d31 100%);
    box-shadow: 0 8px 20px -10px rgb(11 93 49 / 0.7);
  }

  .vpg-counter { font-weight: 800; color: var(--ink-soft); font-variant-numeric: tabular-nums; }

  /* ===== מדריך הניווט מתחת לפריסה ===== */
  .directory-head {
    margin-block-start: clamp(2.6rem, 6vw, 4rem);
    padding-block-start: clamp(1.6rem, 3vw, 2.4rem);
    border-block-start: 1px solid var(--line);
  }

  .directory-head h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 1.8rem); color: var(--navy); }

  .directory-note { margin: 0.5rem 0 0; color: var(--ink-soft); }

  /* ארבעת כפתורי הקפיצה (9.3.8) */
  .part-jumps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: 0.9rem;
    margin-block-start: clamp(1.2rem, 2.6vw, 1.8rem);
  }

  .part-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid var(--line);
    border-block-start: 4px solid var(--part-accent);
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-body);
    text-align: start;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
  }

  .part-btn:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }

  .part-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    /* הגוון נשמר לזיהוי, מוכהה כדי לעבור 4.5:1 בטקסט קטן (4.7, 21.18) */
    color: color-mix(in srgb, var(--part-accent) 62%, #101a2e);
  }

  .part-title { font-weight: 700; font-size: 1.05rem; color: var(--ink); }

  .part-page { font-size: 0.85rem; color: var(--ink-faint); }

  .part-btn.is-active {
    border-color: var(--part-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--part-accent) 35%, transparent);
  }

  /* אינדקס המקטעים */
  .sections-block { margin-block-start: clamp(2rem, 4vw, 2.8rem); }

  .aud-group { margin-block-end: 2rem; }

  .aud-title {
    font-size: 1.2rem;
    margin-block-end: 0.9rem;
    padding-inline-start: 0.8rem;
    border-inline-start: 4px solid var(--aud-accent);
  }

  .maf-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 0.8rem;
  }

  .maf-btn {
    display: flex;
    gap: 0.8rem;
    inline-size: 100%;
    padding: 0.95rem 1rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-body);
    text-align: start;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease), border-color 300ms var(--ease);
  }

  .maf-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
    border-color: color-mix(in srgb, var(--line) 30%, var(--aud-accent) 70%);
  }

  .maf-item.is-active .maf-btn {
    border-color: var(--aud-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--aud-accent) 35%, transparent);
  }

  .maf-id {
    flex: none;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    /* כנ״ל — 0.72rem מודגש נחשב טקסט קטן ודורש 4.5:1 (4.7, 21.18) */
    color: color-mix(in srgb, var(--aud-accent) 62%, #101a2e);
    padding-block-start: 0.2rem;
  }

  .maf-text { display: flex; flex-direction: column; gap: 0.25rem; }

  .maf-title { font-weight: 700; color: var(--ink); line-height: 1.4; }

  .maf-meta { font-size: 0.82rem; color: var(--ink-faint); }

  .maf-note { font-size: 0.84rem; color: var(--ink-soft); }

  /* מה התבטל */
  .obsolete {
    margin-block-start: clamp(2.4rem, 5vw, 3.4rem);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .obsolete h2 { font-size: 1.3rem; margin-block-end: 1rem; }

  .obsolete ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.55rem; }

  .obs-btn {
    background: none;
    border: 0;
    padding: 0.35rem 0;
    font: inherit;
    color: var(--ink-soft);
    cursor: pointer;
    text-align: start;
    border-block-end: 1px dashed transparent;
  }

  .obs-btn:hover { color: var(--terracotta); }

  .obs-page { color: var(--ink-faint); font-size: 0.85rem; }

  .back-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block: 2.4rem clamp(2rem, 4vw, 3rem);
  }

  /* ===== נייד: ההטמעה ראשונה, ההסבר והפעולות אחריה (8.6) ===== */
  @media (max-width: 1099px) {
    .res-split { grid-template-columns: 1fr; gap: clamp(1.4rem, 4vw, 2.2rem); }
    .viewer-pager { justify-content: center; }
  }
</style>

<script>
  import { MAFMAR_LOCAL, MAFMAR_VIEW, MAFMAR_TOTAL_PAGES } from '../data/mafmar';

  const frame = document.getElementById('mafmar-frame') as HTMLIFrameElement;
  const status = document.getElementById('viewer-status')!;
  const shell = document.getElementById('viewer-shell')!;
  const skel = document.getElementById('viewer-skel')!;
  const openCard = document.getElementById('viewer-open-card') as HTMLElement;
  const openLink = document.getElementById('open-card-link') as HTMLAnchorElement;

  /** כתובת המסמך בעמוד מבוקש — מקור אחד לכל מקום שמדפדף */
  const pageSrc = (page: number) => `${MAFMAR_LOCAL}#page=${page}&${MAFMAR_VIEW}`;

  /** כרטיס הפתיחה מפנה תמיד לעמוד שנבחר בפועל */
  const aimOpenCard = (page: number) => {
    openLink.href = `${MAFMAR_LOCAL}#page=${page}`;
    openLink.textContent = page > 1 ? `פתיחת החוזר בעמוד ${page} ↗` : 'פתיחת החוזר ↗';
  };

  /* דפדפן בלי מציג PDF מובנה (בעיקר אנדרואיד): כרטיס פתיחה אמיתי במקום
     מסגרת ריקה — והוא היחיד על הדף (8.8, 8.26). גם הדפדוף יורד, כי אין
     מה לדפדף בתוך העמוד — הכרטיס מפנה לעמוד המבוקש עצמו (5.13). */
  const stage = document.querySelector<HTMLElement>('.viewer-stage')!;
  const pager = document.querySelector<HTMLElement>('.viewer-pager')!;
  const hasPdfViewer = !('pdfViewerEnabled' in navigator) || navigator.pdfViewerEnabled === true;
  if (!hasPdfViewer) {
    shell.hidden = true;
    pager.hidden = true;
    openCard.hidden = false;
    skel.remove();
    // שורת המצב לא תטען "מציג" כשאין מה להציג בעמוד עצמו (4.6)
    status.textContent = `החוזר נפתח לצפייה במסך נפרד — ${MAFMAR_TOTAL_PAGES} עמודים`;
  }

  /* שלד הטעינה נחשף בעדינות; רשת ביטחון שלא משאירה שלד תקוע (8.9) */
  const reveal = () => shell.classList.add('is-loaded');
  frame.addEventListener('load', reveal);
  window.setTimeout(reveal, 8000);
  const copyBtn = document.getElementById('copy-link') as HTMLButtonElement;
  const wa = document.getElementById('wa-share') as HTMLAnchorElement;
  const mail = document.getElementById('mail-share') as HTMLAnchorElement;
  const fsBtn = document.getElementById('fullscreen-btn') as HTMLButtonElement;

  let currentLabel = status.textContent ?? 'חוזר מפמ״ר תשפ״ז';

  const updateShare = () => {
    const url = location.href;
    const text = `${currentLabel} — ${url}`;
    wa.href = `https://wa.me/?text=${encodeURIComponent(text)}`;
    mail.href = `mailto:?subject=${encodeURIComponent('חוזר מפמ״ר תשפ״ז')}&body=${encodeURIComponent(text)}`;
  };

  let curPage = 1;
  const TOTAL = MAFMAR_TOTAL_PAGES;
  const pgPrev = document.getElementById('pg-prev') as HTMLButtonElement;
  const pgNext = document.getElementById('pg-next') as HTMLButtonElement;
  const pgCounter = document.getElementById('pg-counter')!;

  const paintPager = () => {
    pgCounter.textContent = `עמוד ${curPage} מתוך ${TOTAL}`;
    pgPrev.disabled = curPage <= 1;
    pgNext.disabled = curPage >= TOTAL;
  };

  const goto = (page: number, frag: string, label: string) => {
    curPage = page;
    paintPager();
    // טעינה מחדש של ה־iframe בעמוד המבוקש — כך #page נאכף גם אחרי ניווט קודם
    frame.src = pageSrc(page);
    aimOpenCard(page);
    currentLabel = label;
    status.textContent = hasPdfViewer ? `מציג: ${label}` : `נבחר: ${label}`;
    document
      .querySelectorAll('.maf-item.is-active, .part-btn.is-active')
      .forEach((el) => el.classList.remove('is-active'));
    if (frag) {
      history.replaceState(null, '', `#${frag}`);
      document.getElementById(frag)?.classList.add('is-active');
    } else {
      history.replaceState(null, '', location.pathname);
    }
    updateShare();
    // בלי גלילה מונפשת (5.25) — קפיצה מיידית להטמעה שלמעלה
    stage.scrollIntoView({ block: 'start' });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((btn) => {
    btn.addEventListener('click', () =>
      goto(Number(btn.dataset.goto), btn.dataset.frag ?? '', btn.dataset.label ?? '')
    );
  });

  // דפדוף עמוד-עמוד (3.29)
  const flipTo = (n: number) => {
    if (n < 1 || n > TOTAL) return;
    curPage = n;
    frame.src = pageSrc(n);
    aimOpenCard(n);
    paintPager();
  };
  pgPrev.addEventListener('click', () => flipTo(curPage - 1));
  pgNext.addEventListener('click', () => flipTo(curPage + 1));
  paintPager();

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      status.textContent = 'הקישור הועתק — ' + currentLabel;
    } catch {
      status.textContent = 'ההעתקה נכשלה';
    }
  });

  if (document.fullscreenEnabled) fsBtn.hidden = false;
  fsBtn.addEventListener('click', async () => {
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else await shell.requestFullscreen();
    } catch {
      status.textContent = 'מסך מלא נכשל';
    }
  });

  // כניסה עם קישור עמוק (9.3.12): פתיחת המקטע ישירות
  const frag = decodeURIComponent(location.hash.slice(1));
  if (frag) {
    const esc = CSS.escape(frag);
    const target = document.querySelector<HTMLButtonElement>(
      `#${esc}[data-goto], #${esc} [data-goto]`
    );
    if (target) {
      goto(Number(target.dataset.goto), frag, target.dataset.label ?? '');
      document.getElementById(frag)?.scrollIntoView({ behavior: 'auto', block: 'center' });
    }
  }

  updateShare();
</script>
