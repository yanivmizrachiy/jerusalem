---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArtBanner from '../components/ArtBanner.astro';
import MafmarWeb from '../components/MafmarWeb.astro';

import {
  MAFMAR_LOCAL,
  MAFMAR_URL,
  MAFMAR_TOTAL_PAGES,
  mafmarParts,
  mafmarSections,
  mafmarObsoletes,
} from '../data/mafmar';

const partAccents = [
  'var(--olive)',
  'var(--terracotta)',
  'var(--sky)',
  'var(--lilac)',
];

const audiences = [
  { key: 'חט״ב', label: 'חטיבת ביניים', accent: 'var(--olive)' },
  { key: 'מעבר', label: 'המעבר לחטיבה העליונה', accent: 'var(--terracotta)' },
  { key: 'חט״ע', label: 'חטיבה עליונה', accent: 'var(--sky)' },
  { key: 'משותף', label: 'משותף לשתי החטיבות', accent: 'var(--lilac)' },
] as const;
---

<Base
  title="חוזר מפמ״ר תשפ״ז — מחוז ירושלים"
  description="חוזר המפמ״ר לשנת תשפ״ז כתוכן אינטרנט מלא, נגיש ולחיץ, עם 18 עמודים וניווט ל־23 המקטעים."
>
  <div class="page">
    <Breadcrumbs
      items={[
        { label: 'ראשי', href: '/' },
        { label: 'מידע ומדיניות' },
        { label: 'חוזר מפמ״ר תשפ״ז' },
      ]}
    />

    <header class="hero card-accent" style="--card-accent:var(--gold)" data-reveal>
      <p class="eyebrow">מידע ומדיניות · תשפ״ז</p>
      <h1>חוזר מפמ״ר</h1>
      <p>
        חוזר הפיקוח על הוראת המתמטיקה לשנת הלימודים תשפ״ז מוצג כאן
        כתוכן אינטרנט מקומי מלא — {MAFMAR_TOTAL_PAGES} עמודים,
        עם הקישורים המקוריים במקומם.
      </p>

      <div class="source-actions">
        <a class="btn btn-primary" href={MAFMAR_URL} target="_blank" rel="noopener noreferrer">
          מקור משרד החינוך ↗
        </a>
        <a class="btn btn-ghost" href={MAFMAR_LOCAL} download>
          PDF להורדה ↓
        </a>
      </div>
    </header>

    <nav class="part-jumps" aria-label="קפיצה לחלקי החוזר" data-reveal>
      {
        mafmarParts.map((part, index) => (
          <a
            class="part-btn"
            href={`#${part.id}`}
            style={`--part-accent:${partAccents[index]}`}
          >
            <span class="part-num">{index + 1}</span>
            <span>
              <strong>{part.title}</strong>
              <small>מעמוד {part.startPage}</small>
            </span>
          </a>
        ))
      }
    </nav>

    <MafmarWeb canonical />

    <header class="directory-head" data-reveal>
      <h2>ניווט לפי נושאים</h2>
      <p>כל 23 המקטעים מובילים לעוגן HTML אמיתי בתוך החוזר.</p>
    </header>

    <section class="sections-block" aria-label="מקטעי החוזר לפי קהל">
      {
        audiences.map((audience) => (
          <div class="aud-group" data-reveal>
            <h3 style={`--aud-accent:${audience.accent}`}>{audience.label}</h3>
            <ul>
              {mafmarSections
                .filter((section) => section.audience === audience.key)
                .map((section) => (
                  <li>
                    <a href={`#${section.id}`}>
                      <span class="maf-id">{section.id}</span>
                      <span>
                        <strong>{section.title}</strong>
                        <small>
                          עמודים {section.startPage}–{section.endPage}
                        </small>
                        {section.note && <em>{section.note}</em>}
                      </span>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="obsolete card-accent" style="--card-accent:var(--terracotta)" data-reveal>
      <h2>מה התבטל מהשנה שעברה</h2>
      <ul>
        {
          mafmarObsoletes.map((item) => (
            <li>
              <a href={`#mafmar-page-${item.page}`}>
                {item.fact} <span>(עמ׳ {item.page})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="back-nav" aria-label="ניווט חזרה">
      <a class="btn btn-ghost" href="/chativat-beynayim/">לשער חטיבת הביניים</a>
      <a class="btn btn-ghost" href="/">לעמוד הראשי</a>
    </nav>

    <ArtBanner
      art="golden"
      alt="איור אמנותי: ירושלים זהובה בשקיעה — מגדל דוד, גשר המיתרים וגופים גאומטריים זוהרים"
      position="center 45%"
    />
  </div>
</Base>

<style>
  .page {
    inline-size: var(--embed-page-inline);
    margin-inline: auto;
    padding-block: 1.2rem clamp(2.6rem, 5vw, 4rem);
  }

  .hero {
    margin-block: 1.2rem 1rem;
    padding: clamp(1.1rem, 2.5vw, 1.8rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .hero h1 {
    margin: 0.2rem 0 0;
    color: var(--navy);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.7rem);
  }

  .hero > p:not(.eyebrow) {
    max-inline-size: 850px;
    color: var(--ink-soft);
    line-height: 1.75;
  }

  .source-actions,
  .back-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-block-start: 1rem;
  }

  .part-jumps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
    margin-block: 1rem 1.2rem;
  }

  .part-btn {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-block-size: 76px;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--part-accent) 35%, var(--line));
    border-radius: 15px;
    color: var(--navy);
    background: color-mix(in srgb, var(--part-accent) 8%, #fff);
    text-decoration: none;
  }

  .part-num {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    flex: 0 0 auto;
    border-radius: 50%;
    color: #fff;
    background: var(--part-accent);
    font-weight: 900;
  }

  .part-btn strong,
  .part-btn small {
    display: block;
  }

  .part-btn small {
    margin-block-start: 0.15rem;
    color: var(--ink-soft);
  }

  .directory-head {
    margin-block: 2rem 0.8rem;
  }

  .directory-head p {
    color: var(--ink-soft);
  }

  .sections-block {
    display: grid;
    gap: 1rem;
  }

  .aud-group {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fff;
  }

  .aud-group h3 {
    margin: 0 0 0.65rem;
    padding-inline-start: 0.6rem;
    border-inline-start: 5px solid var(--aud-accent);
    color: var(--navy);
  }

  .aud-group ul,
  .obsolete ul {
    display: grid;
    gap: 0.48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aud-group a {
    display: flex;
    gap: 0.65rem;
    padding: 0.65rem;
    border-radius: 12px;
    color: var(--ink);
    background: var(--paper-soft);
    text-decoration: none;
  }

  .maf-id {
    flex: 0 0 auto;
    color: var(--gold-deep);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .aud-group strong,
  .aud-group small,
  .aud-group em {
    display: block;
  }

  .aud-group small,
  .aud-group em {
    margin-block-start: 0.18rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .obsolete {
    margin-block-start: 1rem;
    padding: 1rem;
    border-radius: 18px;
  }

  .obsolete a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 900px) {
    .part-jumps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .part-jumps {
      grid-template-columns: 1fr;
    }
  }

  /* MAFMAR-AA-PART-NUM */
  .part-num {
    color: #111827;
  }
</style>
