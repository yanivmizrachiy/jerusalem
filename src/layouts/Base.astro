---
import '@fontsource-variable/heebo';
import '@fontsource/frank-ruhl-libre/400.css';
import '@fontsource/frank-ruhl-libre/500.css';
import '@fontsource/frank-ruhl-libre/700.css';
// preload לפונטים העבריים הקריטיים — מבטל את קפיצת ה-reflow של טעינת הפונט (CLS)
import heeboHebrewUrl from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';
import frankHebrew500Url from '@fontsource/frank-ruhl-libre/files/frank-ruhl-libre-hebrew-500-normal.woff2?url';
import '../styles/global.css';
import '../styles/luxury-controls.css';
import '../styles/home-immediate.css';
import DateBar from '../components/DateBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** header שקוף מעל hero בעמוד הראשי */
  transparentHeader?: boolean;
}

const { title, description, transparentHeader = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/logo.png', Astro.site).href : '/logo.png';
const structuredData = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'מתמטיקה מחוז ירושלים',
      url: new URL('/', Astro.site).href,
      inLanguage: 'he-IL',
      description,
    }
  : undefined;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbf9f5" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="מתמטיקה מחוז ירושלים — משרד החינוך" />
    <meta property="og:image:width" content="440" />
    <meta property="og:image:height" content="440" />
    {/* חותם הבנייה — מאפשר לאמת שהפרודקשן מגיש בדיוק את הקומיט שנמזג (scripts/verify-deploy.mjs) */}
    <meta name="build-commit" content={(process.env.VERCEL_GIT_COMMIT_SHA ?? 'dev').slice(0, 7)} />
    <link rel="preload" as="font" type="font/woff2" href={heeboHebrewUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/DSEG7Classic-BoldItalic.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frankHebrew500Url} crossorigin />
    <link rel="preconnect" href="https://docs.google.com" />
    <link rel="preconnect" href="https://drive.google.com" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-180.png" />
    {/* מעבר "התחל" → בחירת החטיבה: החלקה מכוונת במקום עמעום (RTL). מסמן את
        המעבר / → /shearim/ בלבד, וה-CSS (global.css) מחליק את העמוד ימינה ואת
        הבא משמאל. Chromium בלבד (View Transitions ל-MPA); דפדפן אחר מנווט רגיל. */}
    <script is:inline>
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        try {
          const navigation = Reflect.get(window, 'navigation');
          const from = navigation?.activation?.from?.url;
          if (from && new URL(from).pathname === '/' && location.pathname === '/shearim/') {
            const root = document.documentElement;
            root.classList.add('vt-forward');
            e.viewTransition.finished.finally(() => root.classList.remove('vt-forward'));
          }
        } catch {}
      });
    </script>
    {/* העמוד הראשי עולה מיד — אין מנגנון "נצפה" ואין bootstrap של הסתרה
        (RULES 6.2, הוראת יניב 10/08/2026). */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן המרכזי</a>
    <DateBar />
    <SiteHeader transparent={transparentHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // חשיפה עדינה בגלילה (5.6, 5.20) — מכבד prefers-reduced-motion דרך ה־CSS
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // מעבר עוגן פנימי בעמעום מהיר — בלי גלילה נראית (5.25, הוראת יניב 03/08/2026)
      document.addEventListener(
        'click',
        (e) => {
          const a = (e.target as Element).closest?.('a[href^="#"]');
          if (!a) return;
          const sel = a.getAttribute('href')!;
          const target = sel.length > 1 ? document.querySelector(sel) : null;
          if (!target) return;
          e.preventDefault();
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            location.hash = sel;
            return;
          }
          const body = document.body;
          body.style.transition = 'opacity 150ms ease';
          body.style.opacity = '0';
          setTimeout(() => {
            location.hash = sel;
            body.style.transition = 'opacity 280ms ease';
            body.style.opacity = '1';
          }, 160);
        },
        true
      );
    </script>
  </body>
</html>