---
import '@fontsource-variable/heebo';
import '@fontsource/frank-ruhl-libre/400.css';
import '@fontsource/frank-ruhl-libre/500.css';
import '@fontsource/frank-ruhl-libre/700.css';
// preload לפונטים העבריים הקריטיים — מבטל את קפיצת ה-reflow של טעינת הפונט (CLS)
import heeboHebrewUrl from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';
import frankHebrew500Url from '@fontsource/frank-ruhl-libre/files/frank-ruhl-libre-hebrew-500-normal.woff2?url';
import '../styles/global.css';
import DateBar from '../components/DateBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** header שקוף מעל hero בעמוד הראשי */
  transparentHeader?: boolean;
}

const { title, description, transparentHeader = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbf9f5" />
    <meta property="og:image" content="/logo.png" />
    <link rel="preload" as="font" type="font/woff2" href={heeboHebrewUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frankHebrew500Url} crossorigin />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-180.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן המרכזי</a>
    <DateBar />
    <SiteHeader transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // חשיפה עדינה בגלילה (5.6, 5.20) — מכבד prefers-reduced-motion דרך ה־CSS
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
